#!/usr/bin/env python3
# HYPPYUKOT (STOMPERS) - couch multiplayer stomp platformer for Batocera (pygame 2).
# Single file, no assets. Copy to /userdata/roms/pygame/
import os, sys, math, random, array, json, threading
import pygame

W, H = 320, 180
TILE = 16
COLS, ROWS = W // TILE, 10          # 20 x 10 tile field, 20px HUD strip
GRAV = 0.32
JUMP_V = -5.6                       # ~49 px apex
MAX_FALL = 6.0
RUN = 1.7
VERSION = "1.2.1"
PCOLORS = [((235, 70, 70), (140, 30, 40)), ((70, 150, 255), (30, 60, 150)),
           ((90, 220, 90), (30, 120, 50)), ((250, 210, 60), (170, 120, 20))]
PCOLKEYS = ["red", "blue", "green", "yellow"]

