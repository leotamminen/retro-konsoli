#!/usr/bin/env python3
# KULTAKIRI - rento 2-4 pelaajan juoksupeli Batoceralle (pygame 2).
# Yksi tiedosto, ei assetteja. Kopioi kansioon /userdata/roms/pygame/
# Versio tulee buildin aikana version.jsonista.
def load_version():
    return '0.2'


# ---- const.py ----
# Shared numbers. Jump reachability tests and the chunk designer both use these.
FPS = 60
W, H = 320, 180
PW, PH = 12, 16

GRAV = 0.28
JUMP_V = -5.15
JUMP_CUT = 0.5
MAX_FALL = 5.1
GLIDE_FALL = 0.62
TILE = 16
MAX_RISE = TILE * 2          # one step is never more than two tiles
RUN = 1.82
# The screen is always a little faster than a normal run, so a full sprint
# drifts toward the left edge and can never catch the right edge.
# Only the speed powerup outruns the scroll.
SPEED_RUN = 2.58
ACCEL = 0.62
COYOTE = 6
JUMP_BUF = 6
SLOW_MUL = 0.84
SHORT_HOLD = 9
CRUMBLE_TIME = 66

SCROLL0 = 1.88               # RUN + 0.06
SCROLL_MAX = 1.96            # RUN + 0.14
SCROLL_ACC = 0.00012

CH_W = 208
EY = 136
LEAD = 18
JUMP_HOLD = 34
FALL_Y = 196
BUMP_VX = 1.45
MAGNET_R = 56
MAGNET_PULL = 3.1

FINISH_X = 5200
ROUNDS = 3
GHOST_FRAMES = 270
INV_HAZARD = 28
STUN_HAZARD = 14

COIN_PTS = 10
DIST_DIV = 24
WIN_PTS = 350

DUR = {
    "double": 360,
    "speed": 300,
    "shield": 420,
    "magnet": 360,
    "slow": 180,
    "glide": 300,
}
POWER_KINDS = ("double", "speed", "shield", "magnet", "slow", "glide")

# Body, outline. Four players, identical controls, distinct colours.
PCOLORS = (
    ((232, 72, 64), (92, 24, 28)),
    ((64, 148, 240), (18, 48, 112)),
    ((72, 196, 96), (20, 96, 44)),
    ((244, 196, 48), (148, 96, 16)),
)
PNAMES = ("PUNAINEN", "SININEN", "VIHREÄ", "KELTAINEN")

POWER_COLORS = {
    "double": (72, 168, 255),
    "speed": (255, 148, 40),
    "shield": (64, 228, 216),
    "magnet": (228, 72, 96),
    "slow": (176, 112, 255),
    "glide": (110, 220, 140),
}

# ---- font.py ----
# Chunky 5x7 glyphs, including Ä Ö Å, so the Pi does not need a system font.
import pygame

_G = {
    "A": "01110100011000111111100011000110001",
    "B": "11110100011000111110100011000111110",
    "C": "01111100001000010000100001000001111",
    "D": "11110100011000110001100011000111110",
    "E": "11111100001000011110100001000011111",
    "F": "11111100001000011110100001000010000",
    "G": "01111100001000010111100011000101111",
    "H": "10001100011000111111100011000110001",
    "I": "11111001000010000100001000010001111",
    "J": "00111000100001000010000101001001100",
    "K": "10001100101010011000101001001010001",
    "L": "10000100001000010000100001000011111",
    "M": "10001110111010110001100011000110001",
    "N": "10001110011010110011100011000110001",
    "O": "01110100011000110001100011000101110",
    "P": "11110100011000111110100001000010000",
    "Q": "01110100011000110001101011001001101",
    "R": "11110100011000111110101001001010001",
    "S": "01111100001000001110000010000111110",
    "T": "11111001000010000100001000010000100",
    "U": "10001100011000110001100011000101110",
    "V": "10001100011000110001010100101000100",
    "W": "10001100011000110101101011010101010",
    "X": "10001100010101000100010101000110001",
    "Y": "10001100010101000100001000010000100",
    "Z": "11111000010001000100010001000011111",
    "0": "01110100011001110101110011000101110",
    "1": "00100011000010000100001000010001110",
    "2": "01110100010000100010001000100011111",
    "3": "11110000010000101110000010000111110",
    "4": "00010001100101010010111110001000010",
    "5": "11111100001000011110000010000111110",
    "6": "01110100001000011110100011000101110",
    "7": "11111000010001000100010000100001000",
    "8": "01110100011000101110100011000101110",
    "9": "01110100011000101111000010000101110",
    "Ä": "10101000000111010001111111000110001",
    "Ö": "10101000000111010001100011000101110",
    "Å": "00100010100111010001111111000110001",
    ".": "00000000000000000000000000110001100",
    "!": "00100001000010000100001000000000100",
    "?": "01110100010000100110001000000000100",
    ":": "00000011000110000000011000110000000",
    "-": "00000000000000011111000000000000000",
    "+": "00000001000010011111001000010000000",
    "/": "00001000010001000100010001000010000",
    "'": "00100001000100000000000000000000000",
    " ": "00000000000000000000000000000000000",
}


def has_glyph(ch):
    return ch in _G


class Font:
    def __init__(self):
        self.cache = {}

    def size(self, text, scale=1):
        if not text:
            return 0, 7 * scale
        return len(text) * 6 * scale - scale, 7 * scale

    def render(self, text, color, scale=1):
        key = (text, color, scale)
        hit = self.cache.get(key)
        if hit is not None:
            return hit
        w, h = self.size(text, scale)
        surf = pygame.Surface((max(1, w), max(1, h)), pygame.SRCALPHA)
        if w and text:
            x = 0
            adv = 6 * scale
            for ch in text:
                bits = _G.get(ch, _G["?"])
                for i, bit in enumerate(bits):
                    if bit == "1":
                        pygame.draw.rect(surf, color, (x + (i % 5) * scale, (i // 5) * scale, scale, scale))
                x += adv
        self.cache[key] = surf
        return surf


def blit(surf, font, text, x, y, color, scale=1, center=False, shadow=True):
    if not text:
        return
    img = font.render(text, color, scale)
    if center:
        x -= img.get_width() // 2
        y -= img.get_height() // 2
    if shadow:
        sh = font.render(text, (32, 18, 28), scale)
        surf.blit(sh, (x + scale, y + scale))
    surf.blit(img, (x, y))

