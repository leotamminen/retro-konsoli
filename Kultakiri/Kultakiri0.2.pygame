    "liuku",
    plats=[_ground(90), (156, EY, 52)],
    movers=[(76, EY, 112, 12, 120)],
    coins=[(40, EY - 24), (180, EY - 24)],
    powers=[(124, EY - 18)],
    tier=1,
)

# Low road has a bramble. High road is two tiles up and holds the power.
HAARA = Chunk(
    "haara",
    plats=[_ground(CH_W), (78, EY - 32, 72)],
    hazards=[_thorn(108, 16, 10)],
    coins=[(40, EY - 24), (100, EY - 54), (176, EY - 24)],
    powers=[(108, EY - 54)],
    tier=1,
)

# Four short steps up to two tiles, then back down to the exit.
RAPUT = Chunk(
    "raput",
    plats=[_ground(70), (58, EY - 16, 40), (90, EY - 32, 40), (122, EY - 16, 40), (150, EY, 58)],
    coins=[(36, EY - 24), (104, EY - 54), (176, EY - 24)],
    powers=[(104, EY - 52)],
    tier=1,
)

POOL = (
    TASAMAA, KOLIKOT, PIKKUKUILU, KUILU, KAKSI, NOUSU, LASKU,
    OKAPUU, KAPEA, SIKSAK, PORTAAT, MATALA,
    KATTO, PIIKIT, MUREA, LIUKU, HAARA, RAPUT,
)
ALL_CHUNKS = (ALKU, MAALI) + POOL
BY_NAME = {c.name: c for c in ALL_CHUNKS}


def validate_all():
    for chunk in ALL_CHUNKS:
        validate_chunk(chunk)
    return True

# ---- world.py ----
# Endless course: a fixed opening, then a shuffle of proved chunks, then a finish.
import random



class Coin:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)
        self.alive = True


class Pickup:
    def __init__(self, kind, x, y, shared=False):
        self.kind = kind
        self.x = float(x)
        self.y = float(y)
        self.alive = True
        self.t = 0
        self.shared = shared
        self.got = set()
        self.linger = 0


class Crumble:
    def __init__(self, x, top, w):
        self.x, self.top, self.w = float(x), float(top), float(w)
        self.timer = 0
        self.armed = False
        self.live = True


class Mover:
    def __init__(self, x, top, w, amp, period):
        self.x, self.top, self.w = float(x), float(top), float(w)
        self.amp, self.period = float(amp), int(period)

    def at(self, frame):
        return self.x + mover_dx(frame, self.period, self.amp), self.top, self.w


class World:
    # Teach the new shapes while the scroll is still gentle, each once.
    OPENING = ("pikkukuilu", "portaat", "okapuu", "lasku", "murea", "liuku", "katto", "piikit", "haara")

    def __init__(self, rng=None):
        self.rng = rng or random.Random()
        validate_all()
        self.placed = []
        self.x_end = 0.0
        self.coins = []
        self.powers = []
        self.crumbles = []
        self.movers = []
        self.power_i = 0
        self.last_hard = False
        self.last_name = ""
        self.frame = 0
        self.done = False
        self.finish_x = None
        self.opening = list(self.OPENING)
        self._place(ALKU)
        self.ensure(0, SCROLL0)

    def _allowed(self, chunk, scroll):
        ramp = (scroll - SCROLL0) / max(0.001, SCROLL_MAX - SCROLL0)
        ramp = 0.0 if ramp < 0 else (1.0 if ramp > 1 else ramp)
        if chunk.tier >= 2 and ramp < 0.55:
            return False
        if chunk.tier == 1 and ramp < 0.15:
            return False
        if chunk.name == self.last_name:
            return False
        if self.last_hard and chunk.hard:
            return False
        return True

    def _pick(self, scroll):
        if self.opening:
            return BY_NAME[self.opening.pop(0)]
        choices = [c for c in POOL if self._allowed(c, scroll)]
        if not choices:
            choices = [c for c in POOL if c.tier == 0 and c.name != self.last_name] or list(POOL)
        ramp = (scroll - SCROLL0) / max(0.001, SCROLL_MAX - SCROLL0)
        bag = []
        for chunk in choices:
            weight = 4 - chunk.tier
            if ramp > 0.7 and chunk.tier >= 1:
                weight += 1
            bag.extend([chunk] * max(1, weight))
        return self.rng.choice(bag)

    def _place(self, chunk):
        origin = float(self.x_end)
        self.placed.append((origin, chunk))
        self.x_end += chunk.w
        self.last_hard = chunk.hard
        self.last_name = chunk.name
        for x, y in chunk.coins:
            self.coins.append(Coin(origin + x, y))
        for x, y in chunk.powers:
            kind = POWER_KINDS[self.power_i % len(POWER_KINDS)]
            self.power_i += 1
            self.powers.append(Pickup(kind, origin + x, y, shared=False))
        for x, top, w in chunk.crumbles:
            self.crumbles.append(Crumble(origin + x, top, w))
        for x, top, w, amp, period in chunk.movers:
            self.movers.append(Mover(origin + x, top, w, amp, period))
        if chunk.name == "maali":
            self.finish_x = origin + 70
            self.done = True

    def ensure(self, camera, scroll=None):
        if scroll is None:
            scroll = SCROLL0
        guard = 0
        while self.x_end < camera + W + CH_W * 2 and not self.done and guard < 48:
            guard += 1
            if self.x_end >= FINISH_X:
                self._place(MAALI)
                break
            self._place(self._pick(scroll))

    def arm_crumbles(self, players):
        for player in players:
            body = player.body
            if player.state != "run" or not body.on_ground:
                continue
            fx = body.x + body.w * 0.5
            fy = body.feet()
            for tile in self.crumbles:
                if tile.live and abs(fy - tile.top) <= 3 and tile.x - 2 <= fx <= tile.x + tile.w + 2:
                    tile.armed = True

    def advance(self):
        self.frame += 1
        for tile in self.crumbles:
            if tile.armed and tile.live:
                tile.timer += 1
                if tile.timer >= CRUMBLE_TIME:
                    tile.live = False

    def _near(self, x0, x1):
        for origin, chunk in self.placed:
            if origin + chunk.w < x0 or origin > x1:
                continue
            yield origin, chunk

    def solids_near(self, x0, x1):
        out = []
        for origin, chunk in self._near(x0, x1):
            for px, top, pw in chunk.plats:
                out.append((origin + px, top, pw))
        for tile in self.crumbles:
            if tile.live and tile.x + tile.w >= x0 and tile.x <= x1:
                out.append((tile.x, tile.top, tile.w))
        for slab in self.movers:
            x, top, w = slab.at(self.frame)
            if x + w >= x0 and x <= x1:
                out.append((x, top, w))
        return out

    def hazards_near(self, x0, x1):
        out = []
        for origin, chunk in self._near(x0, x1):
            for hx, hy, hw, hh in chunk.hazards:
                out.append((origin + hx, hy, hw, hh))
            for hx, hy, hw, hh in chunk.ceilings:
                out.append((origin + hx, hy, hw, hh))
        return out


def chunk_count():
    return len(ALL_CHUNKS)

# ---- actors.py ----
# Runners, the one ghost rescue, bumps and powerups.
# Players never stand on each other and there is no stomp.
import math



class Player:
    def __init__(self, idx, pad):
        self.idx = idx
        self.pad = pad
        self.pilot = None
        self.body = Body()
        self.state = "run"
        self.coins = 0
        self.total_coins = 0
        self.max_x = 0.0
        self.bank = 0
        self.wins = 0
        self.rescues = 1
        self.ghost_t = 0
        self.ghost_land = 0
        self.inv = 0
        self.double_t = 0
        self.speed_t = 0
        self.shield_t = 0
        self.shield = False
        self.magnet_t = 0
        self.slow_t = 0
        self.glide_t = 0
        self.face = 1
        self.anim = 0.0
        self.squash = 0.0
        self.popup = None
        self.lost_t = 0
        self.round_pts = 0
        self.round_meters = 0

    def reset_round(self):
        b = self.body
        b.vx = b.vy = 0.0
        b.on_ground = True
        b.coyote = 0
        b.buf = 0
        b.air_jumps = 0
        b.air_max = 0
        b.stun = 0
        b.slow = b.glide = b.speed = False
        b.was_jump = False
        self.state = "run"
        self.coins = 0
        self.rescues = 1
        self.ghost_t = 0
        self.ghost_land = 0
        self.inv = 18
        self.double_t = self.speed_t = self.shield_t = 0
        self.magnet_t = self.slow_t = self.glide_t = 0
        self.shield = False
        self.squash = 0.0
        self.popup = None
        self.round_pts = 0
        self.round_meters = 0
        if self.pilot is not None:
            self.pilot.hold = 0
            self.pilot.did_air = False

    def sync_flags(self):
        b = self.body
        b.speed = self.speed_t > 0
        b.glide = self.glide_t > 0
        b.slow = self.slow_t > 0
        b.air_max = 1 if self.double_t > 0 else 0

    def tick_timers(self):
        for name in ("double_t", "speed_t", "shield_t", "magnet_t", "slow_t", "glide_t"):
            value = getattr(self, name)
            if value > 0:
                setattr(self, name, value - 1)
        if self.shield_t <= 0:
            self.shield = False
        if self.inv > 0:
            self.inv -= 1
        if self.lost_t > 0:
            self.lost_t -= 1
        if self.popup is not None:
            text, left = self.popup
            self.popup = None if left <= 1 else (text, left - 1)
        if self.squash > 0.02:
            self.squash *= 0.72
        else:
            self.squash = 0.0

    def main_power(self):
        best = None
        best_t = 0
        for key, attr in (
            ("double", "double_t"), ("speed", "speed_t"), ("shield", "shield_t"),
            ("magnet", "magnet_t"), ("slow", "slow_t"), ("glide", "glide_t"),
        ):
            value = getattr(self, attr)
            if key == "shield" and not self.shield:
                continue
            if value > best_t:
                best_t = value
                best = key
        return best


def _note(stats, key, n=1):
    if stats is not None:
        stats[key] = stats.get(key, 0) + n


def _got(stats, kind):
    if stats is None:
        return
    got = stats.setdefault("got_powers", [])
    if kind not in got:
        got.append(kind)


def give_power(player, kind, others, stats=None):
    if kind == "double":
        player.double_t = DUR["double"]
        player.body.air_max = 1
        if not player.body.on_ground:
            player.body.air_jumps = max(player.body.air_jumps, 1)
    elif kind == "speed":
        player.speed_t = DUR["speed"]
    elif kind == "shield":
        player.shield = True
        player.shield_t = DUR["shield"]
        _note(stats, "shield_on")
    elif kind == "magnet":
        player.magnet_t = DUR["magnet"]
    elif kind == "slow":
        slowed = False
        for other in others:
            if other is not player and other.state == "run":
                other.slow_t = max(other.slow_t, DUR["slow"])
                slowed = True
        if slowed:
            _note(stats, "slow_on")
    elif kind == "glide":
        player.glide_t = DUR["glide"]
    player.popup = (tr("p_" + kind), 55)
    _got(stats, kind)


def tick_runner(player, ix, jump_held, jump_pressed, solids, stats=None):
    if player.state != "run":
        return None
    player.sync_flags()
    did, landed = step_body(player.body, ix, jump_held, jump_pressed, solids)
    b = player.body
    if did == "airjump":
        _note(stats, "double_air")
    if player.speed_t > 0 and b.vx > RUN + 0.12:
        _note(stats, "speed_fast")
    if player.glide_t > 0 and jump_held and (not b.on_ground) and abs(b.vy - GLIDE_FALL) < 0.08:
        _note(stats, "glide_frames")
    if b.vx > 0.25:
        player.face = 1
    elif b.vx < -0.25:
        player.face = -1
    if landed is not None:
        player.squash = 0.45
    player.anim += abs(b.vx)
    return did


def touch_hazard(player, hazards, stats=None):
    if player.state != "run" or player.inv > 0:
        return None
    b = player.body
    for hx, hy, hw, hh in hazards:
        if not rect_hit(b.x, b.y, b.w, b.h, hx, hy, hw, hh):
            continue
        if player.shield:
            player.shield = False
            player.shield_t = 0
            player.inv = INV_HAZARD
            b.vy = -2.4
            b.on_ground = False
            _note(stats, "shield_block")
            return "block"
        b.vx = -1.7
        b.vy = -3.1
        b.on_ground = False
        b.stun = STUN_HAZARD
        player.inv = INV_HAZARD
        return "hit"
    return None


def fate(player, camera_x):
    if player.state != "run":
        return None
    if player.body.y > FALL_Y - 10:
        return "fall"
    if player.body.x + player.body.w < camera_x - 1:
        return "behind"
    return None


def start_ghost(player, camera_x):
    """One rescue per round. Coins still count. A second miss is out for the round."""
    if player.rescues <= 0:
        player.state = "out"
        player.popup = (tr("out"), 50)
        return "out"
    player.rescues -= 1
    player.state = "ghost"
    player.ghost_t = GHOST_FRAMES
    player.ghost_land = 0
    player.body.x = camera_x + 30
    player.body.y = 52
    player.body.vx = 0.0
    player.body.vy = 0.0
    player.body.on_ground = False
    player.body.stun = 0
    player.inv = 0
    player.popup = (tr("ghost"), 45)
    return "ghost"


def tick_ghost(player, ix, iy, solids, camera_x, scroll):
    player.ghost_t -= 1
    player.body.vx = scroll + ix * 1.15
    player.body.vy = iy * 1.2 + 0.16
    player.body.x += player.body.vx
    player.body.y += player.body.vy
    lo = camera_x + 2
    hi = camera_x + W - PW - 2
    player.body.x = lo if player.body.x < lo else (hi if player.body.x > hi else player.body.x)
    if player.body.y < 16:
        player.body.y = 16
    elif player.body.y > H - PH - 12:
        player.body.y = H - PH - 12
    feet = player.body.feet()
    cx = player.body.x + PW * 0.5
    top = None
    for px, py, pw in solids:
        if px - 2 <= cx <= px + pw + 2 and abs(feet - py) <= 7:
            top = py
            break
    if top is not None:
        player.ghost_land += 1
        if player.ghost_land >= 8:
            player.body.y = top - PH
            player.body.vy = 0.0
            player.body.vx = max(player.body.vx, scroll)
            player.body.on_ground = True
            player.sync_flags()
            player.body.air_jumps = player.body.air_max
            player.state = "run"
            player.inv = 36
            player.ghost_t = 0
            return "revive"
    else:
        player.ghost_land = 0
    if player.ghost_t <= 0:
        player.state = "out"
        player.popup = (tr("out"), 50)
        return "expire"
    return None


def clamp_runner(player, camera_x, scroll):
    if player.state != "run":
        return
    limit = camera_x + W - PW - 3
    if player.body.x > limit:
        player.body.x = limit
        if player.body.vx > scroll:
            player.body.vx = scroll


def separate_bumps(players, stats=None):
    runners = [p for p in players if p.state == "run"]
    for i, a in enumerate(runners):
        for b in runners[i + 1:]:
            ab, bb = a.body, b.body
            if not rect_hit(ab.x, ab.y, ab.w, ab.h, bb.x, bb.y, bb.w, bb.h):
                continue
            if abs((ab.y + ab.h * 0.5) - (bb.y + bb.h * 0.5)) > PH * 0.42:
                continue
            if ab.x <= bb.x:
                ab.vx = min(ab.vx, -BUMP_VX)
                bb.vx = max(bb.vx, BUMP_VX)
                overlap = (ab.x + ab.w) - bb.x
                if overlap > 0:
                    ab.x -= overlap * 0.5 + 0.4
                    bb.x += overlap * 0.5 + 0.4
            else:
                bb.vx = min(bb.vx, -BUMP_VX)
                ab.vx = max(ab.vx, BUMP_VX)
                overlap = (bb.x + bb.w) - ab.x
                if overlap > 0:
                    bb.x -= overlap * 0.5 + 0.4
                    ab.x += overlap * 0.5 + 0.4
            _note(stats, "bumps")


def pull_coins(players, coins, stats=None):
    for player in players:
        if player.state != "run" or player.magnet_t <= 0:
            continue
        cx = player.body.x + PW * 0.5
        cy = player.body.y + PH * 0.5
        for coin in coins:
            if not coin.alive:
                continue
            dx = cx - coin.x
            dy = cy - coin.y
            dist = math.hypot(dx, dy)
            if 1.0 < dist <= MAGNET_R:
                coin.x += dx / dist * MAGNET_PULL
                coin.y += dy / dist * MAGNET_PULL
                _note(stats, "magnet_pulls")


def _near(player, x, y, rx, ry):
    return abs((player.body.x + PW * 0.5) - x) <= rx and abs((player.body.y + PH * 0.45) - y) <= ry


def collect(player, coins, powers, players, stats=None):
    if player.state == "out":
        return []
    events = []
    for coin in coins:
        if coin.alive and _near(player, coin.x, coin.y, 12, 18):
            coin.alive = False
            player.coins += 1
            player.total_coins += 1
            _note(stats, "coins")
            events.append("coin")
    if player.state != "run":
        return events
    for pickup in powers:
        if not pickup.alive or not _near(player, pickup.x, pickup.y, 14, 18):
            continue
        if pickup.shared:
            if player.idx in pickup.got:
                continue
            pickup.got.add(player.idx)
            pickup.linger = 80
            give_power(player, pickup.kind, players, stats)
            events.append(pickup.kind)
            continue
        pickup.alive = False
        give_power(player, pickup.kind, players, stats)
        events.append(pickup.kind)
    return events


def tick_pickups(powers, runners):
    alive_ids = {p.idx for p in runners}
    for pickup in powers:
        if not pickup.alive:
            continue
        pickup.t += 1
        if pickup.shared and pickup.got:
            pickup.linger -= 1
            if pickup.linger <= 0 or alive_ids and alive_ids <= pickup.got:
                pickup.alive = False


def award(players):
    running = [p for p in players if p.state == "run"]
    ghosts = [p for p in players if p.state == "ghost"]
    pool = running or ghosts or list(players)
    best_x = max(p.max_x for p in pool)
    top = [p for p in pool if p.max_x >= best_x - 12]
    best_c = max(p.coins for p in top)
    winners = [p for p in top if p.coins == best_c]
    for player in players:
        won = player in winners
        player.round_meters = int(player.max_x) // 16
        player.round_pts = player.coins * COIN_PTS + int(player.max_x) // DIST_DIV + (WIN_PTS if won else 0)
        player.bank += player.round_pts
        if won:
            player.wins += 1
    return winners


def spawn_feet(player, x):
    player.body.x = float(x)
    player.body.y = EY - PH
    player.body.vx = 0.0
    player.body.vy = 0.0
    player.body.on_ground = True
    player.max_x = player.body.x

# ---- audio.py ----
# Short synthesized blips. Music is built once, never inside the frame.
import array
import math
import os

import pygame

_SFX = {}
_READY = False


def _tone(freq, dur, vol=0.25, wave="sq", slide=0.0):
    rate = 22050
    n = max(1, int(rate * dur))
    buf = array.array("h")
    ph = 0.0
    for i in range(n):
        t = i / n
        f = freq * (1.0 + slide * t)
        ph += f / rate
        if wave == "sq":
            v = 1.0 if (ph % 1.0) < 0.5 else -1.0
        elif wave == "tri":
            v = 4.0 * abs((ph % 1.0) - 0.5) - 1.0
        else:
            v = math.sin(ph * 6.283185)
        env = 1.0 - t
        sample = int(max(-1.0, min(1.0, v * vol * env)) * 32767)
        buf.append(sample)
        buf.append(sample)
    return buf


def _mix(into, buf, at):
    end = min(len(into), at + len(buf))
    for i in range(at, end):
        into[i] = max(-32767, min(32767, into[i] + buf[i - at]))


def prepare_audio():
    if os.environ.get("KULTAKIRI_NO_SFX"):
        return
    try:
        pygame.mixer.pre_init(22050, -16, 2, 512)
    except Exception:
        pass


def start_audio():
    global _READY
    if os.environ.get("KULTAKIRI_NO_SFX"):
        return
    try:
        if pygame.mixer.get_init() is None:
            pygame.mixer.init(22050, -16, 2, 512)
        _SFX["jump"] = pygame.mixer.Sound(buffer=_tone(520, 0.09, 0.18, "sq", 0.6).tobytes())
        _SFX["coin"] = pygame.mixer.Sound(buffer=_tone(880, 0.08, 0.2, "sq", 0.4).tobytes())
        _SFX["power"] = pygame.mixer.Sound(buffer=_tone(660, 0.16, 0.2, "tri", 0.5).tobytes())
        _SFX["hit"] = pygame.mixer.Sound(buffer=_tone(180, 0.12, 0.22, "sq", -0.4).tobytes())
        _SFX["ghost"] = pygame.mixer.Sound(buffer=_tone(360, 0.22, 0.16, "sine", 0.8).tobytes())
        _SFX["revive"] = pygame.mixer.Sound(buffer=_tone(480, 0.14, 0.2, "tri", 0.7).tobytes())
        _SFX["out"] = pygame.mixer.Sound(buffer=_tone(140, 0.2, 0.2, "sine", -0.5).tobytes())
        _SFX["go"] = pygame.mixer.Sound(buffer=_tone(440, 0.12, 0.2, "sq", 0.2).tobytes())
        _SFX["win"] = pygame.mixer.Sound(buffer=_tone(523, 0.28, 0.2, "tri", 0.15).tobytes())
        if not os.environ.get("KULTAKIRI_NO_MUSIC"):
            pygame.mixer.Sound(buffer=_music().tobytes()).play(loops=-1)
        _READY = True
    except Exception:
        _READY = False


def _music():
    rate = 22050
    seconds = 4
    n = rate * seconds
    buf = array.array("h", [0]) * (n * 2)
    scale = (60, 62, 64, 67, 69, 72, 74, 76)
    step = int(rate * 0.28)

    def midi(m):
        return 440.0 * (2.0 ** ((m - 69) / 12.0))

    for i, m in enumerate((60, 64, 67, 64, 69, 67, 64, 62) * 2):
        tone = _tone(midi(m), 0.26, 0.06, "tri", 0.0)
        _mix(buf, tone, i * step * 2)
    bass_step = step * 2
    for i, m in enumerate((48, 48, 43, 48) * 4):
        tone = _tone(midi(m), 0.34, 0.05, "sine", 0.0)
        _mix(buf, tone, i * bass_step * 2)
    return buf


def sfx(name):
    if not _READY or os.environ.get("KULTAKIRI_AUTOPLAY"):
        return
    sound = _SFX.get(name)
    if sound is not None:
        try:
            sound.play()
        except Exception:
            pass

# ---- draw.py ----
# Chunky dawn meadow. One cached sky, everything else is a handful of rects.
import math

import pygame


SKY_TOP = (255, 168, 132)
SKY_BOT = (255, 226, 206)
HILL_FAR = (176, 196, 168)
HILL = (104, 168, 112)
RAVINE = (48, 78, 90)
GRASS = (168, 210, 92)
GRASS_DK = (72, 150, 68)
DIRT = (168, 118, 70)
DIRT_DK = (116, 74, 46)
SAND = (228, 190, 112)
CLOUD = (255, 248, 242)


def make_sky():
    surf = pygame.Surface((W, H))
    for y in range(H):
        k = y / (H - 1)
        col = tuple(int(SKY_TOP[i] + (SKY_BOT[i] - SKY_TOP[i]) * k) for i in range(3))
        pygame.draw.line(surf, col, (0, y), (W, y))
    return surf


def _plat_kind(top):
    if top < EY - 6:
        return "high"
    if top > EY + 6:
        return "low"
    return "ground"


def draw_world(g):
    c = g.canvas
    cam = g.camera
    c.blit(g.sky, (0, 0))
    # far hills, then a ravine the ground covers
    for i in range(-1, 22):
        wx = i * 16 + cam * 0.25
        h = 16 + int(7 * math.sin(wx * 0.04))
        x = int(i * 16 - (cam * 0.25) % 16)
        pygame.draw.rect(c, HILL_FAR, (x, EY - 36 - h, 16, h + 8))
    pygame.draw.rect(c, RAVINE, (0, EY + 6, W, H - EY))
    for i in range(-1, 22):
        wx = i * 18 + cam * 0.45
        h = 10 + int(5 * math.sin(wx * 0.07 + 1.2))
        x = int(i * 18 - (cam * 0.45) % 18)
        pygame.draw.rect(c, HILL, (x, EY - 16 - h, 18, h))
    _clouds(c, cam, g.t)
    if g.world is not None:
        _chunks(c, g.world, cam, g.t)
        _coins(c, g.world.coins, cam, g.t)
        _pickups(c, g.world.powers, cam, g.t)
    _bits(c, g.bits, cam)
    for pl in g.players:
        if pl.state == "out":
            continue
        draw_player(c, pl, cam, g.t)
    if g.camera > 8:
        # left-edge warning when someone is about to be left behind
        for pl in g.players:
            if pl.state == "run" and pl.body.x - cam < 28:
                pygame.draw.rect(c, (210, 70, 60), (0, 16, 3, H - 16))
                break
    _hud(g)


def _clouds(c, cam, t):
    specs = ((30, 28, 0.12), (110, 18, 0.18), (200, 36, 0.1), (270, 22, 0.16))
    for i, (bx, by, spd) in enumerate(specs):
        x = int((bx - cam * spd + t * 0.05) % (W + 50) - 24)
        pygame.draw.rect(c, (255, 214, 196), (x + 2, by + 3, 22, 6))
        pygame.draw.rect(c, CLOUD, (x, by, 18, 7))
        pygame.draw.rect(c, CLOUD, (x + 8, by - 4, 14, 6))


def _chunks(c, world, cam, t):
    for origin, chunk in world.placed:
        if origin + chunk.w < cam - 8 or origin > cam + W + 8:
            continue
        for px, top, pw in chunk.plats:
            _platform(c, origin + px - cam, top, pw)
        for hx, hy, hw, hh in chunk.hazards:
            _thorn(c, origin + hx - cam, hy, hw, hh, t)
        for hx, hy, hw, hh in chunk.ceilings:
            _ceiling(c, origin + hx - cam, hy, hw, hh)
        if chunk.name == "maali":
            _banner(c, origin + 56 - cam, g_font=None, font=None, t=t, canvas_font=c)
    for tile in world.crumbles:
        if tile.x + tile.w < cam - 8 or tile.x > cam + W + 8:
            continue
        _crumble(c, tile.x - cam, tile.top, tile.w, tile)
    for slab in world.movers:
        x, top, w = slab.at(world.frame)
        if x + w < cam - 8 or x > cam + W + 8:
            continue
        _mover(c, x - cam, top, w)


def _platform(c, x, top, w):
    x, top, w = int(x), int(top), int(w)
    if x > W or x + w < 0:
        return
    kind = _plat_kind(top)
    if kind == "ground":
        h = H - top + 2
        body, edge = DIRT, DIRT_DK
        cap = GRASS
    elif kind == "high":
        h = 12
        body, edge = (214, 168, 96), (150, 110, 54)
        cap = SAND
    else:
        h = 12
        body, edge = (150, 108, 70), (96, 64, 40)
        cap = (196, 150, 86)
    pygame.draw.rect(c, body, (x, top, w, h))
    cap_h = 7 if kind == "ground" else 4
    pygame.draw.rect(c, cap, (x, top, w, cap_h))
    pygame.draw.rect(c, (210, 230, 120) if kind == "ground" else (255, 236, 190), (x, top, w, 2))
    pygame.draw.line(c, edge, (x, top + h - 1), (x + w - 1, top + h - 1))
    for dx in range(3, w - 2, 7):
        _dot(c, x + dx, top + 6, edge)


def _ceiling(c, x, y, w, h):
    x, y, w, h = int(x), int(y), int(w), int(h)
    if x > W or x + w < 0:
        return
    pygame.draw.rect(c, (70, 48, 58), (x, y, w, 4))
    n = max(2, w // 6)
    for i in range(n):
        bx = x + int(i * w / n)
        pygame.draw.polygon(c, (210, 70, 78), [(bx + 1, y + 3), (bx + 4, y + h), (bx + 7, y + 3)])


def _crumble(c, x, top, w, tile):
    x, top, w = int(x), int(top), int(w)
    if not tile.live:
        return
    shake = (tile.timer // 3) % 2 if tile.armed else 0
    x += shake
    pygame.draw.rect(c, (150, 96, 58), (x, top, w, 10))
    pygame.draw.rect(c, (196, 150, 86), (x, top, w, 3))
    col = (80, 40, 28) if tile.armed else (90, 60, 40)
    for dx in range(4, max(5, w - 4), 8):
        pygame.draw.line(c, col, (x + dx, top + 3), (x + dx + 2, top + 9))


def _mover(c, x, top, w):
    x, top, w = int(x), int(top), int(w)
    pygame.draw.rect(c, (70, 90, 110), (x, top + 8, w, 3))
    pygame.draw.rect(c, (150, 186, 206), (x, top, w, 8))
    pygame.draw.rect(c, (230, 244, 250), (x, top, w, 2))
    pygame.draw.rect(c, (40, 60, 80), (x, top, w, 8), 1)


def _thorn(c, x, y, w, h, t):
    x, y, w, h = int(x), int(y), int(w), int(h)
    pygame.draw.rect(c, (92, 48, 64), (x, y + h - 3, w, 4))
    n = max(2, w // 5)
    for i in range(n):
        bx = x + int(i * w / n)
        pygame.draw.polygon(c, (70, 120, 64), [(bx, y + h), (bx + 3, y + 1), (bx + 6, y + h)])
        tip = (220, 60, 70) if (i + t // 8) % 2 == 0 else (255, 120, 90)
        pygame.draw.line(c, tip, (bx + 3, y + 1), (bx + 3, y + 4))


def _dot(c, x, y, col):
    if 0 <= x < W and 0 <= y < H:
        c.set_at((int(x), int(y)), col)


def _banner(c, x, g_font, font, t, canvas_font):
    x = int(x)
    pole_y = EY - 46
    if x < -40 or x > W + 10:
        return
    pygame.draw.rect(c, (96, 64, 40), (x, pole_y, 3, 46))
    pygame.draw.polygon(c, (240, 96, 84), [(x + 3, pole_y), (x + 28, pole_y + 7), (x + 3, pole_y + 14)])
    pygame.draw.polygon(c, (255, 210, 120), [(x + 3, pole_y), (x + 16, pole_y + 5), (x + 3, pole_y + 8)])
    blit(c, _font(c), tr("finish"), x + 6, pole_y + 3, (255, 248, 230), 1, shadow=False)


def _coins(c, coins, cam, t):
    for coin in coins:
        if not coin.alive:
            continue
        sx = int(coin.x - cam)
        if sx < -8 or sx > W + 8:
            continue
        bob = int(math.sin(t * 0.18 + coin.x * 0.1) * 1.5)
        sy = int(coin.y + bob)
        span = 2 + int(abs(math.sin(t * 0.25 + coin.x)) * 3)
        pygame.draw.rect(c, (120, 72, 20), (sx - span, sy - 3, span * 2, 8))
        pygame.draw.rect(c, (255, 210, 64), (sx - span + 1, sy - 2, max(1, span * 2 - 2), 6))
        _dot(c, sx, sy, (255, 250, 210))


def _pickups(c, powers, cam, t):
    for pw in powers:
        if not pw.alive:
            continue
        sx = int(pw.x - cam)
        if sx < -16 or sx > W + 16:
            continue
        bob = int(math.sin(t * 0.16 + pw.t * 0.2) * 2)
        draw_power_icon(c, pw.kind, sx, int(pw.y + bob), pulse=(t // 6) % 2 == 0)


def draw_power_icon(c, kind, x, y, pulse=False, small=False):
    col = POWER_COLORS[kind]
    s = 6 if small else 8
    pygame.draw.rect(c, (255, 255, 255), (x - s - 1, y - s - 1, s * 2 + 2, s * 2 + 2))
    pygame.draw.rect(c, col, (x - s, y - s, s * 2, s * 2))
    if pulse and not small:
        pygame.draw.rect(c, (255, 244, 180), (x - s - 2, y - s - 2, s * 2 + 4, s * 2 + 4), 1)
    ink = (255, 255, 255)
    if kind == "double":
        pygame.draw.polygon(c, ink, [(x - 3, y + 1), (x, y - 4), (x + 1, y + 1)])
        pygame.draw.polygon(c, ink, [(x + 1, y + 3), (x + 4, y - 2), (x + 5, y + 3)])
    elif kind == "speed":
        pygame.draw.polygon(c, (255, 236, 120), [(x - 2, y - 5), (x + 2, y - 5), (x - 1, y), (x + 3, y), (x - 3, y + 6), (x, y + 1), (x - 4, y + 1)])
    elif kind == "shield":
        pygame.draw.circle(c, ink, (x, y), s - 3, 1)
        pygame.draw.circle(c, (230, 255, 255), (x, y), 2)
    elif kind == "magnet":
        pygame.draw.rect(c, ink, (x - 4, y - 3, 2, 6))
        pygame.draw.rect(c, ink, (x + 2, y - 3, 2, 6))
        pygame.draw.rect(c, ink, (x - 4, y + 1, 8, 2))
    elif kind == "slow":
        pygame.draw.circle(c, ink, (x - 2, y + 1), 3, 1)
        pygame.draw.circle(c, ink, (x + 3, y - 1), 2, 1)
    elif kind == "glide":
        pygame.draw.polygon(c, ink, [(x - 6, y + 1), (x, y - 4), (x + 6, y + 1), (x, y + 2)])
    if small:
        return
    # kind letter is the shape; the ring keeps it readable at a glance


def _bits(c, bits, cam):
    for x, y, vx, vy, life, col in bits:
        sx = int(x - cam)
        if 0 <= sx < W:
            size = 2 if life > 8 else 1
            pygame.draw.rect(c, col, (sx, int(y), size, size))


def draw_player(c, pl, cam, t):
    b = pl.body
    x = int(b.x - cam)
    y = int(b.y)
    ghost = pl.state == "ghost"
    col, dark = PCOLORS[pl.idx]
    if ghost:
        col = tuple((v + 255) // 2 for v in col)
    if pl.slow_t > 0 and not ghost:
        pygame.draw.ellipse(c, POWER_COLORS["slow"], (x - 6, y - 4, PW + 12, PH + 10), 2)
    # shadow
    pygame.draw.ellipse(c, (40, 30, 40), (x + 1, int(b.feet() - cam * 0 + 1) if False else y + PH - 1, PW, 3))
    if pl.glide_t > 0 and not ghost:
        cape = (x - 6, y + 4, 6, 8) if pl.face > 0 else (x + PW, y + 4, 6, 8)
        pygame.draw.rect(c, POWER_COLORS["glide"], cape)
    squash = pl.squash
    bh = max(8, int(PH - 4 - squash * 6))
    bw = PW + int(squash * 6)
    bx = x + (PW - bw) // 2
    by = y + PH - 4 - bh
    pygame.draw.rect(c, dark, (bx - 1, by - 1, bw + 2, bh + 2))
    pygame.draw.rect(c, col, (bx, by, bw, bh))
    pygame.draw.rect(c, tuple(min(255, v + 50) for v in col), (bx + 1, by + 1, max(1, bw - 3), 2))
    # feet
    step = int(pl.anim / 5) % 2 if pl.state == "run" and abs(b.vx) > 0.3 else 0
    pygame.draw.rect(c, dark, (bx + 1 + step, by + bh, 3, 3))
    pygame.draw.rect(c, dark, (bx + bw - 5 - step, by + bh, 3, 3))
    # face
    ex = bx + bw // 2 + pl.face * 2
    pygame.draw.rect(c, (255, 255, 255), (ex - 3, by + 3, 2, 3))
    pygame.draw.rect(c, (255, 255, 255), (ex + 1, by + 3, 2, 3))
    pygame.draw.rect(c, (20, 16, 24), (ex - 2 + (pl.face > 0), by + 4, 1, 2))
    pygame.draw.rect(c, (20, 16, 24), (ex + 2 + (pl.face > 0), by + 4, 1, 2))
    pygame.draw.rect(c, (90, 40, 40), (ex - 1, by + bh - 4, 3, 1))
    _hat(c, pl.idx, bx, by, bw, col)
    if pl.double_t > 0 and not ghost:
        pygame.draw.polygon(c, (210, 235, 255), [(bx - 4, by + 4), (bx - 1, by + 1), (bx - 1, by + 7)])
        pygame.draw.polygon(c, (210, 235, 255), [(bx + bw + 3, by + 4), (bx + bw, by + 1), (bx + bw, by + 7)])
    if pl.speed_t > 0 and not ghost and t % 2 == 0:
        for i in range(3):
            pygame.draw.rect(c, POWER_COLORS["speed"], (bx - 5 - i * 3, by + 3 + i * 3, 3, 1))
    if pl.shield and not ghost:
        pygame.draw.circle(c, POWER_COLORS["shield"], (x + PW // 2, y + PH // 2), 12, 1)
    if pl.magnet_t > 0 and not ghost:
        ang = t * 0.3 + pl.idx
        for k in range(3):
            a = ang + k * 2.1
            _dot(c, int(x + PW / 2 + math.cos(a) * 10), int(y + 4 + math.sin(a) * 6), (255, 220, 80))
    if ghost:
        pygame.draw.circle(c, (255, 255, 255), (x + PW // 2, y - 4), 6, 1)
    # Power names stay on the icons. Only short status words float over a player,
    # otherwise four runners grabbing the same row of pickups paint on top of each other.
    if pl.popup and pl.popup[0] in (tr("ghost"), tr("out"), tr("pad")):
        label, _life = pl.popup
        blit(c, _font(c), label, x + PW // 2, y - 14, (255, 244, 210), 1, center=True)
    if pl.lost_t > 0 and (t // 10) % 2 == 0:
        blit(c, _font(c), tr("pad"), x + PW // 2, y - 22, (255, 180, 160), 1, center=True)


def _hat(c, idx, bx, by, bw, col):
    if idx == 0:
        pygame.draw.rect(c, (40, 120, 48), (bx + bw // 2 - 1, by - 4, 2, 4))
        pygame.draw.rect(c, (70, 160, 60), (bx + bw // 2 - 2, by - 6, 4, 2))
    elif idx == 1:
        pygame.draw.rect(c, (20, 40, 90), (bx + 1, by - 3, bw - 2, 3))
        pygame.draw.rect(c, (20, 40, 90), (bx, by - 1, bw, 2))
    elif idx == 2:
        pygame.draw.polygon(c, (40, 150, 60), [(bx + bw // 2, by - 6), (bx + bw // 2 + 6, by - 1), (bx + bw // 2, by - 1)])
    else:
        pygame.draw.rect(c, (230, 80, 90), (bx + bw // 2 - 2, by - 4, 4, 3))
        pygame.draw.rect(c, (255, 220, 80), (bx + bw // 2 - 1, by - 3, 2, 2))


_FONT = None


def _font(c):
    global _FONT
    if _FONT is None:
        _FONT = Font()
    return _FONT


def bind_font(font):
    global _FONT
    _FONT = font


def _hud(g):
    c = g.canvas
    bar = pygame.Surface((W, 15), pygame.SRCALPHA)
    bar.fill((28, 18, 32, 170))
    c.blit(bar, (0, 0))
    font = _font(c)
    blit(c, font, tr("round", g.round_no, 3) if g.round_no else "", 3, 3, (255, 236, 210), 1, shadow=False)
    meters = "%d%s" % (int(g.camera) // 16, tr("meters"))
    mw, _ = font.size(meters, 1)
    blit(c, font, meters, W - mw - 3, 3, (255, 236, 210), 1, shadow=False)
    n = max(1, len(g.players))
    slot = min(70, (W - 78) // n)
    for i, pl in enumerate(g.players):
        x = 52 + i * slot
        col = PCOLORS[pl.idx][0] if pl.state != "out" else (90, 80, 80)
        pygame.draw.rect(c, col, (x, 3, 7, 7))
        label = tr("out") if pl.state == "out" else str(pl.coins)
        blit(c, font, label, x + 9, 3, (255, 248, 230), 1, shadow=False)
        kind = pl.main_power()
        if kind and pl.state == "run":
            draw_power_icon(c, kind, x + 28, 7, small=True)


def draw_lobby(g):
    c = g.canvas
    c.blit(g.sky, (0, 0))
    _clouds(c, 0, g.t)
    pygame.draw.rect(c, HILL, (0, 120, W, 60))
    pygame.draw.rect(c, GRASS, (0, 116, W, 6))
    font = _font(c)
    bob = int(math.sin(g.t * 0.08) * 2)
    blit(c, font, tr("title"), W // 2, 16 + bob, (120, 50, 40), 2, center=True)
    ver = "V" + g.version
    vw, _ = font.size(ver, 1)
    blit(c, font, ver, W - vw - 4, 3, (150, 90, 70), 1, shadow=False)
    blit(c, font, tr("tag"), W // 2, 40, (110, 60, 50), 1, center=True)
    for i in range(4):
        x = 8 + i * 78
        box = pygame.Rect(x, 52, 74, 78)
        pygame.draw.rect(c, (255, 244, 230), box)
        pygame.draw.rect(c, PCOLORS[i][1], box, 2)
        if i < len(g.players):
            pl = g.players[i]
            pl.body.x = x + 30
            pl.body.y = 78 + int(abs(math.sin(g.t * 0.12 + i)) * -4)
            pl.face = 1
            pl.anim = g.t * 0.4
            draw_player(c, pl, 0, g.t)
            blit(c, font, pname(i), x + 37, 116, PCOLORS[i][0], 1, center=True)
        else:
            if (g.t // 25) % 2 == 0:
                blit(c, font, tr("press"), x + 37, 78, (140, 100, 90), 1, center=True)
            blit(c, font, tr("join"), x + 37, 92, (120, 90, 80), 1, center=True)
    hint = tr("start_hint") + "   " + tr("legend_btn") if len(g.players) >= 2 else tr("need")
    blit(c, font, hint, W // 2, 146, (90, 50, 40), 1, center=True)
    blit(c, font, tr("leave_hint") + "   " + tr("quit_hint"), W // 2, 162, (120, 80, 70), 1, center=True)


def draw_legend(g):
    draw_lobby(g) if g.legend_from == "lobby" else draw_world(g)
    _panel_legend(g)


def _panel_legend(g):
    c = g.canvas
    veil = pygame.Surface((W, H), pygame.SRCALPHA)
    veil.fill((24, 14, 20, 180))
    c.blit(veil, (0, 0))
    font = _font(c)
    blit(c, font, tr("legend"), W // 2, 8, (255, 220, 140), 1, center=True)
    kinds = ("double", "speed", "shield", "magnet", "slow", "glide")
    for i, kind in enumerate(kinds):
        y = 24 + i * 22
        draw_power_icon(c, kind, 18, y + 6, pulse=True)
        blit(c, font, tr("p_" + kind), 32, y, POWER_COLORS[kind], 1)
        blit(c, font, tr("d_" + kind), 118, y, (255, 244, 230), 1)
    blit(c, font, tr("controls"), W // 2, 160, (255, 220, 180), 1, center=True)
    blit(c, font, tr("back"), W // 2, 170, (255, 244, 220), 1, center=True)


def draw_count(g):
    font = _font(g.canvas)
    if g.t < 36:
        label, col = "3", (255, 120, 90)
    elif g.t < 72:
        label, col = "2", (255, 170, 80)
    elif g.t < 108:
        label, col = "1", (255, 210, 90)
    else:
        label, col = tr("go"), (255, 244, 160)
    blit(g.canvas, font, label, W // 2, 78, col, 3, center=True)


def draw_round_end(g):
    c = g.canvas
    veil = pygame.Surface((W, H), pygame.SRCALPHA)
    veil.fill((20, 12, 18, 150))
    c.blit(veil, (0, 0))
    font = _font(c)
    panel = pygame.Rect(16, 18, W - 32, H - 36)
    pygame.draw.rect(c, (255, 244, 230), panel)
    pygame.draw.rect(c, (120, 60, 48), panel, 2)
    winners = g.round_winners or []
    if len(winners) == 1:
        title = tr("win", pname(winners[0].idx))
        col = PCOLORS[winners[0].idx][0]
    else:
        title, col = tr("draw"), (120, 60, 48)
    blit(c, font, title, W // 2, 26, col, 1, center=True)
    blit(c, font, tr("board"), W // 2, 40, (120, 70, 50), 1, center=True)
    order = sorted(g.players, key=lambda p: -p.bank)
    for i, pl in enumerate(order):
        y = 54 + i * 22
        pygame.draw.rect(c, PCOLORS[pl.idx][0], (24, y, 8, 8))
        blit(c, font, pname(pl.idx), 36, y - 1, (80, 40, 36), 1)
        line = "%s %d  %s %d  %s %d" % (tr("coins"), pl.coins, tr("meters"), pl.round_meters, tr("total"), pl.bank)
        blit(c, font, line, 36, y + 8, (110, 70, 55), 1)
    if g.t > 20 and (g.t // 20) % 2 == 0:
        blit(c, font, tr("next"), W // 2, 156, (160, 70, 50), 1, center=True)


def draw_results(g):
    c = g.canvas
    c.blit(g.sky, (0, 0))
    pygame.draw.rect(c, HILL, (0, 156, W, 24))
    pygame.draw.rect(c, GRASS, (0, 152, W, 5))
    font = _font(c)
    blit(c, font, tr("results"), W // 2, 6, (120, 50, 40), 1, center=True)
    if g.players:
        champ = max(g.players, key=lambda p: (p.bank, p.wins, p.total_coins, -p.idx))
        blit(c, font, tr("champ", pname(champ.idx)), W // 2, 18, PCOLORS[champ.idx][0], 1, center=True)
        champ.body.x = W // 2 - PW // 2
        champ.body.y = 30
        champ.face = 1
        champ.state = "run"
        champ.squash = 0
        draw_player(c, champ, 0, g.t)
    order = sorted(g.players, key=lambda p: (-p.bank, -p.wins))
    panel = pygame.Rect(16, 64, W - 32, 72)
    pygame.draw.rect(c, (255, 246, 232), panel)
    pygame.draw.rect(c, (140, 80, 60), panel, 2)
    for i, pl in enumerate(order):
        y = 70 + i * 16
        pygame.draw.rect(c, PCOLORS[pl.idx][0], (28, y, 8, 8))
        blit(c, font, pname(pl.idx), 42, y, (70, 36, 32), 1, shadow=False)
        blit(c, font, str(pl.bank), 168, y, (90, 50, 40), 1, shadow=False)
        for k in range(pl.wins):
            pygame.draw.rect(c, (220, 160, 40), (230 + k * 8, y, 6, 6))
    blit(c, font, tr("rematch") + "   " + tr("back_lobby"), W // 2, 166, (255, 248, 236), 1, center=True)


def draw_pause(g):
    c = g.canvas
    veil = pygame.Surface((W, H), pygame.SRCALPHA)
    veil.fill((20, 12, 18, 150))
    c.blit(veil, (0, 0))
    font = _font(c)
    blit(c, font, tr("paused"), W // 2, 48, (255, 220, 150), 2, center=True)
    opts = (tr("resume"), tr("to_lobby"), tr("quit"))
    for i, label in enumerate(opts):
        y = 84 + i * 20
        if i == g.menu_i:
            pygame.draw.rect(c, (255, 210, 140), (70, y - 3, 180, 16))
        blit(c, font, label, W // 2, y, (90, 40, 36), 1, center=True)


def draw_quit(g):
    if g.quit_hold < 6:
        return
    c = g.canvas
    bw = 120
    x = W // 2 - bw // 2
    pygame.draw.rect(c, (40, 20, 24), (x, 4, bw, 10))
    pygame.draw.rect(c, (255, 244, 230), (x, 4, int(bw * min(1, g.quit_hold / 60)), 10))
    blit(c, _font(c), tr("quitting"), W // 2, 5, (80, 30, 30), 1, center=True)


def draw_frame(g):
    if g.font is not None:
        bind_font(g.font)
    st = g.state
    if st == "lobby":
        draw_lobby(g)
    elif st == "legend":
        draw_legend(g)
    elif st == "results":
        draw_results(g)
    else:
        draw_world(g)
        if st == "ready":
            draw_count(g)
        elif st == "play" and g.go_flash:
            blit(g.canvas, _font(g.canvas), tr("go"), W // 2, 78, (255, 244, 160), 3, center=True)
        elif st == "roundend":
            draw_round_end(g)
        elif st == "paused":
            draw_pause(g)
    draw_quit(g)

# ---- game.py ----
# Couch loop: join, run, scoreboard, again.
# A fall or a scroll-off spends the one rescue. You come back as a ghost for a few
# seconds, still able to pick up coins, and you rejoin if you settle on a ledge.
# The second miss is out for the round. That is kinder than watching the rest of
# an autoscroller from the couch, and one rescue keeps "last one running" real.
import random

import pygame



class Game:
    def __init__(self, screen):
        self.screen = screen
        self.canvas = pygame.Surface((W, 180))
        self.font = Font()
        self.sky = make_sky()
        self.version = load_version()
        self.pads = {}
        kb = Pad("kb")
        self.pads[kb.id] = kb
        self.players = []
        self.world = None
        self.state = "lobby"
        self.legend_from = "lobby"
        self.t = 0
        self.camera = 0.0
        self.scroll = SCROLL0
        self.round_no = 0
        self.round_winners = []
        self.ending = 0
        self.go_flash = 0
        self.menu_i = 0
        self.quit_hold = 0
        self.running = True
        self.autoplay = False
        self.seed = 1
        self.rng = random.Random(1)
        self.bits = []
        self.stats = {
            "frames": 0, "chunk_fail": 0, "chunk_types": 0, "validated": 0,
            "double_air": 0, "speed_fast": 0, "shield_on": 0, "shield_block": 0,
            "magnet_pulls": 0, "slow_on": 0, "glide_frames": 0, "ghosts": 0,
            "outs": 0, "revives": 0, "bumps": 0, "rounds_ended": 0, "coins": 0,
            "got_powers": [],
        }

    def public_stats(self):
        got = list(self.stats.get("got_powers", []))
        out = {k: v for k, v in self.stats.items() if k != "got_powers"}
        out["got_powers"] = got
        out["power_types"] = len(got)
        return out

    def arm_autoplay(self, seed):
        self.autoplay = True
        self.seed = seed
        self.rng = random.Random(seed + 3)
        for i, skill in enumerate((0.97, 0.9, 0.55, 0.84)):
            pad = ScriptPad("bot%d" % i)
            pad.skill = skill
            pad.auto = True
            pad.join_frame = 6 + i * 4
            self.pads[pad.id] = pad

    def goto(self, name):
        self.state = name
        self.t = 0

    def add_player(self, pad):
        if len(self.players) >= 4 or any(p.pad is pad for p in self.players):
            return None
        player = Player(len(self.players), pad)
        player.pilot = Pilot(getattr(pad, "skill", 1.0), random.Random(self.seed + 40 + len(self.players)))
        self.players.append(player)
        return player

    def reindex(self):
        for i, player in enumerate(self.players):
            player.idx = i

    def owner(self, pad):
        for player in self.players:
            if player.pad is pad:
                return player
        return None

    # ----- devices -----
    def handle_device(self, ev):
        if ev.type == pygame.JOYDEVICEADDED:
            try:
                joy = pygame.joystick.Joystick(ev.device_index)
            except Exception:
                return
            iid = joy.get_instance_id()
            pad = None
            try:
                from pygame._sdl2 import controller
                if not controller.get_init():
                    try:
                        controller.init()
                    except Exception:
                        pass
                if controller.is_controller(ev.device_index):
                    try:
                        con = controller.Controller.from_joystick(joy)
                    except Exception:
                        con = controller.Controller(ev.device_index)
                    pad = Pad("gc", con, iid=iid, joy=joy)
            except Exception:
                pad = None
            if pad is None:
                pad = Pad("js", joy, iid=iid, joy=joy)
            self.pads[pad.id] = pad
        elif ev.type == pygame.JOYDEVICEREMOVED:
            self.drop_pad("js%d" % ev.instance_id)

    def drop_pad(self, pid):
        pad = self.pads.pop(pid, None)
        if pad is None:
            return
        for player in self.players:
            if player.pad is pad:
                script = ScriptPad("auto-%d" % player.idx)
                script.auto = True
                script.skill = 0.92
                player.pad = script
                player.pilot = Pilot(0.92, random.Random(self.seed + 80 + player.idx))
                player.lost_t = 150
                self.pads[script.id] = script

    def grab_pads(self):
        if self.state not in ("play", "ready"):
            return
        for pad in list(self.pads.values()):
            if self.owner(pad) is not None or not pad.pressed("jump"):
                continue
            for player in self.players:
                if getattr(player.pad, "auto", False):
                    player.pad = pad
                    player.lost_t = 0
                    break

    # ----- frame -----
    def poll_events(self):
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                self.running = False
            elif ev.type in (pygame.JOYDEVICEADDED, pygame.JOYDEVICEREMOVED):
                self.handle_device(ev)
            elif ev.type == pygame.KEYDOWN and ev.key == pygame.K_ESCAPE:
                self.running = False

    def poll_pads(self):
        ks = pygame.key.get_pressed()
        pads = list(self.pads.values())
        for player in self.players:
            if player.pad not in pads:
                pads.append(player.pad)
        seen = set()
        quitting = False
        for pad in pads:
            if id(pad) in seen:
                continue
            seen.add(id(pad))
            pad.poll(ks)
            if pad.held("start") and pad.held("back"):
                quitting = True
        self.quit_hold = self.quit_hold + 1 if quitting else 0

    def drive(self):
        for player in self.players:
            self._drive_player(player)
        if self.state != "lobby":
            return
        for pad in self.pads.values():
            if not pad.script or self.owner(pad) is not None:
                continue
            des = blank()
            if self.t == getattr(pad, "join_frame", 8):
                des["jump"] = True
            pad.desired = des

    def _drive_player(self, player):
        pad = player.pad
        if not (pad.script and (self.autoplay or pad.auto)):
            return
        des = blank()
        if self.state == "lobby":
            if self.t == 30 and player.idx == 0:
                des["start"] = True
        elif self.state in ("ready", "play") and player.state == "ghost":
            solids = self._solids(player.body.x - 90, player.body.x + 160)
            ix, iy = ghost_steer(player.body, solids)
            des["x"], des["y"] = ix, iy
        elif self.state in ("ready", "play") and player.state == "run":
            solids = self._solids(player.body.x - 40, player.body.x + 130)
            hazards = self._hazards(player.body.x - 12, player.body.x + 90)
            _ix, held, pressed = player.pilot.decide(
                player.body, solids, hazards,
                glide=player.glide_t > 0, air_jumps=player.body.air_jumps,
            )
            des["x"] = 1.0
            des["jump"] = bool(held or pressed)
        elif self.state == "roundend" and self.t == 36 and player.idx == 0:
            des["jump"] = True
        elif self.state == "results" and self.t == 24 and player.idx == 0:
            des["jump"] = True
        pad.desired = des

    def _solids(self, x0, x1):
        if self.world is None:
            return []
        return self.world.solids_near(x0, x1)

    def _hazards(self, x0, x1):
        if self.world is None:
            return []
        return self.world.hazards_near(x0, x1)

    def burst(self, x, y, color, n=6):
        for _ in range(n):
            if len(self.bits) > 70:
                self.bits.pop(0)
            self.bits.append([
                x, y, random.uniform(-0.7, 0.7), random.uniform(-1.1, 0.15),
                random.randint(10, 18), color,
            ])

    def _fade_bits(self):
        kept = []
        for bit in self.bits:
            bit[0] += bit[2]
            bit[1] += bit[3]
            bit[3] += 0.05
            bit[4] -= 1
            if bit[4] > 0:
                kept.append(bit)
        self.bits = kept

    def update(self):
        self.poll_events()
        self.drive()
        self.poll_pads()
        self.t += 1
        self.stats["frames"] += 1
        self._fade_bits()
        if self.quit_hold >= 60:
            self.running = False
            return
        self.grab_pads()
        getattr(self, "up_" + self.state)()

    def up_lobby(self):
        for pad in list(self.pads.values()):
            if pad.pressed("alt"):
                self.legend_from = "lobby"
                self.goto("legend")
                return
            owned = self.owner(pad)
            if owned is not None and pad.pressed("back"):
                self.players.remove(owned)
                self.reindex()
                continue
            if owned is None and pad.pressed("jump"):
                self.add_player(pad)
        if len(self.players) >= 2 and any(
            self.owner(pad) is not None and pad.pressed("start") for pad in self.pads.values()
        ):
            self.begin_round()

    def up_legend(self):
        for pad in self.pads.values():
            if pad.pressed("jump") or pad.pressed("back") or pad.pressed("alt") or pad.pressed("start"):
                self.goto(self.legend_from)
                return

    def up_ready(self):
        # Countdown is a hard lock: no input, no scroll, nobody creeps forward.
        if self.t >= 108:
            sfx("go")
            self.go_flash = 28
            self.goto("play")
            self.up_play()

    def up_play(self):
        if self.go_flash:
            self.go_flash -= 1
        if self._wants_pause():
            self.menu_i = 0
            self.goto("paused")
            return
        if not self.ending:
            self.scroll = min(SCROLL_MAX, self.scroll + SCROLL_ACC)
            self.camera += self.scroll
            self.world.ensure(self.camera, self.scroll)
            self.world.advance()
            names = {chunk.name for _origin, chunk in self.world.placed}
            if len(names) > self.stats["chunk_types"]:
                self.stats["chunk_types"] = len(names)
        self._move(kill=not self.ending)
        if self.world is not None:
            self.world.arm_crumbles(self.players)
        if self.ending:
            self.ending -= 1
            if self.ending <= 0:
                self._finish_round()
        else:
            self._maybe_end()

    def up_paused(self):
        for player in self.players:
            pad = player.pad
            if pad.cur["y"] < -0.5 and pad.prev["y"] >= -0.5:
                self.menu_i = (self.menu_i - 1) % 3
            elif pad.cur["y"] > 0.5 and pad.prev["y"] >= -0.5 and pad.prev["y"] <= 0.5:
                self.menu_i = (self.menu_i + 1) % 3
            if pad.pressed("back"):
                self.goto("play")
                return
            if pad.pressed("jump") or pad.pressed("start"):
                self._pause_pick()
                return

    def up_roundend(self):
        if self.t > 20 and any(p.pad.pressed("jump") or p.pad.pressed("start") for p in self.players):
            if self.round_no >= ROUNDS:
                self.goto("results")
            else:
                self.begin_round()

    def up_results(self):
        if any(p.pad.pressed("back") for p in self.players):
            self._to_lobby()
            return
        if self.t > 12 and any(p.pad.pressed("jump") or p.pad.pressed("start") for p in self.players):
            self._rematch()

    def _wants_pause(self):
        if self.autoplay or self.ending:
            return False
        for player in self.players:
            pad = player.pad
            if pad.pressed("start") and not pad.held("back"):
                return True
        return False

    def _pause_pick(self):
        if self.menu_i == 0:
            self.goto("play")
        elif self.menu_i == 1:
            self._to_lobby()
        else:
            self.running = False

    def _to_lobby(self):
        for player in self.players:
            player.bank = 0
            player.wins = 0
            player.total_coins = 0
        self.round_no = 0
        self.world = None
        self.goto("lobby")

    def _rematch(self):
        for player in self.players:
            player.bank = 0
            player.wins = 0
            player.total_coins = 0
        self.round_no = 0
        self.begin_round()

    def begin_round(self):
        self.round_no += 1
        self.world = World(self.rng)
        self.stats["validated"] = chunk_count()
        self.stats["chunk_fail"] = 0
        self.camera = 0.0
        self.scroll = SCROLL0
        self.ending = 0
        self.go_flash = 0
        self.round_winners = []
        for i, player in enumerate(self.players):
            player.reset_round()
            player.body.x = 128 + i * 16
            player.body.y = EY - PH
            player.body.vx = 0.0
            player.body.on_ground = True
            player.max_x = player.body.x
        self.goto("ready")

    def _move(self, kill):
        for player in self.players:
            pad = player.pad
            ix = pad.cur["x"]
            iy = pad.cur["y"]
            if player.state == "run":
                solids = self._solids(player.body.x - 48, player.body.x + 110)
                hazards = self._hazards(player.body.x - 20, player.body.x + 40)
                did = tick_runner(player, ix, pad.held("jump"), pad.pressed("jump"), solids, self.stats)
                if did == "jump":
                    sfx("jump")
                hit = touch_hazard(player, hazards, self.stats)
                if hit == "hit":
                    sfx("hit")
                    self.burst(player.body.x + 6, player.body.y + 8, (210, 70, 60))
                elif hit == "block":
                    sfx("power")
                    self.burst(player.body.x + 6, player.body.y + 4, (120, 230, 220))
                clamp_runner(player, self.camera, self.scroll if self.state == "play" else 0.0)
                if kill:
                    why = fate(player, self.camera)
                    if why:
                        result = start_ghost(player, self.camera)
                        if result == "ghost":
                            self.stats["ghosts"] += 1
                            sfx("ghost")
                        else:
                            self.stats["outs"] += 1
                            sfx("out")
            elif player.state == "ghost":
                solids = self._solids(self.camera - 20, self.camera + W + 20)
                result = tick_ghost(player, ix, iy, solids, self.camera, self.scroll)
                if result == "revive":
                    self.stats["revives"] += 1
                    sfx("revive")
                elif result == "expire":
                    self.stats["outs"] += 1
                    sfx("out")
            if player.state in ("run", "ghost") and player.body.x > player.max_x:
                player.max_x = player.body.x
        separate_bumps(self.players, self.stats)
        if self.world is not None:
            pull_coins(self.players, self.world.coins, self.stats)
            runners = [p for p in self.players if p.state == "run"]
            for player in self.players:
                for event in collect(player, self.world.coins, self.world.powers, self.players, self.stats):
                    if event == "coin":
                        sfx("coin")
                        self.burst(player.body.x, player.body.y, (255, 210, 70), 4)
                    else:
                        sfx("power")
                        self.burst(player.body.x, player.body.y - 6, (255, 244, 210), 8)
            tick_pickups(self.world.powers, runners)
        for player in self.players:
            player.tick_timers()

    def _maybe_end(self):
        running = [p for p in self.players if p.state == "run"]
        ghosts = [p for p in self.players if p.state == "ghost"]
        finish = self.world.finish_x if self.world else None
        reached = finish is not None and (
            self.camera + W * 0.55 >= finish or any(p.body.x >= finish and p.state == "run" for p in self.players)
        )
        last = len(running) <= 1 and not ghosts
        none = not running and not ghosts
        if reached or last or none:
            self.ending = 28

    def _finish_round(self):
        self.round_winners = award(self.players)
        self.stats["rounds_ended"] += 1
        sfx("win")
        self.ending = 0
        self.goto("roundend")

    def draw(self):
        draw_frame(self)
        self.screen.blit(self.canvas, (0, 0))

# ---- main.py ----
# Batocera: copy the built Kultakiri<version>.pygame to /userdata/roms/pygame/
import json
import os

import pygame



def open_screen():
    windowed = bool(os.environ.get("KULTAKIRI_WINDOWED"))
    fast = bool(os.environ.get("KULTAKIRI_FRAMES") or os.environ.get("KULTAKIRI_AUTOPLAY"))
    dummy = os.environ.get("SDL_VIDEODRIVER") == "dummy"
    flags = 0 if dummy else pygame.SCALED
    if not windowed and not dummy:
        flags |= pygame.FULLSCREEN
    vsync = 0 if fast or dummy else 1
    try:
        return pygame.display.set_mode((W, H), flags, vsync=vsync)
    except TypeError:
        try:
            return pygame.display.set_mode((W, H), flags)
        except pygame.error:
            return pygame.display.set_mode((W, H))
    except pygame.error:
        return pygame.display.set_mode((W, H))


def main():
    os.environ.setdefault("SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS", "1")
    frames = int(os.environ.get("KULTAKIRI_FRAMES") or "0")
    fast = bool(frames or os.environ.get("KULTAKIRI_AUTOPLAY"))
    prepare_audio()
    pygame.init()
    start_audio()
    try:
        from pygame._sdl2 import controller
        controller.init()
    except Exception:
        pass
    screen = open_screen()
    pygame.display.set_caption("KULTAKIRI")
    pygame.mouse.set_visible(False)
    game = Game(screen)
    if os.environ.get("KULTAKIRI_AUTOPLAY"):
        game.arm_autoplay(int(os.environ.get("KULTAKIRI_SEED") or "1"))
    clock = pygame.time.Clock()
    n = 0
    while game.running:
        game.update()
        game.draw()
        pygame.display.flip()
        if not fast:
            clock.tick(FPS)
        n += 1
        if frames and n >= frames:
            break
    if game.autoplay:
        print("KULTAKIRI_STATS " + json.dumps(game.public_stats(), separators=(",", ":")))
    pygame.quit()


if __name__ == "__main__":
    main()
