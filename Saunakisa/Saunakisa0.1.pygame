# ---- input.py ----
# One pad, one player. SDL GameController first; raw hid-playstation if it is not mapped.
# Cross and Circle are the action (join, throw löyly), Triangle opens the legend,
# Options starts, Share goes back. The same layout for every player.
# Instance id, never a hard-coded joystick 0. "jump" is that action button.
import pygame


def blank():
    return {"x": 0.0, "y": 0.0, "jump": False, "start": False, "back": False, "alt": False}


class Pad:
    # Linux hid-playstation / DualShock: Cross, Circle, Square, Triangle, L1, R1, L2, R2, Share, Options.
    RAW_JUMP = 0
    RAW_CIRCLE = 1
    RAW_TRIANGLE = 3
    RAW_SHARE = 8
    RAW_OPTIONS = 9

    def __init__(self, kind, dev=None, iid=None, joy=None):
        self.kind = kind
        self.dev = dev
        self.joy = joy
        self.prev = blank()
        self.cur = blank()
        self.desired = blank()
        self.script = kind == "script"
        self.auto = False
        self.skill = 1.0
        if kind == "kb":
            self.id = "kb"
        elif iid is not None:
            self.id = "js%d" % int(iid)
        else:
            self.id = "pad%d" % id(self)

    def poll(self, ks):
        c = blank()
        try:
            if self.kind == "kb":
                right = ks[pygame.K_RIGHT] or ks[pygame.K_d]
                left = ks[pygame.K_LEFT] or ks[pygame.K_a]
                down = ks[pygame.K_DOWN] or ks[pygame.K_s]
                up = ks[pygame.K_UP] or ks[pygame.K_w]
                c["x"] = float(bool(right)) - float(bool(left))
                c["y"] = float(bool(down)) - float(bool(up))
                c["jump"] = bool(ks[pygame.K_x] or ks[pygame.K_z] or ks[pygame.K_SPACE])
                c["start"] = bool(ks[pygame.K_RETURN] or ks[pygame.K_KP_ENTER])
                c["back"] = bool(ks[pygame.K_BACKSPACE] or ks[pygame.K_TAB])
                c["alt"] = bool(ks[pygame.K_c])
            elif self.kind == "gc":
                g = self.dev
                ax = g.get_axis(pygame.CONTROLLER_AXIS_LEFTX) / 32768.0
                ay = g.get_axis(pygame.CONTROLLER_AXIS_LEFTY) / 32768.0
                if g.get_button(pygame.CONTROLLER_BUTTON_DPAD_LEFT):
                    ax = -1.0
                if g.get_button(pygame.CONTROLLER_BUTTON_DPAD_RIGHT):
                    ax = 1.0
                if g.get_button(pygame.CONTROLLER_BUTTON_DPAD_UP):
                    ay = -1.0
                if g.get_button(pygame.CONTROLLER_BUTTON_DPAD_DOWN):
                    ay = 1.0
                c["x"], c["y"] = ax, ay
                c["jump"] = bool(g.get_button(pygame.CONTROLLER_BUTTON_A) or g.get_button(pygame.CONTROLLER_BUTTON_B))
                c["start"] = bool(g.get_button(pygame.CONTROLLER_BUTTON_START))
                c["back"] = bool(g.get_button(pygame.CONTROLLER_BUTTON_BACK))
                c["alt"] = bool(g.get_button(pygame.CONTROLLER_BUTTON_Y))
            elif self.kind == "js":
                j = self.dev
                ax = j.get_axis(0) if j.get_numaxes() > 0 else 0.0
                ay = j.get_axis(1) if j.get_numaxes() > 1 else 0.0
                if j.get_numhats() > 0:
                    hx, hy = j.get_hat(0)
                    if hx:
                        ax = float(hx)
                    if hy:
                        ay = -float(hy)
                c["x"], c["y"] = ax, ay
                nb = j.get_numbuttons()

                def b(i):
                    return nb > i and bool(j.get_button(i))

                c["jump"] = b(Pad.RAW_JUMP) or b(Pad.RAW_CIRCLE)
                c["alt"] = b(Pad.RAW_TRIANGLE)
                c["back"] = b(Pad.RAW_SHARE)
                c["start"] = b(Pad.RAW_OPTIONS)
            elif self.kind == "script":
                c.update(self.desired)
                c["x"] = float(c.get("x", 0.0))
                c["y"] = float(c.get("y", 0.0))
        except (pygame.error, SystemError, AttributeError):
            c = blank()
        if abs(c["x"]) < 0.28:
            c["x"] = 0.0
        if abs(c["y"]) < 0.45:
            c["y"] = 0.0
        self.prev = self.cur
        self.cur = c

    def pressed(self, key):
        return bool(self.cur.get(key)) and not bool(self.prev.get(key))

    def held(self, key):
        return bool(self.cur.get(key))


class ScriptPad(Pad):
    def __init__(self, name):
        Pad.__init__(self, "script", iid=None)
        self.id = name
        self.script = True

# ---- audio.py ----
# Short synthesized blips. Music is built once, never inside the frame.
import array
import math
import os

import pygame

_SFX = {}
_READY = False


def _tone(freq, dur, vol=0.25, wave="sq", slide=0.0):
    rate = 22050
    n = max(1, int(rate * dur))
    buf = array.array("h")
    ph = 0.0
    for i in range(n):
        t = i / n
        f = freq * (1.0 + slide * t)
        ph += f / rate
        if wave == "sq":
            v = 1.0 if (ph % 1.0) < 0.5 else -1.0
        elif wave == "tri":
            v = 4.0 * abs((ph % 1.0) - 0.5) - 1.0
        else:
            v = math.sin(ph * 6.283185)
        env = 1.0 - t
        sample = int(max(-1.0, min(1.0, v * vol * env)) * 32767)
        buf.append(sample)
        buf.append(sample)
    return buf


def _noise(dur, vol=0.12, slide=0.4):
    rate = 22050
    n = max(1, int(rate * dur))
    buf = array.array("h")
    hold = 0
    v = 0.0
    for i in range(n):
        if hold <= 0:
            hold = 40 + (i * 17) % 50
            v = 1.0 if ((i * 13) % 7) < 3 else -1.0
        hold -= 1
        t = i / n
        env = (1.0 - t) * (0.35 + 0.65 * t)
        sample = int(max(-1.0, min(1.0, v * vol * env)) * 32767)
        buf.append(sample)
        buf.append(sample)
    return buf


def _mix(into, buf, at):
    end = min(len(into), at + len(buf))
    for i in range(at, end):
        into[i] = max(-32767, min(32767, into[i] + buf[i - at]))


def prepare_audio():
    if os.environ.get("SAUNAKISA_NO_SFX"):
        return
    try:
        pygame.mixer.pre_init(22050, -16, 2, 512)
    except Exception:
        pass


def start_audio():
    global _READY
    if os.environ.get("SAUNAKISA_NO_SFX"):
        return
    try:
        if pygame.mixer.get_init() is None:
            pygame.mixer.init(22050, -16, 2, 512)
        _SFX["loyly"] = pygame.mixer.Sound(buffer=_noise(0.28, 0.16).tobytes())
        _SFX["faint"] = pygame.mixer.Sound(buffer=_tone(160, 0.22, 0.22, "sine", -0.55).tobytes())
        _SFX["dip"] = pygame.mixer.Sound(buffer=_tone(520, 0.1, 0.16, "sine", -0.3).tobytes())
        _SFX["drink"] = pygame.mixer.Sound(buffer=_tone(740, 0.09, 0.16, "tri", 0.35).tobytes())
        _SFX["go"] = pygame.mixer.Sound(buffer=_tone(440, 0.12, 0.18, "sq", 0.25).tobytes())
        _SFX["win"] = pygame.mixer.Sound(buffer=_tone(523, 0.26, 0.18, "tri", 0.12).tobytes())
        _SFX["join"] = pygame.mixer.Sound(buffer=_tone(620, 0.07, 0.14, "sq", 0.2).tobytes())
        if not os.environ.get("SAUNAKISA_NO_MUSIC"):
            pygame.mixer.Sound(buffer=_music().tobytes()).play(loops=-1)
        _READY = True
    except Exception:
        _READY = False


def _music():
    rate = 22050
    seconds = 8
    n = rate * seconds
    buf = array.array("h", [0]) * (n * 2)

    def midi(m):
        return 440.0 * (2.0 ** ((m - 69) / 12.0))

    step = int(rate * 0.5)
    melody = (67, 65, 62, 60, 62, 65, 67, 62, 60, 58, 60, 62, 65, 62, 60, 67)
    for i, m in enumerate(melody):
        tone = _tone(midi(m), 0.42, 0.045, "sine", 0.0)
        _mix(buf, tone, i * step * 2)
    for i, m in enumerate((48, 48, 46, 43, 41, 43, 46, 48)):
        tone = _tone(midi(m), 0.7, 0.04, "tri", 0.0)
        _mix(buf, tone, i * step * 4)
    return buf


def sfx(name):
    if not _READY or os.environ.get("SAUNAKISA_AUTOPLAY"):
        return
    sound = _SFX.get(name)
    if sound is not None:
        try:
            sound.play()
        except Exception:
            pass

# ---- world.py ----
# The room: löyly in the air, the occasional gust or flare, and one cooling pickup.


class Item:
    def __init__(self, kind, place, x):
        self.kind = kind
        self.place = place
        self.x = x


class Room:
    def __init__(self, rng):
        self.rng = rng
        self.heat = START_ROOM
        self.item = None
        self.item_in = ITEM_FIRST
        self.event_in = rng.randint(EVENT_MIN, EVENT_MAX)
        self.fx = None
        self.fx_t = 0
        self.loyly_t = 0
        self.gusts = 0
        self.flares = 0
        self.spawns = 0

    def tick(self, players):
        """Passive rise, then a gust or a flare. Returns event names."""
        self.heat = min(100.0, self.heat + ROOM_RISE / FPS)
        if self.loyly_t:
            self.loyly_t -= 1
        if self.fx_t:
            self.fx_t -= 1
            if self.fx_t <= 0:
                self.fx = None
        names = []
        if self.item is None:
            self.item_in -= 1
            if self.item_in <= 0:
                self._spawn()
                names.append("spawn")
        self.event_in -= 1
        if self.event_in <= 0:
            kind = "gust" if self.rng.random() < 0.46 else "flare"
            self._event(kind, players)
            names.append(kind)
            self.event_in = self.rng.randint(EVENT_MIN, EVENT_MAX)
        return names

    def _spawn(self):
        if self.rng.random() < 0.68:
            place, x = "porch", self.rng.choice((36, 54, 72))
        else:
            place, x = "low", self.rng.choice((160, 188, 214))
        kind = "olut" if self.rng.random() < 0.55 else "pyyhe"
        self.item = Item(kind, place, x)
        self.spawns += 1

    def took_item(self):
        self.item = None
        self.item_in = ITEM_EVERY

    def _event(self, kind, players):
        self.fx = kind
        self.fx_t = 40
        if kind == "gust":
            self.gusts += 1
            self.heat = max(0.0, self.heat - GUST_ROOM)
            for player in players:
                if player.mode == "faint":
                    continue
                if player.place in ("floor", "porch", "avanto") and player.x < 190:
                    player.heat = max(0.0, player.heat - GUST_BODY)
        else:
            self.flares += 1
            self.heat = min(100.0, self.heat + FLARE_ROOM)
            for player in players:
                if player.mode == "faint":
                    continue
                place = player.place if player.mode != "climb" else player.climb_to
                if place in INSIDE:
                    player.heat = min(100.0, player.heat + FLARE_BODY)

    def draft(self):
        self.heat = max(0.0, self.heat - DOOR_DRAFT)

# ---- actors.py ----
# Bathers, benches, and the little choices that cook you.


def heat_rate(place, room_heat):
    base = HEAT_RATE[place]
    if base <= 0.0:
        return base
    mult = ROOM_MULT0 + (room_heat / 100.0) * ROOM_MULT1
    return base * mult


def _hotter(a, b, room_heat):
    if heat_rate(a, room_heat) >= heat_rate(b, room_heat):
        return a
    return b


class Player:
    def __init__(self, idx, pad):
        self.idx = idx
        self.pad = pad
        self.place = "floor"
        self.x = 150.0
        self.y = float(PLACES["floor"]["y"])
        self.vx = 0.0
        self.mode = "move"
        self.face = 1
        self.heat = START_HEAT
        self.score = 0.0
        self.bank = 0
        self.wins = 0
        self.faints = 0
        self.round_points = 0
        self.cool_t = 0
        self.loyly_cd = 0
        self.climb_to = "floor"
        self.climb_t = 0
        self.climb_dur = 1
        self.climb_y0 = 0.0
        self.climb_x0 = 0.0
        self.anim = 0
        self.got_bonus = False

    def reset_round(self, place, x):
        self.place = place
        self.x = float(x)
        self.y = float(PLACES[place]["y"])
        self.vx = 0.0
        self.mode = "move"
        self.face = 1
        self.heat = START_HEAT
        self.score = 0.0
        self.round_points = 0
        self.cool_t = 0
        self.loyly_cd = 0
        self.climb_t = 0
        self.got_bonus = False
        self.anim = 0

    @property
    def inside(self):
        if self.mode == "faint":
            return False
        if self.mode == "climb":
            return self.place in INSIDE or self.climb_to in INSIDE
        return self.place in INSIDE


def _enter(player, place, x):
    player.place = place
    player.x = float(x)
    player.y = float(PLACES[place]["y"])
    player.vx = 0.0
    player.mode = "move"


def _start_climb(player, dest):
    spec = PLACES[dest]
    player.mode = "climb"
    player.climb_to = dest
    player.climb_t = 0
    player.climb_y0 = player.y
    player.climb_x0 = player.x
    dist = abs(spec["y"] - player.y)
    player.climb_dur = max(8, int(dist / CLIMB_SPEED))


def _arrive(player):
    dest = player.climb_to
    spec = PLACES[dest]
    player.mode = "move"
    player.place = dest
    player.x = float(spec["climb_x"])
    player.y = float(spec["y"])
    player.vx = 0.0


def step_player(player, ix, iy, act, room):
    """One frame of feet, heat and points. Returns a list of event names."""
    events = []
    if player.loyly_cd:
        player.loyly_cd -= 1
    if player.cool_t:
        player.cool_t -= 1
    if player.mode == "faint":
        player.anim += 1
        return events

    if player.mode == "climb":
        player.climb_t += 1
        dest = PLACES[player.climb_to]
        k = min(1.0, player.climb_t / float(player.climb_dur))
        player.y = player.climb_y0 + (dest["y"] - player.climb_y0) * k
        player.x = player.climb_x0 + (dest["climb_x"] - player.climb_x0) * k
        player.face = -1 if dest["climb_x"] < player.climb_x0 else 1
        if player.climb_t >= player.climb_dur:
            _arrive(player)
    else:
        spec = PLACES[player.place]
        if ix:
            player.vx += ix * ACCEL
            if player.vx > WALK:
                player.vx = WALK
            elif player.vx < -WALK:
                player.vx = -WALK
            player.face = 1 if ix > 0 else -1
        else:
            player.vx *= 0.45
            if abs(player.vx) < 0.08:
                player.vx = 0.0
        player.x += player.vx
        if player.x < spec["x0"]:
            player.x = float(spec["x0"])
            player.vx = 0.0
        elif player.x > spec["x1"]:
            player.x = float(spec["x1"])
            player.vx = 0.0
        player.y = float(spec["y"])

        moved = False
        if spec["left"] and player.x <= spec["x0"] + 0.6 and ix < -0.2:
            land = PLACES[spec["left"]]
            _enter(player, spec["left"], land["x1"] - 2)
            moved = True
            if spec["left"] == "avanto":
                events.append("avanto")
            elif player.place == "porch":
                events.append("exit")
        elif spec["right"] and player.x >= spec["x1"] - 0.6 and ix > 0.2:
            land = PLACES[spec["right"]]
            spot = land["x0"] + 4 if spec["right"] != "avanto" else land["x1"] - 2
            if spec["right"] == "floor":
                spot = land["x0"] + 3
            _enter(player, spec["right"], spot)
            moved = True
            if spec["right"] == "avanto":
                events.append("avanto")
            elif player.place == "floor":
                events.append("enter")
        near_ladder = spec["climb_x"] is not None and abs(player.x - spec["climb_x"]) <= 11
        if not moved and near_ladder:
            if iy < -0.5 and spec["up"]:
                _start_climb(player, spec["up"])
            elif iy > 0.5 and spec["down"]:
                _start_climb(player, spec["down"])

    if act and player.mode == "move" and player.place == "floor" and player.x >= STOVE_X and player.loyly_cd <= 0:
        events.append("loyly")

    _apply_body(player, room)
    if room.item is not None and player.mode == "move" and player.place == room.item.place:
        if abs(player.x - room.item.x) <= 9:
            events.append(_take(player, room))
    if try_faint(player):
        events.append("faint")
    player.anim += 1
    return events


def _apply_body(player, room):
    if player.mode == "climb":
        place = _hotter(player.place, player.climb_to, room.heat)
        points = min(POINT_RATE[player.place], POINT_RATE[player.climb_to])
    else:
        place = player.place
        points = POINT_RATE[place]
    rate = heat_rate(place, room.heat)
    if player.cool_t > 0 and rate > 0:
        rate *= 0.5
    player.heat += rate / FPS
    if player.heat < 0:
        player.heat = 0.0
    elif player.heat > HEAT_MAX:
        player.heat = HEAT_MAX
    player.score += points / FPS


def throw_into(thrower, players, room):
    """Heat the room. The thrower is cooked a little less than everyone else inside."""
    room.heat = min(100.0, room.heat + LOYLY_ROOM)
    room.loyly_t = 46
    thrower.loyly_cd = LOYLY_CD
    for player in players:
        if player.mode == "faint" or not player.inside:
            continue
        add = LOYLY_SELF if player is thrower else LOYLY_OTHER
        player.heat = min(HEAT_MAX, player.heat + add)
    return "loyly"


def _take(player, room):
    kind = room.item.kind
    if kind == "olut":
        player.heat = max(0.0, player.heat - OLUT_COOL)
    else:
        player.heat = max(0.0, player.heat - TOWEL_COOL)
        player.cool_t = TOWEL_TIME
    room.took_item()
    return kind


def try_faint(player):
    if player.mode == "faint" or player.heat < HEAT_MAX:
        return False
    if player.mode == "climb":
        lower = player.place if PLACES[player.place]["y"] >= PLACES[player.climb_to]["y"] else player.climb_to
        _enter(player, lower, player.x)
    player.mode = "faint"
    player.vx = 0.0
    player.heat = HEAT_MAX
    player.score *= FAINT_KEEP
    if player.score < 0:
        player.score = 0.0
    return True


def separate(players):
    """Unstack people who are just standing. A walker can pass; nobody is shoved off."""
    groups = {}
    for player in players:
        if player.mode != "move":
            continue
        groups.setdefault(player.place, []).append(player)
    for place, group in groups.items():
        if len(group) < 2:
            continue
        group.sort(key=lambda p: p.x)
        spec = PLACES[place]
        for i in range(len(group) - 1):
            a = group[i]
            b = group[i + 1]
            if abs(a.vx) >= 0.35 or abs(b.vx) >= 0.35:
                continue
            gap = b.x - a.x
            if gap < BODY:
                push = (BODY - gap) * 0.45
                a.x -= push
                b.x += push
        for player in group:
            if player.x < spec["x0"]:
                player.x = float(spec["x0"])
            elif player.x > spec["x1"]:
                player.x = float(spec["x1"])


def bench_x(player, place):
    """Each seat is a different spot, so two bots do not fight over one plank."""
    spec = PLACES[place]
    left = spec["x0"] + 8
    right = spec["x1"] - 10
    if right <= left:
        return (spec["x0"] + spec["x1"]) * 0.5
    return left + (right - left) * (player.idx / 3.0)


# ----- bots, shared by autoplay and the playtest -----

PROFILES = {
    "ahne": {"target": "high", "leave": 86, "back": 34, "throw_at": 74, "item": 0.22, "troll": False, "lock": 0.22},
    "tasainen": {"target": "mid", "leave": 66, "back": 30, "throw_at": 60, "item": 0.7, "troll": False, "lock": 0.05},
    "arka": {"target": "low", "leave": 48, "back": 22, "throw_at": 92, "item": 0.9, "troll": False, "lock": 0.0},
    "kiusa": {"target": "low", "leave": 72, "back": 32, "throw_at": 42, "item": 0.28, "troll": True, "lock": 0.02},
}
PROFILE_ORDER = ("ahne", "tasainen", "arka", "kiusa")


class Bot:
    """Greed decides when to sit, when to run for the lake, and when to throw."""

    def __init__(self, profile, rng):
        if isinstance(profile, str):
            profile = PROFILES[profile]
        self.profile = profile
        self.rng = rng
        self.plan = "bench"
        self.lock = 0
        self.command = "idle"

    def decide(self, player, room, players):
        des = blank()
        self.command = "idle"
        if player.mode == "faint":
            return des
        self._plan(player, room, players)
        if self.plan == "cool":
            self._toward(player, "avanto", bench_x(player, "avanto"), des)
        elif self.plan == "throw":
            stove = min(PLACES["floor"]["x1"] - 4, STOVE_X + 8 + player.idx * 5)
            self._toward(player, "floor", stove, des)
            if player.mode == "move" and player.place == "floor" and player.x >= STOVE_X and player.loyly_cd <= 0:
                des["jump"] = True
                self.plan = "bench"
                self.command = "act"
        elif self.plan == "item" and room.item is not None:
            self._toward(player, room.item.place, room.item.x, des)
        else:
            target = self.profile["target"]
            self._toward(player, target, bench_x(player, target), des)
        if des["x"] or des["y"] or des["jump"]:
            if self.command != "act":
                self.command = "move" if (des["x"] or des["y"]) else "act"
        return des

    def _plan(self, player, room, players):
        profile = self.profile
        if self.lock > 0:
            self.lock -= 1
        inside = player.place in INSIDE or player.mode == "climb"
        if inside and player.heat >= profile["leave"] and self.lock <= 0:
            self.plan = "cool"
            return
        if player.place in ("porch", "avanto") and player.heat > profile["back"]:
            self.plan = "cool"
            return
        if self.plan == "cool" and player.heat <= profile["back"]:
            self.plan = "bench"
        if self.plan == "item" and (room.item is None or player.heat < 28):
            self.plan = "bench"
        if self.plan == "throw" and player.loyly_cd > 30:
            self.plan = "bench"
        if self.plan != "bench":
            return
        if player.mode != "move":
            return
        # Decide a few times a second so the plan does not flicker every frame.
        if player.anim % 20 != 0:
            return
        if profile["lock"] and player.heat > profile["leave"] - 18 and self.rng.random() < profile["lock"]:
            self.lock = 50 + self.rng.randint(0, 40)
            return
        if self._wants_throw(player, players):
            self.plan = "throw"
            return
        if room.item is not None and player.heat > 36 and self.rng.random() < profile["item"]:
            self.plan = "item"

    def _wants_throw(self, player, players):
        if player.loyly_cd > 0 or player.heat > self.profile["leave"] - 10:
            return False
        threshold = self.profile["throw_at"]
        for other in players:
            if other is player or other.mode == "faint" or not other.inside:
                continue
            if other.heat >= threshold:
                return True
            if self.profile["troll"] and ORDER.index(other.place if other.mode != "climb" else other.climb_to) > ORDER.index("low"):
                if other.heat >= threshold - 12:
                    return True
        return False

    def _toward(self, player, place, x, des):
        if player.mode == "climb":
            dest_y = PLACES[player.climb_to]["y"]
            des["y"] = -1.0 if dest_y < player.y else 1.0
            return
        if player.mode != "move":
            return
        if player.place != place:
            here = ORDER.index(player.place)
            there = ORDER.index(place)
            if there > here:
                if player.place in ("avanto", "porch"):
                    des["x"] = 1.0
                else:
                    self._climb_aim(player, des, up=True)
            elif player.place == "porch" and place == "avanto":
                des["x"] = -1.0
            elif player.place == "floor":
                des["x"] = -1.0
            elif player.place in ("low", "mid", "high"):
                self._climb_aim(player, des, up=False)
            else:
                des["x"] = 1.0
            return
        if player.x < x - 3:
            des["x"] = 1.0
        elif player.x > x + 3:
            des["x"] = -1.0

    def _climb_aim(self, player, des, up):
        spec = PLACES[player.place]
        cx = spec["climb_x"]
        if player.x < cx - 4:
            des["x"] = 1.0
        elif player.x > cx + 4:
            des["x"] = -1.0
        else:
            des["y"] = -1.0 if up else 1.0

# ---- draw.py ----
# 320x180 sauna. The background is painted once; the frame only adds fire, people and steam.
import math

import pygame


WOOD_DK = (78, 42, 24)
WOOD = (132, 78, 42)
WOOD_LT = (176, 116, 64)
LOG = (112, 64, 34)
LOG_DK = (64, 36, 20)
STONE = (62, 60, 66)
STONE_LT = (108, 104, 110)
LAKE = (32, 86, 122)
LAKE_DK = (18, 52, 82)
ICE = (214, 232, 236)
SKY_TOP = (24, 36, 72)
SKY_BOT = (78, 118, 158)
PINE = (18, 46, 34)
SKIN = (255, 214, 186)
HOT = (214, 42, 36)


def _mix(a, b, t):
    t = 0.0 if t < 0 else 1.0 if t > 1 else t
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def make_background():
    s = pygame.Surface((W, H))
    for y in range(H):
        k = y / float(H - 1)
        s.fill(_mix(SKY_TOP, SKY_BOT, k), (0, y, 112, 1))
    pygame.draw.circle(s, (232, 226, 196), (22, 28), 8)
    pygame.draw.circle(s, SKY_TOP, (26, 26), 7)
    _pine(s, 4, 78)
    _pine(s, 72, 86)
    pygame.draw.rect(s, LAKE_DK, (0, 160, 112, 20))
    pygame.draw.rect(s, LAKE, (0, 158, 112, 6))
    pygame.draw.ellipse(s, ICE, (12, 156, 44, 12))
    pygame.draw.ellipse(s, (16, 40, 64), (20, 159, 28, 8))
    for x in range(0, 100, 8):
        pygame.draw.rect(s, WOOD if (x // 8) % 2 == 0 else WOOD_LT, (x, 142, 8, 16))
        pygame.draw.rect(s, WOOD_DK, (x, 142, 8, 2))
    pygame.draw.rect(s, LOG_DK, (96, 108, 18, 50))
    pygame.draw.rect(s, (48, 28, 18), (102, 116, 8, 34))
    for y in range(16, 156, 8):
        pygame.draw.rect(s, LOG if (y // 8) % 2 == 0 else WOOD, (112, y, W - 112, 8))
        pygame.draw.rect(s, LOG_DK, (112, y + 6, W - 112, 2))
    pygame.draw.rect(s, (36, 48, 78), (188, 22, 28, 14))
    pygame.draw.rect(s, WOOD_LT, (186, 20, 32, 18), 2)
    _bench(s, 156, 242, 50)
    _bench(s, 142, 254, 84)
    _bench(s, 128, 264, 118)
    pygame.draw.rect(s, WOOD_DK, (112, 156, W - 112, 24))
    for x in range(112, W, 10):
        pygame.draw.rect(s, WOOD, (x, 156, 9, 6))
    rail = (214, 176, 112)
    for y in range(50, 156, 7):
        pygame.draw.rect(s, rail, (230, y, 3, 6))
        pygame.draw.rect(s, rail, (246, y, 3, 6))
        pygame.draw.rect(s, (70, 40, 22), (233, y + 2, 13, 2))
    pygame.draw.rect(s, STONE, (276, 112, 38, 44))
    pygame.draw.rect(s, STONE_LT, (280, 116, 30, 8))
    pygame.draw.rect(s, (24, 22, 26), (286, 128, 18, 20))
    pygame.draw.rect(s, WOOD, (260, 146, 14, 10))
    pygame.draw.rect(s, (36, 78, 110), (263, 142, 8, 5))
    pygame.draw.rect(s, LOG_DK, (112, 16, W - 112, 6))
    return s


def _pine(s, x, top):
    pygame.draw.rect(s, (72, 48, 28), (x + 6, top + 36, 3, 18))
    pygame.draw.polygon(s, PINE, ((x + 7, top), (x, top + 22), (x + 14, top + 22)))
    pygame.draw.polygon(s, PINE, ((x + 7, top + 10), (x - 2, top + 36), (x + 16, top + 36)))


def _bench(s, x0, x1, y):
    pygame.draw.rect(s, WOOD_DK, (x0, y, x1 - x0, 8))
    for x in range(x0, x1, 8):
        pygame.draw.rect(s, WOOD_LT, (x, y, 7, 3))
    pygame.draw.rect(s, LOG_DK, (x0 + 6, y + 8, 3, 10))
    pygame.draw.rect(s, LOG_DK, (x1 - 10, y + 8, 3, 10))


def _font(g):
    return g.font


def draw_frame(g):
    st = g.state
    if st == "lobby":
        draw_lobby(g)
    elif st == "legend":
        draw_legend(g)
    elif st == "results":
        draw_results(g)
    else:
        draw_world(g)
        if st == "ready":
            draw_count(g)
        elif st == "play" and g.go_flash:
            blit(g.canvas, _font(g), tr("go"), W // 2, 78, (255, 236, 170), 3, center=True)
        elif st == "roundend":
            draw_round_end(g)
        elif st == "paused":
            draw_pause(g)
    _notes(g)
    draw_quit(g)


def draw_world(g):
    c = g.canvas
    c.blit(g.bg, (0, 0))
    _fire(c, g)
    _gust(c, g)
    if g.room is not None and g.room.item is not None:
        _item(c, g.room.item, g.t)
    _bits(c, g.bits)
    order = sorted(g.players, key=lambda p: (p.y, p.idx))
    for player in order:
        draw_player(c, player, g.t)
    _soak(c, g.t)
    if any(p.place in ("porch", "avanto") and p.mode != "faint" for p in g.players):
        pygame.draw.rect(c, WOOD_LT, (100, 116, 4, 28))
    _hud(g)


def _soak(c, t):
    """Drawn after the bathers so an avanto dip actually goes under the water."""
    shift = (t // 8) % 2
    pygame.draw.rect(c, LAKE if shift == 0 else LAKE_DK, (0, 166, 104, 14))
    pygame.draw.rect(c, ICE, (14, 163, 40, 3))
    pygame.draw.rect(c, (186, 224, 232), (24 + shift, 164, 12, 1))


def _fire(c, g):
    heat = 22 if g.room is None else g.room.heat
    glow = heat / 100.0
    if g.room is not None and g.room.loyly_t:
        glow = min(1.0, glow + 0.35)
    h = 6 + int(glow * 14)
    col = _mix((180, 70, 24), (255, 220, 90), glow)
    pygame.draw.rect(c, col, (290, 146 - h, 10, h))
    pygame.draw.rect(c, (255, 244, 210), (293, 148 - h, 4, max(3, h // 2)))
    if g.room is not None and g.room.fx == "flare" and g.room.fx_t:
        pygame.draw.rect(c, (255, 180, 60), (276, 112, 38, 4))


def _gust(c, g):
    if g.room is None or g.room.fx != "gust" or not g.room.fx_t:
        return
    x = 108 + (g.t % 5) * 3
    for i in range(4):
        pygame.draw.rect(c, (200, 220, 230), (x + i * 14, 132 + (i % 2) * 6, 10, 2))


def _item(c, item, t):
    spec = PLACES[item.place]
    x = int(item.x) - 3
    y = int(spec["y"]) - 12
    bob = int(math.sin(t * 0.15) * 1)
    y += bob
    if item.kind == "olut":
        pygame.draw.rect(c, (92, 60, 28), (x + 1, y + 2, 4, 8))
        pygame.draw.rect(c, (220, 200, 140), (x + 1, y, 4, 3))
        pygame.draw.rect(c, (240, 230, 200), (x, y - 1, 6, 2))
    else:
        pygame.draw.rect(c, (70, 140, 180), (x, y + 2, 8, 6))
        pygame.draw.rect(c, (230, 240, 245), (x, y + 4, 8, 2))


def _bits(c, bits):
    for bit in bits:
        x, y, _vx, _vy, life, col = bit
        if life <= 0:
            continue
        size = 3 if life > 12 else 2
        pygame.draw.rect(c, col, (int(x), int(y), size, size))


def draw_player(c, player, t, at=None):
    if at is None:
        x = int(player.x - PW // 2)
        y = int(player.y - PH)
    else:
        x, y = at
    heat = max(0.0, min(1.0, player.heat / 100.0))
    skin = _mix(SKIN, HOT, heat * 0.92)
    col, edge = PCOLORS[player.idx]
    if player.mode == "faint":
        feet = int(player.y) if at is None else y + PH
        _fainted(c, x, feet, skin, col, edge, t, player.idx)
        _meter(c, x, feet - PH, 1.0)
        return
    bob = 0
    if abs(player.vx) > 0.2 and player.mode == "move":
        bob = 1 if (player.anim // 4) % 2 == 0 else 0
    if player.place == "avanto":
        _body(c, x, y + 2, skin, col, edge, heat, t, player, bob, water=True)
    else:
        _body(c, x, y - bob, skin, col, edge, heat, t, player, bob, water=False)
    _meter(c, x, y - bob, heat)


def _body(c, x, y, skin, col, edge, heat, t, player, bob, water):
    pygame.draw.rect(c, (30, 18, 12), (x + 2, y + PH - 2, 8, 2))
    if not water:
        step = bob
        pygame.draw.rect(c, skin, (x + 2, y + 11, 3, 5))
        pygame.draw.rect(c, skin, (x + 7, y + 11 - step, 3, 5))
    pygame.draw.rect(c, col, (x + 1, y + 7, 10, 5))
    pygame.draw.rect(c, edge, (x + 1, y + 7, 10, 5), 1)
    pygame.draw.rect(c, skin, (x + 2, y + 1, 8, 7))
    pygame.draw.rect(c, edge, (x + 2, y + 1, 8, 7), 1)
    pygame.draw.rect(c, (50, 32, 24), (x + 2, y, 8, 2))
    look = 1 if player.face > 0 else 0
    if heat > 0.82:
        pygame.draw.rect(c, (60, 20, 20), (x + 3 + look, y + 3, 2, 1))
        pygame.draw.rect(c, (60, 20, 20), (x + 7 + look, y + 4, 2, 1))
    else:
        pygame.draw.rect(c, (40, 24, 24), (x + 3 + look, y + 3, 2, 2))
        pygame.draw.rect(c, (40, 24, 24), (x + 6 + look, y + 3, 2, 2))
    if heat > 0.42:
        drop = (t // 3 + player.idx * 3) % 8
        pygame.draw.rect(c, (190, 230, 255), (x - 1, y + 2 + drop, 1, 2))
    if player.cool_t > 0 and (t // 6) % 2 == 0:
        pygame.draw.rect(c, (140, 210, 230), (x + 4, y + 8, 4, 2))


def _fainted(c, x, feet, skin, col, edge, t, idx):
    y = feet - 8
    pygame.draw.rect(c, skin, (x, y, 6, 7))
    pygame.draw.rect(c, edge, (x, y, 6, 7), 1)
    pygame.draw.rect(c, col, (x + 6, y + 1, 12, 6))
    pygame.draw.rect(c, edge, (x + 6, y + 1, 12, 6), 1)
    pygame.draw.rect(c, (40, 16, 16), (x + 1, y + 2, 2, 1))
    pygame.draw.rect(c, (40, 16, 16), (x + 1, y + 4, 2, 1))
    pygame.draw.rect(c, (40, 16, 16), (x + 3, y + 3, 1, 1))
    for i in range(3):
        sx = x + 4 + i * 5
        sy = y - 5 + int(math.sin(t * 0.25 + i + idx) * 2)
        pygame.draw.rect(c, (255, 220, 80), (sx, sy, 2, 2))


def _meter(c, x, y, heat):
    bar_y = y - 4
    if bar_y < 14:
        bar_y = y + PH + 1
    pygame.draw.rect(c, (20, 12, 10), (x, bar_y, PW, 4))
    w = int((PW - 2) * max(0.0, min(1.0, heat)))
    if heat < 0.45:
        col = (72, 210, 96)
    elif heat < 0.75:
        col = (244, 196, 48)
    else:
        col = (232, 64, 48)
    if w:
        pygame.draw.rect(c, col, (x + 1, bar_y + 1, w, 2))


def _hud(g):
    c = g.canvas
    font = _font(g)
    pygame.draw.rect(c, (32, 18, 14), (0, 0, W, 13))
    pygame.draw.rect(c, (90, 52, 30), (0, 12, W, 1))
    for i, player in enumerate(g.players):
        x = 3 + i * 36
        pygame.draw.rect(c, PCOLORS[player.idx][0], (x, 3, 6, 6))
        blit(c, font, str(int(player.score)), x + 8, 2, (255, 236, 214), 1, shadow=False)
    label = tr("round", g.round_no, 3)
    blit(c, font, label, 168, 2, (255, 214, 160), 1, shadow=False)
    left = 0 if g.room is None else max(0, g.round_left)
    secs = (left + FPS - 1) // FPS if left else 0
    # imported locally to keep this file from needing a cycle on a renamed const
    clock = "%d:%02d" % (secs // 60, secs % 60)
    col = (255, 120, 90) if 0 < secs <= 10 else (255, 244, 220)
    blit(c, font, clock, 228, 2, col, 1, shadow=False)
    heat = 0 if g.room is None else g.room.heat / 100.0
    pygame.draw.rect(c, (255, 220, 170), (267, 2, 50, 8), 1)
    pygame.draw.rect(c, (48, 28, 22), (268, 3, 48, 6))
    pygame.draw.rect(c, _mix((90, 190, 90), (255, 70, 36), heat), (268, 3, max(1, int(48 * heat)), 6))


def _notes(g):
    font = _font(g)
    for text, x, y, life, col in g.notes:
        if life <= 0:
            continue
        blit(g.canvas, font, text, int(x), int(y), col, 1, center=True)


def draw_lobby(g):
    c = g.canvas
    c.blit(g.bg, (0, 0))
    c.blit(g.veil, (0, 0))
    font = _font(g)
    bob = int(math.sin(g.t * 0.08) * 2)
    blit(c, font, tr("title"), W // 2, 18 + bob, (255, 214, 140), 2, center=True)
    ver = "V" + g.version
    vw, _vh = font.size(ver, 1)
    blit(c, font, ver, W - vw - 4, 3, (220, 170, 120), 1, shadow=False)
    blit(c, font, tr("tag"), W // 2, 40, (255, 186, 130), 1, center=True)
    for i in range(4):
        x = 8 + i * 78
        box = pygame.Rect(x, 54, 74, 78)
        pygame.draw.rect(c, (255, 232, 204), box)
        pygame.draw.rect(c, PCOLORS[i][1], box, 2)
        if i < len(g.players):
            player = g.players[i]
            draw_player(c, player, g.t, at=(x + 28, 78))
            blit(c, font, pname(i), x + 37, 118, PCOLORS[i][0], 1, center=True)
        else:
            if (g.t // 25) % 2 == 0:
                blit(c, font, tr("press"), x + 37, 82, (140, 90, 70), 1, center=True)
            blit(c, font, tr("join"), x + 37, 96, (110, 70, 50), 1, center=True)
    hint = tr("start_hint") + "   " + tr("legend_btn") if len(g.players) >= 2 else tr("need")
    blit(c, font, hint, W // 2, 146, (255, 220, 180), 1, center=True)
    blit(c, font, tr("leave_hint") + "   " + tr("quit_hint"), W // 2, 164, (230, 180, 140), 1, center=True)


def draw_legend(g):
    c = g.canvas
    c.blit(g.bg, (0, 0))
    c.blit(g.veil, (0, 0))
    font = _font(g)
    blit(c, font, tr("legend"), W // 2, 6, (255, 220, 150), 1, center=True)
    keys = ("c_move", "c_climb", "c_loyly", "c_door", "c_avanto", "c_item", "c_score", "c_faint", "c_win")
    for i, key in enumerate(keys):
        blit(c, font, tr(key), W // 2, 22 + i * 15, (255, 236, 214), 1, center=True)
    blit(c, font, tr("back"), W // 2, 164, (255, 210, 140), 1, center=True)


def draw_count(g):
    font = _font(g)
    if g.t < 60:
        label, col = "3", (255, 120, 80)
    elif g.t < 120:
        label, col = "2", (255, 170, 70)
    elif g.t < 180:
        label, col = "1", (255, 214, 100)
    else:
        label, col = tr("go"), (255, 244, 180)
    blit(g.canvas, font, label, W // 2, 70, col, 3, center=True)
    blit(g.canvas, font, tr("hint_play"), W // 2, 164, (255, 232, 200), 1, center=True)


def draw_round_end(g):
    c = g.canvas
    c.blit(g.veil, (0, 0))
    font = _font(g)
    panel = pygame.Rect(12, 20, W - 24, 132)
    pygame.draw.rect(c, (255, 236, 214), panel)
    pygame.draw.rect(c, (120, 64, 36), panel, 2)
    winners = g.round_winners or []
    if len(winners) == 1:
        title = tr("win", pname(winners[0].idx))
        col = PCOLORS[winners[0].idx][0]
    else:
        title, col = tr("draw"), (120, 64, 36)
    blit(c, font, title, W // 2, 28, col, 1, center=True)
    blit(c, font, tr("board"), W // 2, 42, (120, 70, 40), 1, center=True)
    order = sorted(g.players, key=lambda p: (-p.round_points, p.idx))
    for i, player in enumerate(order):
        y = 56 + i * 20
        pygame.draw.rect(c, PCOLORS[player.idx][0], (22, y, 8, 8))
        blit(c, font, pname(player.idx), 34, y - 1, (70, 36, 24), 1, shadow=False)
        line = "%s %d   %s %d" % (tr("points"), player.round_points, tr("total"), player.bank)
        if player.mode == "faint":
            line += "  " + tr("fainted")
        blit(c, font, line, 34, y + 8, (110, 64, 40), 1, shadow=False)
    if g.t > 24 and (g.t // 20) % 2 == 0:
        blit(c, font, tr("next"), W // 2, 162, (255, 220, 170), 1, center=True)


def draw_results(g):
    c = g.canvas
    c.blit(g.bg, (0, 0))
    pygame.draw.rect(c, (32, 18, 14), (0, 0, W, 13))
    font = _font(g)
    blit(c, font, tr("results"), W // 2, 2, (255, 220, 160), 1, center=True)
    if g.players:
        champ = max(g.players, key=lambda p: (p.bank, p.wins, -p.faints, -p.idx))
        blit(c, font, tr("champ", pname(champ.idx)), W // 2, 20, PCOLORS[champ.idx][0], 1, center=True)
        draw_player(c, champ, g.t, at=(W // 2 - 6, 32))
    order = sorted(g.players, key=lambda p: (-p.bank, -p.wins, p.idx))
    panel = pygame.Rect(16, 64, W - 32, 78)
    pygame.draw.rect(c, (255, 236, 214), panel)
    pygame.draw.rect(c, (140, 80, 48), panel, 2)
    for i, player in enumerate(order):
        y = 72 + i * 16
        pygame.draw.rect(c, PCOLORS[player.idx][0], (26, y, 8, 8))
        blit(c, font, pname(player.idx), 40, y, (70, 36, 24), 1, shadow=False)
        blit(c, font, str(player.bank), 168, y, (90, 48, 28), 1, shadow=False)
        for k in range(min(3, player.wins)):
            pygame.draw.rect(c, (220, 160, 40), (230 + k * 8, y, 6, 6))
    blit(c, font, tr("rematch") + "   " + tr("back_lobby"), W // 2, 164, (255, 236, 210), 1, center=True)


def draw_pause(g):
    c = g.canvas
    c.blit(g.veil, (0, 0))
    font = _font(g)
    blit(c, font, tr("paused"), W // 2, 48, (255, 220, 150), 2, center=True)
    opts = (tr("resume"), tr("to_lobby"), tr("quit"))
    for i, label in enumerate(opts):
        y = 84 + i * 20
        if i == g.menu_i:
            pygame.draw.rect(c, (255, 210, 140), (70, y - 3, 180, 16))
        blit(c, font, label, W // 2, y, (90, 40, 28), 1, center=True)


def draw_quit(g):
    if g.quit_hold < 6:
        return
    c = g.canvas
    bw = 120
    x = W // 2 - bw // 2
    pygame.draw.rect(c, (40, 20, 24), (x, 4, bw, 10))
    pygame.draw.rect(c, (255, 236, 214), (x, 4, int(bw * min(1, g.quit_hold / 60.0)), 10))
    blit(c, _font(g), tr("quitting"), W // 2, 5, (80, 30, 24), 1, center=True)

# ---- game.py ----
# Couch loop: join, sweat, scoreboard, again.
import random

import pygame



SPOTS = (148, 178, 208, 236)


class Game:
    def __init__(self, screen):
        self.screen = screen
        self.canvas = pygame.Surface((W, H))
        self.font = Font()
        self.bg = make_background()
        self.veil = pygame.Surface((W, H), pygame.SRCALPHA)
        self.veil.fill((28, 16, 12, 150))
        self.version = load_version()
        self.pads = {}
        kb = Pad("kb")
        self.pads[kb.id] = kb
        self.players = []
        self.room = None
        self.state = "lobby"
        self.t = 0
        self.round_no = 0
        self.round_left = 0
        self.round_winners = []
        self.ending = 0
        self.go_flash = 0
        self.menu_i = 0
        self.quit_hold = 0
        self.running = True
        self.autoplay = False
        self.seed = 1
        self.rng = random.Random(1)
        self.bits = []
        self.notes = []
        self.stats = {
            "frames": 0, "faints": 0, "loyly": 0, "dips": 0, "pickups": 0,
            "exits": 0, "gusts": 0, "flares": 0, "rounds_ended": 0,
            "early": 0, "wipes": 0,
        }

    def public_stats(self):
        return dict(self.stats)

    def arm_autoplay(self, seed):
        self.autoplay = True
        self.seed = seed
        self.rng = random.Random(seed + 3)
        for i, name in enumerate(PROFILE_ORDER):
            pad = ScriptPad("bot%d" % i)
            pad.auto = True
            pad.join_frame = 8 + i * 5
            pad.bot = Bot(name, random.Random(seed + 17 + i))
            self.pads[pad.id] = pad

    def goto(self, name):
        self.state = name
        self.t = 0

    def add_player(self, pad):
        if len(self.players) >= 4 or any(p.pad is pad for p in self.players):
            return None
        player = Player(len(self.players), pad)
        player.reset_round("floor", SPOTS[player.idx])
        self.players.append(player)
        sfx("join")
        return player

    def reindex(self):
        for i, player in enumerate(self.players):
            player.idx = i

    def owner(self, pad):
        for player in self.players:
            if player.pad is pad:
                return player
        return None

    def handle_device(self, ev):
        if ev.type == pygame.JOYDEVICEADDED:
            try:
                joy = pygame.joystick.Joystick(ev.device_index)
            except Exception:
                return
            iid = joy.get_instance_id()
            pad = None
            try:
                from pygame._sdl2 import controller
                if not controller.get_init():
                    try:
                        controller.init()
                    except Exception:
                        pass
                if controller.is_controller(ev.device_index):
                    try:
                        con = controller.Controller.from_joystick(joy)
                    except Exception:
                        con = controller.Controller(ev.device_index)
                    pad = Pad("gc", con, iid=iid, joy=joy)
            except Exception:
                pad = None
            if pad is None:
                pad = Pad("js", joy, iid=iid, joy=joy)
            self.pads[pad.id] = pad
        elif ev.type == pygame.JOYDEVICEREMOVED:
            self.drop_pad("js%d" % ev.instance_id)

    def drop_pad(self, pid):
        pad = self.pads.pop(pid, None)
        if pad is None:
            return
        for player in self.players:
            if player.pad is pad:
                script = ScriptPad("auto-%d" % player.idx)
                script.auto = True
                script.bot = Bot("tasainen", random.Random(self.seed + 90 + player.idx))
                player.pad = script
                self.pads[script.id] = script

    def grab_pads(self):
        if self.state not in ("play", "ready"):
            return
        for pad in list(self.pads.values()):
            if self.owner(pad) is not None or not pad.pressed("jump"):
                continue
            for player in self.players:
                if getattr(player.pad, "auto", False):
                    player.pad = pad
                    break

    def poll_events(self):
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT:
                self.running = False
            elif ev.type in (pygame.JOYDEVICEADDED, pygame.JOYDEVICEREMOVED):
                self.handle_device(ev)
            elif ev.type == pygame.KEYDOWN and ev.key == pygame.K_ESCAPE:
                self.running = False

    def poll_pads(self):
        ks = pygame.key.get_pressed()
        pads = list(self.pads.values())
        for player in self.players:
            if player.pad not in pads:
                pads.append(player.pad)
        seen = set()
        quitting = False
        for pad in pads:
            if id(pad) in seen:
                continue
            seen.add(id(pad))
            pad.poll(ks)
            if pad.held("start") and pad.held("back"):
                quitting = True
        self.quit_hold = self.quit_hold + 1 if quitting else 0

    def drive(self):
        if self.state == "lobby":
            for pad in self.pads.values():
                if not getattr(pad, "auto", False) or self.owner(pad) is not None:
                    continue
                des = blank()
                if self.t == getattr(pad, "join_frame", 8):
                    des["jump"] = True
                pad.desired = des
        for player in self.players:
            bot = getattr(player.pad, "bot", None)
            if bot is None:
                continue
            if not (self.autoplay or getattr(player.pad, "auto", False)):
                continue
            player.pad.desired = self._auto_desire(player, bot)

    def _auto_desire(self, player, bot):
        if self.state == "lobby":
            des = blank()
            if self.t == 40 and player.idx == 0 and len(self.players) >= 2:
                des["start"] = True
            return des
        if self.state in ("ready", "play") and self.room is not None:
            return bot.decide(player, self.room, self.players)
        if self.state == "roundend" and self.t == 48 and player.idx == 0:
            des = blank()
            des["jump"] = True
            return des
        if self.state == "results" and self.t == 30 and player.idx == 0:
            des = blank()
            des["jump"] = True
            return des
        return blank()

    def note(self, text, x, y, color):
        self.notes.append([text, x, y, 46, color])
        if len(self.notes) > 8:
            del self.notes[0]

    def _tick_notes(self):
        kept = []
        for item in self.notes:
            item[2] -= 0.22
            item[3] -= 1
            if item[3] > 0:
                kept.append(item)
        self.notes = kept

    def _tick_bits(self):
        kept = []
        for bit in self.bits:
            bit[0] += bit[2]
            bit[1] += bit[3]
            bit[4] -= 1
            if bit[4] > 0:
                kept.append(bit)
        self.bits = kept[-70:]

    def puff(self, x, y, color, n=4, speed=0.4):
        for i in range(n):
            if len(self.bits) > 70:
                self.bits.pop(0)
            self.bits.append([
                x + random.uniform(-3, 3), y,
                random.uniform(-speed, speed), random.uniform(-0.7, -0.15),
                random.randint(12, 26), color,
            ])

    def update(self):
        self.poll_events()
        self.drive()
        self.poll_pads()
        self.t += 1
        self.stats["frames"] += 1
        self._tick_notes()
        self._tick_bits()
        if self.quit_hold >= 60:
            self.running = False
            return
        self.grab_pads()
        getattr(self, "up_" + self.state)()

    def up_lobby(self):
        for pad in list(self.pads.values()):
            if pad.pressed("alt"):
                self.goto("legend")
                return
            owned = self.owner(pad)
            if owned is not None and pad.pressed("back"):
                self.players.remove(owned)
                self.reindex()
                continue
            if owned is None and pad.pressed("jump"):
                self.add_player(pad)
        if len(self.players) >= 2 and any(
            self.owner(pad) is not None and pad.pressed("start") for pad in self.pads.values()
        ):
            self.begin_round()

    def up_legend(self):
        for pad in self.pads.values():
            if pad.pressed("jump") or pad.pressed("back") or pad.pressed("alt") or pad.pressed("start"):
                self.goto("lobby")
                return

    def up_ready(self):
        self._ambience()
        if self.t >= COUNTDOWN:
            sfx("go")
            self.go_flash = 28
            self.goto("play")
            self.up_play()

    def up_play(self):
        if self.go_flash:
            self.go_flash -= 1
        if self._wants_pause():
            self.menu_i = 0
            self.goto("paused")
            return
        self._simulate()
        alive = [p for p in self.players if p.mode != "faint"]
        if self.ending:
            self.ending -= 1
            if self.ending <= 0 or not alive:
                self._finish_round()
            return
        if not alive:
            self.stats["wipes"] += 1
            self._finish_round()
            return
        elapsed = ROUND_FRAMES - max(0, self.round_left)
        if len(alive) == 1 and len(self.players) >= 2 and elapsed >= MIN_FRAMES:
            alive[0].score += LAST_BONUS
            alive[0].got_bonus = True
            self.stats["early"] += 1
            self.note(tr("last"), W / 2, 36, (255, 220, 140))
            sfx("win")
            self.ending = SOLO_HOLD
            return
        if self.round_left <= 0:
            self._finish_round()

    def up_paused(self):
        for player in self.players:
            pad = player.pad
            if pad.cur["y"] < -0.5 and pad.prev["y"] >= -0.5:
                self.menu_i = (self.menu_i - 1) % 3
            elif pad.cur["y"] > 0.5 and pad.prev["y"] >= -0.5 and pad.prev["y"] <= 0.5:
                self.menu_i = (self.menu_i + 1) % 3
            if pad.pressed("back"):
                self.goto("play")
                return
            if pad.pressed("jump") or pad.pressed("start"):
                self._pause_pick()
                return

    def up_roundend(self):
        if self.t > 24 and any(p.pad.pressed("jump") or p.pad.pressed("start") for p in self.players):
            if self.round_no >= ROUNDS:
                self.goto("results")
            else:
                self.begin_round()

    def up_results(self):
        if any(p.pad.pressed("back") for p in self.players):
            self._to_lobby()
            return
        if self.t > 16 and any(p.pad.pressed("jump") or p.pad.pressed("start") for p in self.players):
            self._rematch()

    def _wants_pause(self):
        if self.autoplay or self.ending:
            return False
        for player in self.players:
            pad = player.pad
            if pad.pressed("start") and not pad.held("back"):
                return True
        return False

    def _pause_pick(self):
        if self.menu_i == 0:
            self.goto("play")
        elif self.menu_i == 1:
            self._to_lobby()
        else:
            self.running = False

    def _to_lobby(self):
        for player in self.players:
            player.bank = 0
            player.wins = 0
            player.faints = 0
            player.score = 0
        self.round_no = 0
        self.room = None
        self.notes = []
        self.goto("lobby")

    def _rematch(self):
        for player in self.players:
            player.bank = 0
            player.wins = 0
            player.faints = 0
        self.round_no = 0
        self.begin_round()

    def begin_round(self):
        self.round_no += 1
        self.room = Room(self.rng)
        self.round_left = ROUND_FRAMES
        self.ending = 0
        self.go_flash = 0
        self.round_winners = []
        self.bits = []
        self.notes = []
        for i, player in enumerate(self.players):
            player.reset_round("floor", SPOTS[i])
        self.goto("ready")

    def _simulate(self):
        self.round_left -= 1
        self.room.tick(self.players)
        self.stats["gusts"] = self.room.gusts
        self.stats["flares"] = self.room.flares
        thrown = []
        for player in self.players:
            pad = player.pad
            events = step_player(
                player, pad.cur["x"], pad.cur["y"], pad.pressed("jump"), self.room,
            )
            if "exit" in events:
                self.room.draft()
                self.stats["exits"] += 1
            if "avanto" in events:
                self.stats["dips"] += 1
                sfx("dip")
                self.note(tr("avanto"), player.x, player.y - 26, (170, 220, 255))
                self.puff(player.x, player.y - 8, (180, 220, 240), 5, 0.5)
            if "loyly" in events:
                thrown.append(player)
            if "olut" in events or "pyyhe" in events:
                kind = "olut" if "olut" in events else "pyyhe"
                self.stats["pickups"] += 1
                sfx("drink")
                self.note(tr(kind), player.x, player.y - 22, (255, 230, 160))
            if "faint" in events:
                self._on_faint(player)
        for player in thrown:
            throw_into(player, self.players, self.room)
            self.stats["loyly"] += 1
            sfx("loyly")
            self.note(tr("loyly"), 250, 78, (255, 244, 220))
            self.puff(296, 120, (230, 236, 240), 8, 0.55)
        for player in self.players:
            if try_faint(player):
                self._on_faint(player)
        separate(self.players)
        self._ambience()

    def _ambience(self):
        if self.room is None:
            return
        rate = 2 if self.room.heat > 50 or self.room.loyly_t else 4
        if self.t % rate == 0:
            self.puff(296, 118, (236, 240, 244), 2, 0.35)
        for player in self.players:
            if player.mode == "faint" or player.heat < 58:
                continue
            if self.t % 14 == player.idx:
                self.puff(player.x, player.y - 18, (200, 230, 255), 1, 0.2)

    def _on_faint(self, player):
        self.stats["faints"] += 1
        sfx("faint")
        self.note(tr("fainted"), player.x, player.y - 18, PCOLORS[player.idx][0])
        self.puff(player.x, player.y - 10, (255, 220, 80), 4, 0.35)

    def _finish_round(self):
        for player in self.players:
            player.round_points = int(player.score + 0.5)
            player.bank += player.round_points
            if player.mode == "faint":
                player.faints += 1
        self.notes = []
        best = max(player.round_points for player in self.players) if self.players else 0
        self.round_winners = [p for p in self.players if p.round_points == best and best > 0]
        for player in self.round_winners:
            player.wins += 1
        self.stats["rounds_ended"] += 1
        sfx("win")
        self.ending = 0
        self.goto("roundend")

    def draw(self):
        draw_frame(self)
        self.screen.blit(self.canvas, (0, 0))

# ---- main.py ----
# Batocera: copy the built Saunakisa<version>.pygame to /userdata/roms/pygame/
import json
import os

import pygame



def open_screen():
    windowed = bool(os.environ.get("SAUNAKISA_WINDOWED"))
    fast = bool(os.environ.get("SAUNAKISA_FRAMES") or os.environ.get("SAUNAKISA_AUTOPLAY"))
    dummy = os.environ.get("SDL_VIDEODRIVER") == "dummy"
    flags = 0 if dummy else pygame.SCALED
    if not windowed and not dummy:
        flags |= pygame.FULLSCREEN
    vsync = 0 if fast or dummy else 1
    try:
        return pygame.display.set_mode((W, H), flags, vsync=vsync)
    except TypeError:
        try:
            return pygame.display.set_mode((W, H), flags)
        except pygame.error:
            return pygame.display.set_mode((W, H))
    except pygame.error:
        return pygame.display.set_mode((W, H))


def main():
    os.environ.setdefault("SDL_GAMECONTROLLER_ALLOW_BACKGROUND_EVENTS", "1")
    frames = int(os.environ.get("SAUNAKISA_FRAMES") or "0")
    fast = bool(frames or os.environ.get("SAUNAKISA_AUTOPLAY"))
    prepare_audio()
    pygame.init()
    start_audio()
    try:
        from pygame._sdl2 import controller
        controller.init()
    except Exception:
        pass
    screen = open_screen()
    pygame.display.set_caption("SAUNAKISA")
    pygame.mouse.set_visible(False)
    game = Game(screen)
    if os.environ.get("SAUNAKISA_AUTOPLAY"):
        game.arm_autoplay(int(os.environ.get("SAUNAKISA_SEED") or "1"))
    clock = pygame.time.Clock()
    n = 0
    while game.running:
        game.update()
        game.draw()
        pygame.display.flip()
        if not fast:
            clock.tick(FPS)
        n += 1
        if frames and n >= frames:
            break
    if game.autoplay:
        print("SAUNAKISA_STATS " + json.dumps(game.public_stats(), separators=(",", ":")))
    pygame.quit()


if __name__ == "__main__":
    main()
