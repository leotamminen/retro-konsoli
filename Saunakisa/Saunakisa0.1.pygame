#!/usr/bin/env python3
# SAUNAKISA - rento 2-4 pelaajan saunakisa Batoceralle (pygame 2).
# Yksi tiedosto, ei assetteja. Kopioi kansioon /userdata/roms/pygame/
# Versio tulee buildin aikana version.jsonista.
def load_version():
    return '0.1'


