# ======== p30_v13_map.py ========
"""Explored-cell map: unseen realm is neither drawn nor implied. Small area surfaces not full map."""
def map13(s):
    if getattr(s,'mapimg',None):return
    rows=[]
    for nm,a,b in AREAS:
        if nm in ('ranta','syvanne','katedraali') and (not s.save or not s.save.get('vellamo_unlocked') or not s.save.get('vellamo_visited')):continue
        base,top={'forest':((70,80,62),(110,150,80)),'swamp':((70,78,56),(140,160,80)),'river':((84,84,120),(150,190,220)),'pohjola':((36,40,57),(83,105,150)),'ranta':((15,47,47),(67,135,112)),'syvanne':((15,29,59),(66,105,164)),'katedraali':((20,41,32),(98,134,112))}[nm]
        surf=pygame.Surface(((b-a)*2,ROWS));surf.fill((14,12,20));sil=pygame.Surface(surf.get_size());sil.fill((14,12,20))
        for tx in range(a,b):
            for ty in range(ROWS):
                v=GRID[ty][tx];x=(tx-a)*2
                if v==SOLID:surf.fill(top if GRID[ty-1][tx]!=SOLID else base,(x,ty,2,1));sil.fill((34,32,42),(x,ty,2,1))
                elif v==PLAT:surf.fill((150,110,70),(x,ty,2,1))
                elif v==WATER:surf.fill((50,90,170),(x,ty,2,1));sil.fill((28,30,46),(x,ty,2,1))
                elif v==THORN:surf.fill((180,60,70),(x,ty,2,1))
                elif v==LADDER:surf.fill((170,120,70),(x,ty,2,1))
        rows.append((nm,a,b,surf,sil))
    s.mapimg=rows
GameUI.build_map=map13

# ======== p31_v13_tide.py ========
"""Localized Ahti tide with real lift/pull. Base move_body and World remain byte-equivalent."""
Classic_phys=Player.phys
def tide_phys(p,fric=.82,grav=True):
    if isinstance(p,Player) and isinstance(p.g,GameCore) and p.g.arena=='ahti':
        water=228-p.g.tide
        p.in_water=p.y-PH_>water
        if p.in_water:
            # shallow tide has mild horizontal wave motion, increased buoyancy in phase 2
            p.vy=min(2.8,p.vy-.045);p.vx+=math.sin(p.g.frames*.04)*.025
            if p.vy<0:p.vy*=.94
    else:p.in_water=False
    return Classic_phys(p,fric,grav)
Player.phys=tide_phys
def water_level(g):return 228-g.tide if g.arena=='ahti' else 0
GameCore.water_level=water_level
# New realm water is traversable water; base-game water/insta-kill hazard stays unchanged.
_Legacy_hazard_at=hazard_at
def hazard_region(wd,b):
    if b.x>=486*TILE and wd.tile(int(b.x//TILE),19)==WATER:return False
    return _Legacy_hazard_at(wd,b)
hazard_at=hazard_region
# Sanitization stays explicit and backwards compatible; do not preserve a victory in a defeated boss.
Save_sanitize=sanitize_save
def sanitize_v13(d,valid_bonfires=None,valid_ids=None):
    sv=Save_sanitize(d,valid_bonfires,valid_ids)
    if sv is None:return None
    # These fields may have appeared in experiments but have no active semantics.
    sv.pop('vellamo_clear',None)
    return sv
sanitize_save=sanitize_v13

# ======== p32_v13_chunk_budget.py ========
"""Spread terrain decoding outside budgets, prewarm short known-looking transitions."""
Root_chunk=GameCore.chunk
def budget_chunk(s,c):
    # A chunk is garbage only if camera hydration rev's the tilemap - cache same revision.
    return Root_chunk(s,c)
def warm_chunks(s):
    if s.frames%4:return
    if getattr(s,'chunk_frame',-1)==s.frames:return
    center=int(s.cam[0])//320
    for cc in sorted(range(max(0,center-3),min((COLS-1)//20,center+4)+1),key=lambda c:abs(c-center)):
        if (cc,GameCore.CHUNK_REV[0]) not in GameCore.CHUNK_CACHE:
            s.chunk_frame=s.frames;Root_chunk(s,cc);return
GameCore.warm_chunks=warm_chunks
_root_warm_all=GameCore.warm_all
def warm_all(s):
    center=int(s.cam[0])//320
    for cc in range(max(0,center-1),min((COLS-1)//20,center+1)+1):Root_chunk(s,cc)
GameCore.warm_all=warm_all
_pre_start=GameCore.start_boss
def prewarm_intro(s,key):
    a=ARENAS[key];center=(a['x0']-1)*16//320
    # one near-left/current/right, never full map / every-attack generation
    for ci in (center-1,center,center+1):
        if 0<=ci<((COLS-1)//20+1):Root_chunk(s,ci)
    return _pre_start(s,key)
GameCore.start_boss=prewarm_intro

# ======== p33_v13_map_draw.py ========
def map_y(s,i):
    return 15+i*18 if s.save and s.save.get('vellamo_unlocked') and s.save.get('vellamo_visited') else 17+i*39

def dr_map_fog(s):
    s.build_map();c=s.canvas;s.msgs.clear()
    if s.save is not None:s.draw_play_scene()
    c.blit(s.dimmer,(0,0));c.fill((10,8,14),(0,0,W,H))
    s.text(tr('m_map'),W//2,7,(255,225,150),s.font)
    vis,front=s.map_known();compact=bool(s.save and s.save.get('vellamo_unlocked') and s.save.get('vellamo_visited'))
    for i,(nm,a,b,surf,sil) in enumerate(s.mapimg):
        newrow=nm in ('ranta','syvanne','katedraali');y=map_y(s,i);x=(W-surf.get_width())//2
        if compact:
            surf=pygame.transform.scale(surf,(surf.get_width(),22));sil=pygame.transform.scale(sil,(surf.get_width(),22))
        known=any(a<=cx*MAP_CW+MAP_CW-1 and cx*MAP_CW<b for cx,cy in vis)
        pygame.draw.rect(c,(18,16,24) if known else (10,8,14),(x-1,y-1,surf.get_width()+2,surf.get_height()+2))
        for cx in range(a//MAP_CW,(b-1)//MAP_CW+1):
            for cy in range((ROWS+MAP_CH-1)//MAP_CH):
                src=surf if (cx,cy) in vis else (sil if not newrow and (cx,cy) in front else None)
                if src is None:continue
                t0=max(a,cx*MAP_CW);t1=min(b,cx*MAP_CW+MAP_CW)
                r=pygame.Rect((t0-a)*2,int(cy*MAP_CH*surf.get_height()/ROWS),(t1-t0)*2,int(min(MAP_CH,ROWS-cy*MAP_CH)*surf.get_height()/ROWS))
                if r.w>0 and r.h>0:c.blit(src,(x+r.x,y+r.y),r)
        for k,ar in ARENAS.items():
            if a<=ar['x0']<b:
                if 'arena:'+k not in s.mapseen:
                    h=max(2,int((ar['ground']-ar['y0']+2)*surf.get_height()/ROWS))
                    c.fill((10,8,14),(x+(ar['x0']+1-a)*2,y+int(ar['y0']*surf.get_height()/ROWS),(ar['x1']-ar['x0']-1)*2,h));continue
                done=k in s.save['bosses'];mx=x+(ar['x0']+10-a)*2;my=y+int((ar['y0']+6)*surf.get_height()/ROWS)
                pygame.draw.rect(c,(90,90,100) if done else (220,60,60),(mx-2,my-2,5,5),1);c.fill((90,90,100) if done else (220,60,60),(mx,my,1,1))
        for bid,tx in BONFIRES.items():
            if a<=tx<b and bid in s.save['seen']:
                by=floor_row(tx,BF_START[bid]);c.fill((255,170,70),(x+(tx-a)*2-1,y+int((by-3)*surf.get_height()/ROWS),4,3));c.fill((255,235,150),(x+(tx-a)*2,y+int((by-3)*surf.get_height()/ROWS),2,1))
        for p in s.players:
            tx=p.x/TILE
            if a<=tx<b and (s.t_ui//15)%2==0:
                col=(255,255,255) if p.idx==0 else P2_TINT[p.cls];c.fill(col,(x+int((tx-a)*2)-1,y+int(p.y/TILE*surf.get_height()/ROWS)-2,3,3))
        if known:s.text(tr('area_'+nm),x+3,y-5,(220,215,200),s.tiny,'l')
    s.text(tr('map_legend'),W//2,H-6,(170,170,180),s.tiny)
GameUI.dr_map=dr_map_fog

# ======== p34_v131_water.py ========
# Cached, tiled water surfaces: no large allocation or gradient per game frame.
def vellamo_bg(name):
    if name not in _WL_BG:
        sf=pygame.Surface((W,H));top,bot=PAL[name]['sky']
        for y in range(H):
            f=y/(H-1);pygame.draw.line(sf,tuple(int(top[i]*(1-f)+bot[i]*f) for i in range(3)),(0,y),(W,y))
        # Three slender rays. Tapered edges make the water luminous, not scanlined.
        ray=mk(W,H)
        for i in range(3):
            x=21+i*145
            pygame.draw.polygon(ray,(top[0]+6,top[1]+11,top[2]+12),[(x,0),(x+9,0),(x+83,H),(x+41,H)])
            pygame.draw.polygon(ray,(top[0]+3,top[1]+6,top[2]+5),[(x+13,0),(x+19,0),(x+57,H),(x+40,H)])
        sf.blit(ray,(0,0))
        # Irregular gentle caustics only in the upper band of the tile.
        for i in range(10):
            x=7+i*37;y=11+(i*11)%35
            pygame.draw.arc(sf,(top[0]+9,top[1]+16,top[2]+18),(x,y,19,8),.12,2.92,1)
        _WL_BG[name]=sf
    return _WL_BG[name]
_WL_BG={'blank_fog':mk(1,1)}
_sky13=sky_surface
def sky_for(ar):return vellamo_bg(ar) if ar in ('ranta','syvanne','katedraali') else _sky13(ar)
sky_surface=sky_for
def par_for(ar):
    if ar not in _PAR13:
        sh=mk(480,180)
        if ar=='ranta':
            # Reeds and old rocks recede below the luminous water surface.
            for i in range(18):
                x=i*31;y=148-(i*19)%38
                pygame.draw.ellipse(sh,(37,90,90),(x-10,y,38,56-y))
                pygame.draw.line(sh,(43,108,89),(x,180),(x+(i%3)-1,y+2),2)
                for j in range(3):pygame.draw.line(sh,(44,101,85),(x,y+8+j*7),(x-7+(i%2)*12,y+3+j*7),1)
        elif ar=='syvanne':
            # Kelp ribbons stand far apart; contrast drops into dark water.
            for i in range(19):
                x=i*26;hy=42+(i*29)%63
                pygame.draw.lines(sh,(30,78,81),False,[(x,180),(x+4,151),(x-2,135),(x+6,115),(x+3,hy)],3)
                for j in range(3):
                    y=hy+j*20
                    pygame.draw.ellipse(sh,(37,91,80),(x-7+(j%2)*7,y,11,4))
                pygame.draw.circle(sh,(56,116,106),(x+3,hy),3)
        else:
            # Sunken cathedral: round arches and surviving paired columns.
            for x in (-8,106,230,354):
                pygame.draw.rect(sh,(43,94,94),(x,61,88,119))
                pygame.draw.ellipse(sh,PAL[ar]['sky'][0],(x+10,79,64,82))
                for xx in (x+4,x+70):
                    pygame.draw.rect(sh,(65,124,109),(xx,76,11,104))
                    pygame.draw.rect(sh,(76,136,118),(xx-3,72,17,5))
                    for yy in range(83,165,10):pygame.draw.line(sh,(50,102,95),(xx+3,yy),(xx+3,yy+5),1)
                pygame.draw.arc(sh,(65,126,110),(x+6,70,75,90),0,math.pi,4)
                pygame.draw.line(sh,(62,124,112),(x,61),(x+88,61),3)
            pygame.draw.line(sh,(54,105,99),(0,178),(480,178),3)
        for i in range(13):
            xx=17+(i*109)%432;yy=23+(i*59)%111
            if ar!='katedraali' or yy<74:
                pygame.draw.circle(sh,(65,123,127),(xx,yy),2,1)
                pygame.draw.rect(sh,(91,150,145),(xx-1,yy-1,1,1))
        ps=mk(480,180);ps.blit(sh,(0,0));_PAR13[ar]=[(ps,.28,0)]
    return _PAR13[ar]
_PAR13={};layers_for=par_for

# Generic fog uses a source-alpha fill; a translucent ellipse without its
# fill would be completely opaque. Clear low-alpha water mist at the seam.
_water_fog=fog_surface
def fog_for(ar):
    if ar not in ('ranta','syvanne','katedraali'):return _water_fog(ar)
    key='mist_'+ar
    if key not in _WL_BG:
        sf=mk(640,64);sf.fill((0,0,0,0))
        for i in range(8):
            x=16+i*80;y=32+(i%3)*8
            pygame.draw.arc(sf,(40,82,103,25),(x-50,y-8,110,15),.18,2.95,2)
            pygame.draw.arc(sf,(53,105,120,17),(x-34,y-3,76,19),3.3,6.08,2)
        _WL_BG[key]=sf
    return _WL_BG[key]
fog_surface=fog_for
# Preserve 1.3 chunking and fog draw order; only opaque water fog is skipped.
def _water_world(s,c,t):
    global fog_surface
    area=area_at(int((s.cam[0]+W//2)//TILE))
    if area not in ('ranta','syvanne','katedraali'):return _world(s,c,t)
    blank=_WL_BG['blank_fog']
    # Original half-transparent tile strips can inherit opaque black alpha.
    # The established color-key clear is cheap, cached, and preserves allocation.
    for ch in range(int(s.cam[0])//320,min((COLS*TILE-1)//320,(int(s.cam[0])+W-1)//320)+1):
        strip=s.chunk(ch)
        if strip.get_colorkey() is None:strip.set_colorkey((0,0,0))
    cache=fog_surface
    try:
        fog_surface=lambda ar:blank
        return _world(s,c,t)
    finally:fog_surface=cache
GameCore.draw_world=_water_world

# ======== p35_v132_fixes.py ========
"""1.3.2: complete bonfire names, directional shots and obvious Vellamo entrance."""
VERSION='1.3.2'
for b,nm,en in [
 ('b9','Pohjolan nuotio','Pohjola Bonfire'),('b10','Aallon ranta','Shimmering Shore'),
 ('b11','Syvänteen nuotio','Depths Bonfire'),('b12','Temppelin nuotio','Cathedral Bonfire'),
 ('b13','Vapauden ranta','Shore of Freedom'),
 ('vel_entrance','VELLAMON VALTAKUNTA  →','VELLAMO\'S REALM  →'),
 ('p_vellamo','Jatka Vellamon valtakuntaan','Enter Vellamo\'s realm'),
 ('vel_sign','Vellamon portti on heti nuotion oikealla puolella. Mene portille ja paina ylös.','\'Vellamo\'s gate is right by the bonfire. Go to it and press up.\'')]:_t(b,nm,en)
# Explicit entries are also safe for code that reads BF_KEYS directly.
BF_KEYS.update({('b%d'%i):'bf_b%d'%i for i in range(9,14)})
_VELLAMO_GATE=(454*TILE+8,320)
def _gate_unlocked(s):return s.save and s.save.get('vellamo_unlocked') and not s.save.get('vellamo_visited')
_interact132=GameCore.interact
def interact132(s,p,near):
 if near==('vellamo_gate','gate'):
  if _gate_unlocked(s):sfx('confirm',.7);s.enter_vellamo()
  return
 return _interact132(s,p,near)
GameCore.interact=interact132
_items132=GameCore.interactables
def items132(s):
 out=_items132(s)
 if _gate_unlocked(s):out.append((_VELLAMO_GATE[0],_VELLAMO_GATE[1],'vellamo_gate','gate'))
 return out
GameCore.interactables=items132
_world132=GameCore.draw_world
def world132(s,c,t):
 _world132(s,c,t)
 if not _gate_unlocked(s) or s.area!='pohjola':return
 x=int(_VELLAMO_GATE[0]-s.cam[0]);y=int(_VELLAMO_GATE[1]-s.cam[1])
 # Tiny cached primitives only: a bright, readable portal and anchored sign.
 pygame.draw.rect(c,(35,116,133),(x-8,y-43,16,43),1)
 pygame.draw.rect(c,(67,182,184),(x-5,y-40,10,37),1)
 for k in range(3):pygame.draw.circle(c,(124,224,205),(x-6+k*6,y-35-((t//5+k*7)%25)),1)
 s.text(tr('vel_entrance'),x,y-51,(164,234,205),s.tiny)
GameCore.draw_world=world132
_dead132=GameCore.on_boss_dead
def dead132(s,b):
 _dead132(s,b)
 if b.key=='louhi':s.msg(tr('vel_sign'),(160,240,210))
GameCore.on_boss_dead=dead132
_area132=GameCore.update_area
def area132(s):
 _area132(s)
 if s.frames==3 and _gate_unlocked(s) and s.area=='pohjola':s.msg(tr('vel_sign'),(160,240,210))
GameCore.update_area=area132
# Direction comes from the same current pad state as all other actions.
# Pure vector changes only: no event reads, timers, or buffering.
def aim_up132(s,z,speed):
 horizontal=(1 if s.pad.held('right') else -1 if s.pad.held('left') else 0)
 if horizontal:z.vx=horizontal*speed/math.sqrt(2);z.vy=-speed/math.sqrt(2)
 else:z.vx=0.0;z.vy=-speed
# Wrap only projectile construction helpers. Directional velocity is a multiplier of
# the existing shot speed; all damage, focus, charge and projectile life stay as-is.
_arrow132=Player.fire_arrow
def fire_arrow132(s,dmg,speed,vy,charge,poise=8,n=1,spread=0.0):
 before=len(s.g.projs);_arrow132(s,dmg,speed,vy,charge,poise,n,spread)
 if s.pad.held('up'):
  for z in s.g.projs[before:]:aim_up132(s,z,speed)
Player.fire_arrow=fire_arrow132
_spell132=Player.fire_spell
def fire_spell132(s,a):
 before=len(s.g.projs);_spell132(s,a)
 if s.pad.held('up'):
  for z in s.g.projs[before:]:aim_up132(s,z,math.hypot(z.vx,z.vy))
Player.fire_spell=fire_spell132
