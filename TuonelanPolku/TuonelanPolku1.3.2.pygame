    ARENAS[_key]=dict(x0=_x0,x1=_x1,y0=2,ground=20,door_in=(_x0,2,20),door_out=None,track=_tr)
    DYN['d_'+_key+'_in']=dict(tiles=_col(_x0,2,20),code=SOLID,active=False,key='vellamo_fog')
DYN['d_vellamo']=dict(tiles=_col(486,2,20),code=SOLID,active=True,key='vellamo_fog')
