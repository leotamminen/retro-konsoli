# ======== p4_phys.py ========

# ---------------- world runtime + shared physics ----------------
class World:
    def __init__(s):
        s.g = GRID
        s.state = {k: d["active"] for k, d in DYN.items()}
        s.dmap = {}
        s._rebuild()
    def _rebuild(s):
        s.dmap = {}
        for k, d in DYN.items():
            if s.state[k]:
                for t in d["tiles"]: s.dmap[t] = d["code"]
            elif d["code"] == SOLID:
                for t in d["tiles"]: s.dmap[t] = AIR       # an opened gate also clears the grid tile under it
    def opened(s, k):
        d = DYN[k]
        return (not s.state[k]) if d["code"] == SOLID else s.state[k]
    def set_open(s, k, opened):
        d = DYN[k]
        s.state[k] = (not opened) if d["code"] == SOLID else bool(opened)
        s._rebuild()
    def tile(s, tx, ty):
        if tx < 0 or tx >= COLS or ty >= ROWS: return SOLID
        if ty < 0: return SOLID if (tx, ty) not in s.dmap else AIR
        v = s.dmap.get((tx, ty))
        return s.g[ty][tx] if v is None else v
    def solid(s, tx, ty): return s.tile(tx, ty) == SOLID
    def is_ladder(s, tx, ty): return s.tile(tx, ty) == LADDER
    def ladder_top(s, tx, ty): return s.tile(tx, ty) == LADDER and s.tile(tx, ty - 1) != LADDER
    def surface(s, tx, ty, climbing=False):
        t = s.tile(tx, ty)
        if t == SOLID or t == PLAT: return True
        if t == LADDER and s.tile(tx, ty - 1) != LADDER and not climbing: return True
        return False

class Body:
    def __init__(s, x=0.0, y=0.0, w=PW_, h=PH_):
        s.x, s.y, s.w, s.h = float(x), float(y), w, h
        s.vx = s.vy = 0.0
        s.on_ground = False; s.wall = 0; s.coyote = 0; s.jbuf = 0; s.climb = False
        s.dj_used = False; s.drop_t = 0; s.run_speed = RUN; s.grav = GRAV; s.head = False

def move_body(wd, b, ghost_ok=False):
    """Axis-separated AABB move. b.x = centre, b.y = feet. Handles one-way platforms and ladder tops."""
    hw = b.w / 2.0
    b.wall = 0
    # --- horizontal ---
    nx = b.x + b.vx
    top = int((b.y - b.h) // TILE); bot = int((b.y - 0.01) // TILE)
    if b.vx > 0:
        tx = int((nx + hw) // TILE)
        for ty in range(top, bot + 1):
            if wd.solid(tx, ty): nx = tx * TILE - hw - 0.001; b.vx = 0; b.wall = 1; break
    elif b.vx < 0:
        tx = int((nx - hw) // TILE)
        for ty in range(top, bot + 1):
            if wd.solid(tx, ty): nx = (tx + 1) * TILE + hw + 0.001; b.vx = 0; b.wall = -1; break
    b.x = nx
    # --- vertical ---
    prev = b.y
    ny = b.y + b.vy
    l = int((b.x - hw + 0.5) // TILE); r = int((b.x + hw - 0.5) // TILE)
    b.on_ground = False; b.head = False
    if b.vy >= 0:
        row = int(ny // TILE)
        for ty in (row,):
            for tx in range(l, r + 1):
                t = wd.tile(tx, ty)
                if t == SOLID or ((t == PLAT or (t == LADDER and wd.tile(tx, ty - 1) != LADDER and not b.climb)) and b.drop_t <= 0 and prev <= ty * TILE + 0.001):
                    if t == SOLID and prev > ty * TILE + 0.001 and ny - ty * TILE > 8:
                        continue                      # already well inside (should not happen)
                    ny = ty * TILE; b.vy = 0; b.on_ground = True; break
            if b.on_ground: break
    else:
        row = int((ny - b.h) // TILE)
        for tx in range(l, r + 1):
            if wd.solid(tx, row):
                ny = (row + 1) * TILE + b.h + 0.001; b.vy = 0; b.head = True; break
    b.y = ny
    if b.drop_t > 0: b.drop_t -= 1
    return b.on_ground

def hazard_at(wd, b):
    """Thorn or water touching the feet area."""
    hw = b.w / 2.0
    for tx in range(int((b.x - hw + 1) // TILE), int((b.x + hw - 1) // TILE) + 1):
        for ty in (int((b.y - 3) // TILE), int((b.y - b.h * 0.5) // TILE)):
            if wd.tile(tx, ty) in (THORN, WATER): return True
    return False

def ladder_overlap(wd, b, below=False):
    tx = int(b.x // TILE)
    if below: return wd.is_ladder(tx, int((b.y + 1) // TILE)) and wd.ladder_top(tx, int((b.y + 1) // TILE))
    return wd.is_ladder(tx, int((b.y - b.h * 0.4) // TILE)) or wd.is_ladder(tx, int((b.y - 2) // TILE))

def walk_step(wd, b, ix, iy, jp, jh, dj_ok, drop=False, accel_g=0.55, accel_a=0.28):
    """One frame of free movement shared by the game and the traversal tester.
    ix/iy -1..1, jp = jump pressed this frame, jh = jump held. Returns dict of events."""
    ev = {}
    # ladders
    if not b.climb:
        if iy < -0.5 and ladder_overlap(wd, b) and not jp:
            b.climb = True; b.vx = b.vy = 0; b.x = int(b.x // TILE) * TILE + TILE / 2
        elif iy > 0.5 and b.on_ground and ladder_overlap(wd, b, below=True):
            b.climb = True; b.vx = b.vy = 0; b.x = int(b.x // TILE) * TILE + TILE / 2; b.y += 2
    if b.climb:
        if jp:
            b.climb = False; b.vy = JUMP_V * 0.7; b.vx = ix * 1.2; b.coyote = 0; ev["jump"] = True
            move_body(wd, b); return ev
        b.vx = 0; b.vy = iy * 1.15; b.dj_used = False
        tx = int(b.x // TILE)
        move_body(wd, b)
        if b.on_ground and iy > 0: b.climb = False
        elif not ladder_overlap(wd, b):
            # climbed over the top?
            if iy < 0 and wd.is_ladder(tx, int((b.y + 1) // TILE)):
                b.y = (int((b.y + 1) // TILE)) * TILE; b.climb = False; b.vy = 0; b.on_ground = True
            else:
                b.climb = False
        return ev
    sp = b.run_speed
    tgt = ix * sp
    a = accel_g if b.on_ground else accel_a
    if ix == 0 and b.on_ground: a = 0.7
    if b.vx < tgt: b.vx = min(tgt, b.vx + a)
    elif b.vx > tgt: b.vx = max(tgt, b.vx - a)
    if jp: b.jbuf = 6
    elif b.jbuf > 0: b.jbuf -= 1
    if b.on_ground: b.coyote = 6; b.dj_used = False
    elif b.coyote > 0: b.coyote -= 1
    if drop and b.on_ground and wd.tile(int(b.x // TILE), int((b.y + 1) // TILE)) in (PLAT, LADDER):
        b.drop_t = 10; b.y += 1.5; b.on_ground = False; b.jbuf = 0; b.coyote = 0
    elif b.jbuf > 0 and b.coyote > 0:
        b.vy = JUMP_V; b.coyote = 0; b.jbuf = 0; b.on_ground = False; ev["jump"] = True
    elif jp and dj_ok and not b.on_ground and b.coyote == 0 and not b.dj_used:
        b.vy = DJ_V; b.dj_used = True; b.jbuf = 0; ev["djump"] = True
    if not jh and b.vy < -2.4: b.vy = -2.4
    b.vy = min(MAX_FALL, b.vy + b.grav)
    was = b.on_ground
    move_body(wd, b)
    if b.on_ground and not was: ev["land"] = True
    return ev

# ======== p5_art.py ========

# ---------------- procedural pixel art ----------------
def mk(w, h): return pygame.Surface((w, h), pygame.SRCALPHA)
def _ln(s, c, a, b, w=1): pygame.draw.line(s, c, a, b, w)
def _rc(s, c, r): pygame.draw.rect(s, c, r)
def _el(s, c, r): pygame.draw.ellipse(s, c, r)
def _poly(s, c, pts): pygame.draw.polygon(s, c, pts)
def _mul(c, f): return (max(0, min(255, int(c[0] * f))), max(0, min(255, int(c[1] * f))), max(0, min(255, int(c[2] * f))))
OUT = (14, 10, 18)

def _outline(s, col=OUT):
    """Dark 1px outline around the opaque pixels (what makes small sprites readable)."""
    m = pygame.mask.from_surface(s, 40)
    o = mk(s.get_width() + 2, s.get_height() + 2)
    for dx, dy in ((0, 1), (2, 1), (1, 0), (1, 2)):
        o.blit(m.to_surface(setcolor=col, unsetcolor=(0, 0, 0, 0)), (dx, dy))
    o.blit(s, (1, 1))
    return o

# ---- humanoid rig (players, peikko, hukkunut, haamu ...) ----
PCLASS_PAL = {
    "warrior": dict(skin=(226, 182, 140), hair=(110, 70, 40), tunic=(150, 50, 50), trim=(210, 170, 70), cape=(110, 36, 44), boots=(70, 50, 40), metal=(190, 195, 205)),
    "sage":    dict(skin=(226, 182, 140), hair=(200, 200, 210), tunic=(60, 120, 130), trim=(230, 210, 130), cape=(40, 90, 110), boots=(60, 60, 70), metal=(150, 220, 200)),
    "hunter":  dict(skin=(214, 170, 130), hair=(60, 40, 30), tunic=(70, 100, 60), trim=(190, 150, 80), cape=(40, 70, 50), boots=(70, 55, 40), metal=(180, 180, 170)),
}
P2_TINT = {"warrior": (60, 110, 190), "sage": (170, 90, 190), "hunter": (200, 130, 50)}

def human(p, W=26, H=28):
    s = mk(W, H); c = p["pal"]; ox = 13; base = H - 2
    ph = p.get("phase", 0.0); lean = p.get("lean", 0); cr = p.get("crouch", 0)
    hip = (ox, base - 8 - cr); sh = (ox + lean, hip[1] - 7)
    cape = c.get("cape")
    if cape:
        fl = p.get("flow", 2)
        _poly(s, cape, [(sh[0] - 2, sh[1]), (sh[0] + 1, sh[1] + 1), (hip[0] - 3 - fl, hip[1] + 5), (hip[0] - 5 - fl, hip[1] + 2)])
    legs = []
    for k in (0, 1):
        a = ph + k * 3.14159
        fx = ox - 1 + 2 * k + int(round(math.sin(a) * p.get("stride", 4)))
        fy = base - int(max(0.0, math.cos(a)) * p.get("lift", 3))
        if p.get("air"): fx = ox - 2 + 4 * k + (2 if k else -1); fy = base - 4 - k * 2
        legs.append((fx, fy, k))
    for fx, fy, k in sorted(legs, key=lambda t: -t[2]):
        _ln(s, _mul(c["boots"], 0.8 if k == 0 else 1.0), (ox - 1 + 2 * k, hip[1]), (fx, fy), 2)
        _rc(s, c["boots"], (fx - 1 + (1 if k else 0), fy, 3, 1))
    # off arm
    def arm(angle, length=6, col=None, behind=False):
        a = math.radians(angle); hx = sh[0] + math.cos(a) * length; hy = sh[1] + 1 + math.sin(a) * length
        _ln(s, col or c["skin"], (sh[0], sh[1] + 1), (hx, hy), 2)
        return (int(round(hx)), int(round(hy)))
    offh = None
    if p.get("off_a") is not None: offh = arm(p["off_a"], 5, _mul(c["tunic"], 0.8))
    # torso
    _rc(s, c["tunic"], (ox - 3 + lean // 2, sh[1] - 1, 7, hip[1] - sh[1] + 3))
    _rc(s, c["trim"], (ox - 3 + lean // 2, hip[1] + 1, 7, 1))
    _rc(s, _mul(c["tunic"], 1.25), (ox + lean // 2, sh[1], 3, 2))
    # head
    hx, hy = ox + lean, sh[1] - 4
    pygame.draw.circle(s, c["skin"], (hx, hy), 3)
    if p.get("hood"):
        pygame.draw.circle(s, c["cape"], (hx, hy - 1), 4)
        _rc(s, c["skin"], (hx + 1, hy - 1, 3, 3))
    else:
        _rc(s, c["hair"], (hx - 3, hy - 3, 6, 2)); _rc(s, c["hair"], (hx - 3, hy - 1, 2, 3))
    _rc(s, (20, 14, 20), (hx + 1, hy, 1, 1))
    if c.get("helm"): _rc(s, c["metal"], (hx - 3, hy - 3, 7, 2))
    # shield / weapon arm
    fh = arm(p.get("arm_a", 40), 6)
    w = p.get("wpn"); wa = math.radians(p.get("wpn_a", 0))
    if w == "sword":
        ex, ey = fh[0] + math.cos(wa) * 9, fh[1] + math.sin(wa) * 9
        _ln(s, c["metal"], fh, (ex, ey), 2); _ln(s, (255, 255, 255), fh, (ex, ey), 1); _rc(s, c["trim"], (fh[0] - 1, fh[1] - 1, 3, 3))
    elif w == "dagger":
        ex, ey = fh[0] + math.cos(wa) * 5, fh[1] + math.sin(wa) * 5
        _ln(s, c["metal"], fh, (ex, ey), 2)
    elif w == "staff":
        ex, ey = fh[0] + math.cos(wa) * 10, fh[1] + math.sin(wa) * 10; bx, by = fh[0] - math.cos(wa) * 8, fh[1] - math.sin(wa) * 8
        _ln(s, (120, 90, 60), (bx, by), (ex, ey), 1)
        pygame.draw.circle(s, p.get("glow", c["metal"]), (int(ex), int(ey)), 2)
    elif w == "bow":
        pygame.draw.arc(s, (130, 90, 50), (fh[0] - 3, fh[1] - 8, 7, 16), -1.57, 1.57, 2) if not p.get("draw") else None
        if p.get("draw"):
            _ln(s, (130, 90, 50), (fh[0] + 2, fh[1] - 7), (fh[0] + 4, fh[1]), 2); _ln(s, (130, 90, 50), (fh[0] + 4, fh[1]), (fh[0] + 2, fh[1] + 7), 2)
            _ln(s, (220, 220, 200), (fh[0] + 2, fh[1] - 7), (fh[0] - 3, fh[1]), 1); _ln(s, (220, 220, 200), (fh[0] - 3, fh[1]), (fh[0] + 2, fh[1] + 7), 1)
            _ln(s, (230, 230, 210), (fh[0] - 3, fh[1]), (fh[0] + 7, fh[1]), 1)
        else:
            _ln(s, (220, 220, 200), (fh[0], fh[1] - 7), (fh[0], fh[1] + 7), 1)
    elif w == "club":
        ex, ey = fh[0] + math.cos(wa) * 9, fh[1] + math.sin(wa) * 9
        _ln(s, (110, 80, 50), fh, (ex, ey), 3); pygame.draw.circle(s, (80, 56, 36), (int(ex), int(ey)), 3)
    elif w == "spear":
        ex, ey = fh[0] + math.cos(wa) * 13, fh[1] + math.sin(wa) * 13; bx, by = fh[0] - math.cos(wa) * 5, fh[1] - math.sin(wa) * 5
        _ln(s, (150, 120, 90), (bx, by), (ex, ey), 1); pygame.draw.circle(s, c["metal"], (int(ex), int(ey)), 2)
    if p.get("shield"):
        sx, sy = (offh or (sh[0] + 4, sh[1] + 4))
        sa = p["shield"]    # 1 = held at side, 2 = raised guard
        if sa == 2: sx, sy = sh[0] + 5, sh[1] + 4
        pygame.draw.circle(s, _mul(c["trim"], 0.8), (sx, sy), 5 if sa == 2 else 4)
        pygame.draw.circle(s, c["cape"], (sx, sy), 3); _rc(s, c["metal"], (sx, sy, 1, 1))
    if p.get("flask"):
        _rc(s, (230, 120, 40), (hx + 2, hy - 1, 3, 4)); _rc(s, (255, 220, 120), (hx + 3, hy, 1, 2))
    return s

def _crop_outline(s):
    return _outline(s)

_PSPR = {}
def player_frame(cls, anim, t, flash=False, tint=None):
    key = (cls, anim, t, flash, tint)
    f = _PSPR.get(key)
    if f: return f
    pal = dict(PCLASS_PAL[cls])
    if tint: pal["trim"] = tint
    wpn = {"warrior": "sword", "sage": "staff", "hunter": "dagger"}[cls]
    p = dict(pal=pal, wpn=wpn, arm_a=50, wpn_a=-50, off_a=None, shield=1 if cls == "warrior" else 0, hood=(cls != "warrior"))
    if cls == "warrior": pal["helm"] = True
    if cls == "sage": p["glow"] = (170, 255, 230)
    if anim == "idle":
        p.update(phase=0.0, stride=0, lift=0, lean=0, flow=1 + (t % 2), crouch=1 if t % 2 else 0, wpn_a=-60 + (t % 2) * 6)
    elif anim == "run":
        p.update(phase=t * 1.57, stride=4, lift=3, lean=1, flow=3 + (t % 2), wpn_a=-40, arm_a=30 + (t % 2) * 10)
    elif anim in ("jump", "fall"):
        p.update(air=True, flow=4 if anim == "fall" else 1, wpn_a=-70 if anim == "jump" else -20, arm_a=-30 if anim == "jump" else 60, lean=0)
    elif anim == "roll":
        base = human(dict(pal=pal, air=True, crouch=4, lean=2, wpn=None, arm_a=100, flow=0, hood=p["hood"]))
        ang = -90 * t if t < 4 else 0
        f = pygame.transform.rotate(base, ang)
        out = mk(26, 28); out.blit(f, f.get_rect(center=(13, 17)))
        f = _outline(out)
        _PSPR[key] = f = _finish(f, flash); return f
    elif anim in ("atk1", "atk2", "atk3", "heavy", "stab", "slash"):
        ph = t   # 0 windup, 1 active, 2 recover
        if anim == "heavy":
            p.update(lean=[-2, 3, 2][ph], arm_a=[-100, 55, 40][ph], wpn_a=[-120, 40, 70][ph], crouch=[0, 2, 2][ph], flow=[0, 5, 3][ph], stride=2, phase=0.5)
        elif anim == "atk2":
            p.update(lean=[-1, 3, 2][ph], arm_a=[-20, 10, 20][ph], wpn_a=[-170, 15, 30][ph], crouch=[1, 1, 1][ph], flow=[0, 4, 2][ph], stride=2, phase=0.7)
        else:
            p.update(lean=[-2, 3, 2][ph], arm_a=[-70, 5, 25][ph], wpn_a=[-120 if anim != "atk3" else 90, 5 if anim != "atk3" else -5, 40][ph], crouch=[0, 1, 1][ph], flow=[0, 4, 2][ph], stride=2, phase=0.7)
        if cls == "sage": p["wpn_a"] = [-90, -5, 20][ph]
        if cls == "hunter": p["lean"] += 1
    elif anim == "guard":
        p.update(shield=2, arm_a=0, wpn_a=-30, lean=-1, crouch=1, phase=0.5, stride=2, off_a=10)
    elif anim == "bash":
        p.update(shield=2, arm_a=-20, lean=[2, 4][min(t, 1)], crouch=1, wpn_a=-80, off_a=20)
    elif anim == "cast":
        p.update(arm_a=-80 if t == 0 else -10, wpn_a=-60 if t == 0 else 0, lean=-1 if t == 0 else 2, glow=(200, 255, 240), off_a=-70 if t == 0 else -20)
    elif anim == "kantele":
        p.update(arm_a=-20 + (t % 2) * 25, off_a=10, lean=0, crouch=1, wpn=None, glow=(255, 240, 160))
    elif anim == "shoot":
        p.update(wpn="bow", draw=(t == 0), arm_a=-3, off_a=-3, lean=-1 if t == 0 else 1, crouch=1)
    elif anim == "hurt":
        p.update(lean=-3, arm_a=100, wpn_a=60, flow=5, air=True, off_a=80)
    elif anim == "drink":
        p.update(flask=True, arm_a=-100, lean=-1, crouch=1 + (t % 2), wpn=None, off_a=40)
    elif anim == "climb":
        p.update(phase=t * 3.14, stride=2, lift=2, arm_a=-100 if t % 2 else -60, off_a=-60 if t % 2 else -100, wpn=None, shield=0, flow=0)
    elif anim == "down":
        base = human(dict(pal=pal, wpn=None, crouch=0, hood=p["hood"], arm_a=80))
        f = pygame.transform.rotate(base, 90)
        out = mk(26, 28); out.blit(f, f.get_rect(midbottom=(13, 27)))
        _PSPR[key] = f = _finish(_outline(out), flash); return f
    f = _finish(_outline(human(p)), flash)
    _PSPR[key] = f
    return f

def _finish(f, flash):
    if flash:
        f = f.copy(); f.fill((120, 120, 120, 0), special_flags=pygame.BLEND_RGB_ADD)
    return f

# ---- enemy painters ----  each returns a surface; feet at bottom-centre minus 1
def _en_human(kind, anim, t):
    if kind == "peikko":
        pal = dict(skin=(108, 140, 80), hair=(60, 50, 30), tunic=(100, 70, 44), trim=(70, 50, 30), cape=None, boots=(60, 44, 30), metal=(150, 150, 140))
        p = dict(pal=pal, wpn="club", arm_a=30, wpn_a=-50, lean=2, crouch=1)
    elif kind == "jousi":
        pal = dict(skin=(140, 120, 80), hair=(150, 40, 40), tunic=(120, 50, 40), trim=(200, 150, 60), cape=(80, 30, 30), boots=(50, 40, 30), metal=(200, 200, 190))
        p = dict(pal=pal, wpn="bow", arm_a=-3, wpn_a=0, lean=0, hood=True)
    elif kind == "hukkunut":
        pal = dict(skin=(120, 150, 150), hair=(40, 70, 60), tunic=(70, 100, 90), trim=(50, 80, 70), cape=(40, 70, 60), boots=(50, 70, 70), metal=(150, 170, 160))
        p = dict(pal=pal, wpn="club", arm_a=50, wpn_a=60, lean=3, crouch=0)
    elif kind == "haamu":
        pal = dict(skin=(190, 215, 230), hair=(190, 215, 230), tunic=(70, 80, 110), trim=(120, 180, 220), cape=(40, 50, 90), boots=(60, 70, 100), metal=(170, 210, 240), helm=True)
        p = dict(pal=pal, wpn="spear", arm_a=0, wpn_a=-20, lean=0, hood=False, shield=1)
    else:
        raise KeyError(kind)
    if anim == "walk": p.update(phase=t * 1.57, stride=3, lift=2)
    elif anim == "idle": p.update(phase=0, stride=0, lift=0, crouch=p.get("crouch", 0) + (t % 2))
    elif anim == "windup":
        if kind == "haamu": p.update(arm_a=-5, wpn_a=-5, lean=-3, phase=0.5, stride=2)
        else: p.update(arm_a=-100, wpn_a=-130, lean=-3, phase=0.5, stride=2)
    elif anim == "attack":
        if kind == "haamu": p.update(arm_a=0, wpn_a=0, lean=5, phase=0.5, stride=4)
        else: p.update(arm_a=60, wpn_a=40, lean=5, crouch=2, phase=0.5, stride=3)
    elif anim == "hurt": p.update(lean=-3, arm_a=100, wpn_a=70, air=True)
    elif anim == "die": p.update(lean=-4, arm_a=110, wpn_a=90, air=True, crouch=2)
    p.setdefault("flow", 2)
    return human(p, 30, 32)

def _en_wolf(anim, t):
    s = mk(34, 20); fur = (110, 112, 125); dk = (70, 72, 85)
    cr = {"windup": 3, "attack": -1}.get(anim, 0)
    by = 7 + cr
    _el(s, fur, (6, by, 20, 9)); _poly(s, fur, [(24, by + 1), (32, by - 1 + (0 if anim != "attack" else -3)), (30, by + 6), (24, by + 8)])
    if anim == "attack": _ln(s, fur, (6, by + 3), (0, by - 3), 3)
    else: _ln(s, fur, (6, by + 3), (1, by + 5 + (t % 2)), 3)
    for k, lx in enumerate((9, 12, 20, 23)):
        ph = (t + k) % 4 if anim == "walk" else 0
        if anim == "attack": _ln(s, dk, (lx, by + 8), (lx - 3 + 6 * (k % 2), by + 9), 2)
        else: _ln(s, dk if k % 2 == 0 else fur, (lx, by + 7), (lx + (ph - 1.5), 18 - (1 if ph == 0 else 0)), 2)
    _poly(s, fur, [(29, by - 2), (31, by - 5), (32, by - 1)]); _rc(s, (250, 220, 90) if anim in ("windup", "attack") else (240, 240, 120), (30, by + 1, 1, 1))
    if anim in ("windup", "attack"): _rc(s, (240, 240, 240), (31, by + 4, 3, 1))
    return s

def _en_crow(anim, t, swan=False):
    s = mk(28, 20) if not swan else mk(34, 24)
    col = (30, 28, 42) if not swan else (40, 36, 60)
    up = (t // 4) % 2 == 0
    if anim in ("windup",): up = True
    cx, cy = (14, 10) if not swan else (16, 14)
    _el(s, col, (cx - 5, cy - 3, 11, 7))
    if up: _poly(s, col, [(cx - 2, cy - 2), (cx - 9, cy - 9), (cx + 2, cy - 3)]); _poly(s, _mul(col, 1.5), [(cx - 1, cy - 2), (cx - 4, cy - 8), (cx + 3, cy - 3)])
    else: _poly(s, col, [(cx - 2, cy), (cx - 10, cy + 4), (cx + 2, cy + 2)])
    _poly(s, col, [(cx - 5, cy), (cx - 11, cy + 2), (cx - 5, cy + 3)])
    if not swan:
        _poly(s, (200, 170, 60), [(cx + 5, cy - 1), (cx + 9, cy), (cx + 5, cy + 1)]); pygame.draw.circle(s, col, (cx + 4, cy - 2), 2)
        _rc(s, (255, 90, 80) if anim in ("windup", "attack") else (230, 230, 230), (cx + 4, cy - 3, 1, 1))
    else:
        _ln(s, (60, 54, 90), (cx + 4, cy - 2), (cx + 9, cy - 8), 2); pygame.draw.circle(s, (60, 54, 90), (cx + 10, cy - 9), 2)
        _poly(s, (200, 80, 60), [(cx + 12, cy - 9), (cx + 16, cy - 8), (cx + 12, cy - 7)]); _rc(s, (160, 240, 255), (cx + 10, cy - 10, 1, 1))
    return s

def _en_wisp(anim, t):
    s = mk(20, 20); r = 4 + (t // 5) % 2
    hot = anim in ("windup", "attack")
    c1 = (255, 190, 90) if hot else (120, 255, 200); c2 = (255, 90, 40) if hot else (40, 200, 140)
    _poly(s, _mul(c2, 0.7), [(7, 12), (13, 12), (10, 19)]); pygame.draw.circle(s, c2, (10, 10), r + 2); pygame.draw.circle(s, c1, (10, 10), r)
    _rc(s, (255, 255, 255), (9, 9, 2, 2)); _rc(s, (10, 40, 30), (8, 10, 1, 1)); _rc(s, (10, 40, 30), (12, 10, 1, 1))
    return s

def _en_nakki(anim, t):
    s = mk(24, 22); c = (60, 140, 100); dk = (30, 90, 70)
    leap = anim in ("attack",)
    cr = 2 if anim == "windup" else 0
    _el(s, c, (4, 6 + cr, 16, 12)); _poly(s, dk, [(8, 6 + cr), (11, 1 + cr), (14, 6 + cr)]); _poly(s, dk, [(3, 14), (0, 10), (6, 11)])
    _rc(s, (255, 240, 120), (14, 9 + cr, 2, 2)); _rc(s, (255, 240, 240), (15, 14 + cr, 4, 1)) if anim in ("windup", "attack") else None
    _ln(s, dk, (8, 17), (6, 20 + (0 if leap else t % 2)), 2); _ln(s, dk, (15, 17), (17, 20), 2)
    return s

def _en_henki(anim, t):
    s = mk(28, 34); cx = 14; fl = (t // 6) % 2
    robe = (50, 56, 100); lt = (150, 230, 255)
    _poly(s, robe, [(cx - 6, 10), (cx + 6, 10), (cx + 9, 30 + fl), (cx + 4, 27), (cx, 31), (cx - 4, 27), (cx - 9, 30 + fl)])
    pygame.draw.circle(s, (30, 34, 70), (cx, 8), 6); pygame.draw.circle(s, (210, 225, 235), (cx, 9), 4)
    hot = anim in ("windup", "attack")
    _rc(s, (255, 90, 90) if hot else (20, 20, 40), (cx - 2, 8, 1, 2)); _rc(s, (255, 90, 90) if hot else (20, 20, 40), (cx + 1, 8, 1, 2))
    _ln(s, (60, 66, 110), (cx + 5, 16), (cx + 10, 14 - (4 if hot else 0)), 2)
    pygame.draw.circle(s, (255, 160, 90) if hot else lt, (cx + 11, 12 - (4 if hot else 0)), 3)
    return s

_ESPR = {}
EN_SIZE = {"peikko": (30, 32), "jousi": (30, 32), "hukkunut": (30, 32), "haamu": (30, 32), "susi": (34, 20),
           "korppi": (28, 20), "joutsen": (34, 24), "virvatuli": (20, 20), "nakki": (24, 22), "henki": (28, 34)}
def enemy_frame(kind, anim, t, flip=False, flash=False):
    key = (kind, anim, t, flip, flash)
    f = _ESPR.get(key)
    if f: return f
    if kind in ("peikko", "jousi", "hukkunut", "haamu"): base = _en_human(kind, anim, t)
    elif kind == "susi": base = _en_wolf(anim, t)
    elif kind == "korppi": base = _en_crow(anim, t)
    elif kind == "joutsen": base = _en_crow(anim, t, True)
    elif kind == "virvatuli": base = _en_wisp(anim, t)
    elif kind == "nakki": base = _en_nakki(anim, t)
    elif kind == "henki": base = _en_henki(anim, t)
    else: base = mk(16, 16)
    f = base if kind == "virvatuli" else _outline(base)
    if flip: f = pygame.transform.flip(f, True, False)
    f = _finish(f, flash)
    _ESPR[key] = f
    return f

# ======== p6_env.py ========

# ---------------- environment art: tiles, parallax, light ----------------
PAL={
 "forest": dict(sky=((10,20,36),(58,88,82)),lit=(84,62,46),deep=(46,34,30),top=(84,150,66),top2=(48,104,52),stone=(92,94,98),bw=(18,26,26),bwa=190,ambient=(172,186,190),fog=(120,160,150)),
 "swamp": dict(sky=((12,24,22),(70,96,62)),lit=(70,70,46),deep=(38,40,30),top=(112,130,58),top2=(70,96,46),stone=(80,88,78),bw=(16,24,20),bwa=190,ambient=(150,176,148),fog=(130,170,110)),
 "river": dict(sky=((8,6,24),(44,34,84)),lit=(76,76,104),deep=(36,34,58),top=(150,190,220),top2=(110,140,190),stone=(100,100,130),bw=(14,12,30),bwa=150,ambient=(136,136,186),fog=(110,110,190)),
 "pohjola":dict(sky=((5,7,17),(17,12,30)),lit=(57,65,87),deep=(20,25,43),top=(95,113,139),top2=(86,104,131),stone=(64,76,102),bw=(9,11,23),bwa=150,ambient=(33,33,50),fog=(61,68,104))}
def _h(x, y, s=0):
    n = (x * 374761393 + y * 668265263 + s * 1274126177) & 0xFFFFFFFF
    n = (n ^ (n >> 13)) * 1274126177 & 0xFFFFFFFF
    return (n ^ (n >> 16)) & 0xFFFF

_TILE_EXPOSED = None
def _exposed_table():
    """sky exposure: air tile with no solid tile above it in its column"""
    global _TILE_EXPOSED
    if _TILE_EXPOSED is None:
        ex = [[False] * COLS for _ in range(ROWS)]
        for x in range(COLS):
            for y in range(ROWS):
                if GRID[y][x] == SOLID: break
                ex[y][x] = True
        _TILE_EXPOSED = ex
    return _TILE_EXPOSED

def render_chunk(cx, wd):
    """Static tiles for a 20-column chunk -> SRCALPHA surface (full world height)."""
    x0 = cx * 20; surf = mk(320, ROWS * TILE); ex = _exposed_table()
    G = GRID
    def t(x, y):
        if x < 0 or x >= COLS or y < 0: return SOLID
        if y >= ROWS: return SOLID
        return G[y][x]
    for tx in range(x0, min(COLS, x0 + 20)):
        area = area_at(tx); pal = PAL[area]; px = (tx - x0) * TILE
        for ty in range(ROWS):
            v = G[ty][tx]; py = ty * TILE; hh = _h(tx, ty)
            if v == SOLID:
                up, dn, lf, rt = t(tx, ty - 1), t(tx, ty + 1), t(tx - 1, ty), t(tx + 1, ty)
                exposed = not (up == SOLID and dn == SOLID and lf == SOLID and rt == SOLID)
                base = pal["lit"] if exposed else pal["deep"]
                var = 0.9 + (hh % 7) * 0.03
                _rc(surf, _mul(base, var), (px, py, TILE, TILE))
                for k in range(5):      # speckles
                    hk = _h(tx, ty, k + 1)
                    c = _mul(base, 1.35 if hk & 1 else 0.7)
                    _rc(surf, c, (px + (hk >> 1) % 14, py + (hk >> 5) % 14, 1 + (hk >> 9) % 2, 1))
                if area == "river" or (hh % 11 == 0):      # stone blocks
                    _ln(surf, _mul(base, 0.6), (px, py + 7 + hh % 3), (px + 15, py + 7 + hh % 3))
                    _ln(surf, _mul(base, 0.6), (px + 5 + hh % 6, py), (px + 5 + hh % 6, py + 7))
                if up != SOLID:           # lit top lip
                    _rc(surf, pal["top2"], (px, py, TILE, 4)); _rc(surf, pal["top"], (px, py, TILE, 2))
                    for k in range(5):
                        hk = _h(tx, ty, 20 + k)
                        hx = px + (hk % 15); hl = 1 + (hk >> 4) % 3
                        _rc(surf, pal["top"], (hx, py - hl + 1, 1, hl + 1))
                    _rc(surf, _mul(pal["top"], 1.3), (px + (hh % 12), py, 3, 1))
                if dn != SOLID:           # underside shadow and roots / icicles
                    _rc(surf, _mul(base, 0.45), (px, py + 13, TILE, 3))
                    if hh % 3 == 0:
                        _ln(surf, _mul(pal["top2"], 0.6) if area != "river" else (170, 200, 230), (px + 4 + hh % 8, py + 15), (px + 4 + hh % 8, py + 19 + hh % 4))
                if lf != SOLID: _rc(surf, _mul(base, 0.55), (px, py, 1, TILE))
                if rt != SOLID: _rc(surf, _mul(base, 0.55), (px + 15, py, 1, TILE))
            elif v == PLAT:
                _rc(surf, (104, 74, 46), (px, py, TILE, 5)); _rc(surf, (140, 100, 60), (px, py, TILE, 2))
                _rc(surf, (60, 40, 28), (px, py + 4, TILE, 1)); _rc(surf, (60, 40, 28), (px + 7, py, 1, 4))
                if area == "river": _rc(surf, (160, 190, 220), (px, py, TILE, 1))
                if hh % 2 == 0: _rc(surf, (80, 56, 38), (px + 2, py + 5, 2, 5))
            elif v == LADDER:
                _rc(surf, (110, 76, 46), (px + 3, py, 2, TILE)); _rc(surf, (110, 76, 46), (px + 11, py, 2, TILE))
                for k in (1, 5, 9, 13): _rc(surf, (150, 108, 64), (px + 3, py + k, 10, 2))
            elif v == THORN:
                c1, c2 = ((70, 40, 60), (190, 50, 70)) if area != "river" else ((160, 190, 210), (230, 240, 255))
                for k in range(4):
                    bx = px + 1 + k * 4
                    _poly(surf, c1, [(bx, py + 15), (bx + 2, py + 3 + (hh >> k) % 4), (bx + 4, py + 15)])
                    _rc(surf, c2, (bx + 2, py + 3 + (hh >> k) % 4, 1, 3))
            elif v == WATER:
                wc = {"forest": (40,90,120), "swamp": (50,100,70), "river": (50,70,170), "pohjola": (48,72,128), "ranta": (40,133,126), "syvanne": (35,70,128), "katedraali": (81,113,97)}[area]
                surf.fill(wc + (190,), (px, py, TILE, TILE))
                if t(tx, ty - 1) != WATER: surf.fill(_mul(wc, 1.8) + (230,), (px, py, TILE, 2))
            else:
                if not ex[ty][tx]:
                    b = pal["bw"]; a = pal["bwa"]
                    surf.fill(b + (a,), (px, py, TILE, TILE))
                    if (tx + ty) % 2 == 0: surf.fill(_mul(b, 1.5) + (a,), (px + 1, py + 8, 14, 1))
                    surf.fill(_mul(b, 1.5) + (a,), (px + (8 if ty % 2 else 0), py, 1, 8))
    return surf

def dyn_tile_surf(kind, w=1, h=1):
    """Surfaces for dynamic tiles; w,h in tiles."""
    key = ("dyn", kind, w, h)
    f = _DCACHE.get(key)
    if f: return f
    s = mk(w * TILE, h * TILE)
    if kind == "gate":
        for i in range(w * 2):
            _rc(s, (96, 70, 50), (i * 8 + 1, 0, 5, h * TILE)); _rc(s, (60, 44, 34), (i * 8 + 5, 0, 1, h * TILE))
        for j in range(0, h * TILE, 20): _rc(s, (50, 50, 56), (0, j + 4, w * TILE, 3)); _rc(s, (120, 120, 130), (0, j + 4, w * TILE, 1))
        for i in range(0, h * TILE, 5): _rc(s, (150, 150, 160), (w * TILE // 2, i, 1, 1))
    elif kind == "bridge":
        _rc(s, (110, 78, 48), (0, 0, w * TILE, 6)); _rc(s, (150, 106, 62), (0, 0, w * TILE, 2))
        for i in range(0, w * TILE, 8): _rc(s, (60, 40, 28), (i, 0, 1, 6))
        _rc(s, (70, 50, 34), (0, 6, w * TILE, 1))
    elif kind == "wall":
        s.fill((84, 84, 98, 255))
        for k in range(30): s.fill((60, 60, 76, 255), (_h(k, 3) % (w * TILE - 1), _h(k, 4) % (h * TILE - 1), 2, 1))
        _ln(s, (36, 34, 46), (2, 2), (w * TILE // 2, h * TILE // 2)); _ln(s, (36, 34, 46), (w * TILE // 2, h * TILE // 2), (w * TILE - 3, h * TILE // 2 + 6))
        _ln(s, (170, 170, 190), (4, 3), (w * TILE // 2 + 1, h * TILE // 2 - 1))
    elif kind == "lad":
        for j in range(h):
            _rc(s, (110, 76, 46), (3, j * TILE, 2, TILE)); _rc(s, (110, 76, 46), (11, j * TILE, 2, TILE))
            for k in (1, 5, 9, 13): _rc(s, (150, 108, 64), (3, j * TILE + k, 10, 2))
    _DCACHE[key] = s
    return s
_DCACHE = {}

FOG_DOORS={}
def fog_door(w, h, t):
    """Cached white mist wall: cheap animation, no per-frame surface allocation."""
    key=(w,h,t%120)
    if key in FOG_DOORS:return FOG_DOORS[key]
    s = mk(w * TILE, h * TILE)
    for i in range(0, h * TILE, 3):
        a = 120 + int(60 * math.sin(t * 0.07 + i * 0.3))
        x = int(4 * math.sin(t * 0.05 + i * 0.17))
        s.fill((220, 235, 245, a), (w * TILE // 2 - 6 + x, i, 12 + int(4 * math.sin(i * 0.4 + t * 0.09)), 3))
    FOG_DOORS[key]=s
    return s

# ---- parallax ----
_LAYERS = {}
CK = (255, 0, 255)
def _layer(w, h, draw):
    s = pygame.Surface((w, h)); s.fill(CK); s.set_colorkey(CK); draw(s, random.Random(w * 7 + h)); return s
def layers_for(area):
    if area in _LAYERS: return _LAYERS[area]
    sk = PAL[area]["sky"][1]
    if area == "forest":
        def far(s, r):
            pts = [(0, 90)]; x = 0
            while x < 480: x += 24; pts.append((x, 40 + r.randint(0, 40)))
            pts += [(480, 140), (0, 140)]; _poly(s, (36, 62, 66), pts)
        def mid(s, r):
            x = 0
            while x < 480:
                hgt = r.randint(40, 80); w2 = r.randint(14, 22)
                for k in range(4):
                    yy = 140 - hgt + k * hgt // 4; ww = w2 * (k + 1) // 3
                    _poly(s, (22, 44, 48), [(x, yy + hgt // 3), (x + ww // 2 + 3, yy - 8), (x + ww + 6, yy + hgt // 3)])
                _rc(s, (18, 34, 38), (x + w2 // 2 + 1, 140 - 12, 3, 12)); x += r.randint(14, 24)
        def near(s, r):
            x = 10
            while x < 480:
                tw = r.randint(8, 13); _rc(s, (14, 28, 32), (x, 0, tw, 180)); _rc(s, (22, 40, 44), (x, 0, 2, 180))
                by = r.randint(40, 120); _ln(s, (14, 28, 32), (x + tw, by), (x + tw + 20, by - 20), 3); _ln(s, (14, 28, 32), (x, by + 20), (x - 18, by), 3)
                x += r.randint(70, 130)
        L = [(_layer(480, 140, far), 0.12, 30), (_layer(480, 140, mid), 0.3, 50), (_layer(480, 180, near), 0.7, 0)]
    elif area == "swamp":
        def far(s, r):
            pts = [(0, 100)]; x = 0
            while x < 480: x += 20; pts.append((x, 70 + r.randint(0, 30)))
            pts += [(480, 140), (0, 140)]; _poly(s, (44, 70, 56), pts)
            x = 0
            while x < 480:
                th = r.randint(30, 60); _rc(s, (30, 52, 44), (x, 140 - th, 2, th)); _ln(s, (30, 52, 44), (x + 1, 140 - th + 8), (x + 7, 140 - th), 1); _ln(s, (30, 52, 44), (x + 1, 140 - th + 14), (x - 6, 140 - th + 8), 1); x += r.randint(18, 40)
        def mid(s, r):
            x = 0
            while x < 480:
                th = r.randint(60, 100); tw = r.randint(5, 8); _rc(s, (24, 40, 34), (x, 140 - th, tw, th))
                for k in range(3): _ln(s, (24, 40, 34), (x + tw // 2, 140 - th + 6 + k * 8), (x + r.randint(-16, 20), 140 - th - 6 + k * 6), 2)
                for k in range(4):
                    mx = x + r.randint(-14, 14); _ln(s, (36, 62, 46), (mx, 140 - th + 10), (mx + r.randint(-1, 1), 140 - th + 10 + r.randint(10, 26)), 1)
                x += r.randint(40, 80)
        def near(s, r):
            x = 20
            while x < 480:
                tw = r.randint(8, 12); _rc(s, (12, 24, 20), (x, 0, tw, 180))
                for k in range(3): _ln(s, (12, 24, 20), (x + tw // 2, r.randint(20, 100)), (x + r.randint(-30, 30), r.randint(-10, 20)), 3)
                for k in range(3):
                    vx = x + r.randint(-14, 20); _ln(s, (22, 44, 32), (vx, 0), (vx, r.randint(30, 80)), 1)
                x += r.randint(90, 150)
        L = [(_layer(480, 140, far), 0.1, 30), (_layer(480, 140, mid), 0.28, 50), (_layer(480, 180, near), 0.65, 0)]
    elif area == "pohjola":
        def far(s,r):
            for x in range(-15,520,38): _poly(s,(20,24,45),[(x,140),(x+34,r.randint(10,65)),(x+68,140)])
        def mid(s,r):
            for x in range(0,520,27):
                h=r.randint(40,93);_poly(s,(13,17,29),[(x,140),(x+9,140-h),(x+18,140)]);_rc(s,(10,14,25),(x+6,140-h,3,h))
        def near(s,r):
            for x in range(0,520,67):
                _ln(s,(10,13,22),(x,180),(x+8,r.randint(70,108)),3);_ln(s,(10,13,22),(x+8,112),(x+35,r.randint(45,87)),2)
                _ln(s,(10,13,22),(x,35),(x+18,90+r.randint(0,35)),2)
        L=[(_layer(480,140,far),0.09,25),(_layer(480,140,mid),0.25,40),(_layer(480,180,near),0.55,0)]
    else:
        def far(s, r):
            x = 0
            while x < 480:
                th = r.randint(20, 70); _poly(s, (30, 24, 60), [(x, 0), (x + 10, th), (x + 20, 0)]); x += r.randint(10, 24)
            pts = [(0, 140)]; x = 0
            while x < 480: x += 22; pts.append((x, 80 + r.randint(0, 50)))
            pts.append((480, 140)); _poly(s, (30, 24, 60), pts)
        def mid(s, r):
            x = 0
            while x < 480:
                hh = r.randint(60, 110); _rc(s, (26, 22, 52), (x, 140 - hh, 10, hh)); _rc(s, (26, 22, 52), (x + 50, 140 - hh, 10, hh))
                pygame.draw.arc(s, (26, 22, 52), (x, 140 - hh - 24, 60, 50), 0, 3.1416, 8)
                for k in range(3): pygame.draw.circle(s, (80, 90, 160), (x + 30 + r.randint(-8, 8), 140 - hh + 6 + r.randint(0, 20)), 1)
                x += r.randint(100, 170)
        def near(s, r):
            x = 5
            while x < 480:
                bh = r.randint(30, 80); _poly(s, (10, 8, 24), [(x, 180), (x + 7, 180 - bh), (x + 14, 180)])
                _poly(s, (10, 8, 24), [(x + 10, 0), (x + 16, r.randint(30, 80)), (x + 22, 0)]); x += r.randint(30, 70)
        L = [(_layer(480, 140, far), 0.1, 20), (_layer(480, 140, mid), 0.3, 40), (_layer(480, 180, near), 0.6, 0)]
    _LAYERS[area] = L
    return L

_SKY = {}
def sky_surface(area):
    if area not in _SKY:
        s = pygame.Surface((W, H)); a, b = PAL[area]["sky"]
        for y in range(H):
            f = (y / H) ** 1.3
            _ln(s, tuple(int(a[i] + (b[i] - a[i]) * f) for i in range(3)), (0, y), (W, y))
        if area != "river":
            pygame.draw.circle(s, (230, 235, 210), (278, 62), 11); pygame.draw.circle(s, _mul(a, 1.3), (283, 59), 10)
            pygame.draw.circle(s, (230, 235, 210), (278, 62), 9); pygame.draw.circle(s, (205, 210, 190), (275, 59), 2)
            r = random.Random(3)
            for _ in range(40):
                x, y = r.randrange(W), r.randrange(H // 2); s.set_at((x, y), (200 + r.randrange(55),) * 3)
        else:
            r = random.Random(5)
            for _ in range(30):
                x, y = r.randrange(W), r.randrange(H); s.set_at((x, y), (90, 100 + r.randrange(100), 180))
        _SKY[area] = s
    return _SKY[area]

# ---- light and fog ----
_GLOW = {}
def glow(radius, color):
    k = (radius, color)
    if k not in _GLOW:
        s = pygame.Surface((radius * 2, radius * 2)); s.fill((0, 0, 0))
        for r in range(radius, 0, -2):
            f = (1 - r / radius) ** 1.8
            pygame.draw.circle(s, (int(color[0] * f), int(color[1] * f), int(color[2] * f)), (radius, radius), r)
        _GLOW[k] = s
    return _GLOW[k]
_VIG = None
def vignette():
    global _VIG
    if _VIG is None:
        s = pygame.Surface((W, H)); s.fill((255, 255, 255))
        for i in range(34):
            v = max(0, int(255 - (34 - i) ** 1.45 * 0.55))
            pygame.draw.rect(s, (v, v, v), (i, i * 180 // 320, W - 2 * i, H - 2 * (i * 180 // 320)), 1)
        _VIG = s
    return _VIG
_FOGS = {}
def fog_surface(area):
    if area not in _FOGS:
        s = mk(640, 64); r = random.Random(8); c = PAL[area]["fog"]
        for _ in range(26):
            x = r.randrange(640); y = r.randrange(10, 54); w = r.randint(60, 140); h = r.randint(10, 26)
            for k in range(3):
                e = mk(w, h); pygame.draw.ellipse(e, c + (10,), (0, 0, w, h)); pygame.draw.ellipse(e, c + (14,), (w // 6, h // 6, w * 2 // 3, h * 2 // 3))
                s.blit(e, (x - w // 2 + k * 3, y)); s.blit(e, (x - w // 2 - 640, y)) if x - w // 2 < 0 else None
                if x + w // 2 > 640: s.blit(e, (x - w // 2 - 640, y))
        _FOGS[area] = s
    return _FOGS[area]

# ======== p7_bossart.py ========

# ---------------- boss art ----------------
_BSPR = {}
def hiisi_frame(pose, t, flip=False, flash=False, enraged=False):
    key = ("hiisi", pose, t, flip, flash, enraged)
    f = _BSPR.get(key)
    if f: return f
    s = mk(72, 70)
    club_a, lean, cr, mouth = {"idle": (50, 0, 0, 0), "walk": (40, 2, 0, 0), "slam_w": (-110, -4, 0, 1), "slam": (70, 6, 3, 0),
        "sweep_w": (-170, -6, 2, 1), "sweep": (10, 7, 2, 0), "charge_w": (60, -5, 4, 1), "charge": (20, 9, 2, 1), "roar": (-30, -3, 0, 2),
        "stagger": (80, -6, 5, 1), "hurt": (60, -3, 2, 0), "die": (90, -8, 8, 0), "rock": (-80, -2, 0, 1)}.get(pose, (50, 0, 0, 0))
    bob = (t // 8) % 2 if pose == "idle" else 0
    skin = (92, 86, 70) if not enraged else (110, 70, 58); moss = (60, 100, 56); dk = _mul(skin, 0.6)
    gx = 34 + lean; base = 66; hip = base - 22 + cr
    # legs
    for k, dx in enumerate((-8, 8)):
        ph = (t // 5 + k) % 2 if pose in ("walk", "charge") else 0
        _rc(s, dk if k == 0 else skin, (34 + dx - 4, hip, 9, base - hip - (2 if ph else 0)))
        _rc(s, _mul(skin, 0.5), (34 + dx - 5, base - 3 - (2 if ph else 0), 11, 3))
    # body
    _poly(s, skin, [(gx - 14, hip + 2), (gx - 17, hip - 20 - bob), (gx - 8, hip - 30 - bob), (gx + 8, hip - 30 - bob), (gx + 17, hip - 20 - bob), (gx + 14, hip + 2)])
    _poly(s, moss, [(gx - 17, hip - 20 - bob), (gx - 8, hip - 30 - bob), (gx + 4, hip - 30 - bob), (gx - 4, hip - 21 - bob), (gx - 10, hip - 14)])
    for k in range(6): _rc(s, _mul(skin, 1.2), (gx - 10 + k * 3, hip - 14 + (k * 5) % 9, 2, 1))
    # head with antlers
    hx, hy = gx + 3, hip - 36 - bob
    pygame.draw.circle(s, skin, (hx, hy), 8)
    _rc(s, (20, 14, 14), (hx - 2, hy + 2, 8, 2 + mouth * 2))
    ey = (255, 120, 40) if not enraged else (255, 50, 40)
    _rc(s, ey, (hx - 4, hy - 3, 3, 2)); _rc(s, ey, (hx + 2, hy - 3, 3, 2))
    for sx_, dr in ((-1, -1), (1, 1)):
        bx = hx + sx_ * 5
        _ln(s, (150, 130, 100), (bx, hy - 6), (bx + dr * 6, hy - 16), 2); _ln(s, (150, 130, 100), (bx + dr * 3, hy - 11), (bx + dr * 10, hy - 12), 1); _ln(s, (150, 130, 100), (bx + dr * 5, hy - 14), (bx + dr * 4, hy - 20), 1)
    # arm + club
    shx, shy = gx + 12, hip - 24 - bob
    a = math.radians(club_a); hx2 = shx + math.cos(a) * 14; hy2 = shy + math.sin(a) * 14
    _ln(s, skin, (shx, shy), (hx2, hy2), 6)
    ex, ey2 = hx2 + math.cos(a) * 22, hy2 + math.sin(a) * 22
    _ln(s, (96, 70, 44), (hx2, hy2), (ex, ey2), 5); pygame.draw.circle(s, (74, 54, 34), (int(ex), int(ey2)), 7)
    for k in range(3): _rc(s, (170, 170, 160), (int(ex) - 5 + k * 4, int(ey2) - 5 + (k % 2) * 6, 2, 2))
    off = (-12 + 0, hip - 24 - bob)
    _ln(s, dk, (gx - 12, hip - 24 - bob), (gx - 18, hip - 8 + (t // 8) % 2), 5)
    f = _outline(s)
    if flip: f = pygame.transform.flip(f, True, False)
    f = _finish(f, flash)
    _BSPR[key] = f
    return f

def tytti_frame(pose, t, flip=False, flash=False, enraged=False):
    key = ("tytti", pose, t, flip, flash, enraged)
    f = _BSPR.get(key)
    if f: return f
    s = mk(70, 64); cx = 30; fl = (t // 6) % 3
    bob = int(2 * math.sin(t * 0.08)) if pose == "idle" else 0
    robe = (30, 24, 54); trim = (150, 120, 220) if not enraged else (230, 90, 150)
    top = 20 + bob
    _poly(s, robe, [(cx - 7, top + 6), (cx + 7, top + 6), (cx + 13, 56 + fl), (cx + 6, 52), (cx, 58), (cx - 6, 52), (cx - 13, 56 - fl)])
    _poly(s, _mul(robe, 1.5), [(cx - 3, top + 8), (cx + 3, top + 8), (cx + 6, 52), (cx - 6, 52)])
    _rc(s, trim, (cx - 7, top + 6, 14, 1))
    hair = (14, 10, 24)
    pygame.draw.circle(s, hair, (cx, top), 7); _poly(s, hair, [(cx - 7, top), (cx - 11, top + 24 + fl), (cx - 4, top + 8)]); _poly(s, hair, [(cx + 6, top + 2), (cx + 10, top + 22 - fl), (cx + 3, top + 8)])
    pygame.draw.circle(s, (206, 214, 232), (cx, top + 1), 4)
    hot = pose in ("slash_w", "cast", "beam", "tele_in")
    ec = (255, 70, 110) if hot or enraged else (110, 220, 255)
    _rc(s, ec, (cx - 2, top, 1, 1)); _rc(s, ec, (cx + 1, top, 1, 1))
    for k in range(5): _poly(s, (220, 220, 200), [(cx - 6 + k * 3, top - 5), (cx - 5 + k * 3, top - 9 - (k % 2) * 2), (cx - 4 + k * 3, top - 5)])
    # scythe
    ang = {"idle": 70, "slash_w": -150, "slash": 20, "cast": -100, "beam": -90, "stagger": 100, "hurt": 90, "tele_in": 80, "die": 100}.get(pose, 70)
    a = math.radians(ang); sx0, sy0 = cx + 8, top + 12
    ex, ey = sx0 + math.cos(a) * 24, sy0 + math.sin(a) * 24; bx, by = sx0 - math.cos(a) * 10, sy0 - math.sin(a) * 10
    _ln(s, (130, 100, 70), (bx, by), (ex, ey), 2)
    pa = a - 1.6
    _poly(s, (190, 215, 240), [(ex, ey), (ex + math.cos(pa) * 14, ey + math.sin(pa) * 14), (ex + math.cos(pa + 0.5) * 6 + math.cos(a) * 4, ey + math.sin(pa + 0.5) * 6 + math.sin(a) * 4)])
    _ln(s, (230, 245, 255), (ex, ey), (ex + math.cos(pa) * 14, ey + math.sin(pa) * 14), 1)
    _ln(s, (200, 190, 230), (cx + 4, top + 8), (sx0, sy0), 2)
    f = _outline(s)
    if flip: f = pygame.transform.flip(f, True, False)
    f = _finish(f, flash)
    _BSPR[key] = f
    return f

def turso_draw(c, ox, oy, bx, by, hx, hy, t, mouth, flash, enraged):
    """Draws Iku-Turso: a neck from (bx,by) base to head (hx,hy). Coordinates are screen coordinates."""
    n = 14
    col = (50, 120, 110) if not enraged else (120, 60, 90); dk = _mul(col, 0.55); lt = _mul(col, 1.5)
    if flash: col = (200, 200, 200); dk = (160, 160, 160); lt = (255, 255, 255)
    pts = []
    for i in range(n + 1):
        f = i / n
        # curve: rises from the base then bends to the head
        mx = bx + (hx - bx) * f + math.sin(f * 3.14159) * -18 + math.sin(t * 0.07 + f * 4) * 3 * f
        my = by + (hy - by) * f - math.sin(f * 3.14159) * 14
        pts.append((mx, my))
    for i, (px, py) in enumerate(pts):
        r = 9 - i * 0.28 if i < n else 7
        pygame.draw.circle(c, dk, (int(px), int(py) + 1), int(r + 1)); pygame.draw.circle(c, col, (int(px), int(py)), int(r))
        if i % 2 == 0: pygame.draw.circle(c, lt, (int(px) - 1, int(py) - 2), max(1, int(r * 0.4)))
        if i % 3 == 1: _poly(c, dk, [(px - 2, py - r), (px + 1, py - r - 5), (px + 4, py - r)])
    # base blob (coils in the water)
    for k in range(3): pygame.draw.circle(c, col, (int(bx) + k * 9 - 9, int(by) + 4), 10); pygame.draw.circle(c, dk, (int(bx) + k * 9 - 9, int(by) + 8), 5)
    dx = hx - pts[-2][0]; dy = hy - pts[-2][1]; ang = math.atan2(dy, dx)
    # head
    hs = pygame.Surface((46, 36), pygame.SRCALPHA)
    _el(hs, dk, (4, 8, 36, 22)); _el(hs, col, (4, 6, 34, 20))
    jaw = 3 + mouth * 9
    _poly(hs, (30, 20, 30), [(20, 18), (42, 18 + jaw // 2), (20, 20 + jaw)])
    for k in range(5): _poly(hs, (240, 240, 230), [(22 + k * 4, 18), (24 + k * 4, 18 + 4), (26 + k * 4, 18)])
    _poly(hs, lt, [(10, 8), (4, 0), (18, 6)]); _poly(hs, lt, [(18, 6), (14, -2), (26, 6)]) if False else None
    ey = (255, 220, 80) if not enraged else (255, 60, 60)
    pygame.draw.circle(hs, ey, (26, 12), 3); _rc(hs, (20, 10, 10), (26, 11, 2, 3))
    fdir = -1 if dx < 0 else 1
    if fdir < 0: hs = pygame.transform.flip(hs, True, False)
    phi = math.degrees(math.atan2(dy, abs(dx))); phi = max(-60, min(60, phi))
    hs = pygame.transform.rotate(hs, -fdir * phi)
    c.blit(hs, hs.get_rect(center=(int(hx), int(hy))))

def louhi_frame(pose="idle",t=0,flash=False,phase=1):
    k=("louhi",pose,t%4,flash,phase)
    if k in _BSPR:return _BSPR[k]
    s=mk(150,112); dark=(15+phase*2,17,29+phase*4); edge=(71,78,109)
    # A huge ragged northern eagle/mistress silhouette, not a resized humanoid.
    for side in (-1,1):
        pts=[(75,48),(75+side*25,30 if pose!="windup" else 14),(75+side*68,8 if pose=="windup" else 25),(75+side*48,47),(75+side*65,38),(75+side*42,63),(75+side*20,72)]
        pygame.draw.polygon(s,dark,pts);pygame.draw.lines(s,edge,False,pts,2)
        for j in range(5):
            x=75+side*(26+j*8);y=40+j%2*4;pygame.draw.line(s,edge,(x,y),(x+side*14,y+29-j*2),3)
    pygame.draw.ellipse(s,dark,(61,32,29,65));pygame.draw.ellipse(s,edge,(61,32,29,65),2)
    # horns/crown, beak and three baleful eyes.
    pygame.draw.polygon(s,(118,133,162),[(60,49),(66,23),(72,43),(77,15),(82,43),(91,24),(88,56)])
    pygame.draw.polygon(s,(217,219,214),[(91,49),(112,55),(93,60)])
    for xx,yy in ((78,47),(86,44),(83,53)):pygame.draw.circle(s,(255,48,32),(xx,yy),3 if phase>=3 else 2)
    if phase>=2:
        for xx in (68,79,89):pygame.draw.polygon(s,(141,180,235),[(xx,88),(xx-5,106),(xx+5,106)])
    if phase>=3:
        pygame.draw.circle(s,(212,180,99),(75,72),13,2);pygame.draw.circle(s,(255,232,143),(75,72),5,2)
    if flash:s.set_colorkey((0,0,0));white=pygame.Surface(s.get_size());white.fill((255,240,235));white.blit(s,(0,0),special_flags=pygame.BLEND_RGB_MULT);s=white
    _BSPR[k]=s;return s

# ======== p8_ent.py ========

# ---------------- entities: particles, projectiles, zones, enemies, bosses ----------------
def ov(a, b): return a[0] < b[0] + b[2] and b[0] < a[0] + a[2] and a[1] < b[1] + b[3] and b[1] < a[1] + a[3]

class Parts:
    def __init__(s): s.l = []
    def add(s, x, y, vx, vy, life, col, size=1, grav=0.0):
        if len(s.l) < 360: s.l.append([x, y, vx, vy, life, life, col, size, grav])
    def burst(s, x, y, col, n=8, sp=1.6, life=22, size=1, grav=0.08, up=0.0):
        for _ in range(n):
            a = random.random() * 6.283; v = random.random() * sp
            s.add(x, y, math.cos(a) * v, math.sin(a) * v - up, life + random.randint(-6, 6), col, size, grav)
    def update(s):
        out = []
        for p in s.l:
            p[0] += p[2]; p[1] += p[3]; p[3] += p[8]; p[4] -= 1
            if p[4] > 0: out.append(p)
        s.l = out
    def draw(s, surf, cx, cy):
        for p in s.l:
            x = int(p[0] - cx); y = int(p[1] - cy)
            if -4 < x < W + 4 and -4 < y < H + 4:
                c = p[6]
                if p[4] < p[5] * 0.4: c = (c[0] * 2 // 3, c[1] * 2 // 3, c[2] * 2 // 3)
                surf.fill(c, (x, y, p[7], p[7]))

class Atk:
    """A melee hitbox attached to a body. rel = (forward offset, y offset from feet, w, h)."""
    __slots__ = ("rel", "dmg", "kb", "kbu", "tags", "hit", "poise", "pid", "t", "mult")
    def __init__(s, rel, dmg, kb=2.0, tags=(), poise=20, kbu=0.0, pid=0):
        s.rel = rel; s.dmg = dmg; s.kb = kb; s.kbu = kbu; s.tags = set(tags); s.hit = set(); s.poise = poise; s.pid = pid; s.t = 0; s.mult = 1.0
    def rect(s, x, y, face):
        ox, oy, w, h = s.rel
        return (x + ox if face > 0 else x - ox - w, y + oy, w, h)

class Proj:
    def __init__(s, kind, x, y, vx, vy, dmg, w=6, h=6, enemy=True, life=240, grav=0.0, tags=(), homing=0.0, pid=0, pierce=0, poise=10, col=(255, 160, 80), hp=1):
        s.kind = kind; s.x = x; s.y = y; s.vx = vx; s.vy = vy; s.dmg = dmg; s.w = w; s.h = h; s.enemy = enemy; s.life = life
        s.grav = grav; s.tags = set(tags); s.homing = homing; s.pid = pid; s.pierce = pierce; s.poise = poise; s.col = col
        s.hit = set(); s.dead = False; s.t = 0; s.hp = hp; s.kbx = 1.5
    def rect(s): return (s.x - s.w / 2, s.y - s.h / 2, s.w, s.h)
    def update(s, g):
        s.t += 1; s.life -= 1
        if s.life <= 0: s.dead = True; return
        if s.homing and s.enemy:
            t = g.nearest_player(s.x, s.y)
            if t:
                ta = math.atan2(t.y - 9 - s.y, t.x - s.x); ca = math.atan2(s.vy, s.vx)
                d = (ta - ca + math.pi) % (2 * math.pi) - math.pi
                ca += max(-s.homing, min(s.homing, d)); sp = math.hypot(s.vx, s.vy)
                s.vx = math.cos(ca) * sp; s.vy = math.sin(ca) * sp
        s.vy += s.grav
        if s.kind == "wave":
            s.x += s.vx; return
        s.x += s.vx; s.y += s.vy
        if s.kind not in ("rock",) and g.wd.solid(int(s.x // TILE), int(s.y // TILE)):
            s.dead = True; g.parts.burst(s.x, s.y, s.col, 5, 1.0, 14)
            if s.kind == "spit": g.spit_land(s)
        if s.kind in ("orb", "bolt", "spit") and s.t % 3 == 0:
            g.parts.add(s.x, s.y, random.uniform(-.2, .2), random.uniform(-.2, .2), 14, s.col, 1)
    def draw(s, surf, cx, cy):
        x = int(s.x - cx); y = int(s.y - cy)
        if s.kind == "arrow":
            a = math.atan2(s.vy, s.vx); ex = int(math.cos(a) * 6); ey = int(math.sin(a) * 6)
            pygame.draw.line(surf, (200, 180, 140), (x - ex, y - ey), (x + ex, y + ey), 1); surf.set_at((x + ex, y + ey), (240, 240, 240))
        elif s.kind == "parrow":
            a = math.atan2(s.vy, s.vx); ex = int(math.cos(a) * 7); ey = int(math.sin(a) * 7)
            pygame.draw.line(surf, (230, 210, 150), (x - ex, y - ey), (x + ex, y + ey), 1); surf.set_at((x + ex, y + ey), (255, 255, 255))
        elif s.kind in ("orb", "bolt", "spit"):
            r = 3 if s.kind != "bolt" else 2 + (s.t // 3) % 2
            c = s.col
            pygame.draw.circle(surf, _mul(c, 0.5), (x, y), r + 1); pygame.draw.circle(surf, c, (x, y), r); surf.set_at((x, y), (255, 255, 255))
        elif s.kind == "wave":
            f = (s.t // 3) % 2
            sgn = 1 if s.vx > 0 else -1
            pygame.draw.polygon(surf, _mul(s.col, 0.6), [(x - sgn * 4, y), (x - sgn * 2, y - 8 - f), (x + sgn * 5, y - 2), (x + sgn * 5, y)])
            pygame.draw.polygon(surf, s.col, [(x - sgn * 2, y), (x, y - 6 - f), (x + sgn * 3, y - 2), (x + sgn * 3, y)])
        elif s.kind == "rock":
            pygame.draw.circle(surf, (96, 90, 84), (x, y), 6); pygame.draw.circle(surf, (130, 124, 116), (x - 2, y - 2), 3); pygame.draw.circle(surf, (50, 46, 44), (x + 2, y + 2), 2)
        else:
            surf.fill(s.col, (x - 1, y - 1, 3, 3))

class Zone:
    """Telegraphed area hazard: warns for `delay` frames, then hurts for `life` frames."""
    def __init__(s, x, y, w, h, delay, life, dmg, style="rock", kb=2.5, tags=("heavy",)):
        s.x = x; s.y = y; s.w = w; s.h = h; s.delay = delay; s.life = life; s.dmg = dmg; s.style = style; s.t = 0; s.hit = set(); s.dead = False
        s.kb = kb; s.tags = set(tags)
    @property
    def active(s): return s.t >= s.delay
    def rect(s): return (s.x - s.w / 2, s.y - s.h, s.w, s.h)
    def update(s, g):
        s.t += 1
        if s.t == s.delay:
            if s.style == "rock": g.shake(3, 8); sfx("boom", 0.5); g.parts.burst(s.x, s.y, (150, 140, 130), 10, 1.8, 20, 2, 0.1, 0.8)
            elif s.style == "geyser": sfx("splash", 0.9); g.parts.burst(s.x, s.y, (150, 200, 255), 12, 1.6, 22, 1, 0.05, 2.0)
            elif s.style == "beam": sfx("ice", 0.8)
        if s.t >= s.delay + s.life: s.dead = True
    def draw(s, surf, cx, cy):
        x = int(s.x - cx); y = int(s.y - cy); w = int(s.w); h = int(s.h)
        if not s.active:
            f = s.t / max(1, s.delay); a = 60 + int(120 * f)
            warn = pygame.Surface((w, h if s.style != "rock" else 4), pygame.SRCALPHA)
            col = (126,190,255) if s.style=="frost" else (194,138,255) if s.style=="stolen" else (255,80,60) if s.style!="puddle" else (160,255,90)
            if s.style == "ghost":
                if (s.t // 3) % 2 == 0:
                    gs = tytti_frame("idle", 0, False, False, False).copy(); gs.set_alpha(40 + int(80 * f)); surf.blit(gs, (x - gs.get_width() // 2, y - gs.get_height() + 8))
            elif s.style == "beam": warn.fill(col + (int(40 + 60 * f),)); surf.blit(warn, (x - w // 2, y - h))
            elif s.style == "rock":
                warn.fill(col + (a,)); surf.blit(warn, (x - w // 2, y - 3))
                if (s.t // 4) % 2 == 0: pygame.draw.line(surf, (255, 200, 120), (x, y - 6), (x, y - 14), 1)
                rem = s.delay - s.t
                if rem < 24:
                    ry = y - 6 - rem * 5
                    pygame.draw.circle(surf, (96, 90, 84), (x, ry), 6); pygame.draw.circle(surf, (130, 124, 116), (x - 2, ry - 2), 3)
            else:
                warn.fill(col + (int(30 + 50 * f),)); surf.blit(warn, (x - w // 2, y - 6 if s.style == "geyser" else y - h)); 
                if s.style == "geyser" and (s.t // 3) % 2 == 0: surf.fill((200, 230, 255), (x - 3 + (s.t % 5), y - 8 - (s.t % 7), 2, 2))
        else:
            k = s.t - s.delay
            if s.style == "geyser":
                hh = min(h, 12 + k * 14) if k < s.life - 4 else max(0, h * (s.delay + s.life - s.t) // 4)
                pygame.draw.rect(surf, (140, 200, 255), (x - w // 2, y - hh, w, hh)); pygame.draw.rect(surf, (230, 245, 255), (x - w // 4, y - hh, w // 2, hh))
            elif s.style == "beam":
                pygame.draw.rect(surf, (255, 120, 190), (x - w // 2, y - h, w, h)); pygame.draw.rect(surf, (255, 240, 250), (x - w // 4, y - h, max(2, w // 2), h))
            elif s.style == "rock":
                pass
            elif s.style == "puddle":
                pygame.draw.ellipse(surf, (90, 200, 70), (x - w // 2, y - 5, w, 6)); pygame.draw.ellipse(surf, (190, 255, 120), (x - w // 3, y - 4, w * 2 // 3, 3))
                if (s.t // 7) % 2 == 0: surf.fill((220, 255, 150), (x - 4 + (s.t * 3) % 9, y - 8, 1, 2))

ESPEC = {
    "peikko":   dict(hp=34, w=12, h=20, souls=14, poise=22, spd=0.8, wake=130, dmg=20),
    "susi":     dict(hp=24, w=18, h=12, souls=10, poise=12, spd=1.3, wake=150, dmg=16),
    "korppi":   dict(hp=16, w=12, h=9, souls=8, poise=8, spd=1.1, wake=140, fly=True, dmg=10),
    "jousi":    dict(hp=26, w=10, h=20, souls=14, poise=14, spd=0.7, wake=170, dmg=14),
    "hukkunut": dict(hp=90, w=14, h=24, souls=25, poise=45, spd=0.55, wake=120, dmg=30),
    "virvatuli": dict(hp=20, w=10, h=10, souls=18, poise=6, spd=0.7, wake=150, fly=True, dmg=14),
    "nakki":    dict(hp=30, w=12, h=12, souls=20, poise=30, spd=1.0, wake=70, dmg=18),
    "haamu":    dict(hp=110, w=12, h=26, souls=40, poise=50, spd=0.8, wake=140, dmg=32),
    "henki":    dict(hp=40, w=12, h=24, souls=35, poise=10, spd=0.7, wake=170, fly=True, dmg=18),
    "joutsen":  dict(hp=40, w=16, h=10, souls=28, poise=14, spd=1.0, wake=160, fly=True, dmg=18),
    "hiisi":    dict(hp=800, w=26, h=44, souls=900, poise=9999, spd=1.0, wake=0, dmg=28),
    "turso":    dict(hp=800, w=22, h=22, souls=1800, poise=9999, spd=1.0, wake=0, dmg=40, fly=True),
    "louhi":    dict(hp=2800, w=88, h=94, souls=8000, poise=9999, spd=1.0, wake=0, dmg=52, fly=True),
    "tytti":    dict(hp=1500, w=14, h=34, souls=4000, poise=9999, spd=1.0, wake=0, dmg=36, fly=True),
}
FLYERS = ("korppi", "virvatuli", "henki", "joutsen")

class Enemy(Body):
    boss = False
    def __init__(s, g, kind, x, y, sid=None):
        sp = ESPEC[kind]
        Body.__init__(s, x, y, sp["w"], sp["h"])
        s.g = g; s.kind = kind; s.sp = sp; s.hp = s.maxhp = float(sp["hp"]); s.souls = sp["souls"]; s.fly = sp.get("fly", False)
        s.hx, s.hy = x, y; s.face = random.choice((-1, 1)); s.anim = "idle"; s.t = random.randint(0, 99); s.stun = 0; s.flash = 0
        s.poise = s.poise_max = sp["poise"]; s.poise_t = 0; s.armor = False; s.dead = False; s.dt = 0; s.atk = None; s.warn = 0; s.warn_t = 0
        s.kx = 0.0; s.vuln = 0; s.alert = 0; s.invuln = False; s.hidden = False; s.sid = sid; s.gen = None; s.stag_cd = 0; s.last_hit = 0
        s.speed = sp["spd"]
    # ----- helpers for the AI -----
    def target(s):
        g = s.g; t = g.nearest_player(s.x, s.y - 10)
        if t is None: return None
        dx = abs(t.x - s.x); dy = abs(t.y - s.y)
        if s.alert > 0: s.alert -= 1
        if dx < s.sp["wake"] and dy < 60 and g.los(s.x, s.y - s.h * 0.6, t.x, t.y - 9):
            s.alert = 240
        if s.alert > 0 and abs(s.x - s.hx) < 230 and dx < 260: return t
        return None
    def see(s, t): s.face = 1 if t.x >= s.x else -1
    def can_step(s, d):
        wd = s.g.wd
        nx = s.x + d * (s.w / 2 + 4); tx = int(nx // TILE)
        ty_f = int((s.y + 2) // TILE)
        if wd.solid(tx, int((s.y - 4) // TILE)) or wd.solid(tx, int((s.y - 12) // TILE)): return False
        for k in range(0, 3):
            tt = wd.tile(tx, ty_f + k)
            if tt in (THORN, WATER): return False
            if tt in (SOLID, PLAT) or (tt == LADDER and wd.tile(tx, ty_f + k - 1) != LADDER): return True if k < 2 else False
        return False
    def step(s, d, spd=None):
        if spd is None: spd = s.speed
        s.vx = d * spd * D()["spd"] if s.can_step(d) else 0.0
    def idle(s, n):
        s.vx = 0
        for _ in range(n):
            s.anim = "idle"; s.vx = 0; yield
    def patrol(s, n):
        d = random.choice((-1, 1))
        if abs(s.x - s.hx) > 60: d = 1 if s.hx > s.x else -1
        s.face = d
        for _ in range(n):
            if s.target(): break
            s.anim = "walk"
            s.vx = d * s.speed * 0.5 * D()["spd"] if s.can_step(d) and abs(s.x + d * 8 - s.hx) < 70 else 0.0
            yield
        s.vx = 0; s.anim = "idle"
        for _ in range(random.randint(20, 60)):
            if s.target(): break
            yield
    def attack(s, anim_w, tel, anim_a, act, rec, rel, dmg, kb=2.0, tags=(), lunge=0.0, poise=20, snd="swing", kbu=0.0, armor=False, anim_r="idle", vy=0.0, until_ground=False, hook=None):
        n = tele(tel); s.armor = armor
        s.anim = anim_w
        for i in range(n):
            s.vx = 0; s.warn = n - i; s.warn_t = i; yield
        s.warn = 0
        s.anim = anim_a; s.atk = Atk(rel, dmg * D()["dmg"], kb, tags, poise, kbu); sfx(snd, 0.8)
        if vy: s.vy = vy; s.on_ground = False
        if hook: hook()
        i = 0
        while i < act or (until_ground and not s.on_ground and i < act + 40):
            s.vx = lunge * s.face * D()["spd"]; i += 1; yield
        s.atk = None; s.vx = 0; s.armor = False; s.anim = anim_r
        for _ in range(rec): yield
    # ----- core -----
    def hurt_rect(s): return (s.x - s.w / 2, s.y - s.h, s.w, s.h)
    def mult(s): return D()["hp"] * s.g.coop_mult(s.boss)
    def take(s, dmg, kb=0.0, poise=10, pl=None, tags=(), kbu=0.0):
        if s.dead or s.invuln or s.hidden: return False
        g = s.g
        if s.vuln > 0: dmg *= 2.2; tags = set(tags) | {"crit"}
        real = dmg / s.mult(); s.hp -= real; s.flash = 4; s.last_hit = 0
        if pl is not None: pl.dealt = getattr(pl, "dealt", 0) + 1
        g.dnum(s.x, s.y - s.h - 2, int(round(dmg)), (255, 230, 120) if "crit" in tags else (255, 255, 255))
        g.parts.burst(s.x, s.y - s.h * 0.55, (255, 230, 200) if not s.boss else (255, 180, 140), 6, 1.6, 14)
        sfx("hit2" if "heavy" in tags or "crit" in tags else "hit", 0.8)
        g.hitstop = max(g.hitstop, 5 if "heavy" in tags or "crit" in tags else 3)
        if s.alert < 200: s.alert = 240
        if s.hp <= 0: s.die(pl); return True
        s.poise -= poise; s.poise_t = 100
        if s.stun <= 0 and not s.boss and (s.poise <= 0) and not s.armor:
            s.stun = 16 if "heavy" not in tags else 24; s.poise = s.poise_max; s.atk = None; s.warn = 0; s.gen = None; s.anim = "hurt"
        if kb and not (s.boss or s.armor): s.kx = kb * (1.0 if not s.fly else 0.7)
        if kbu and not (s.boss or s.armor) and not s.fly: s.vy = -kbu; s.on_ground = False
        return True
    def stagger(s, n=70):
        if s.stag_cd > 0 or s.dead: return
        s.stun = n; s.vuln = n; s.atk = None; s.warn = 0; s.gen = None; s.anim = "hurt"; s.armor = False; s.stag_cd = 240 if s.boss else 0
        s.g.parts.burst(s.x, s.y - s.h * 0.6, (255, 240, 160), 14, 2.2, 20)
    def die(s, pl):
        s.dead = True; s.dt = 0; s.atk = None; s.anim = "die"; s.warn = 0
        g = s.g
        g.parts.burst(s.x, s.y - s.h * 0.5, (255, 255, 255) if not s.fly else (180, 255, 240), 14, 2.0, 26, 1, 0.05, 0.6)
        sfx("edie", 0.9)
        g.give_souls(int(s.souls * D()["souls"]), s.x, s.y - s.h)
        g.on_kill(s)
    def brain(s): raise NotImplementedError
    def update(s):
        g = s.g; s.t += 1; s.poise_t -= 1; s.last_hit += 1
        if s.flash > 0: s.flash -= 1
        if s.stag_cd > 0: s.stag_cd -= 1
        if s.poise_t <= 0: s.poise = s.poise_max
        if s.dead:
            s.dt += 1; s.vx = 0
            if not s.fly and not s.on_ground: s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
            return
        if s.vuln > 0: s.vuln -= 1
        if s.stun > 0:
            s.stun -= 1; s.vx = 0
            if s.stun == 0: s.anim = "idle"
        else:
            if s.gen is None: s.gen = s.brain()
            try: next(s.gen)
            except StopIteration: s.gen = None
        if s.atk: s.atk.t += 1
        # physics
        vx0 = s.vx; s.vx = vx0 + s.kx
        if not s.fly: s.vy = min(MAX_FALL, s.vy + GRAV)
        move_body(g.wd, s)
        if s.wall: s.kx = 0.0
        s.vx = vx0; s.kx *= 0.82
        if abs(s.kx) < 0.05: s.kx = 0.0
        if s.vx and s.stun <= 0 and not s.atk and abs(s.vx) > 0.05: s.face = 1 if s.vx > 0 else -1
        if s.y > ROWS * TILE - 20 or (not s.fly and hazard_at(g.wd, s) and not s.kind == "nakki"):
            s.hp = 0; s.dead = True; s.dt = 30; s.souls = 0; g.parts.burst(s.x, s.y, (150, 200, 255), 8, 1.2, 16, 1, 0.1, 1.5); sfx("splash", 0.5)
    # ----- drawing -----
    def sprite(s):
        a = s.anim
        if a == "walk" and abs(s.vx) < 0.05: a = "idle"
        t = (s.t // (5 if a != "walk" else 6)) % 8
        if s.dead: a = "die"; t = 0
        fl = s.flash > 0
        return enemy_frame(s.kind, a, t, s.face < 0, fl)
    def draw(s, surf, cx, cy):
        if s.hidden: return
        spr = s.sprite(); w, h = spr.get_size()
        x = int(s.x - cx); y = int(s.y - cy)
        if s.fly: bx, by = x - w // 2, y - h // 2 - int(s.h / 2) + (int(math.sin(s.t * 0.1) * 2) if not s.dead else 0)
        else: bx, by = x - w // 2, y - h + 2
        if s.dead:
            if s.dt > 34: return
            spr = spr.copy(); spr.set_alpha(max(0, 255 - s.dt * 8))
        surf.blit(spr, (bx, by))
        if s.warn > 0:
            if s.warn_t < 12:
                px = x; py = by - 6
                pygame.draw.rect(surf, (255, 60, 50), (px - 1, py - 8, 3, 5)); pygame.draw.rect(surf, (255, 60, 50), (px - 1, py - 2, 3, 2))
                pygame.draw.rect(surf, (255, 230, 200), (px, py - 7, 1, 3))
            if s.warn <= 4:
                g2 = spr.copy(); g2.fill((100, 80, 20, 0), special_flags=pygame.BLEND_RGB_ADD); surf.blit(g2, (bx, by))
        if not s.dead and s.vuln > 0 and (s.t // 4) % 2 == 0: surf.fill((255, 240, 140), (x - 1, by - 3, 3, 3))
        if s.atk and DEBUG_BOXES:
            r = s.atk.rect(s.x, s.y, s.face); pygame.draw.rect(surf, (255, 0, 0), (r[0] - cx, r[1] - cy, r[2], r[3]), 1)
DEBUG_BOXES = False

# ======== p9_ai.py ========

# ---------------- enemy brains ----------------
def _los_walk_chase(e, t, until):
    """Walk toward the target until horizontal distance < until."""
    e.see(t); e.anim = "walk"; e.step(e.face)

class Mob(Enemy):
    def brain(s):
        return getattr(s, "b_" + s.kind)()
    # ---- grounded melee ----
    def b_peikko(s):
        while True:
            t = s.target()
            if t is None: yield from s.patrol(70); continue
            ad = abs(t.x - s.x); s.see(t)
            if ad > 26: s.anim = "walk"; s.step(s.face); yield; continue
            s.vx = 0
            yield from s.attack("windup", 34, "attack", 7, 22, (3, -20, 26, 20), s.sp["dmg"], 2.4, ("parry",), snd="swing", poise=18)
            if random.random() < min(0.75, 0.3 * D()["aggr"]):
                s.see(t); yield from s.attack("windup", 24, "attack", 7, 26, (3, -20, 26, 20), s.sp["dmg"], 2.4, ("parry",), poise=18)
            yield from s.idle(rest(36))
    def b_susi(s):
        while True:
            t = s.target()
            if t is None: yield from s.patrol(60); continue
            ad = abs(t.x - s.x); s.see(t)
            if ad > 78: s.anim = "walk"; s.step(s.face, s.speed * 1.2); yield; continue
            # prowl, then pounce
            for _ in range(random.randint(20, 50)):
                t = s.target()
                if t is None: break
                s.see(t); ad = abs(t.x - s.x)
                s.anim = "walk"
                s.step(-s.face if ad < 44 else s.face, s.speed * 0.5); yield
            t = s.target()
            if t is None: continue
            s.see(t)
            yield from s.attack("windup", 24, "attack", 14, 36, (-4, -13, 28, 13), s.sp["dmg"], 2.6, ("parry",), lunge=3.0, poise=14,
                                snd="roar", vy=-3.0, until_ground=True, anim_r="idle")
            yield from s.idle(rest(18))
    def b_hukkunut(s):
        while True:
            t = s.target()
            if t is None: yield from s.patrol(80); continue
            ad = abs(t.x - s.x); s.see(t)
            if ad > 34: s.anim = "walk"; s.step(s.face); yield; continue
            s.vx = 0
            if random.random() < 0.55:
                yield from s.attack("windup", 38, "attack", 8, 34, (2, -24, 32, 24), s.sp["dmg"], 3.0, ("parry", "heavy"), poise=40, snd="boom", armor=True)
            else:
                yield from s.attack("windup", 26, "attack", 14, 28, (0, -20, 28, 16), s.sp["dmg"] * 0.75, 2.2, ("parry",), lunge=1.6, poise=30, armor=True)
            yield from s.idle(rest(40))
    def b_haamu(s):
        while True:
            t = s.target()
            if t is None: yield from s.patrol(80); continue
            ad = abs(t.x - s.x); s.see(t)
            if ad > 52: s.anim = "walk"; s.step(s.face); yield; continue
            s.vx = 0
            if random.random() < 0.6:
                yield from s.attack("windup", 30, "attack", 9, 32, (4, -21, 44, 7), s.sp["dmg"], 2.6, ("parry",), lunge=2.2, poise=40, snd="swing2", armor=True)
            else:
                yield from s.attack("windup", 40, "attack", 8, 36, (0, -32, 30, 32), s.sp["dmg"] * 1.15, 3.2, ("parry", "heavy"), poise=50, snd="boom", armor=True)
            if random.random() < min(0.5, 0.15 * D()["aggr"]):
                s.see(t); yield from s.attack("windup", 22, "attack", 9, 28, (4, -21, 44, 7), s.sp["dmg"], 2.6, ("parry",), lunge=2.2, poise=40, armor=True)
            yield from s.idle(rest(34))
    # ---- ranged ----
    def b_jousi(s):
        while True:
            t = s.target()
            if t is None: yield from s.patrol(70); continue
            ad = abs(t.x - s.x); s.see(t); dy = abs(t.y - s.y)
            if ad < 64 and s.can_step(-s.face):
                s.anim = "walk"; s.step(-s.face, s.speed * 1.2); yield; continue
            if ad > 200 or dy > 52 or not s.g.los(s.x, s.y - 12, t.x, t.y - 9):
                s.anim = "walk"; s.step(s.face, s.speed * 0.7) if ad > 120 else None; yield; continue
            n = tele(30); s.anim = "windup"
            for i in range(n): s.vx = 0; s.warn = n - i; s.warn_t = i; s.see(t); yield
            s.warn = 0; s.anim = "attack"; sfx("bow", 0.7)
            sp = 3.0 * D()["spd"]; s.g.projs.append(Proj("arrow", s.x + s.face * 8, s.y - 13, s.face * sp, 0.0, s.sp["dmg"] * D()["dmg"], 8, 3, tags=("parry",), life=200, col=(220, 200, 150)))
            for _ in range(12): yield
            s.anim = "idle"
            yield from s.idle(rest(80))
    def b_virvatuli(s):
        yield from s._caster(70, 26, 1.6, "orb", (255, 170, 80), 0.0, 110)
    def b_henki(s):
        yield from s._caster(92, 30, 1.2, "orb", (180, 130, 255), 0.022, 150)
    def _caster(s, dist, tel_n, spd, kind, col, homing, cd):
        cool = random.randint(30, cd)
        while True:
            t = s.target()
            if t is None:
                s.vx = 0; s.vy = math.sin(s.t * 0.05) * 0.2; s.anim = "idle"; yield; continue
            s.see(t); dx = t.x - s.x; ad = abs(dx); ty = t.y - 26 - 14 * math.sin(s.t * 0.03)
            want = (1 if dx > 0 else -1) * (1 if ad > dist + 14 else (-1 if ad < dist - 14 else 0))
            s.vx = want * s.speed * D()["spd"]; s.vy = max(-0.7, min(0.7, (ty - (s.y - s.h * 0.5)) * 0.04)); s.anim = "idle"
            cool -= 1
            if cool <= 0 and ad < 190 and s.g.los(s.x, s.y - 10, t.x, t.y - 9):
                n = tele(tel_n); s.anim = "windup"
                for i in range(n): s.vx *= 0.9; s.vy *= 0.9; s.warn = n - i; s.warn_t = i; yield
                s.warn = 0; s.anim = "attack"; sfx("orb", 0.7)
                ang = math.atan2(t.y - 9 - (s.y - s.h * 0.5), t.x - s.x)
                sp = spd * D()["spd"]
                s.g.projs.append(Proj(kind, s.x + s.face * 6, s.y - s.h * 0.5, math.cos(ang) * sp, math.sin(ang) * sp, s.sp["dmg"] * D()["dmg"], 7, 7, tags=("parry", "magic"), life=260, col=col, homing=homing, hp=1))
                for _ in range(10): s.vx = 0; s.vy = 0; yield
                cool = rest(cd)
            yield
    # ---- fliers ----
    def b_korppi(s): yield from s._swooper(1.0, 22, 2.6, 52)
    def b_joutsen(s): yield from s._swooper(1.4, 30, 2.1, 62)
    def _swooper(s, dmgm, tel_n, speed, hover):
        cool = random.randint(20, 90)
        while True:
            t = s.target()
            if t is None:
                s.vx = math.sin(s.t * 0.02) * 0.4; s.vy = math.cos(s.t * 0.03) * 0.2; s.anim = "idle"; yield; continue
            s.see(t)
            gx = t.x + math.sin(s.t * 0.025) * 70; gy = t.y - hover
            s.vx = max(-1.2, min(1.2, (gx - s.x) * 0.03)) * D()["spd"]; s.vy = max(-1.0, min(1.0, (gy - s.y) * 0.04)); s.anim = "idle"
            cool -= 1
            if cool <= 0 and abs(t.x - s.x) < 170 and s.y < t.y - 14:
                n = tele(tel_n); s.anim = "windup"
                for i in range(n):
                    s.vx = 0; s.vy = -0.5 if i < n - 8 else 0; s.warn = n - i; s.warn_t = i; s.see(t); yield
                s.warn = 0; s.anim = "attack"; sfx("crow", 0.7)
                ang = math.atan2(t.y - 8 - s.y, t.x - s.x); sp = speed * D()["spd"]
                s.atk = Atk((-s.w // 2 - 2, -s.h - 2, s.w + 4, s.h + 4), s.sp["dmg"] * D()["dmg"] * dmgm, 2.2, ("parry",), 12)
                s.atk.rel = (-s.w // 2 - 2 if s.face > 0 else -s.w // 2 - 2, -s.h - 2, s.w + 4, s.h + 4)
                for i in range(46):
                    s.vx = math.cos(ang) * sp; s.vy = math.sin(ang) * sp
                    if s.wall or s.head or s.on_ground and i > 4: break
                    yield
                s.atk = None; s.anim = "idle"
                for i in range(38): s.vx = -math.cos(ang) * 0.8; s.vy = -1.0; yield
                cool = rest(80)
            yield
    # ---- water ----
    def b_nakki(s):
        wy = s.hy
        while True:
            s.hidden = True; s.invuln = True; s.vx = 0; s.vy = 0; s.y = wy + 6; s.anim = "idle"
            t = s.g.nearest_player(s.x, s.y)
            if t is None or abs(t.x - s.x) > 52 or t.y > wy + 4 or t.y < wy - 120: yield; continue
            # bubbles warn, then leap
            n = tele(34)
            for i in range(n):
                if i % 4 == 0: s.g.parts.add(s.x + random.randint(-5, 5), wy, 0, -0.5, 18, (200, 230, 255), 1)
                s.warn = 0; yield
            t = s.g.nearest_player(s.x, s.y) or t
            s.hidden = False; s.invuln = False; s.see(t); s.y = wy
            s.anim = "windup"; s.warn = 8; s.warn_t = 0
            for _ in range(10): s.warn = 0; s.vy = 0; yield
            s.anim = "attack"; sfx("splash", 0.7); s.g.parts.burst(s.x, wy, (180, 220, 255), 8, 1.4, 16, 1, 0.1, 1.5)
            s.vy = -6.0; dxx = max(-60.0, min(60.0, t.x - s.x)); s.vx = dxx / 60.0
            s.atk = Atk((-8, -s.h - 2, 16, s.h + 4), s.sp["dmg"] * D()["dmg"], 2.4, ("parry",), 20); s.fly = True
            i = 0
            while True:
                i += 1; s.vy += GRAV * 0.98
                if s.y >= wy and i > 6: break
                yield
            s.fly = False; s.atk = None; s.vx = 0
            s.g.parts.burst(s.x, wy, (180, 220, 255), 8, 1.4, 16, 1, 0.1, 1.5); sfx("splash", 0.5)
            s.vuln = 0
            # snap back home and hide
            s.x = s.hx; s.y = wy + 6
            for _ in range(rest(70)): yield

    def update(s):
        if s.kind == "nakki" and not s.dead:
            # nakki are handled without tile physics
            s.t += 1; s.poise_t -= 1; s.last_hit += 1
            if s.flash > 0: s.flash -= 1
            if s.stun > 0: s.stun -= 1
            if s.gen is None: s.gen = s.brain()
            try: next(s.gen)
            except StopIteration: s.gen = None
            if not s.hidden: s.x += s.vx; s.y += s.vy
            if s.atk: s.atk.t += 1
            if s.hp <= 0 and not s.dead: s.die(None)
            return
        Enemy.update(s)
    def take(s, dmg, kb=0.0, poise=10, pl=None, tags=(), kbu=0.0):
        r = Enemy.take(s, dmg, 0.0 if s.kind == "nakki" else kb, poise, pl, tags, kbu)
        return r
    def hurt_rect(s):
        return (s.x - s.w / 2, s.y - s.h, s.w, s.h)

# ======== p10_boss.py ========

# ---------------- bosses ----------------
class Boss(Enemy):
    boss = True
    def __init__(s, g, key, x, y):
        Enemy.__init__(s, g, key, x, y)
        s.key = key; s.arena = ARENAS[key]; s.engaged = False; s.phase = 1; s.invuln = True; s.armor = True
        s.L = (s.arena["x0"] + 1) * TILE + 12; s.R = s.arena["x1"] * TILE - 12; s.gy = s.arena["ground"] * TILE
        s.face = -1; s.trans_t = 0; s.death_t = 0; s.shown_bar = 0.0
    def engage(s):
        if s.engaged: return
        s.engaged = True; s.gen = None
    def mid_target(s):
        return s.g.nearest_player(s.x, s.y - 10)
    def trans(s):
        s.atk = None; s.warn = 0; s.invuln = True; s.armor = True; s.anim = "roar"; s.vx = 0
        sfx("roar", 1.0); s.g.shake(5, 40)
        for i in range(80):
            s.trans_t = i; s.vx = 0
            if i % 6 == 0: s.g.parts.burst(s.x, s.y - s.h * 0.5, (255, 120, 60), 4, 2.0, 24, 1, 0.0)
            yield
        s.phase = 2; s.invuln = False; s.anim = "idle"
    def die(s, pl):
        s.dead = True; s.gen = None; s.dt = 0; s.atk = None; s.warn = 0; s.anim = "die"; s.invuln = True
        s.g.give_souls(int(s.souls * D()["souls"]), s.x, s.y - s.h)
        s.g.on_boss_dead(s)
    def update(s):
        g = s.g; s.t += 1
        if s.flash > 0: s.flash -= 1
        if s.stag_cd > 0: s.stag_cd -= 1
        if s.vuln > 0: s.vuln -= 1
        if s.dead:
            s.dt += 1
            if s.dt % 5 == 0 and s.dt < 120:
                g.parts.burst(s.x + random.randint(-14, 14), s.y - random.randint(0, int(s.h)), (255, 230, 180), 5, 2.0, 22, 2, 0.02)
                if s.dt % 15 == 0: sfx("boom", 0.6); g.shake(3, 6)
            self_phys = getattr(s, "dead_phys", None)
            if self_phys: self_phys()
            return
        if not s.engaged: s.anim = "idle"; self_idle = getattr(s, "idle_pose", None); self_idle() if self_idle else None; return
        if s.phase == 1 and s.hp <= s.maxhp * 0.5 and s.key!="louhi":
            s.phase = 1.5; s.stun = 0; s.gen = s.trans()
        if s.stun > 0:
            s.stun -= 1; s.vx = 0
            if s.stun == 0 and s.anim == "stagger": s.anim = "idle"
        else:
            if s.gen is None: s.gen = s.brain()
            try: next(s.gen)
            except StopIteration:
                s.gen = None
        if s.atk: s.atk.t += 1
        s.physics()
    def physics(s): pass
    def take(s, dmg, kb=0.0, poise=10, pl=None, tags=(), kbu=0.0):
        return Enemy.take(s, dmg, 0.0, poise, pl, tags, 0.0)
    def pick(s, opts):
        """weighted choice, never the same attack three times in a row"""
        last = getattr(s, "_last", [])
        pool = [(n, w) for n, w in opts if not (len(last) >= 2 and last[-1] == last[-2] == n)]
        r = random.random() * sum(w for _, w in pool)
        for n, w in pool:
            r -= w
            if r <= 0: break
        s._last = (last + [n])[-3:]
        return n

class Hiisi(Boss):
    def __init__(s, g, x, y): Boss.__init__(s, g, "hiisi", x, y)
    def physics(s):
        g = s.g
        vx0 = s.vx; s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
        s.x = max(s.L, min(s.R, s.x)); s.vx = vx0
        if s.vx and abs(s.vx) > 0.05 and not s.atk: s.face = 1 if s.vx > 0 else -1
    def dead_phys(s):
        s.vy = min(MAX_FALL, s.vy + GRAV); move_body(s.g.wd, s)
    def spd(s): return (1.0 if s.phase < 2 else 1.25) * D()["spd"]
    def brain(s):
        if not getattr(s, "intro_done", False):
            s.intro_done = True; s.invuln = True; s.anim = "roar"; sfx("roar", 1.0); s.g.shake(4, 50)
            for i in range(90): s.vx = 0; yield
            s.invuln = False; s.armor = True
        while True:
            t = s.mid_target()
            if t is None: s.anim = "idle"; yield; continue
            s.see(t); ad = abs(t.x - s.x)
            opts = [("slam", 0.4), ("sweep", 0.35), ("charge", 0.25)]
            if s.phase >= 2: opts = [("slam", 0.25), ("sweep", 0.2), ("charge", 0.2), ("rocks", 0.2), ("combo", 0.25)]
            if ad > 150: opts = [("charge", 0.6), ("rocks" if s.phase >= 2 else "slam", 0.4)]
            act = s.pick(opts)
            if act in ("slam", "sweep", "combo") and ad > 62:
                for _ in range(100):
                    t = s.mid_target(); s.see(t); s.anim = "walk"; s.vx = s.face * 0.9 * s.spd()
                    if abs(t.x - s.x) < 56: break
                    yield
                s.vx = 0
            yield from getattr(s, "a_" + act)()
            yield from s.idle(rest(34 if s.phase < 2 else 18))
    def a_slam(s):
        def hook():
            s.g.shake(4, 10); s.g.parts.burst(s.x + s.face * 38, s.y, (160, 140, 120), 12, 2.2, 22, 2, 0.1, 1.0)
            for d in (-1, 1):
                s.g.projs.append(Proj("wave", s.x + s.face * 38 + d * 8, s.y, d * 1.8 * s.spd(), 0, 22 * D()["dmg"], 12, 10, tags=("heavy",), life=130, col=(190, 160, 120)))
        yield from s.attack("slam_w", 46, "slam", 8, 44, (10, -34, 46, 34), s.sp["dmg"] * 1.05, 3.6, ("parry", "heavy"), snd="boom", hook=hook, armor=True)
    def a_sweep(s):
        yield from s.attack("sweep_w", 36, "sweep", 12, 34, (-6, -16, 70, 16), s.sp["dmg"] * 0.85, 3.2, ("parry",), snd="swing2", armor=True)
    def a_combo(s):
        yield from s.a_slam(); s.see(s.mid_target()) if s.mid_target() else None
        yield from s.attack("sweep_w", 20, "sweep", 12, 30, (-6, -16, 70, 16), s.sp["dmg"] * 0.85, 3.2, ("parry",), snd="swing2", armor=True)
    def a_charge(s):
        t = s.mid_target(); s.see(t)
        n = tele(38); s.anim = "charge_w"
        for i in range(n):
            s.vx = 0; s.warn = n - i; s.warn_t = i
            if i % 5 == 0: s.g.parts.burst(s.x, s.y, (160, 140, 120), 3, 1.0, 14, 1, 0.05, 0.6)
            yield
        s.warn = 0; s.anim = "charge"; sfx("roar", 0.8)
        s.atk = Atk((-14, -42, 28, 42), s.sp["dmg"] * D()["dmg"], 4.0, ("heavy",), 40)
        crashed = False
        for i in range(80):
            s.vx = s.face * 3.4 * s.spd()
            if i % 4 == 0: s.g.parts.burst(s.x - s.face * 10, s.y, (150, 130, 110), 2, 1.0, 14, 1, 0.05, 0.6)
            if s.wall or abs(s.x - (s.R if s.face > 0 else s.L)) < 3: crashed = True; break
            yield
        s.atk = None; s.vx = 0
        if crashed:
            s.g.shake(5, 14); sfx("boom", 0.9); s.g.parts.burst(s.x + s.face * 14, s.y - 20, (160, 140, 120), 18, 2.4, 26, 2, 0.1, 1.2)
            s.anim = "stagger"; s.stun = 78; s.vuln = 78; s.armor = False
            yield
            s.armor = True
    def a_rocks(s):
        s.anim = "rock"; n = tele(44); s.vx = 0
        for i in range(n): s.warn = n - i; s.warn_t = i; yield
        s.warn = 0; s.anim = "slam"; sfx("roar", 0.7)
        t = s.mid_target()
        xs = [t.x if t else s.x]
        for k in range(5): xs.append(random.uniform(s.L + 10, s.R - 10))
        for k, x in enumerate(xs):
            s.g.zones.append(Zone(x, s.gy, 20, 150, tele(48) + k * 9, 6, 30 * D()["dmg"], "rock", 2.8))
        for _ in range(30): yield

class Turso(Boss):
    def __init__(s, g, x, y):
        Boss.__init__(s, g, "turso", x, y)
        s.bx = s.R + 4; s.by = s.gy + 10
        s.hx_, s.hy_ = s.bx - 56, s.gy - 74
        s.x, s.y = s.hx_, s.hy_ + 11; s.mouth = 0; s.face = -1
    def idle_pose(s):
        s.x = s.hx_ + math.sin(s.t * 0.04) * 4; s.y = s.hy_ + 11 + math.sin(s.t * 0.06) * 3
    def physics(s):
        if s.anim == "idle" and not s.atk: s.idle_pose()
        if s.wall: s.wall = 0
    def spd(s): return (1.0 if s.phase < 2 else 1.25) * D()["spd"]
    def move_head(s, tx, ty, n, mouth=None):
        sx, sy = s.x, s.y - 11
        for i in range(1, n + 1):
            f = i / n; f = f * f * (3 - 2 * f)
            s.x = sx + (tx - sx) * f; s.y = sy + (ty - sy) * f + 11
            if mouth is not None: s.mouth = mouth
            yield
    def spit_land_fn(s): pass
    def brain(s):
        if not getattr(s, "intro_done", False):
            s.intro_done = True; s.invuln = True; sfx("roar", 1.0); s.g.shake(4, 50); s.mouth = 1
            for i in range(90): s.idle_pose(); yield
            s.mouth = 0; s.invuln = False
        while True:
            s.anim = "idle"; s.mouth = 0
            for i in range(rest(50 if s.phase < 2 else 30)):
                s.idle_pose(); yield
            opts = [("lunge", 0.4), ("geyser", 0.3), ("wave", 0.3)]
            if s.phase >= 2: opts = [("lunge", 0.25), ("geyser", 0.2), ("wave", 0.15), ("spit", 0.25), ("dwave", 0.15)]
            yield from getattr(s, "a_" + s.pick(opts))()
    def a_lunge(s):
        t = s.mid_target()
        tx = max(s.L + 20, min(s.R - 30, t.x if t else s.x)); n = tele(42)
        z = Zone(tx, s.gy, 30, 6, n, 0, 0, "warn"); s.g.zones.append(z); s.anim = "windup"
        sfx("warn", 0.8)
        yield from s.move_head(min(s.R - 10, tx + 70), s.gy - 96, n // 2, 0)
        for i in range(n - n // 2): s.warn = n - n // 2 - i; s.warn_t = i; s.x += random.uniform(-.3, .3); s.mouth = 1 if i > 4 else 0; yield
        s.warn = 0; s.anim = "attack"; s.mouth = 2
        s.atk = Atk((-15, -26, 30, 30), s.sp["dmg"] * D()["dmg"], 3.5, ("heavy",), 30); sfx("roar", 0.7)
        yield from s.move_head(tx, s.gy - 12, 9, 2)
        for i in range(8): yield
        s.atk = None; s.g.shake(3, 8); s.g.parts.burst(s.x, s.gy, (150, 200, 255), 10, 2.0, 20, 1, 0.1, 1.5); sfx("splash", 0.8)
        s.mouth = 1
        s.vuln = 0
        for i in range(tele(96)): s.y += 0; s.x += math.sin(i * 0.5) * 0.2; yield     # stuck: the opening
        yield from s.move_head(s.hx_, s.hy_, 36, 0)
    def a_geyser(s):
        t = s.mid_target(); s.anim = "windup"; s.mouth = 1; sfx("roar", 0.7)
        px = t.x if t else (s.L + s.R) / 2
        xs = [px, px - 46, px + 46] + ([px - 92, px + 92] if s.phase >= 2 else [])
        d0 = tele(52)
        for k, x in enumerate(xs):
            x = max(s.L + 10, min(s.R - 10, x))
            s.g.zones.append(Zone(x, s.gy, 22, 96, d0 + k * 6, 16, s.sp["dmg"] * 0.8 * D()["dmg"], "geyser", 3.0))
        for i in range(d0 + 40): s.idle_pose(); s.warn = 0; yield
        s.mouth = 0
    def a_wave(s):
        s.anim = "windup"; n = tele(34)
        yield from s.move_head(s.hx_ + 6, s.gy - 52, n // 2, 1)
        for i in range(n - n // 2): s.warn = n - n // 2 - i; s.warn_t = i; yield
        s.warn = 0; s.anim = "attack"; s.mouth = 2
        yield from s.move_head(s.bx - 22, s.gy - 14, 8, 2)
        s.g.shake(4, 10); sfx("boom", 0.9)
        s.g.projs.append(Proj("wave", s.bx - 24, s.gy, -2.0 * s.spd(), 0, 24 * D()["dmg"], 14, 12, tags=("heavy",), life=200, col=(120, 200, 255)))
        for i in range(30): yield
        yield from s.move_head(s.hx_, s.hy_, 30, 0)
    def a_dwave(s):
        s.anim = "windup"; n = tele(30)
        yield from s.move_head(s.hx_ + 6, s.gy - 52, n // 2, 1)
        for i in range(n - n // 2): s.warn = n - n // 2 - i; s.warn_t = i; yield
        s.warn = 0; s.mouth = 2
        yield from s.move_head(s.bx - 22, s.gy - 14, 7, 2)
        s.g.shake(4, 10); sfx("boom", 0.9)
        s.g.projs.append(Proj("wave", s.bx - 24, s.gy, -2.0 * s.spd(), 0, 24 * D()["dmg"], 14, 12, tags=("heavy",), life=200, col=(120, 200, 255)))
        for i in range(52): yield
        s.g.shake(4, 10); sfx("boom", 0.9)
        s.g.projs.append(Proj("wave", s.bx - 24, s.gy, -2.0 * s.spd(), 0, 24 * D()["dmg"], 14, 12, tags=("heavy",), life=200, col=(120, 200, 255)))
        for i in range(30): yield
        yield from s.move_head(s.hx_, s.hy_, 30, 0)
    def a_spit(s):
        s.anim = "windup"; n = tele(34); s.mouth = 1
        yield from s.move_head(s.hx_ - 20, s.gy - 86, n // 2, 1)
        for i in range(n - n // 2): s.warn = n - n // 2 - i; s.warn_t = i; yield
        s.warn = 0; s.mouth = 2; sfx("bow", 0.9)
        t = s.mid_target(); tx = t.x if t else s.x - 80
        for k in range(3):
            dx = tx + (k - 1) * 44 - s.x; vx = max(-2.4, min(2.4, dx / 62.0))
            s.g.projs.append(Proj("spit", s.x, s.y - 11, vx, -3.4, 22 * D()["dmg"], 8, 8, tags=("parry", "magic"), life=200, grav=0.11, col=(130, 230, 80)))
        for i in range(40): yield
        yield from s.move_head(s.hx_, s.hy_, 30, 0)
    def draw(s, surf, cx, cy):
        if s.dead and s.dt > 130: return
        hx = int(s.x - cx); hy = int(s.y - 11 - cy)
        if s.dead: hy += s.dt // 2
        turso_draw(surf, 0, 0, int(s.bx - cx), int(s.by - cy), hx, hy, s.t, s.mouth, s.flash > 0, s.phase >= 2)
        if s.warn > 0 and s.warn_t < 12:
            pygame.draw.rect(surf, (255, 60, 50), (hx - 1, hy - 26, 3, 5)); pygame.draw.rect(surf, (255, 60, 50), (hx - 1, hy - 20, 3, 2))
    def hurt_rect(s): return (s.x - 11, s.y - 22, 22, 22)

class Tytti(Boss):
    def __init__(s, g, x, y):
        Boss.__init__(s, g, "tytti", x, y)
        s.fy = s.gy - 8; s.alpha = 255
    def idle_pose(s): s.y = s.fy + math.sin(s.t * 0.06) * 3
    def physics(s):
        s.x = max(s.L, min(s.R, s.x + s.vx)); s.y += s.vy
        if not s.atk and s.anim == "idle": s.vy = 0
    def spd(s): return (1.0 if s.phase < 2 else 1.3) * D()["spd"]
    def brain(s):
        if not getattr(s, "intro_done", False):
            s.intro_done = True; s.invuln = True; s.anim = "cast"; sfx("roar", 0.9); s.g.shake(3, 40)
            for i in range(90): yield
            s.invuln = False
        while True:
            s.anim = "idle"; s.hidden = False; s.invuln = False; s.y = s.fy
            for i in range(rest(54 if s.phase < 2 else 34)): s.idle_pose(); t = s.mid_target(); s.see(t) if t else None; yield
            opts = [("tslash", 0.45), ("orbs", 0.3), ("wave", 0.25)]
            if s.phase >= 2: opts = [("tslash", 0.2), ("orbs", 0.15), ("wave", 0.12), ("beams", 0.3), ("tcombo", 0.23)]
            yield from getattr(s, "a_" + s.pick(opts))()
    def vanish(s, n=14):
        s.invuln = True
        for i in range(n): s.alpha = 255 - int(255 * i / n); s.vx = 0; yield
        s.hidden = True
    def appear_at(s, x, n=26):
        s.x = max(s.L + 16, min(s.R - 16, x)); s.y = s.fy; s.hidden = True
        s.g.zones.append(Zone(s.x, s.gy, 22, 36, n, 0, 0, "ghost"))
        for i in range(n): yield
        s.hidden = False; s.invuln = False; s.alpha = 255; sfx("warn", 0.7); s.g.parts.burst(s.x, s.y - 16, (200, 160, 255), 10, 1.6, 18, 1, 0)
    def a_tslash(s, quick=False):
        t = s.mid_target()
        side = random.choice((-1, 1)); tx = (t.x if t else s.x) + side * 44
        if tx < s.L + 20 or tx > s.R - 20: tx = (t.x if t else s.x) - side * 44
        yield from s.vanish()
        yield from s.appear_at(tx, tele(18 if quick else 26))
        t = s.mid_target()
        if t: s.see(t)
        yield from s.attack("slash_w", 22 if quick else 28, "slash", 10, 30 if not quick else 12, (6, -38, 58, 40), s.sp["dmg"], 3.4, ("parry",), snd="swing2", armor=True)
    def a_tcombo(s):
        yield from s.a_tslash(False); yield from s.a_tslash(True)
    def a_orbs(s):
        s.anim = "cast"; n = tele(34); t = s.mid_target()
        for i in range(n): s.warn = n - i; s.warn_t = i; s.see(t) if t else None; yield
        s.warn = 0; sfx("orb", 0.9)
        t = s.mid_target(); base = math.atan2((t.y - 12 - (s.y - 20)) if t else 0, (t.x - s.x) if t else s.face)
        cnt = 3 if s.phase < 2 else 5
        for k in range(cnt):
            a = base + (k - (cnt - 1) / 2) * 0.32
            s.g.projs.append(Proj("orb", s.x + s.face * 8, s.y - 22, math.cos(a) * 1.5 * s.spd(), math.sin(a) * 1.5 * s.spd(), 22 * D()["dmg"], 8, 8, tags=("parry", "magic"), life=260, col=(220, 120, 255), homing=0.012, hp=1))
        for _ in range(26): yield
    def a_wave(s):
        s.anim = "cast"; n = tele(30)
        for i in range(n): s.warn = n - i; s.warn_t = i; yield
        s.warn = 0; s.anim = "slash"; s.g.shake(3, 8); sfx("boom", 0.7)
        for d in (-1, 1):
            s.g.projs.append(Proj("wave", s.x + d * 8, s.gy, d * 1.9 * s.spd(), 0, 26 * D()["dmg"], 12, 12, tags=("heavy",), life=170, col=(200, 120, 255)))
        for _ in range(34): yield
    def a_beams(s):
        s.anim = "beam"; n = tele(60); s.vx = 0
        t = s.mid_target(); px = t.x if t else s.x
        for vol in range(2):
            d0 = n if vol == 0 else 0
            xs = [s.L + 6 + i * 30 + (15 if vol else 0) for i in range(int((s.R - s.L) // 30))]
            gapx = (t.x if t else px) if vol == 1 else px
            for x in xs:
                if abs(x - gapx) < (26 if vol == 0 else 26): continue
                s.g.zones.append(Zone(x, s.gy, 14, 150, (tele(58) if vol == 0 else tele(58) + 62), 14, 40 * D()["dmg"], "beam", 3.0))
            if vol == 0: sfx("warn", 0.8)
            for i in range(60 if vol == 0 else 30): s.warn = 0; yield
        for _ in range(60): yield
    def draw(s, surf, cx, cy):
        if s.hidden: return
        pose = s.anim if s.anim in ("idle", "slash_w", "slash", "cast", "beam", "stagger", "hurt", "die") else "idle"
        if s.dead: pose = "die"
        spr = tytti_frame(pose, (s.t // 6) % 6 if pose == "idle" else 0, s.face < 0, s.flash > 0, s.phase >= 2)
        w, h = spr.get_size(); x = int(s.x - cx); y = int(s.y - cy)
        if s.alpha < 255 or s.dead:
            spr = spr.copy(); spr.set_alpha(s.alpha if not s.dead else max(0, 255 - s.dt * 2))
        surf.blit(spr, (x - w // 2, y - h + 8))
        if s.warn > 0 and s.warn_t < 12:
            pygame.draw.rect(surf, (255, 60, 50), (x - 1, y - 52, 3, 5)); pygame.draw.rect(surf, (255, 60, 50), (x - 1, y - 46, 3, 2))
    def dead_phys(s):
        s.y = min(s.gy - 2, s.y + 0.3)

BOSS_CLS = {"hiisi": Hiisi, "turso": Turso, "tytti": Tytti}

def _hiisi_draw(s, surf, cx, cy):
    if s.dead and s.dt > 150: return
    pose = s.anim if s.anim in ("idle", "walk", "slam_w", "slam", "sweep_w", "sweep", "charge_w", "charge", "roar", "stagger", "hurt", "die", "rock") else "idle"
    if s.dead: pose = "die"
    if s.anim == "walk" and abs(s.vx) < 0.05: pose = "idle"
    spr = hiisi_frame(pose, (s.t // 6) % 6 if pose in ("walk", "charge") else (s.t // 12) % 2 * 8, s.face < 0, s.flash > 0, s.phase >= 2)
    w, h = spr.get_size(); x = int(s.x - cx); y = int(s.y - cy)
    if s.dead: spr = spr.copy(); spr.set_alpha(max(0, 255 - max(0, s.dt - 80) * 4))
    surf.blit(spr, (x - w // 2, y - h + 3))
    if s.warn > 0 and s.warn_t < 12:
        pygame.draw.rect(surf, (255, 60, 50), (x - 1, y - 66, 3, 5)); pygame.draw.rect(surf, (255, 60, 50), (x - 1, y - 60, 3, 2))
    if s.warn > 0 and s.warn <= 5:
        g2 = spr.copy(); g2.fill((90, 60, 10, 0), special_flags=pygame.BLEND_RGB_ADD); surf.blit(g2, (x - w // 2, y - h + 3))
Hiisi.draw = _hiisi_draw

class Louhi(Boss):
    """Final secret encounter. Large floating eagle; scripted lanes leave fair escape space."""
    def __init__(s,g,x,y):
        Boss.__init__(s,g,"louhi",x,y);s.x=(s.arena["x0"]+14)*16;s.y=s.gy-65;s.fy=s.y;s.darkness=0
    def hurt_rect(s):
        ground=s.y>=s.gy-8
        return (s.x-43,max(s.y-s.h+6,s.gy-150),86,s.gy-max(s.y-s.h+6,s.gy-150)+4)
    def update(s):
        if not s.dead and s.phase in (1,2) and s.hp<=s.maxhp*(.66 if s.phase==1 else .33):
            target=1.5 if s.phase==1 else 2.5;s.phase=target;s.stun=0;s.gen=s.trans(2 if target==1.5 else 3);s.darkness=0.35
        Boss.update(s)
    def physics(s):
        s.x=max(s.L+50,min(s.R-50,s.x+s.vx));s.y=max(s.gy-140,min(s.gy-9,s.y+s.vy));s.atk=None if s.atk and s.atk.t>16 else s.atk
    def trans(s,phase):
        s.atk=None;s.warn=0;s.invuln=True;s.anim="roar";s.vx=s.vy=0;s.g.shake(7,35);sfx("roar",1)
        for i in range(100):
            s.trans_t=i
            if i%7==0:s.g.parts.burst(s.x,s.y-48,(106,139,218),8,2.1,28)
            yield
        s.phase=phase;s.invuln=False;s.darkness=phase-1
    def die(s,pl):
        Boss.die(s,pl)
    def brain(s):
        s.invuln=True;s.anim="roar";sfx("roar",1);s.g.shake(7,65)
        for i in range(100):s.fly_hover();s.warn=max(0,45-i) if i<45 else 0;yield
        s.warn=0;s.invuln=False
        while True:
            t=s.mid_target()
            if t is None:yield;continue
            s.see(t);s.fly_hover()
            opts=[("dive",.3),("frost",.3),("gale",.25),("orbs",.15)]
            if s.phase>=2:opts=[("dive",.22),("frost",.2),("light",.3),("minions",.15),("orbs",.13)]
            if s.phase>=3:opts=[("dive",.25),("frost",.2),("light",.2),("gale",.15),("minions",.1),("combo",.1)]
            yield from getattr(s,"a_"+s.pick(opts))()
            for i in range(rest(36 if s.phase==1 else 22 if s.phase==2 else 13)):s.fly_hover();yield
    def fly_hover(s):
        s.vy=math.sin(s.t*.055)*.18;s.vx=math.sin(s.t*.025)*.2;s.anim="idle"
    def a_dive(s):
        t=s.mid_target();tx=t.x if t else s.x;n=tele(48);s.vx=s.vy=0;s.g.shake(2,6)
        for i in range(n):
            s.anim="windup";s.see(t) if t else None;s.warn=n-i;s.warn_t=i;tx=t.x if t else tx
            for x in (tx-16,tx,tx+16):s.g.parts.add(x,s.gy,0,-.3,1,(255,83,69),1)
            yield
        s.warn=0;s.anim="attack";sfx("roar",.9);sx=s.x
        s.atk=Atk((-45,-38,90,58),s.sp["dmg"]*D()["dmg"]*1.15,4.6,("heavy",),14)
        for i in range(10):s.x=sx+(tx-sx)*i/9;s.y=s.gy-65+(s.gy-(s.gy-65))*i/9;yield
        for i in range(14):s.atk=None; yield
        s.atk=None;sfx("boom",1);s.g.shake(8,15)
        for d in (-1,1):s.g.projs.append(Proj("wave",tx+d*5,s.gy,d*2.7*D()["spd"],0,34*D()["dmg"],13,12,tags=("heavy",),life=120,col=(145,188,235)))
        s.vy=0
        for i in range(25):s.y=s.gy;s.x=max(s.L+30,min(s.R-30,s.x));yield
        for i in range(25):s.y=s.gy+(s.gy-65-s.gy)*i/24;s.x=max(s.L+30,min(s.R-30,s.x));yield
    def a_frost(s):
        t=s.mid_target();n=tele(50);s.vx=s.vy=0
        for i in range(n):s.warn=n-i;s.warn_t=i;s.anim="windup";yield
        s.warn=0;s.anim="attack"
        xs=(([t.x] if t else [s.x])+[s.L+25+(s.R-s.L-50)*(.2 if s.phase<3 else .12),s.L+25+(s.R-s.L-50)*.82])
        for j,x in enumerate(xs):s.g.zones.append(Zone(x,s.gy,36,100,tele(48)+j*10,12,38*D()["dmg"],"beam",3))
        for i in range(55):s.fly_hover();yield
    def a_gale(s):
        t=s.mid_target();s.see(t);n=tele(42)
        for i in range(n):s.vx=s.vy=0;s.warn=n-i;s.warn_t=i;s.anim="windup";yield
        s.warn=0;s.anim="attack"
        for j in range(3+(s.phase>=3)):
            for d in (-1,1):s.g.projs.append(Proj("wave",s.x,s.gy-10,d*(2.7+j*.5)*D()["spd"],0,32*D()["dmg"],14,11,tags=("heavy",),life=110,col=(164,199,239)))
            for i in range(12):yield
    def a_orbs(s):
        t=s.mid_target();n=tele(38)
        for i in range(n):s.warn=n-i;s.warn_t=i;s.anim="windup";yield
        s.warn=0;s.anim="attack"
        for j in range(5+(s.phase-1)*2):
            if t:
                dx=t.x-s.x;dy=t.y-12-(s.y-40);ln=max(1,math.hypot(dx,dy));sp=2.0*D()["spd"]
                s.g.projs.append(Proj("orb",s.x-20+j*10,s.y-38,dx/ln*sp,dy/ln*sp,30*D()["dmg"],7,6,tags=("magic","parry"),life=230,col=(144,115,246),homing=.012,hp=1))
            for i in range(7 if s.phase<3 else 4):yield
    def a_light(s):
        s.darkness=2.8;MUSIC.request("louhi"+("3" if s.phase>=3 else "2"));n=tele(60);t=s.mid_target();safe=t.x if t else s.L+60;s.g.shake(3,12)
        for i in range(n):
            s.warn=n-i;s.warn_t=i;s.anim="windup"
            if i%5==0:
                pygame.draw.circle(s.g.canvas,(239,198,103),(int(safe-s.g.cam[0]),int(s.gy-s.g.cam[1]-12)),26,1)
                s.g.parts.burst(safe,s.gy-15,(224,182,88),5,1.5,22)
            yield
        s.warn=0;s.darkness=0;s.anim="attack"
        for j,x in enumerate([s.L+35,s.L+100,s.L+165,s.R-38]):
            if abs(x-safe)>48:s.g.zones.append(Zone(x,s.gy,58,180,tele(38)+j*3,15,40*D()["dmg"],"beam",3))
        for i in range(58):s.fly_hover();yield
    def a_minions(s):
        s.anim="roar";s.g.projs.append(Proj("orb",s.x,s.y-45,0,0,0,0,0,tags=(),life=1,col=(0,0,0)))
        n=2 if s.phase<3 else 3
        for j in range(n):
            x=max(s.L+20,min(s.R-20,s.x+(j-1)*50));e=Mob(s.g,"virvatuli",x,s.gy-32,1000+j+int(s.t));e.sp=dict(hp=24,w=12,h=20,souls=0,poise=0,spd=.4,wake=99999,dmg=25);e.maxhp=e.hp=24;s.g.enemies.append(e)
        s.g.msg(tr("louhi_minions"),(194,171,240))
        for i in range(38):s.fly_hover();yield
    def a_combo(s):
        yield from s.a_dive();yield from s.a_frost()
    def draw(s,surf,cx,cy):
        spr=louhi_frame(s.anim,(s.t//8)%4,s.flash>0,3 if s.phase>=2.5 else 2 if s.phase>=1.5 else 1)
        x=int(s.x-cx-spr.get_width()/2);y=int(s.y-cy-spr.get_height());
        if s.darkness:
            s.g.black.fill((3,3,18));s.g.black.set_alpha(int(64*s.darkness));surf.blit(s.g.black,(0,0))
        surf.blit(spr,(x,y))
BOSS_CLS["louhi"]=Louhi

# ======== p11_player.py ========

# ---------------- input ----------------
# Face / shoulder mapping is identical for every device:
#   Cross/A = jump, Circle/B = dodge, Square/X = light, Triangle/Y = heavy,
#   L1 = guard, R1 = skill, R2 or D-pad down = flask, Options = start, Share = back.
# GameController path preferred; raw joystick uses the Linux hid-playstation layout that matches it.
# Per-device instance id; never hardcode joystick 0 or split one pad across two players.
class Pad:
    KEYS = ("up", "jump", "light", "heavy", "dodge", "guard", "skill", "flask", "start", "back", "left", "right", "down")
    # raw hid-playstation / DualShock face+shoulder indices (== SDL GameController South,East,West,North,L1,R1,R2,Share,Options)
    RAW = dict(jump=0, dodge=1, light=2, heavy=3, guard=4, skill=5, flask=7, back=8, start=9)
    def __init__(self, kind, dev=None, iid=None, joy=None):
        self.kind, self.dev, self.joy = kind, dev, joy
        self.prev = self.blank(); self.cur = self.blank()
        if kind == "kb": self.id = "kb"
        elif iid is not None: self.id = "js%d" % iid
        else: self.id = "js%s" % (joy.get_instance_id() if joy is not None else (dev.get_instance_id() if hasattr(dev, "get_instance_id") else id(self)))
        self.rep = {}
    def blank(self):
        c = {k: False for k in self.KEYS}; c["x"] = 0.0; c["y"] = 0.0; return c
    def _apply_face(self, c, jump, dodge, light, heavy, guard, skill, flask, start, back):
        c.update(jump=bool(jump), dodge=bool(dodge), light=bool(light), heavy=bool(heavy),
                 guard=bool(guard), skill=bool(skill), flask=bool(flask), start=bool(start), back=bool(back))
    def poll(self, ks):
        c = self.blank()
        try:
            if self.kind == "kb":
                c["x"] = float(ks[pygame.K_RIGHT] - ks[pygame.K_LEFT]); c["y"] = float(ks[pygame.K_DOWN] - ks[pygame.K_UP])
                c.update(up=bool(ks[pygame.K_UP]), down=bool(ks[pygame.K_DOWN]), left=bool(ks[pygame.K_LEFT]), right=bool(ks[pygame.K_RIGHT]))
                self._apply_face(c, ks[pygame.K_z] or ks[pygame.K_SPACE], ks[pygame.K_v], ks[pygame.K_x], ks[pygame.K_c],
                                 ks[pygame.K_a], ks[pygame.K_s], ks[pygame.K_d], ks[pygame.K_RETURN], ks[pygame.K_TAB])
            elif self.kind == "gc":
                g = self.dev; P = pygame
                ax = g.get_axis(P.CONTROLLER_AXIS_LEFTX) / 32768.0; ay = g.get_axis(P.CONTROLLER_AXIS_LEFTY) / 32768.0
                b = g.get_button
                if b(P.CONTROLLER_BUTTON_DPAD_LEFT): ax = -1.0
                if b(P.CONTROLLER_BUTTON_DPAD_RIGHT): ax = 1.0
                if b(P.CONTROLLER_BUTTON_DPAD_UP): ay = -1.0
                if b(P.CONTROLLER_BUTTON_DPAD_DOWN): ay = 1.0
                self._fill_axes(c, ax, ay)
                trig = False
                try: trig = g.get_axis(P.CONTROLLER_AXIS_TRIGGERRIGHT) > 12000
                except (pygame.error, SystemError): pass
                self._apply_face(c, b(P.CONTROLLER_BUTTON_A), b(P.CONTROLLER_BUTTON_B), b(P.CONTROLLER_BUTTON_X), b(P.CONTROLLER_BUTTON_Y),
                                 b(P.CONTROLLER_BUTTON_LEFTSHOULDER), b(P.CONTROLLER_BUTTON_RIGHTSHOULDER),
                                 c["down"] or trig, b(P.CONTROLLER_BUTTON_START), b(P.CONTROLLER_BUTTON_BACK))
            else:    # raw joystick, same layout as GameController face buttons
                j = self.dev
                ax = j.get_axis(0) if j.get_numaxes() > 0 else 0.0; ay = j.get_axis(1) if j.get_numaxes() > 1 else 0.0
                if j.get_numhats() > 0:
                    hx, hy = j.get_hat(0)
                    if hx: ax = float(hx)
                    if hy: ay = -float(hy)          # SDL hat: up = +1
                self._fill_axes(c, ax, ay)
                nb = j.get_numbuttons(); b = lambda i: nb > i and bool(j.get_button(i)); R = Pad.RAW
                self._apply_face(c, b(R["jump"]), b(R["dodge"]), b(R["light"]), b(R["heavy"]), b(R["guard"]), b(R["skill"]),
                                 b(R["flask"]) or c["down"], b(R["start"]), b(R["back"]))
        except (pygame.error, SystemError):
            pass
        self.prev, self.cur = self.cur, c
    def _fill_axes(self, c, ax, ay):
        c["x"] = ax if abs(ax) > 0.25 else 0.0
        c["y"] = ay if abs(ay) > 0.5 else 0.0
        c["left"] = c["x"] < -0.5; c["right"] = c["x"] > 0.5; c["up"] = c["y"] < -0.5; c["down"] = c["y"] > 0.5
    def pressed(self, k): return bool(self.cur.get(k)) and not self.prev.get(k)
    def held(self, k): return bool(self.cur.get(k))
    def nav(self, k):
        if self.pressed(k): self.rep[k] = 0; return True
        if self.held(k):
            self.rep[k] = self.rep.get(k, 0) + 1
            if self.rep[k] > 22 and self.rep[k] % 5 == 0: return True
        return False

class IdlePad(Pad):
    def __init__(self): Pad.__init__(self, "idle"); self.id = "idle%d" % id(self)
    def poll(self, ks): self.prev, self.cur = self.cur, self.blank()

class ScriptPad(Pad):
    """Used by tests: set .nextc (or .cur) directly. Same KEYS as a real pad."""
    def __init__(self, name="script"):
        Pad.__init__(self, "script"); self.id = name; self.cur = self.blank(); self.prev = self.blank(); self.nextc = None
    def poll(self, ks):
        self.prev = self.cur; self.cur = self.nextc if self.nextc is not None else self.blank()

class FakeJoyPad(Pad):
    """Test stand-in for a physical stick. Push the same button/axis events P1 and P2 would see."""
    def __init__(self, name, via="gc"):
        Pad.__init__(self, "fake"); self.id = name; self.via = via
        self.axes = [0.0] * 6; self.buttons = [0] * 16; self.hat = (0, 0)
        self.cur = self.blank(); self.prev = self.blank()
    def set_button(self, name, v=1):
        """name is a logical action OR a raw index. Logical names use the shared RAW/GC mapping."""
        if name in Pad.RAW: self.buttons[Pad.RAW[name]] = int(bool(v))
        elif name == "dpad_up": self.hat = (self.hat[0], 1 if v else 0)
        elif name == "dpad_down": self.hat = (self.hat[0], -1 if v else 0)
        elif name == "dpad_left": self.hat = (-1 if v else 0, self.hat[1])
        elif name == "dpad_right": self.hat = (1 if v else 0, self.hat[1])
        elif isinstance(name, int): self.buttons[name] = int(bool(v))
    def set_stick(self, x=0.0, y=0.0): self.axes[0] = x; self.axes[1] = y
    def poll(self, ks):
        # Always go through the same apply path as a real pad of the chosen kind.
        c = self.blank(); b = lambda i: i < len(self.buttons) and bool(self.buttons[i]); R = Pad.RAW
        ax, ay = self.axes[0], self.axes[1]
        hx, hy = self.hat
        if hx: ax = float(hx)
        if hy: ay = -float(hy)
        self._fill_axes(c, ax, ay)
        self._apply_face(c, b(R["jump"]), b(R["dodge"]), b(R["light"]), b(R["heavy"]), b(R["guard"]), b(R["skill"]),
                         b(R["flask"]) or c["down"], b(R["start"]), b(R["back"]))
        self.prev, self.cur = self.cur, c

_FLIP = {}
def flipped(surf):
    k = id(surf)
    f = _FLIP.get(k)
    if f is None or f[0] is not surf:
        f = (surf, pygame.transform.flip(surf, True, False)); _FLIP[k] = f
    return f[1]

# ---------------- classes ----------------
CLS = {
    "warrior": dict(hp=120, st=100, foc=0, flask=0.45),
    "sage":    dict(hp=80, st=90, foc=100, flask=0.45),
    "hunter":  dict(hp=95, st=105, foc=0, flask=0.45),
}
# attack tables: st=startup frames, ac=active, rc=recover, stam, rel hitbox (fwd, y, w, h)
ATK = {
    "warrior": {
        "light": [dict(st=6, ac=4, rc=11, dmg=14, rel=(2, -20, 25, 16), kb=1.6, poise=10, stam=14, step=0.9, anim="atk1", snd="swing"),
                  dict(st=5, ac=4, rc=12, dmg=14, rel=(2, -18, 25, 16), kb=1.6, poise=10, stam=14, step=0.9, anim="atk2", snd="swing"),
                  dict(st=8, ac=5, rc=18, dmg=23, rel=(2, -24, 30, 22), kb=3.0, poise=22, stam=20, step=1.5, anim="atk3", snd="swing2")],
        "heavy": dict(st=18, ac=5, rc=24, dmg=40, rel=(2, -26, 32, 26), kb=3.6, poise=36, stam=32, step=1.0, anim="heavy", snd="swing2", tags=("heavy",)),
    },
    "sage": {
        "light": [dict(st=8, ac=2, rc=12, dmg=12, fire="bolt", foc=4, stam=6, anim="atk1", snd="bolt")],
        "heavy": dict(st=22, ac=2, rc=22, dmg=30, fire="orb", foc=16, stam=14, anim="cast", snd="orb", tags=("heavy",)),
        "melee": dict(st=6, ac=4, rc=12, dmg=8, rel=(2, -22, 24, 14), kb=1.4, poise=8, stam=10, step=0.5, anim="atk1", snd="swing"),
    },
    "hunter": {
        "light": [dict(st=3, ac=3, rc=8, dmg=9, rel=(2, -16, 20, 14), kb=0.8, poise=7, stam=9, step=1.0, anim="atk1", snd="swing"),
                  dict(st=3, ac=3, rc=10, dmg=9, rel=(2, -16, 20, 14), kb=0.8, poise=7, stam=9, step=1.0, anim="atk2", snd="swing"),
                  dict(st=4, ac=4, rc=14, dmg=14, rel=(2, -18, 24, 16), kb=1.6, poise=12, stam=12, step=1.6, anim="atk3", snd="swing2")],
        "heavy": dict(st=10, ac=5, rc=18, dmg=26, rel=(0, -18, 28, 14), kb=2.4, poise=24, stam=24, step=3.0, anim="heavy", snd="swing2", tags=("heavy",)),
    },
}
ROLL = {"warrior": dict(dur=22, i0=3, i1=16, sp=2.7, stam=20), "sage": dict(dur=22, i0=3, i1=13, sp=2.6, stam=22),
        "hunter": dict(dur=26, i0=3, i1=20, sp=3.3, stam=18)}
CHARM_NAMES = ("c_bear", "c_wolf", "c_moss", "c_ember")

class Player(Body):
    def __init__(s, g, idx, pad, ch):
        Body.__init__(s, 0, 0, PW_, PH_)
        s.g = g; s.idx = idx; s.pad = pad; s.ch = ch; s.cls = ch["cls"]
        s.state = "free"; s.st_t = 0; s.face = 1; s.hp = 1.0; s.stam = 1.0; s.focus = 0.0
        s.inv = 0; s.flash = 0; s.atk = None; s.act = None; s.combo = 0; s.combo_t = 0; s.buf = None; s.buf_t = 0
        s.stam_delay = 0; s.stun = 0; s.guard_t = 0; s.drink_t = 0; s.flasks = 0
        s.down_t = 0; s.revive_t = 0; s.safe = (0, 0); s.safe_t = 0; s.draw_t = 0; s.ward = 0; s.roll_dir = 1
        s.nearby = None; s.blocked_flash = 0; s.dealt = 0; s.exh = 0; s.air_atk = False; s.climb = False; s.t = 0; s.carry_souls = 0
        s.recalc(); s.hp = s.maxhp; s.stam = s.maxst; s.focus = s.maxfoc
    @property
    def souls(s): return s.ch.get("souls", 0)
    @souls.setter
    def souls(s, v): s.ch["souls"] = max(0, min(99999999, int(v)))
    # ----- derived stats -----
    @property
    def taken(s): return s.g.save["taken"]
    def has(s, k): return k in s.taken
    def recalc(s):
        c = CLS[s.cls]; st = s.ch["stats"]
        s.maxhp = c["hp"] + 10 * st["vit"] + (20 if s.has("c_moss") else 0)
        s.maxst = c["st"] + 6 * st["end"]
        s.maxfoc = (c["foc"] + 10 * st["foc"]) if s.cls == "sage" else 0
        s.dmgm = (1 + 0.08 * st["str"]) * (1.15 if s.has("c_bear") else 1.0) * (1.25 if s.ward > 0 else 1.0)
        s.spellm = (1 + 0.08 * st["foc"] + 0.04 * st["str"]) * (1.15 if s.has("c_bear") else 1.0) * (1.25 if s.ward > 0 else 1.0)
        s.bowm = (1 + 0.04 * st["str"] + 0.08 * st["foc"]) * (1.15 if s.has("c_bear") else 1.0) * (1.25 if s.ward > 0 else 1.0)
        s.regen = 0.55 * (1.3 if s.has("c_wolf") else 1.0)
        s.flask_max = 3 + (1 if s.has("flask1") else 0) + (1 if s.has("flask2") else 0)
        s.flask_pct = CLS[s.cls]["flask"] + (0.25 if s.has("flaskpow") else 0.0)
        s.dj_ok = s.has("feather")
        s.poise_b = 3 * st["foc"] if s.cls == "warrior" else 0
        s.block_eff = 1.0 - (0.03 * st["foc"] if s.cls == "warrior" else 0.0)
        s.roll_cost = ROLL[s.cls]["stam"] * (0.7 if s.has("c_ember") else 1.0) * (1.0 - (0.03 * st["foc"] if s.cls == "hunter" else 0.0))
        s.hp = min(s.hp, s.maxhp); s.stam = min(s.stam, s.maxst); s.focus = min(s.focus, s.maxfoc)
    def refill(s):
        s.recalc(); s.hp = s.maxhp; s.stam = s.maxst; s.focus = s.maxfoc; s.flasks = s.flask_max
    def alive(s): return s.state not in ("dead", "down")
    @property
    def level(s): return 1 + sum(s.ch["stats"].values())
    def hurt_rect(s): return (s.x - 5, s.y - 18, 10, 18)
    def spawn(s, x, y):
        s.x = float(x); s.y = float(y); s.vx = s.vy = 0.0; s.state = "free"; s.st_t = 0; s.atk = None; s.act = None; s.inv = 40; s.climb = False
        s.stun = 0; s.safe = (x, y); s.buf = None; s.drink_t = 0; s.on_ground = False; s.revive_t = 0
    # ----- resources -----
    def spend(s, n):
        s.stam = max(0.0, s.stam - n); s.stam_delay = 36 if s.stam > 0 else 70
    # ----- damage in -----
    def take_hit(s, dmg, sx, kb=2.0, tags=(), src=None):
        if s.state in ("dead", "down") or s.inv > 0: return False
        g = s.g; tags = set(tags)
        facing_src = (sx >= s.x) == (s.face > 0) or abs(sx - s.x) < 3
        # parry / block (warrior guard)
        if s.state == "guard" and facing_src:
            win = int(11 * D()["parry"])
            if s.guard_t < win and "parry" in tags:
                sfx("parry", 1.0); g.hitstop = max(g.hitstop, 8); s.flash = 3; g.shake(2, 6)
                g.parts.burst(s.x + s.face * 8, s.y - 12, (255, 240, 160), 14, 2.4, 20)
                if isinstance(src, Enemy): src.stagger(60 if src.boss else 80)
                elif isinstance(src, Proj): src.enemy = False; src.vx *= -1.4; src.vy *= -1.4; src.pid = s.idx; src.hit = set(); src.tags.add("reflected")
                s.stam = min(s.maxst, s.stam + 25); s.inv = 12
                g.dnum(s.x, s.y - 26, tr("parry"), (255, 240, 160))
                return True
            cost = dmg * 0.55 * s.block_eff + 6
            if "heavy" in tags: cost *= 1.4
            if s.stam >= cost:
                s.spend(cost); sfx("block", 0.9); g.hitstop = max(g.hitstop, 3); s.vx = -s.face * kb * 0.5 if sx > s.x else s.face * -kb * 0.5
                s.blocked_flash = 6; g.parts.burst(s.x + s.face * 7, s.y - 11, (255, 255, 220), 6, 1.8, 12)
                chip = dmg * 0.12
                s.hp -= chip
                if s.hp <= 0: s.die()
                return True
            s.stam = 0; s.stam_delay = 90; dmg *= 0.7; s.stun = 26; s.state = "hurt"; s.st_t = 0   # guard break
            sfx("hurt", 1.0)
        else:
            s.state = "hurt"; s.st_t = 0
            s.stun = 14 if "heavy" not in tags else 22
        if s.state == "hurt" and s.act is not None: s.act = None
        s.atk = None; s.drink_t = 0; s.draw_t = 0; s.climb = False; s.buf = None
        s.hp -= dmg; s.flash = 6; s.inv = 40
        s.vx = kb * (1 if s.x >= sx else -1) * 1.3; s.vy = -2.2; s.on_ground = False
        sfx("hurt", 1.0); g.hitstop = max(g.hitstop, 6); g.shake(3, 8)
        g.parts.burst(s.x, s.y - 10, (200, 40, 50), 8, 1.8, 18, 1, 0.08)
        g.dnum(s.x, s.y - 26, int(round(dmg)), (255, 90, 90), player=True)
        if s.hp <= 0: s.die()
        return True
    def die(s):
        s.hp = 0; s.atk = None; s.act = None; s.drink_t = 0; s.climb = False
        s.g.player_down(s)
    # ----- actions -----
    def start_act(s, kind, spec, **kw):
        s.state = "act"; s.st_t = 0; s.act = dict(spec); s.act["kind"] = kind; s.act.update(kw); s.atk = None
        s.combo_t = 0
        if "stam" in spec: s.spend(spec["stam"])
        if "foc" in spec: s.focus = max(0.0, s.focus - spec["foc"])
    def can(s, stam=1, foc=0): return s.stam >= min(stam, 1) and s.focus >= foc
    def want(s, name):
        s.buf = name; s.buf_t = 12
    def try_action(s, name):
        """returns True if the action started."""
        c = s.cls; tbl = ATK[c]
        if name == "dodge":
            if s.stam < 1: return False
            r = ROLL[c]; s.state = "roll"; s.st_t = 0; s.atk = None; s.act = None; s.spend(s.roll_cost)
            ix = s.pad.cur["x"]
            s.roll_dir = (1 if ix > 0 else -1) if abs(ix) > 0.3 else s.face
            s.face = s.roll_dir; s.climb = False; sfx("roll", 0.7); return True
        if name == "flask":
            if s.flasks <= 0 or s.hp >= s.maxhp or not s.on_ground: return False
            s.state = "drink"; s.st_t = 0; s.flasks -= 1; s.drink_t = 0; sfx("flask", 0.8); return True
        if name in ("light", "heavy"):
            if s.stam < 1 and c != "sage": return False
            if name == "heavy":
                if c == "sage" and s.focus < tbl["heavy"]["foc"]: return False
                s.start_act("heavy", tbl["heavy"]); return True
            if c == "sage":
                sp = tbl["light"][0]
                if s.focus < sp["foc"]: sp = tbl["melee"]
                s.start_act("light", sp); return True
            sp = tbl["light"][s.combo % len(tbl["light"])]
            s.start_act("light", sp); s.combo += 1; return True
        if name == "guard":
            if c == "warrior":
                if not s.on_ground: return False
                s.state = "guard"; s.st_t = 0; s.guard_t = 0; s.vx = 0; return True
            if c == "sage":
                if s.focus < 45 or not s.on_ground: return False
                s.focus -= 45; s.state = "kantele"; s.st_t = 0; sfx("kantele", 0.9); return True
            if c == "hunter":
                if s.stam < 1: return False
                s.start_act("flip", dict(st=4, ac=22, rc=6, stam=20, anim="shoot"))
                s.vx = -s.face * 3.2; s.vy = -3.0; s.on_ground = False; s.inv = max(s.inv, 10); return True
        if name == "skill":
            if c == "warrior":
                if s.stam < 1: return False
                s.start_act("bash", dict(st=8, ac=4, rc=14, dmg=10, rel=(2, -20, 20, 18), kb=4.5, poise=60, stam=22, step=1.8, anim="bash", snd="swing", tags=("bash",)))
                return True
            if c == "sage":
                if s.focus < 25: return False
                s.start_act("nova", dict(st=10, ac=3, rc=18, dmg=22, foc=25, stam=10, anim="cast", snd="boom"))
                return True
            if c == "hunter":
                if s.stam < 1: return False
                s.state = "draw"; s.st_t = 0; s.draw_t = 0; return True
        return False
    # ----- per frame -----
    def update(s):
        s.g.pending_action={a for a in ("jump","light","heavy","dodge") if s.pad.pressed(a)}
        g = s.g; pad = s.pad; c = pad.cur; s.t += 1
        if s.flash > 0: s.flash -= 1
        if s.blocked_flash > 0: s.blocked_flash -= 1
        if s.ward > 0: s.ward -= 1; s.recalc() if s.ward in (0, 1799) else None
        if s.state == "dead": return
        if s.state == "down":
            s.down_t -= 1; s.vx *= 0.8
            s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
            if s.down_t <= 0: s.state = "dead"; g.on_player_dead(s)
            return
        if s.inv > 0: s.inv -= 1
        if s.buf_t > 0:
            s.buf_t -= 1
            if s.buf_t == 0: s.buf = None
        if s.combo_t > 0:
            s.combo_t -= 1
            if s.combo_t == 0: s.combo = 0
        # stamina / focus
        if s.stam_delay > 0: s.stam_delay -= 1
        elif s.stam < s.maxst:
            r = s.regen * (0.45 if s.state == "guard" else 1.0) * (1.0 if s.on_ground or s.climb else 0.6)
            s.stam = min(s.maxst, s.stam + r)
        if s.cls == "sage" and s.focus < s.maxfoc: s.focus = min(s.maxfoc, s.focus + 0.018)
        if g.state_name == "play" and s.t % 6 == 0: pass
        mode = SETTINGS["runmode"]
        ixr = c["x"]; ix = (ixr if mode == "analog" and abs(ixr) > 0.25 else (1.0 if ixr > 0.25 else -1.0 if ixr < -0.25 else 0.0))
        if mode == "analog" and ix: ix = math.copysign(0.45 + 0.55 * min(1.0, (abs(ixr) - 0.25) / 0.6), ix)
        iy = c["y"] if abs(c["y"]) > 0.5 else 0.0
        # inputs -> buffered actions
        for k in ("light", "heavy", "dodge", "guard", "skill", "flask"):
            if pad.pressed(k): s.want(k)
        jp = pad.pressed("jump"); jh = pad.held("jump")
        st = s.state
        if st == "free": s.upd_free(ix, iy, jp, jh)
        elif st == "act": s.upd_act(ix, iy, jp, jh)
        elif st == "roll": s.upd_roll()
        elif st == "guard": s.upd_guard(ix)
        elif st == "hurt": s.upd_hurt()
        elif st == "drink": s.upd_drink(ix)
        elif st == "kantele": s.upd_kantele()
        elif st == "draw": s.upd_draw(ix)
        # safe spot tracking
        if s.on_ground and not s.climb and s.state in ("free", "act", "guard") and not hazard_at(g.wd, s):
            s.safe_t += 1
            if s.safe_t > 24 and g.safe_ok(s): s.safe = (s.x, s.y)
        else: s.safe_t = 0 if not s.on_ground else s.safe_t
    # --- states ---
    def phys(s, fric=0.82, grav=True):
        g = s.g
        if grav: s.vy = min(MAX_FALL, s.vy + GRAV)
        if s.on_ground: s.vx *= fric
        move_body(g.wd, s)
    def upd_free(s, ix, iy, jp, jh):
        g = s.g; pad = s.pad
        # buffered actions
        if s.buf and not s.climb:
            b = s.buf
            if s.try_action(b): s.buf = None; return
            if b in ("flask",) : s.buf = None
        if s.climb and s.buf in ("dodge",) and s.try_action("dodge"): s.buf = None; return
        # interaction
        if pad.pressed("up") and s.nearby and not ladder_overlap(g.wd, s):
            g.interact(s, s.nearby)
        drop = bool(pad.held("down") and jp)
        if drop: jp = False
        if ix: s.face = 1 if ix > 0 else -1
        s.run_speed = RUN
        ev = walk_step(g.wd, s, ix, iy, jp, jh, s.dj_ok, drop)
        if "jump" in ev: sfx("jump", 0.5); g.parts.burst(s.x, s.y, (200, 200, 190), 3, 0.6, 10, 1, 0.0)
        if "djump" in ev: sfx("djump", 0.6); g.parts.burst(s.x, s.y, (190, 230, 255), 8, 1.0, 14, 1, 0.0)
        if "land" in ev: sfx("land", 0.4)
        s.combo_t = s.combo_t  # keep
    def upd_act(s, ix, iy, jp, jh):
        g = s.g; a = s.act; t = s.st_t; s.st_t += 1; kind = a["kind"]
        st, ac, rc = a["st"], a["ac"], a["rc"]
        total = st + ac + rc
        # movement during action
        if kind == "flip":
            s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
            if t == st:
                s.fire_arrow(10 * s.bowm, 3.4, 0, 0, poise=8, n=3, spread=0.12)
            if s.on_ground and t > 6: s.vx *= 0.7
            if t >= total or (s.on_ground and t > 10): s.end_act()
            return
        if t < st: s.vx *= 0.8
        if st <= t < st + ac and "step" in a: s.vx = s.face * a["step"]
        s.vy = min(MAX_FALL, s.vy + GRAV); 
        if s.on_ground: s.vx *= 0.85
        move_body(g.wd, s)
        # fire at the first active frame
        if t == st:
            if "fire" in a: s.fire_spell(a)
            elif kind == "nova": s.nova(a)
            elif "rel" in a:
                tags = set(a.get("tags", ())); dm = a["dmg"] * s.dmgm
                s.atk = Atk(a["rel"], dm, a["kb"], tags, a["poise"] + s.poise_b, pid=s.idx)
                sfx(a.get("snd", "swing"), 0.8)
        if "rel" in a and st <= t < st + ac and s.atk: s.melee_hits()
        if t == st + ac: s.atk = None
        # cancel into roll after active frames
        if t >= st + ac and s.buf == "dodge" and s.stam >= 1:
            s.atk = None; s.act = None
            if s.try_action("dodge"): s.buf = None; return
        if t >= st + ac and s.buf in ("light", "heavy", "guard", "skill", "flask") and t >= st + ac + max(2, rc // 3):
            s.atk = None; s.act = None; s.state = "free"
            if s.try_action(s.buf): s.buf = None; return
        if s.atk is None and t >= st and kind == "light" and "rel" in a: s.combo_t = 22 + rc
        if t >= total: s.end_act()
    def end_act(s):
        s.state = "free"; s.act = None; s.atk = None
    def melee_hits(s):
        g = s.g; a = s.atk
        rect = a.rect(s.x, s.y, s.face)
        for e in g.enemies:
            if e.dead or e.hidden or e.invuln or id(e) in a.hit: continue
            if ov(rect, e.hurt_rect()):
                a.hit.add(id(e)); tg = set(a.tags)
                dm = a.dmg
                if e.take(dm, a.kb * s.face, a.poise, s, tg, 0.0):
                    if s.cls == "sage": s.focus = min(s.maxfoc, s.focus + 3)
                    if "bash" in a.tags: e.stun = max(e.stun, 40) if not e.boss and e.poise_max < 100 else e.stun
        g.poke_secret(rect)
        for p in g.projs:
            if p.enemy and p.kind in ("orb", "spit") and ov(rect, p.rect()):
                p.dead = True; g.parts.burst(p.x, p.y, p.col, 8, 1.6, 16); sfx("parry", 0.5)
    def fire_spell(s, a):
        g = s.g; sp = 3.6
        if a["fire"] == "bolt":
            g.projs.append(Proj("bolt", s.x + s.face * 8, s.y - 13, s.face * sp, 0, a["dmg"] * s.spellm, 6, 5, enemy=False, life=70, tags=(), pid=s.idx, poise=7, col=(150, 255, 230)))
        else:
            g.projs.append(Proj("orb", s.x + s.face * 8, s.y - 13, s.face * 2.4, 0, a["dmg"] * s.spellm, 11, 11, enemy=False, life=110, tags=("heavy",), pid=s.idx, pierce=2, poise=22, col=(110, 255, 210)))
        sfx(a.get("snd", "bolt"), 0.8); g.parts.burst(s.x + s.face * 9, s.y - 13, (150, 255, 230), 4, 0.8, 10)
    def nova(s, a):
        g = s.g
        rect = (s.x - 28, s.y - 30, 56, 32); sfx("boom", 0.7); g.shake(2, 6)
        for k in range(18):
            ang = k / 18 * 6.283; g.parts.add(s.x, s.y - 12, math.cos(ang) * 2.0, math.sin(ang) * 1.4, 18, (150, 255, 230), 2)
        for e in g.enemies:
            if e.dead or e.hidden or e.invuln: continue
            if ov(rect, e.hurt_rect()):
                if e.take(a["dmg"] * s.spellm, 4.5 * (1 if e.x >= s.x else -1), 40, s, ("heavy",), 1.5): s.focus = min(s.maxfoc, s.focus + 3)
        for p in g.projs:
            if p.enemy and ov(rect, p.rect()): p.dead = True; g.parts.burst(p.x, p.y, p.col, 6, 1.4, 14)
    def fire_arrow(s, dmg, speed, vy, charge, poise=8, n=1, spread=0.0):
        g = s.g
        for k in range(n):
            ang = (k - (n - 1) / 2) * spread
            vx = math.cos(ang) * speed * s.face; vyy = math.sin(ang) * speed + vy
            g.projs.append(Proj("parrow", s.x + s.face * 8, s.y - 12, vx, vyy, dmg, 8, 4, enemy=False, life=70, pid=s.idx, poise=poise,
                                pierce=2 if charge else 0, tags=("heavy",) if charge else (), col=(240, 230, 190)))
        sfx("arrow", 0.8)
    def upd_roll(s):
        g = s.g; r = ROLL[s.cls]; t = s.st_t; s.st_t += 1
        f = 1.0 - 0.45 * (t / r["dur"])
        s.vx = s.roll_dir * r["sp"] * f
        if r["i0"] <= t <= r["i1"]: s.inv = max(s.inv, 2)
        s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
        if s.wall: s.vx = 0
        if t % 5 == 2 and s.on_ground: g.parts.add(s.x - s.roll_dir * 4, s.y - 1, 0, -0.2, 10, (170, 170, 160), 1)
        if t >= r["dur"]:
            s.state = "free"; s.vx *= 0.3
            s.inv = max(s.inv, 0)
    def upd_guard(s, ix):
        g = s.g
        s.guard_t += 1; s.vx *= 0.6
        if abs(ix) > 0: s.face = 1 if ix > 0 else -1; s.vx = ix * 0.5
        s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
        if not s.pad.held("guard") or not s.on_ground: s.state = "free"; s.guard_t = 0; return
        if s.buf == "dodge": 
            if s.try_action("dodge"): s.buf = None
        elif s.buf in ("light", "heavy", "skill"):
            nm = s.buf; s.state = "free"
            if s.try_action(nm): s.buf = None
    def upd_hurt(s):
        g = s.g; s.stun -= 1
        s.vy = min(MAX_FALL, s.vy + GRAV); s.vx *= 0.92; move_body(g.wd, s)
        if s.stun <= 0 and s.on_ground or s.stun < -20: s.state = "free"; s.stun = 0
    def upd_drink(s, ix):
        g = s.g; t = s.st_t; s.st_t += 1
        s.vx = ix * 0.35 if ix else s.vx * 0.5
        s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
        if t == 24:
            s.hp = min(s.maxhp, s.hp + s.maxhp * s.flask_pct * D()["flask"]); sfx("heal", 0.8)
            g.parts.burst(s.x, s.y - 10, (255, 220, 140), 10, 1.0, 22, 1, -0.02, 0.5)
        if t >= 42: s.state = "free"
        elif s.buf == "dodge" and t >= 24:
            if s.try_action("dodge"): s.buf = None
    def upd_kantele(s):
        g = s.g; t = s.st_t; s.st_t += 1; s.vx = 0
        s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
        if t % 8 == 0: sfx("kantele", 0.5); g.parts.burst(s.x, s.y - 20, (255, 235, 150), 3, 0.7, 24, 1, -0.02, 0.4)
        if t == 40:
            for p in g.players:
                if p.alive() and abs(p.x - s.x) < 110 and abs(p.y - s.y) < 70:
                    p.hp = min(p.maxhp, p.hp + p.maxhp * 0.22); p.ward = 1800; p.recalc()
                    g.parts.burst(p.x, p.y - 10, (255, 235, 150), 12, 1.2, 28, 1, -0.02, 0.6)
            sfx("heal", 0.9)
        if t >= 54: s.state = "free"
    def upd_draw(s, ix):
        g = s.g; s.draw_t += 1; s.vx *= 0.5
        if ix: s.face = 1 if ix > 0 else -1
        s.vy = min(MAX_FALL, s.vy + GRAV); move_body(g.wd, s)
        if s.draw_t == 1: s.spend(14)
        held = s.pad.held("skill")
        if (not held and s.draw_t >= 6) or s.draw_t > 70:
            ch = s.draw_t >= 26
            if ch: s.fire_arrow(34 * s.bowm, 5.2, 0, 1, poise=26)
            else: s.fire_arrow(14 * s.bowm, 3.8, 0, 0, poise=8)
            g.parts.burst(s.x + s.face * 10, s.y - 12, (255, 255, 255), 3, 0.8, 8)
            s.state = "act"; s.st_t = 0; s.act = dict(kind="bowrec", st=99, ac=0, rc=0); s.act["st"] = 0; s.act["rc"] = 8 if ch is False else 14
            s.act["ac"] = 0; s.act["st"] = 0
        elif s.buf == "dodge" and s.try_action("dodge"): s.buf = None
    def projs_hit_player_setup(s): pass
    # ----- drawing -----
    def anim_name(s):
        st = s.state
        if st == "down": return "down", 0
        if st == "roll": return "roll", min(3, s.st_t * 4 // ROLL[s.cls]["dur"])
        if st == "hurt": return "hurt", 0
        if st == "drink": return "drink", (s.st_t // 8)
        if st == "guard": return "guard", 0
        if st == "kantele": return "kantele", s.st_t // 6
        if st == "draw": return "shoot", 0
        if st == "act":
            a = s.act; k = a["kind"]; t = s.st_t
            if k == "flip": return "shoot", 1
            if k == "bowrec": return "shoot", 1
            ph = 0 if t < a["st"] else (1 if t < a["st"] + a["ac"] else 2)
            if k == "bash": return "bash", 0 if ph == 0 else 1
            if k == "nova": return "cast", 0 if ph == 0 else 1
            if "fire" in a:
                return ("cast", 0 if ph == 0 else 1) if a["fire"] == "orb" else ("atk1", ph)
            return a["anim"], ph
        if s.climb: return "climb", (s.t // 6) % 2
        if not s.on_ground: return ("jump" if s.vy < 0 else "fall"), 0
        if abs(s.vx) > 0.3: return "run", (s.t // 5) % 4
        return "idle", (s.t // 24) % 2
    def draw(s, surf, cx, cy):
        a, t = s.anim_name()
        flash = s.flash > 0 and (s.flash % 2 == 0)
        tint = P2_TINT[s.cls] if s.idx == 1 else None
        spr = player_frame(s.cls, a, t, flash, tint)
        if s.face < 0: spr = flipped(spr)
        x = int(s.x - cx); y = int(s.y - cy)
        if s.inv > 0 and s.state not in ("roll", "hurt") and (s.t // 3) % 2 == 0 and s.inv < 40: spr = spr.copy(); spr.set_alpha(120)
        w, h = spr.get_size()
        if s.state == "down": spr = spr.copy(); spr.set_alpha(180 if (s.t // 20) % 2 else 230)
        surf.blit(spr, (x - w // 2, y - h + 2))
        if s.state == "guard" or s.blocked_flash:
            pass
        if s.state == "guard" and s.guard_t < int(11 * D()["parry"]):
            pygame.draw.circle(surf, (255, 240, 170), (x + s.face * 9, y - 12), 3 + s.guard_t // 3, 1)
        if s.state == "draw" and s.draw_t > 4:
            f = min(1.0, s.draw_t / 26.0)
            pygame.draw.line(surf, (255, 255, 255) if f >= 1 else (200, 200, 140), (x + s.face * 6, y - 22), (x + s.face * (6 + int(10 * f)), y - 22), 1)
            if f >= 1 and (s.t // 3) % 2 == 0: surf.fill((255, 255, 255), (x + s.face * 18, y - 23, 2, 2))
        if s.g.coop and s.alive():
            col = P2_TINT[s.cls] if s.idx == 1 else (255, 220, 120)
            pygame.draw.polygon(surf, col, [(x - 2, y - 33), (x + 2, y - 33), (x, y - 30)])
        if s.atk and DEBUG_BOXES:
            r = s.atk.rect(s.x, s.y, s.face); pygame.draw.rect(surf, (0, 255, 0), (r[0] - cx, r[1] - cy, r[2], r[3]), 1)
        if s.state == "down":
            f = s.down_t / 1200.0
            pygame.draw.rect(surf, (60, 20, 20), (x - 8, y - 34, 16, 3)); pygame.draw.rect(surf, (230, 70, 70), (x - 8, y - 34, int(16 * f), 3))
            if s.revive_t > 0: pygame.draw.rect(surf, (140, 255, 160), (x - 8, y - 38, int(16 * s.revive_t / 70.0), 2))

# ======== p12_game.py ========

# ---------------- game core: session, world state, combat resolution, camera, world drawing ----------------
MAP_CW, MAP_CH = 20, 11          # fog-of-war cell size in tiles
def map_cell(tx, ty): return "%d,%d" % (int(tx) // MAP_CW, max(0, int(ty)) // MAP_CH)
BF_START = {"b0": 0, "b1": 0, "b2": 0, "b3": 0, "b4": 0, "b5": 0, "b6": 10, "b7": 37, "b8": 2, "b9": 0}
def bonfire_pos(bid):
    if bid in BONFIRE_POS:return BONFIRE_POS[bid]
    tx = BONFIRES[bid]
    return tx * TILE + 8, floor_row(tx, BF_START[bid]) * TILE
BONFIRE_POS={k:(v*TILE+8,floor_row(v,BF_START[k])*TILE) for k,v in BONFIRES.items()}
BF_NAME = {"b0": "forest", "b1": "forest", "b2": "forest", "b3": "swamp", "b4": "swamp", "b5": "swamp", "b6": "river", "b7": "river", "b8": "river", "b9": "pohjola"}
BOSS_NAMES = ("hiisi", "turso", "tytti", "louhi")
CHARMS = ("c_moss", "c_bear", "c_wolf", "c_ember")

class GameCore:
    # ---------- session ----------
    def init_core(s):
        s.save = None; s.wd = None; s.players = []; s.enemies = []; s.projs = []; s.zones = []; s.parts = Parts()
        s.dns = []; s.hitstop = 0; s.state_name = "title"; s.boss = None; s.arena = None; s.stains = []
        s.cam = [0.0, 0.0]; s.shk_t = 0; s.shk_amp = 0; s.frames = 0; s.t0 = 0; s.dying = 0; s.msgs = []
        s.area = "forest"; s.area_popup = None; s.dark = 0.0; s.ffs = []; s.chunks = {}; s.banner = None; s.sep_t = 0
        s.hints_seen = set(); s.kills = 0; s.pads = {}; s.p_pad = [None, None]; s.felled = None; s.ending_t = 0
        s.dark_target = 0.0; s.gain = [];s.black=pygame.Surface((W,H))
    CHUNK_CACHE={};CHUNK_REV=[0]
    def chunk(s,c):
        key=(c,s.CHUNK_REV[0]);surf=GameCore.CHUNK_CACHE.get(key)
        if surf is None:
            surf=render_chunk(c,s.wd)
            if pygame.display.get_surface():surf=surf.convert()
            GameCore.CHUNK_CACHE[key]=surf
            if len(GameCore.CHUNK_CACHE)>28:GameCore.CHUNK_CACHE.pop(next(iter(GameCore.CHUNK_CACHE)))
        return surf
    def warm_all(s):
        center=int(s.cam[0])//320
        for c in range(max(0,center-3),min((COLS-1)//20,center+4)+1):s.chunk(c)
    def warm_chunks(s):
        center=int(s.cam[0])//320
        if s.frames%4:return
        for c in sorted(range(max(0,center-3),min((COLS-1)//20,center+4)+1),key=lambda c:abs(c-center)):
            if (c,s.CHUNK_REV[0]) not in GameCore.CHUNK_CACHE:s.chunk(c);break
    def enter_pohjola(s,save):
        MUSIC.request("pohjola")
        for ar in ("pohjola",):sky_surface(ar);layers_for(ar);fog_surface(ar)
        for key in [(105,(130,153,254)),(70,(130,35,52))]:glow(*key)
        for phase in (1,2,3):louhi_frame("idle",0,phase=phase);louhi_frame("windup",0,phase=phase)
        save["bonfire"]="b9";save["louhi_unlocked"]=True
        write_save(save);s.start_session(save,s.p_pad[0] if s.p_pad and s.p_pad[0] is not None else s.kb);s.poht_t=0
        p=s.players[0];before=p.pad;p.pad=IdlePad();s.interact(p,("bonfire","b9"));s.state_name="poht";p.pad=before;s.coop_restore=True
        
    def start_session(s, save, p1pad):
        # v1.1 fix: everything transient from a previous session (e.g. a finished game's ending timer,
        # chunk images rendered with that world's opened shortcuts) is reset here
        s.ending_t = 0; s.hitstop = 0; s.shk_t = 0; s.shk_amp = 0; s.sep_t = 0; s.gain = []; s.dark = 0.0; s.dark_target = 0.0
        s.chunks = {}; s.hint = None; s.hint_t = 0; s.need_pad = None; s.end_page = 0; s.end_t = 0; s.kills = 0; s.ffs = []
        s.save = save; s.wd = World(); s.p_pad = [p1pad, None]
        for k in save["opened"]:
            if k in DYN: s.wd.state[k] = not DYN[k]["active"]
        for b in save["bosses"]:
            if b in ARENAS and ARENAS[b]["door_out"] and ("d_%s_out" % b) in DYN: s.wd.state["d_%s_out" % b] = False
        s.wd._rebuild()
        s.enemies = []; s.projs = []; s.zones = []; s.parts = Parts(); s.dns = []; s.boss = None; s.arena = None
        s.stains = save["stain"]; s.msgs = []; s.banner = None; s.dying = 0; s.hitstop = 0; s.felled = None
        s.t0 = save["time"] * 60; s.frames = 0; s.kills = 0; s.hints_seen = set();s.true_end_delay=0
        p = Player(s, 0, p1pad, save); s.players = [p]
        if save["bonfire"] not in save["seen"]: save["seen"].append(save["bonfire"])
        if save.get("mapseen") is None:       # 1.0 save: reveal what the player has provably explored
            ms = set()
            for bid in save["seen"]:
                if bid in BONFIRES: ms.add(map_cell(BONFIRES[bid], floor_row(BONFIRES[bid], BF_START[bid])))
            for k in save["bosses"]: ms.add("arena:" + k)
            save["mapseen"] = sorted(ms)
        s.mapseen = set(save["mapseen"])
        bx, by = bonfire_pos(save["bonfire"])
        p.refill(); p.spawn(bx - 26, by); p.face = 1
        s.spawn_enemies(); s.snap_cam(); s.area = area_at(int(p.x // TILE)); s.area_popup = (s.area, 0)
        s.state_name = "play"; s.init_fireflies()
        s.warm_all();s.enter_t=0
    @property
    def coop(s): return len(s.players) > 1
    def save_game(s):
        if s.save is None: return False
        sv = s.save
        sv["time"] = int((s.t0 + s.frames) // 60); sv["level"] = 1 + sum(sv["stats"].values())
        sv["p2"] = s.players[1].ch if len(s.players) > 1 else sv.get("p2")
        if sv["p2"]: sv["p2"]["level"] = 1 + sum(sv["p2"]["stats"].values())
        sv["stain"] = s.stains; sv["mapseen"] = sorted(s.mapseen)
        return write_save(sv)
    def p2_char(s, cls):
        sv = s.save; p1lvl = 1 + sum(sv["stats"].values())
        ch = sv.get("p2")
        if not ch or ch["cls"] != cls: ch = {"cls": cls, "level": 1, "stats": {k: 0 for k in STAT_KEYS}, "souls": 0}
        order = {"warrior": ("vit", "str", "end", "foc"), "sage": ("foc", "vit", "end", "str"), "hunter": ("str", "end", "vit", "foc")}[cls]
        want = max(0, p1lvl - 3); have = sum(ch["stats"].values()); i = 0
        while have < want: ch["stats"][order[i % 4]] += 1; have += 1; i += 1
        ch["level"] = 1 + have; sv["p2"] = ch
        return ch
    def add_p2(s, cls, pad):
        if len(s.players) > 1 or s.save is None: return None
        ch = s.p2_char(cls); s.p_pad[1] = pad
        p = Player(s, 1, pad, ch); p.refill(); p0 = s.players[0]
        sx, sy = s.find_safe_xy(p0.x - p0.face * 14, p0.y, face=-p0.face, fallback=p0.safe)
        p.spawn(sx, sy); p.face = p0.face; p.safe = (sx, sy)
        s.players.append(p); sfx("join", 0.9); s.parts.burst(p.x, p.y - 10, P2_TINT[cls], 18, 1.6, 26)
        s.msg(tr("p2_joined", tr("cls_" + cls)))
        return p
    def remove_p2(s):
        if len(s.players) > 1:
            p = s.players.pop(1); s.p_pad[1] = None
            s.msg(tr("p2_left"))
    def msg(s, text, col=(255, 240, 200)):
        s.msgs.append([text, 200, col])
        if len(s.msgs) > 3: s.msgs.pop(0)
    # ---------- enemies ----------
    def spawn_enemies(s):
        s.enemies = [e for e in s.enemies if e.boss and not e.dead]
        s.projs = []; s.zones = []
        active=int(s.players[0].x//TILE) if s.players else 0
        if active>=446:trange=(446,487)
        else:trange=(0,446)
        for i,(k,tx,fr) in enumerate(SPAWNS):
            if abs(tx-active)>24 and not (420<=active<=445 and 400<=tx<=445):continue

            if any(abs(tx-bt)<=7 for bt in BONFIRES.values()):continue      # bonfires are safe ground
            x = tx * TILE + 8
            if k == "nakki":
                y = fr * TILE
                for ty in range(fr, ROWS):
                    if s.wd.tile(tx, ty) == WATER: y = ty * TILE + 8; break
            else:
                y = floor_row(tx, fr) * TILE
                if k in FLYERS: y -= 44
            s.enemies.append(Mob(s, k, x, y, i))
    def reset_boss(s):
        s.CHUNK_REV[0]+=1
        if s.boss is not None:
            if s.boss in s.enemies: s.enemies.remove(s.boss)
            k = s.boss.key; s.boss = None
            if ("d_%s_in" % k) in DYN: s.wd.set_open("d_%s_in" % k, True)
        s.arena = None
    def start_boss(s,key):
        if key=="louhi":
            for phase in (1,2,3):
                for pose in ("idle","windup","roar"):
                    spr=louhi_frame(pose,0,phase=phase);surf=pygame.Surface((W,H),pygame.SRCALPHA);surf.blit(spr,(0,0))
        a=ARENAS[key]
        s.wd.set_open("d_%s_in" % key, False); s.arena = key
        gy = a["ground"] * TILE
        b = BOSS_CLS[key](s, (a["x1"] - 5) * TILE, gy)
        s.boss = b; s.enemies.append(b); b.engage()
        for p in s.players:        # anyone left outside is carried in
            if p.alive() and not (a["x0"] + 1 <= p.x / TILE < a["x1"]):
                sx, sy = s.find_safe_xy((a["x0"] + 4) * TILE, gy, face=1)
                p.spawn(sx, sy); p.inv = 30; p.safe = (sx, sy)
        s.snap_cam()
        MUSIC.request(a["track"]); b.shown_bar = 0.0
    def on_boss_dead(s, b):
        k = b.key; sv = s.save
        if k not in sv["bosses"]: sv["bosses"].append(k)
        a = ARENAS[k]
        if a["door_out"]: s.wd.set_open("d_%s_out" % k, True)
        s.wd.set_open("d_%s_in" % k, True)
        if k == "hiisi" and "feather" not in sv["taken"]:
            sv["taken"].append("feather")
            for p in s.players: p.recalc()
            s.msg(tr("found_item", tr("it_feather")), (255, 235, 150)); s.msg(tr("it_feather_d"), (200, 225, 200))
        s.felled = (k, 0); sfx("levelup", 0.9); s.shake(5, 30)
        s.parts.burst(b.x, b.y - 16, (255, 240, 180), 40, 3.0, 40, 2, 0.02, 0.5)
        if k == "tytti":
            sv["louhi_unlocked"]=True
            s.ending_t=1;s.save_game()
        elif k=="louhi":
            sv["done"]=True;s.save_game();s.ending_t=0;s.end_t=0;s.true_end_delay=1
        else: s.save_game()
    def on_kill(s, e):
        s.kills += 1
    # ---------- helpers used by entities ----------
    def nearest_player(s, x, y):
        best = None; bd = 1e9
        for p in s.players:
            if not p.alive(): continue
            d = abs(p.x - x) + abs(p.y - y) * 1.5
            if d < bd: bd = d; best = p
        return best
    def los(s, x1, y1, x2, y2):
        n = int(max(abs(x2 - x1), abs(y2 - y1)) // 8)
        for i in range(1, n):
            f = i / n
            if s.wd.solid(int((x1 + (x2 - x1) * f) // TILE), int((y1 + (y2 - y1) * f) // TILE)): return False
        return True
    def coop_mult(s, boss):
        if len(s.players) < 2: return 1.0
        return 1.8 if boss else 1.6
    def give_souls(s, n, x, y):
        if n <= 0: return
        for p in s.players:
            if p.alive(): p.souls += n; p.gain_t = 90; p.gain_n = getattr(p, "gain_n", 0) + n if getattr(p, "gain_t", 0) > 0 else n
        for i in range(min(12, 3 + n // 40)):
            s.parts.add(x, y, random.uniform(-1, 1), random.uniform(-1.8, -0.4), 36, (150, 230, 255), 1, 0.03)
    def dnum(s, x, y, val, col=(255, 255, 255), player=False):
        if not SETTINGS["dmgnum"]: return
        if len(s.dns) > 24: s.dns.pop(0)
        s.dns.append([x + random.randint(-4, 4), y, str(val) if not isinstance(val, str) else val, col, 0, isinstance(val, TStr)])
    def shake(s, amp, frames):
        if SETTINGS["shake"]: s.shk_amp = max(s.shk_amp if s.shk_t > 0 else 0, amp); s.shk_t = max(s.shk_t, frames)
    def spit_land(s, pr):
        ty = int(pr.y // TILE)
        for k in range(8):
            if s.wd.solid(int(pr.x // TILE), ty + k): y = (ty + k) * TILE; break
        else: return
        s.zones.append(Zone(pr.x, y, 24, 6, 0, 150, 12 * D()["dmg"], "puddle", 1.0, ("parry",)[:0]))
    def safe_ok(s, p):
        wd = s.wd; tx = int(p.x // TILE)
        for dx in (-1, 0, 1):
            for k in range(0, 3):
                if wd.tile(tx + dx, int(p.y // TILE) + k) in (THORN, WATER): return False
        return True
    def standing_free(s, x, y, w=PW_, h=PH_):
        """True if a body centred at x with feet at y stands on solid/platform, overlaps no solid, and is not in a hazard."""
        wd = s.wd; hw = w / 2.0
        # feet must rest on a surface
        foot = wd.tile(int(x // TILE), int(y // TILE))
        if foot not in (SOLID, PLAT) and not (foot == LADDER and wd.tile(int(x // TILE), int(y // TILE) - 1) != LADDER):
            # allow being a hair above the surface (spawn snap)
            if wd.tile(int(x // TILE), int((y + 1) // TILE)) not in (SOLID, PLAT): return False
            y = int((y + 1) // TILE) * TILE
        # body must not overlap solids (scan the AABB, ignore the floor row the feet stand on)
        top = int((y - h + 0.5) // TILE); bot = int((y - 1.0) // TILE)
        for ty in range(top, bot + 1):
            for tx in range(int((x - hw + 0.5) // TILE), int((x + hw - 0.5) // TILE) + 1):
                if wd.solid(tx, ty): return False
        # hazards at feet / shins
        for tx in range(int((x - hw + 1) // TILE), int((x + hw - 1) // TILE) + 1):
            for ty in (int((y - 3) // TILE), int((y - h * 0.5) // TILE), int(y // TILE)):
                if wd.tile(tx, ty) in (THORN, WATER): return False
        return True
    def find_safe_xy(s, x, y, face=1, fallback=None):
        """Nearest free standing spot near (x, y). Falls back to partner safe / last safe / bonfire."""
        # snap y down onto the first surface at this column
        def snap(xx, yy):
            tx = int(xx // TILE); ty0 = max(0, int(yy // TILE))
            for ty in range(ty0, min(ROWS, ty0 + 8)):
                if s.wd.tile(tx, ty) in (SOLID, PLAT): return xx, float(ty * TILE)
            for ty in range(ty0, -1, -1):
                if s.wd.tile(tx, ty) in (SOLID, PLAT): return xx, float(ty * TILE)
            return xx, yy
        x, y = snap(x, y)
        if s.standing_free(x, y): return x, y
        for dist in range(1, 18):
            for dx in (dist * face, -dist * face, dist, -dist):
                nx, ny = snap(x + dx * 4, y)
                if s.standing_free(nx, ny): return nx, ny
            for dy in (-dist, dist):
                nx, ny = snap(x, y + dy * TILE)
                if s.standing_free(nx, ny): return nx, ny
        # partner / own last safe ground
        for cand in (fallback,):
            if cand is None: continue
            cx, cy = snap(cand[0], cand[1])
            if s.standing_free(cx, cy): return cx, cy
        for p in s.players:
            if getattr(p, "safe", None):
                cx, cy = snap(p.safe[0], p.safe[1])
                if s.standing_free(cx, cy): return cx, cy
        if s.save is not None:
            bx, by = bonfire_pos(s.save["bonfire"]); return snap(bx, by)
        return x, y
    def poke_secret(s, rect):
        for k in ("secret_f", "secret_r"):
            if not s.wd.state[k]: continue
            for (tx, ty) in DYN[k]["tiles"]:
                if rect[0] < tx * TILE + TILE and rect[0] + rect[2] > tx * TILE and rect[1] < ty * TILE + TILE and rect[1] + rect[3] > ty * TILE:
                    s.open_dyn(k, True); return
    def open_dyn(s, k, silent=False):
        s.CHUNK_REV[0]+=1
        d = DYN[k]; s.wd.state[k] = not d["active"]; s.wd._rebuild()
        if k not in s.save["opened"]: s.save["opened"].append(k)
        tx, ty = d["tiles"][len(d["tiles"]) // 2]
        if d["key"] == "wall":
            sfx("boom", 0.7); s.shake(3, 12)
            for ty2 in range(d["tiles"][0][1], d["tiles"][-1][1] + 1):
                s.parts.burst(tx * TILE + 8, ty2 * TILE + 8, (150, 150, 170), 10, 2.0, 24, 2, 0.12, 0.8)
            s.msg(tr("secret_found"), (200, 220, 255))
        else: sfx("gate", 0.9); s.shake(2, 20)
    # ---------- player events ----------
    def player_down(s, p):
        sfx("die", 0.8)
        others = [q for q in s.players if q is not p and q.alive()]
        p.vx = 0; p.vy = min(p.vy, 0)
        if others:
            # snap onto safe ground so the body doesn't fall away from a helper
            sx, sy = s.find_safe_xy(p.x, p.y, fallback=p.safe)
            p.x, p.y = sx, sy; p.on_ground = True; p.safe = (sx, sy)
            p.state = "down"; p.down_t = 1200; p.revive_t = 0; p.hp = 0
            s.msg(tr("p_down", tr("pl_%d" % (p.idx + 1))), (255, 150, 150))
        else:
            p.state = "dead"; s.begin_death()
    def on_player_dead(s, p):
        if not any(q.alive() for q in s.players): s.begin_death()
    def begin_death(s):
        if s.dying: return
        s.dying = 1; sfx("die", 1.0); MUSIC.request(None) if False else None
        sv = s.save; sv["deaths"] += 1
        if SETTINGS["penalty"] == "classic":
            s.stains[:] = [x for x in s.stains if x["p"] not in [p.idx for p in s.players]]
            for p in s.players:
                if p.souls > 0:
                    x, y = (p.x, p.y) if (p.on_ground and s.safe_ok(p)) else p.safe
                    s.stains.append({"p": p.idx, "x": float(x), "y": float(y), "souls": p.souls}); p.souls = 0
    def respawn(s):
        if s.players and 446*TILE<=s.players[0].x<486*TILE:s.save["bonfire"]="b9"
        sv = s.save; bx, by = bonfire_pos(sv["bonfire"])
        s.reset_boss()
        for i, p in enumerate(s.players):
            sx, sy = s.find_safe_xy(bx + (24 if i else -26), by, face=1 if i else -1)
            p.refill(); p.spawn(sx, sy); p.face = 1; p.safe = (sx, sy)
        s.dying = 0; s.felled = None; s.dns = []
        s.spawn_enemies(); s.snap_cam(); s.save_game()
        s.area_popup = None
    def rest_at(s, p, bid):
        sv = s.save; first = bid not in sv["seen"]
        sv["bonfire"] = bid
        if first: sv["seen"].append(bid)
        for q in s.players:
            if q.state in ("down", "dead"): q.state = "free"; q.spawn(q.x, q.y)
            q.refill(); q.inv = 20
        s.reset_boss(); s.spawn_enemies(); s.dns = []
        sfx("bonfire", 1.0); bx, by = bonfire_pos(bid)
        s.parts.burst(bx, by - 14, (255, 190, 90), 24, 1.8, 36, 1, -0.02, 0.9)
        s.save_game()
        return first
    def interact(s, p, near):
        kind, ident = near
        if kind == "bonfire":
            first = s.rest_at(p, ident)
            if first: s.banner = [tr("bonfire_lit"), 0]
            s.menu_owner = p.idx; s.open_bonfire()
        elif kind == "lever":
            lv = LEVERS[ident]; k = lv["opens"]
            if not s.wd.opened(k) if DYN[k]["code"] == SOLID else not s.wd.state[k]:
                sfx("lever", 0.9); s.open_dyn(k)
                s.msg(tr("lever_" + ident), (220, 230, 255))
    def buy_stat(s, p, k):
        lv = p.level
        if lv >= MAX_LEVEL: return False
        cost = level_cost(lv)
        if p.souls < cost: return False
        p.souls -= cost; p.ch["stats"][k] += 1; p.ch["level"] = p.level
        ohp = p.maxhp; p.recalc(); p.hp = min(p.maxhp, p.hp + (p.maxhp - ohp))
        sfx("levelup", 0.8)
        return True
    # ---------- items / interactables ----------
    def item_xy(s, k):
        tx, ty, kind, pl = ITEMS[k]
        return tx * TILE + 8, ty * TILE - 6
    def interactables(s):
        out = []
        for bid in BONFIRES:
            x, y = bonfire_pos(bid); out.append((x, y, "bonfire", bid))
        for lid, lv in LEVERS.items():
            k = lv["opens"]
            done = (not s.wd.state[k]) if DYN[k]["code"] == SOLID else s.wd.state[k]
            if not done: out.append((lv["tx"] * TILE + 8, lv["ty"] * TILE, "lever", lid))
        return out
    def nearby_for(s, p, its):
        best = None; bd = 1e9
        for (x, y, kind, ident) in its:
            dx = abs(p.x - x); dy = abs(p.y - y)
            if dx < 18 and dy < 26 and dx + dy < bd: bd = dx + dy; best = (kind, ident)
        return best
    def pickup(s, p, k):
        tx, ty, kind, pl = ITEMS[k]; sv = s.save
        sv["taken"].append(k); sfx("pickup", 0.9)
        x, y = s.item_xy(k); s.parts.burst(x, y, (255, 230, 150), 14, 1.6, 26, 1, -0.01, 0.6)
        name = desc = None
        if kind == "souls":
            p.souls += pl; s.msg(tr("got_souls", pl), (150, 230, 255))
        elif kind == "charm":
            for q in s.players: q.recalc()
            name, desc = tr("it_" + k), tr("it_" + k + "_d")
        elif kind == "flask":
            for q in s.players: q.recalc(); q.flasks += 1
            name, desc = tr("it_flask"), tr("it_flask_d")
        elif kind == "flaskpow":
            for q in s.players: q.recalc()
            name, desc = tr("it_flaskpow"), tr("it_flaskpow_d")
        if name:
            s.msg(tr("found_item", name), (255, 235, 150)); s.msg(desc, (200, 225, 200))
    # ---------- per-frame world update ----------
    def update_world(s):
        s.frames += 1
        wd = s.wd
        if not SETTINGS["flash"]:
            for e in s.enemies: e.flash = 0
            for p in s.players: p.flash = 0
        # death sequence
        if s.dying:
            s.dying += 1
            if s.dying > 190: s.respawn(); return
        # players
        its = s.interactables()
        for p in s.players:
            p.nearby = s.nearby_for(p, its) if p.alive() and not s.dying else None
        if s.hitstop > 0:
            s.hitstop -= 1
            s.parts.update(); s.tick_fx(); return
        for p in s.players: p.update()
        self_hz = [p for p in s.players if p.alive()]
        for p in self_hz:
            if p.climb: continue
            if hazard_at(wd, p) or p.y > ROWS * TILE - 12:
                s.hazard(p)
        # revive
        for d in s.players:
            if d.state != "down": continue
            helper = [q for q in s.players if q is not d and q.alive() and abs(q.x - d.x) < 40 and abs(q.y - d.y) < 40 and q.pad.held("up")]
            if helper:
                d.revive_t += 1
                q = helper[0]; q.inv = max(q.inv, 10)   # helping is committing: brief i-frames so a hit doesn't cancel the revive
                if abs(q.x - d.x) > 14:
                    q.x = d.x - (14 if q.x < d.x else -14); q.vx = 0
                if abs(q.y - d.y) > 20: q.y = d.y; q.vy = 0
            else: d.revive_t = max(0, d.revive_t - 2)
            if d.revive_t >= 70:
                sx, sy = s.find_safe_xy(d.x, d.y, fallback=d.safe)
                d.x, d.y = sx, sy; d.safe = (sx, sy)
                d.state = "free"; d.hp = d.maxhp * 0.4; d.inv = 90; d.revive_t = 0; d.stam = d.maxst
                sfx("revive", 0.9); s.parts.burst(d.x, d.y - 10, (150, 255, 180), 20, 1.6, 30, 1, -0.02, 0.7)
                s.msg(tr("p_revived", tr("pl_%d" % (d.idx + 1))), (170, 255, 190))
        # co-op: both downed
        if s.coop and not s.dying and not any(p.alive() for p in s.players): s.begin_death()
        # enemies
        ccx = s.cam[0] + W / 2; ccy = s.cam[1] + H / 2
        for e in s.enemies:
            if e.boss or (abs(e.x - ccx) < 330 and abs(e.y - ccy) < 240):
                e.update()
        s.enemies = [e for e in s.enemies if not (e.dead and e.dt > (40 if not e.boss else 240))]
        # projectiles / zones
        s.update_projs()
        for z in s.zones: z.update(s)
        s.zones = [z for z in s.zones if not z.dead]
        s.resolve_enemy_hits()
        s.update_arena()
        s.update_items()
        s.parts.update(); s.tick_fx()
        s.update_camera(); s.warm_chunks()
        s.update_area()
    def tick_fx(s):
        if s.shk_t > 0: s.shk_t -= 1
        for d in s.dns: d[4] += 1; d[1] -= 0.35
        s.dns = [d for d in s.dns if d[4] < 40]
        for m in s.msgs: m[1] -= 1
        s.msgs = [m for m in s.msgs if m[1] > 0]
        if s.banner:
            s.banner[1] += 1
            if s.banner[1] > 150: s.banner = None
        if s.felled:
            s.felled = (s.felled[0], s.felled[1] + 1)
            if s.felled[1] > 220: s.felled = None
        if s.area_popup:
            s.area_popup = (s.area_popup[0], s.area_popup[1] + 1)
            if s.area_popup[1] > 220: s.area_popup = None
        for p in s.players:
            if getattr(p, "gain_t", 0) > 0: p.gain_t -= 1
    def hazard(s, p):
        if p.inv > 0 and p.state == "roll": pass
        dmg = max(12.0, p.maxhp * 0.15)
        sfx("splash", 0.7); s.parts.burst(p.x, p.y - 4, (150, 200, 255), 10, 1.4, 20, 1, 0.1, 1.5)
        p.hp -= dmg; s.dnum(p.x, p.y - 26, int(dmg), (255, 90, 90), True)
        if p.hp <= 0: p.die(); return
        p.x, p.y = p.safe; p.vx = p.vy = 0; p.inv = 60; p.state = "free"; p.atk = None; p.act = None; p.climb = False; p.flash = 6
    def update_projs(s):
        for pr in s.projs: pr.update(s)
        for pr in s.projs:
            if pr.dead: continue
            if pr.enemy:
                for p in s.players:
                    if not p.alive() or p.idx in pr.hit: continue
                    if ov(pr.rect(), p.hurt_rect()):
                        r = p.take_hit(pr.dmg, pr.x - pr.vx * 2, pr.kbx, pr.tags, pr)
                        if pr.enemy is False: break
                        if r or p.inv > 0:
                            pr.hit.add(p.idx)
                            if pr.kind != "wave": pr.dead = True
                            break
            else:
                for e in s.enemies:
                    if e.dead or e.hidden or e.invuln or id(e) in pr.hit: continue
                    if ov(pr.rect(), e.hurt_rect()):
                        pr.hit.add(id(e)); pl = s.players[pr.pid] if pr.pid < len(s.players) else None
                        tg = set(pr.tags)
                        if e.take(pr.dmg, pr.vx * 0.5, pr.poise, pl, tg, 0.0) and pl is not None and pl.cls == "sage": pl.focus = min(pl.maxfoc, pl.focus + 2)
                        if pr.pierce > 0: pr.pierce -= 1
                        else: pr.dead = True; s.parts.burst(pr.x, pr.y, pr.col, 5, 1.0, 12)
                        break
        s.projs = [p for p in s.projs if not p.dead]
    def resolve_enemy_hits(s):
        for e in s.enemies:
            if e.dead: continue
            a = e.atk
            if not a: continue
            r = a.rect(e.x, e.y, e.face)
            for p in s.players:
                if not p.alive() or p.idx in a.hit: continue
                if ov(r, p.hurt_rect()):
                    a.hit.add(p.idx)
                    p.take_hit(a.dmg, e.x, a.kb, a.tags, e)
        for z in s.zones:
            if not z.active or z.dmg <= 0: continue
            r = z.rect()
            for p in s.players:
                if not p.alive(): continue
                last = z.hit_t.get(p.idx) if hasattr(z, "hit_t") else None
                if z.style == "puddle":
                    if not hasattr(z, "hit_t"): z.hit_t = {}
                    if last is not None and z.t - last < 50: continue
                elif p.idx in z.hit: continue
                if ov(r, p.hurt_rect()):
                    if z.style == "puddle": z.hit_t[p.idx] = z.t
                    else: z.hit.add(p.idx)
                    p.take_hit(z.dmg, z.x, z.kb, z.tags, None)
    def update_arena(s):
        if s.boss is None:
            if s.dying: return
            for key, a in ARENAS.items():
                if key in s.save["bosses"]: continue
                x0 = (a["x0"] + 3) * TILE; x1 = (a["x1"] - 1) * TILE; yt = a["y0"] * TILE; yb = (a["ground"] + 1) * TILE
                for p in s.players:
                    if p.alive() and x0 < p.x < x1 and yt - 8 < p.y < yb + 8:
                        s.start_boss(key); return
        else:
            b = s.boss
            if b.dead:
                if b.dt > 160 and s.arena:
                    s.arena = None; MUSIC.request(s.area)
                if b.dt > 240: s.boss = None
    def update_items(s):
        if s.dying: return
        taken = s.save["taken"]
        for k in ITEMS:
            if k in taken: continue
            x, y = s.item_xy(k)
            for p in s.players:
                if p.alive() and abs(p.x - x) < 11 and abs(p.y - 8 - y) < 18:
                    s.pickup(p, k); break
        for st in list(s.stains):
            for p in s.players:
                if p.idx == st["p"] and p.alive() and abs(p.x - st["x"]) < 14 and abs(p.y - st["y"]) < 22:
                    p.souls += st["souls"]; s.stains.remove(st); sfx("souls", 1.0)
                    s.parts.burst(st["x"], st["y"] - 10, (150, 230, 255), 24, 1.8, 30, 1, -0.03, 0.8)
                    s.msg(tr("stain_back", st["souls"]), (150, 230, 255)); break
    def explore(s):
        """fog of war: mark the map cells (and boss rooms) the players are in"""
        for q in s.players:
            if not q.alive(): continue
            tx = int(q.x // TILE); ty = int((q.y - 8) // TILE)
            s.mapseen.add(map_cell(tx, ty))
            for k, ar in ARENAS.items():
                if ar["x0"] < tx < ar["x1"] and ar["y0"] <= ty <= ar["ground"]: s.mapseen.add("arena:" + k)
        if s.boss is not None: s.mapseen.add("arena:" + s.boss.key)
    def update_area(s):
        if s.frames % 6 == 0: s.explore()
        p = s.players[0]; a = area_at(int(p.x // TILE))
        if a != s.area:
            s.area = a; s.area_popup = (a, 0)
        if s.boss is None or s.boss.dead:
            MUSIC.request(s.area)
        elif s.boss.engaged:          # phase 2 (from the transition roar on) gets the intensified version
            MUSIC.request("louhi" if s.boss.key=="louhi" and s.boss.phase==1 else "louhi2" if s.boss.key=="louhi" and s.boss.phase<2.5 else "louhi3" if s.boss.key=="louhi" else ARENAS[s.boss.key]["track"]+("2" if s.boss.phase>=1.5 else ""))
        pm = [q for q in s.players if q.alive()] or s.players
        dy = sum(q.y for q in pm) / len(pm)
        s.dark_target = max(0.0, min(1.0, (dy - 31 * TILE) / (4 * TILE)))
        if s.arena: s.dark_target = 0.35
        if s.area=="pohjola":s.dark_target=.67
        if s.area=="pohjola":s.dark_target=.67
        s.dark += (s.dark_target - s.dark) * 0.04
    # ---------- camera ----------
    def cam_goal(s):
        alive = [p for p in s.players if p.alive()] or s.players
        mx = sum(p.x for p in alive) / len(alive); my = sum(p.y - 10 for p in alive) / len(alive)
        lead = alive[0].face * 16 if len(alive) == 1 else 0
        tx = mx + lead - W / 2; ty = my - H * 0.56
        if s.arena:
            a = ARENAS[s.arena]; tx = (a["x0"] - 1) * TILE; ty = a["ground"] * TILE + 8 - H
        tx = max(0, min(COLS * TILE - W, tx)); ty = max(0, min(ROWS * TILE - H, ty))
        return tx, ty
    def snap_cam(s):
        s.cam[0], s.cam[1] = s.cam_goal()
    def update_camera(s):
        tx, ty = s.cam_goal()
        k = 0.2 if s.arena else 0.1
        s.cam[0] += (tx - s.cam[0]) * k; s.cam[1] += (ty - s.cam[1]) * (0.2 if s.arena else 0.08)
        s.cam[0] = max(0, min(COLS * TILE - W, s.cam[0])); s.cam[1] = max(0, min(ROWS * TILE - H, s.cam[1]))
        if s.coop and not s.dying:
            al = [p for p in s.players if p.alive()]
            if len(al) == 2:
                pinned = False
                reviving = any(p.state == "down" and p.revive_t > 0 for p in s.players)
                for p in al:
                    if reviving: continue          # don't yank a helper off a revive
                    lo = s.cam[0] + 8; hi = s.cam[0] + W - 8
                    if p.x < lo or p.x > hi:
                        nx = lo if p.x < lo else hi
                        sx, sy = s.find_safe_xy(nx, p.y, face=1 if p.x < lo else -1, fallback=p.safe)
                        p.x, p.y = sx, sy; p.vx = max(0, p.vx) if p.x < lo + 1 else min(0, p.vx); pinned = True
                far = abs(al[0].y - al[1].y) > 120 or abs(al[0].x - al[1].x) > W + 40
                offy = any(not (s.cam[1] - 6 < p.y - 10 < s.cam[1] + H + 6) for p in al)
                if far or offy or (pinned and abs(al[0].x - al[1].x) > W - 24): s.sep_t += 1
                else: s.sep_t = max(0, s.sep_t - 2)
                if s.sep_t > 150 and not s.arena:
                    s.sep_t = 0
                    a, b = al
                    lag = a if (abs(a.x - (s.cam[0] + W / 2)) + abs(a.y - (s.cam[1] + H / 2))) > (abs(b.x - (s.cam[0] + W / 2)) + abs(b.y - (s.cam[1] + H / 2))) else b
                    oth = b if lag is a else a
                    sx, sy = s.find_safe_xy(oth.x - oth.face * 14, oth.y, face=-oth.face, fallback=oth.safe)
                    lag.x, lag.y = sx, sy; lag.vx = lag.vy = 0; lag.inv = max(lag.inv, 40); lag.safe = (sx, sy); lag.on_ground = True
                    sfx("join", 0.7); s.parts.burst(lag.x, lag.y - 10, (200, 220, 255), 14, 1.4, 22)
            else: s.sep_t = 0
    # ---------- fireflies ----------
    def init_fireflies(s):
        r = random.Random(11)
        s.ffs = [[r.uniform(0, W), r.uniform(20, H - 10), r.uniform(-0.15, 0.15), r.uniform(-0.1, 0.1), r.uniform(0, 6.28)] for _ in range(22)]
    # ---------- world drawing ----------
    def draw_world(s, c, t):
        wd = s.wd; cx = int(s.cam[0]); cy = int(s.cam[1]); area = area_at(int((cx + W // 2) // TILE))
        pal = PAL[area]
        c.blit(sky_surface(area), (0, 0))
        for (lay, f, yo) in layers_for(area):
            lw, lh = lay.get_size()
            y = H - lh + yo // 2 - int((cy - 370) * f * 0.45)
            x = -int(cx * f) % lw
            c.blit(lay, (x - lw, y)); c.blit(lay, (x, y))
            if x + lw < W: c.blit(lay, (x + lw, y))
        for ch in range(cx // 320, min((COLS * TILE - 1) // 320, (cx + W - 1) // 320) + 1):
            c.blit(s.chunk(ch), (ch * 320 - cx, -cy))
        # dynamic tiles
        for k, d in DYN.items():
            if not wd.state[k]: continue
            tl = d["tiles"]; x0 = tl[0][0] * TILE - cx; y0 = tl[0][1] * TILE - cy
            nx = tl[-1][0] - tl[0][0] + 1; ny = tl[-1][1] - tl[0][1] + 1
            if x0 > W or y0 > H or x0 + nx * TILE < 0 or y0 + ny * TILE < 0: continue
            kind = d["key"]
            if kind == "fog": c.blit(fog_door(nx, ny, t), (x0, y0))
            else: c.blit(dyn_tile_surf(kind, nx, ny), (x0, y0))
        # props
        its = s.interactables()
        seen = s.save["seen"]
        for (x, y, kind, ident) in its:
            sx = x - cx; sy = y - cy
            if -20 < sx < W + 20 and -30 < sy < H + 30:
                if kind == "bonfire": s.draw_bonfire(c, sx, sy, ident in seen, t)
                else: s.draw_lever(c, sx, sy, t)
        for k, (tx, ty, kind, pl) in ITEMS.items():
            if k in s.save["taken"]: continue
            sx = tx * TILE + 8 - cx; sy = ty * TILE - 6 - cy
            if -10 < sx < W + 10 and -10 < sy < H + 10: s.draw_item(c, sx, sy, kind, t, k)
        # lever already pulled: draw handle flipped
        for lid, lv in LEVERS.items():
            k = lv["opens"]; done = (not wd.state[k]) if DYN[k]["code"] == SOLID else wd.state[k]
            if done:
                sx = lv["tx"] * TILE + 8 - cx; sy = lv["ty"] * TILE - cy
                if -20 < sx < W + 20 and -30 < sy < H + 30: s.draw_lever(c, sx, sy, t, True)
        for st in s.stains:
            sx = int(st["x"] - cx); sy = int(st["y"] - cy)
            if -20 < sx < W + 20 and -30 < sy < H + 30:
                bob = int(math.sin(t * 0.08) * 2)
                pygame.draw.circle(c, (60, 120, 160), (sx, sy - 10 + bob), 5); pygame.draw.circle(c, (170, 235, 255), (sx, sy - 10 + bob), 3)
                c.fill((255, 255, 255), (sx - 1, sy - 12 + bob, 2, 2))
                for k in range(3): c.fill((150, 220, 255), (sx - 4 + ((t // 3 + k * 5) % 9), sy - 4 - ((t // 2 + k * 7) % 14), 1, 1))
        for e in s.enemies:
            if -105 < e.x - cx < W + 105 and -60 < e.y - cy < H + 80: e.draw(c, cx, cy)
        for z in s.zones:
            if -z.w-20<z.x-cx<W+z.w+20:z.draw(c,cx,cy)
        for p in s.players:
            p.draw(c, cx, cy)
        for pr in s.projs:
            if -20<pr.x-cx<W+20 and -20<pr.y-cy<H+30:pr.draw(c,cx,cy)
        s.parts.draw(c, cx, cy)
        # fog
        fs = fog_surface(area)
        for (yy, f, sp) in ((H - 74, 1.25, 0.25), (H - 40, 1.6, -0.35)):
            fx = -int(cx * f + t * sp) % 640
            c.blit(fs, (fx - 640, yy)); c.blit(fs, (fx, yy))
        # light
        s.draw_light(c, t, cx, cy, pal)
        # fireflies (after lighting: they glow)
        fc = {"forest": (220, 255, 120), "swamp": (180, 255, 110), "river": (170, 200, 255), "pohjola":(106,138,225), "ranta":(100,210,176), "syvanne":(130,160,231), "katedraali":(153,221,190)}[area]
        for f in s.ffs:
            f[0] = (f[0] + f[2] + math.sin(t * 0.03 + f[4]) * 0.2 - (s.cam[0] - getattr(s, "_pcx", s.cam[0])) * 0.6) % (W + 10)
            f[1] = (f[1] + f[3] + math.cos(t * 0.027 + f[4]) * 0.18 - (s.cam[1] - getattr(s, "_pcy", s.cam[1])) * 0.6) % (H + 10)
            a = 0.5 + 0.5 * math.sin(t * 0.07 + f[4] * 3)
            if a > 0.25:
                col = (int(fc[0] * a), int(fc[1] * a), int(fc[2] * a)); c.fill(col, (int(f[0]) - 5, int(f[1]) - 5, 2, 2))
                if a > 0.8: c.fill((255, 255, 230), (int(f[0]) - 5, int(f[1]) - 5, 1, 1))
        s._pcx = s.cam[0]; s._pcy = s.cam[1]
    def draw_light(s, c, t, cx, cy, pal):

        amb = pal["ambient"]; dk = s.dark
        night = (62, 68, 86)
        base = tuple(int(amb[i] + (night[i] - amb[i]) * dk) for i in range(3))
        lm = s.lightmap; lm.fill(base)
        fl = 0.9 + 0.1 * math.sin(t * 0.37) + 0.05 * math.sin(t * 0.13)
        def lit(x, y, r, col, f=1.0):
            if -r < x < W + r and -r < y < H + r:
                lm.blit(glow(r, tuple(min(255, int(v * f)) for v in col)), (int(x - r), int(y - r)), special_flags=pygame.BLEND_ADD)
        for bid in BONFIRES:
            x, y = bonfire_pos(bid)
            if bid in s.save["seen"]: lit(x - cx, y - cy - 10, 74, (255, 170, 80), fl)
            else: lit(x - cx, y - cy - 6, 14, (90, 40, 20))
        for p in s.players:
            if p.alive():
                col = (110, 100, 80) if p.cls != "sage" else (70, 110, 120)
                lit(p.x - cx, p.y - cy - 12, 44 + int(26 * dk), col)
        for e in s.enemies:
            if e.dead and e.dt > 20: continue
            if e.kind in ("virvatuli", "henki", "haamu", "tytti", "turso", "joutsen"):
                lit(e.x - cx, e.y - cy - e.h / 2, 28 if not e.boss else 56, {"virvatuli": (60, 150, 255), "henki": (60, 150, 140), "haamu": (60, 80, 140), "tytti": (160, 70, 150), "turso": (50, 90, 160), "joutsen": (90, 100, 140)}[e.kind])
            elif e.kind=="louhi":
                lit(e.x-cx,e.y-cy-58,105,(130,153,254),1.05)
                if e.warn:lit(e.x-cx,e.y-cy-58,70,(130,35,52))
            elif e.kind == "hiisi": lit(e.x - cx, e.y - cy - 20, 40, (120, 60, 30))
        for pr in s.projs: lit(pr.x - cx, pr.y - cy, 18, tuple(v // 2 for v in pr.col))
        for z in s.zones:
            if z.active and z.style in ("beam", "geyser"): lit(z.x - cx, z.y - cy - z.h / 2, 30, (120, 80, 120) if z.style == "beam" else (60, 100, 140))
        for f in s.ffs[::3]:
            lit(f[0] - 5, f[1] - 5, 9, (50, 60, 20))
        for st in s.stains: lit(st["x"] - cx, st["y"] - cy - 10, 22, (50, 100, 140))
        for k, (tx, ty, kind, pl) in ITEMS.items():
            if k not in s.save["taken"]: lit(tx * TILE + 8 - cx, ty * TILE - 6 - cy, 18, (90, 80, 40))
        c.blit(lm, (0, 0), special_flags=pygame.BLEND_MULT)
        c.blit(vignette(), (0, 0), special_flags=pygame.BLEND_MULT)
    def draw_bonfire(s, c, x, y, lit, t):
        x = int(x); y = int(y)
        pygame.draw.rect(c, (36, 34, 40), (x - 8, y - 3, 16, 3)); pygame.draw.rect(c, (70, 68, 78), (x - 8, y - 3, 16, 1))
        pygame.draw.line(c, (74, 50, 32), (x - 7, y - 4), (x + 5, y - 9), 2); pygame.draw.line(c, (96, 66, 40), (x + 7, y - 4), (x - 5, y - 9), 2)
        if lit:
            f = (t // 3) % 4; hgt = 14 + (f % 2) * 2 + int(math.sin(t * 0.3) * 1.5)
            pygame.draw.polygon(c, (214, 80, 30), [(x - 6, y - 7), (x - 2 + (f % 2), y - 7 - hgt + 2), (x + 1, y - 7 - hgt // 2), (x + 3, y - 7 - hgt), (x + 6, y - 7)])
            pygame.draw.polygon(c, (255, 170, 50), [(x - 4, y - 7), (x - 1, y - 7 - hgt + 5), (x + 1, y - 7 - hgt // 2 + 2), (x + 2 + (f % 2), y - 7 - hgt + 3), (x + 4, y - 7)])
            pygame.draw.polygon(c, (255, 235, 150), [(x - 2, y - 7), (x, y - 7 - hgt // 2 - 1), (x + 2, y - 7)])
            if s.state_name == "play" and t % 9 == 0 and random.random() < 0.7: s.parts.add(x + s.cam[0] + random.randint(-3, 3), y + s.cam[1] - 14, random.uniform(-0.2, 0.2), -0.5, 30, (255, 190, 90), 1, -0.005)
        else:
            c.fill((120, 50, 30), (x - 1, y - 8, 2, 1))
            if (t // 20) % 2 == 0: c.fill((190, 90, 40), (x, y - 9, 1, 1))
    def draw_lever(s, c, x, y, t, pulled=False):
        x = int(x); y = int(y)
        pygame.draw.rect(c, (60, 60, 70), (x - 5, y - 3, 10, 3)); pygame.draw.rect(c, (110, 110, 124), (x - 5, y - 3, 10, 1))
        pygame.draw.rect(c, (70, 52, 36), (x - 1, y - 6, 2, 3))
        dx = -6 if pulled else 6
        pygame.draw.line(c, (140, 100, 60), (x, y - 5), (x + dx, y - 12), 2); c.fill((220, 60, 50), (x + dx - 1, y - 14, 3, 3))
        if not pulled and (t // 30) % 2 == 0: c.fill((255, 255, 255), (x + dx, y - 14, 1, 1))
    def draw_item(s, c, x, y, kind, t, k):
        x = int(x); y = int(y + math.sin(t * 0.07 + x) * 1.5)
        if kind == "souls":
            pygame.draw.ellipse(c, (110, 80, 50), (x - 4, y - 3, 9, 8)); pygame.draw.rect(c, (70, 50, 34), (x - 2, y - 5, 5, 3))
            c.fill((230, 200, 90), (x - 1, y - 1, 2, 2))
        elif kind == "charm":
            pygame.draw.polygon(c, (230, 200, 110), [(x, y - 5), (x + 4, y), (x, y + 5), (x - 4, y)]); pygame.draw.polygon(c, (150, 230, 255), [(x, y - 3), (x + 2, y), (x, y + 3), (x - 2, y)])
        elif kind in ("flask", "flaskpow"):
            col = (230, 120, 70) if kind == "flask" else (255, 220, 100)
            pygame.draw.rect(c, (180, 200, 210), (x - 1, y - 6, 3, 3)); pygame.draw.ellipse(c, col, (x - 4, y - 4, 8, 9)); c.fill((255, 255, 255), (x - 2, y - 2, 1, 2))
        if (t // 25 + x) % 3 == 0: c.fill((255, 255, 220), (x + 3, y - 5, 1, 1))

# ======== p13_ui.py ========

# ---------------- UI: text, button glyphs, HUD, menus and screens ----------------
_ESC = [False]
def ks_quit():
    v = _ESC[0]; _ESC[0] = False; return v

BF_KEYS = {"b0": "bf_b0", "b1": "bf_b1", "b2": "bf_b2", "b3": "bf_b3", "b4": "bf_b4", "b5": "bf_b5", "b6": "bf_b6", "b7": "bf_b7", "b8": "bf_b8", "b9": "bf_b9", "b10": "bf_b10", "b11": "bf_b11", "b12": "bf_b12", "b13": "bf_b13"}
# glyph tables: action -> (label, color, shape)
GLYPHS = {
    "ps": {"jump": ("x", (110, 160, 255), "cross"), "dodge": ("o", (255, 100, 110), "circle"), "light": ("s", (240, 140, 220), "square"),
           "heavy": ("t", (110, 230, 150), "tri"), "guard": ("L1", None, "pill"), "skill": ("R1", None, "pill"), "flask": ("R2", None, "pill"),
           "interact": ("up", None, "dpadup"), "pause": ("Options", None, "pill"), "map": ("Share", None, "pill"), "move": ("L", None, "stick")},
    "xbox": {"jump": ("A", (90, 220, 110), "letter"), "dodge": ("B", (255, 90, 90), "letter"), "light": ("X", (90, 150, 255), "letter"),
             "heavy": ("Y", (255, 215, 80), "letter"), "guard": ("LB", None, "pill"), "skill": ("RB", None, "pill"), "flask": ("RT", None, "pill"),
             "interact": ("up", None, "dpadup"), "pause": ("Menu", None, "pill"), "map": ("View", None, "pill"), "move": ("L", None, "stick")},
    "kb": {"jump": ("Z", None, "key"), "dodge": ("V", None, "key"), "light": ("X", None, "key"), "heavy": ("C", None, "key"),
           "guard": ("A", None, "key"), "skill": ("S", None, "key"), "flask": ("D", None, "key"), "interact": ("up", None, "keyup"),
           "pause": ("Enter", None, "pill"), "map": ("Tab", None, "pill"), "move": ("arrows", None, "keyarrows")},
}
CLASS_KEYS = {"warrior": "cls_warrior", "sage": "cls_sage", "hunter": "cls_hunter"}
SETTING_ROWS = ["lang", "difficulty", "penalty", "music", "music_vol", "sfx", "sfx_vol", "shake", "dmgnum", "flash", "prompts", "runmode", "hints", "perf", "controls", "back"]
HINTS = [(2, 9, "h_move"), (9, 13, "h_jump"), (13, 17, "h_attack"), (18, 23, "h_roll"), (25, 30, "h_special")]

def fmt_time(sec):
    return tr("time_fmt", sec // 3600, (sec // 60) % 60)

class GameUI:
    def init_ui(s):
        s.font = PixelFont(tall=True); s.big = PixelFont(tall=True, scale=2, bold=True)
        s.mid = PixelFont(tall=True, bold=True); s.tiny = PixelFont()
        s.tcache = {}; s.gcache = {}; s.track = None
        s.lightmap = pygame.Surface((W, H)); s.dimmer = pygame.Surface((W, H)); s.dimmer.fill((0, 0, 0)); s.dimmer.set_alpha(150)
        s.menu_i = {}; s.quit_hold = 0; s.last_pad = None; s.menu_owner = 0; s.set_from = "title"; s.set_i = 0
        s.hp_ghost = [1.0, 1.0]; s.hint = None; s.hint_t = 0; s.cs_i = 0; s.cs_who = 0; s.cs_pad = None; s.need_pad = None
        s.lv_i = 0; s.lv_who = 0; s.map_from = "play"; s.t_ui = 0; s.title_msg = None; s.confirm_i = 1; s.end_page = 0; s.end_t = 0
        s.info_pad_lost = False
    # ---------- text ----------
    def render(s, t, f, col):
        k = (t, col, id(f))
        img = s.tcache.get(k)
        if img is None:
            if len(s.tcache) > 500: s.tcache.clear()
            img = f.render(str(t), False, col); s.tcache[k] = img
        return img
    def text(s, t, x, y, col=(255, 255, 255), font=None, anchor="c", shadow=True):
        f = font or s.font
        if s.track is not None and not isinstance(t, TStr): s.track.append(("untr", str(t), None))
        img = s.render(t, f, col); r = img.get_rect()
        if anchor == "c": r.center = (int(x), int(y))
        elif anchor == "l": r.midleft = (int(x), int(y))
        else: r.midright = (int(x), int(y))
        if s.track is not None: s.track.append(("rect", str(t), tuple(r)))
        if shadow: s.canvas.blit(s.render(t, f, (0, 0, 0)), r.move(1, 1))
        s.canvas.blit(img, r)
        return r
    def glyph(s, action):
        style = SETTINGS["prompts"]; k = (style, action)
        g = s.gcache.get(k)
        if g: return g
        lab, col, shape = GLYPHS[style][action]
        tf = s.tiny
        if shape in ("cross", "circle", "square", "tri", "letter"):
            g = pygame.Surface((13, 13), pygame.SRCALPHA); pygame.draw.circle(g, (30, 32, 44), (6, 6), 6); pygame.draw.circle(g, (90, 94, 110), (6, 6), 6, 1)
            if shape == "cross": pygame.draw.line(g, col, (3, 3), (9, 9), 2); pygame.draw.line(g, col, (9, 3), (3, 9), 2)
            elif shape == "circle": pygame.draw.circle(g, col, (6, 6), 3, 1)
            elif shape == "square": pygame.draw.rect(g, col, (3, 3, 7, 7), 1)
            elif shape == "tri": pygame.draw.polygon(g, col, [(6, 2), (10, 9), (2, 9)], 1)
            else:
                im = tf.render(lab, False, col); g.blit(im, (6 - im.get_width() // 2, 6 - im.get_height() // 2))
        elif shape == "pill" or shape == "key":
            im = tf.render(lab, False, (235, 235, 245)); w = max(13, im.get_width() + 6)
            g = pygame.Surface((w, 13), pygame.SRCALPHA)
            pygame.draw.rect(g, (30, 32, 44), (0, 0, w, 13), 0, 4 if shape == "pill" else 2); pygame.draw.rect(g, (130, 134, 150), (0, 0, w, 13), 1, 4 if shape == "pill" else 2)
            g.blit(im, (w // 2 - im.get_width() // 2, 6 - im.get_height() // 2 + 1))
        elif shape == "dpadup":
            g = pygame.Surface((13, 13), pygame.SRCALPHA)
            pygame.draw.rect(g, (60, 62, 76), (4, 0, 5, 13)); pygame.draw.rect(g, (60, 62, 76), (0, 4, 13, 5)); pygame.draw.rect(g, (235, 235, 245), (4, 0, 5, 5))
        elif shape == "keyup":
            g = pygame.Surface((13, 13), pygame.SRCALPHA); pygame.draw.rect(g, (30, 32, 44), (0, 0, 13, 13), 0, 2); pygame.draw.rect(g, (130, 134, 150), (0, 0, 13, 13), 1, 2)
            pygame.draw.polygon(g, (235, 235, 245), [(6, 3), (10, 8), (2, 8)])
        elif shape == "keyarrows":
            g = pygame.Surface((27, 13), pygame.SRCALPHA)
            for i, pts in enumerate(([(5, 3), (2, 8), (8, 8)], [(5, 11), (2, 6), (8, 6)])): pass
            pygame.draw.rect(g, (30, 32, 44), (0, 0, 13, 13), 0, 2); pygame.draw.rect(g, (130, 134, 150), (0, 0, 13, 13), 1, 2)
            pygame.draw.polygon(g, (235, 235, 245), [(4, 6), (8, 3), (8, 9)])
            pygame.draw.rect(g, (30, 32, 44), (14, 0, 13, 13), 0, 2); pygame.draw.rect(g, (130, 134, 150), (14, 0, 13, 13), 1, 2)
            pygame.draw.polygon(g, (235, 235, 245), [(23, 6), (19, 3), (19, 9)])
        else:   # stick
            g = pygame.Surface((13, 13), pygame.SRCALPHA); pygame.draw.circle(g, (30, 32, 44), (6, 6), 6); pygame.draw.circle(g, (130, 134, 150), (6, 6), 6, 1)
            im = tf.render(lab, False, (235, 235, 245)); g.blit(im, (6 - im.get_width() // 2, 6 - im.get_height() // 2))
        s.gcache[k] = g
        return g
    def rich(s, t, x, y, col=(255, 255, 255), font=None, anchor="c"):
        """Text with {action} tokens drawn as button glyphs."""
        f = font or s.font
        if s.track is not None and not isinstance(t, TStr): s.track.append(("untr", str(t), None))
        parts = []; i = 0; t = str(t)
        while i < len(t):
            j = t.find("{", i)
            if j < 0: parts.append(("t", t[i:])); break
            if j > i: parts.append(("t", t[i:j]))
            k = t.find("}", j)
            parts.append(("g", t[j + 1:k])); i = k + 1
        tw = 0; items = []
        for kind, v in parts:
            if kind == "t": im = s.render(v, f, col); sh = s.render(v, f, (0, 0, 0)); items.append((im, sh, im.get_width())); tw += im.get_width()
            else: g = s.glyph(v); items.append((g, None, g.get_width() + 2)); tw += g.get_width() + 2
        x0 = x - tw // 2 if anchor == "c" else (x if anchor == "l" else x - tw)
        if s.track is not None: s.track.append(("rect", t, (x0, y - 7, tw, 14)))
        cx = x0
        for im, sh, w in items:
            if sh is not None:
                s.canvas.blit(sh, (cx + 1, y - im.get_height() // 2 + 1)); s.canvas.blit(im, (cx, y - im.get_height() // 2))
            else: s.canvas.blit(im, (cx, y - im.get_height() // 2 + 0))
            cx += w
    def panel(s, x, y, w, h, alpha=210, border=(150, 130, 90)):
        r = pygame.Rect(int(x), int(y), int(w), int(h))
        if not hasattr(s, "panel_cache"): s.panel_cache = {}
        key=(r.w,r.h,alpha); sf=s.panel_cache.get(key)
        if sf is None:
            sf = pygame.Surface((r.w, r.h), pygame.SRCALPHA); sf.fill((12, 10, 18, alpha)); s.panel_cache[key]=sf
            if len(s.panel_cache)>32:s.panel_cache.clear()
        s.canvas.blit(sf, r.topleft)
        pygame.draw.rect(s.canvas, border, r, 1); pygame.draw.rect(s.canvas, (60, 50, 40), r.inflate(-4, -4), 1)
        if s.track is not None: s.track.append(("rect", "panel", tuple(r)))
        return r
    def menu_box(s, items, idx, cy=None, title=None, sub=None, minw=120, x=None, selcol=(255, 225, 140), draw_panel=True):
        """Auto-sized vertical menu. returns panel rect."""
        rows = len(items); rh = 16
        tw = max([s.font.size(it)[0] for it in items] + [s.mid.size(title)[0] if title else 0, s.tiny.size(sub)[0] if sub else 0, minw - 40])
        w = tw + 44; h = rows * rh + 14 + (20 if title else 0) + (12 if sub else 0)
        if cy is None: cy = H // 2
        px = (W - w) // 2 if x is None else x; py = int(cy - h / 2)
        if draw_panel: s.panel(px, py, w, h)
        y = py + 9
        if title: s.text(title, px + w // 2, y + 6, (255, 225, 150), s.mid); y += 20
        if sub: s.text(sub, px + w // 2, y + 4, (170, 170, 190), s.tiny); y += 12
        for i, it in enumerate(items):
            sel = i == idx
            if sel:
                pygame.draw.rect(s.canvas, (60, 40, 30), (px + 6, y + i * rh, w - 12, rh - 1)); pygame.draw.rect(s.canvas, (150, 110, 60), (px + 6, y + i * rh, w - 12, rh - 1), 1)
                a = 2 + (s.t_ui // 10) % 2
                pygame.draw.polygon(s.canvas, selcol, [(px + 10 + a, y + i * rh + 4), (px + 10 + a, y + i * rh + 11), (px + 15 + a, y + i * rh + 7)])
            s.text(it, px + w // 2, y + i * rh + 7, selcol if sel else (200, 200, 210))
        return pygame.Rect(px, py, w, h)
    # ---------- input helpers ----------
    def menu_in(s):
        r = {"up": 0, "down": 0, "left": 0, "right": 0, "ok": 0, "back": 0, "any": 0}
        for p in s.pads.values():
            for k in ("up", "down", "left", "right"):
                if p.nav(k): r[k] = 1; r["any"] = 1
            if p.pressed("jump") or p.pressed("start"): r["ok"] = 1; s.last_pad = p
            if p.pressed("dodge"): r["back"] = 1
        if ks_quit(): r["back"] = 1
        return r
    def sel(s, key, n, r):
        i = s.menu_i.get(key, 0) % n
        if r["up"]: i = (i - 1) % n; sfx("select", 0.5)
        if r["down"]: i = (i + 1) % n; sfx("select", 0.5)
        s.menu_i[key] = i
        return i
    # ---------- state transitions ----------
    def go(s, st):
        s.state_name = st
    def has_save(s): return s.title_save is not None
    def open_title(s):
        s.state_name = "title"; MUSIC.request("title"); s.menu_i["title"] = 0
        s.title_save, s.title_status = load_save(None, set(BONFIRES))
    def new_game_flow(s):
        s.cs_who = 0; s.cs_pad = s.last_pad; s.cs_i = 0; s.state_name = "class"
    def begin_session(s, save):
        save=save.copy()
        if save.get("louhi_unlocked") or save.get("done") or "tytti" in save.get("bosses",[]):
            if "b9" not in save["seen"]:save["seen"].append("b9")
            save["bonfire"]="b9";save["louhi_unlocked"]=True;write_save(save)
        s.pending = save; s.pend_pad = s.last_pad or next(iter(s.pads.values())); s.state_name = "loading"
    def open_pause(s):
        s.state_name = "pause"; s.menu_i["pause"] = 0; sfx("select", 0.6)
    def open_bonfire(s):
        s.state_name = "bonfire"; s.menu_i["bonfire"] = 0
    def open_map(s, frm):
        s.map_from = frm; s.state_name = "map"
    def open_settings(s, frm):
        s.set_from = frm; s.state_name = "settings"; s.menu_i["settings"] = 0
    def back_to_title(s):
        if s.save is not None: s.save_game()
        s.save = None; s.players = []; s.enemies = []; s.boss = None; s.arena = None
        s.open_title()
    # ---------- title ----------
    def up_title(s):
        r = s.menu_in(); items = s.title_items(); n = len(items)
        i = s.sel("title", n, r); key = items[i][0]
        if r["ok"]:
            sfx("confirm", 0.7)
            if key == "cont": s.begin_session(s.title_save)
            elif key == "new":
                if s.title_save is not None: s.confirm_i = 1; s.menu_i["confirm"] = 1; s.state_name = "confirm"   # default = No
                else: s.new_game_flow()
            elif key == "settings": s.open_settings("title")
            elif key == "quit": s.running = False
        if r["back"]: s.menu_i["title"] = n - 1
    def title_items(s):
        it = []
        if s.title_save is not None: it.append(("cont", tr("m_continue")))
        it += [("new", tr("m_new")), ("settings", tr("m_settings")), ("quit", tr("m_quit"))]
        return it
    def dr_title(s):
        c = s.canvas; t = s.t_ui
        s.draw_title_bg(c, t)
        ttl = tr("title")
        for dx, dy, col in ((2, 2, (20, 10, 10)), (0, 0, (240, 215, 150))):
            img = s.render(ttl, s.big, col); r = img.get_rect(center=(W // 2 + dx, 34 + dy)); c.blit(img, r)
        if s.track is not None: s.track.append(("rect", str(ttl), tuple(img.get_rect(center=(W // 2, 34)))))
        s.text(tr("subtitle"), W // 2, 54, (200, 200, 170), s.font)
        items = s.title_items(); i = s.menu_i.get("title", 0)
        s.menu_box([x[1] for x in items], i, cy=112, minw=110)
        if s.title_save is not None:
            sv = s.title_save
            s.text(tr("save_info", tr(CLASS_KEYS[sv["cls"]]), 1 + sum(sv["stats"].values()), fmt_time(sv["time"])), W // 2, 152, (200, 200, 190), s.tiny)
        if s.title_status == "corrupt": s.text(tr("save_corrupt"), W // 2, 165, (255, 130, 120), s.tiny)
        elif s.title_status == "backup": s.text(tr("save_backup"), W // 2, 165, (255, 220, 130), s.tiny)
        s.text(num("VERSION " + VERSION), 4, H - 6, (220, 220, 235), s.tiny, "l")
    def draw_title_bg(s, c, t):
        area = "forest"; c.blit(sky_surface(area), (0, 0))
        for (lay, f, yo) in layers_for(area):
            lw, lh = lay.get_size(); x = -int(t * f * 0.3) % lw; y = H - lh + yo // 2 + 10
            c.blit(lay, (x - lw, y)); c.blit(lay, (x, y))
        pygame.draw.polygon(c, (10, 14, 16), [(0, H), (0, 150), (60, 144), (120, 150), (200, 146), (260, 152), (320, 148), (320, H)])
        pygame.draw.rect(c, (8, 10, 12), (0, 158, W, 22))
        s.draw_bonfire(c, 40, 156, True, t)
        for k in range(3):
            fs = fog_surface(area); fx = -int(t * (0.2 + k * 0.1)) % 640; c.blit(fs, (fx - 640, 100 + k * 26)); c.blit(fs, (fx, 100 + k * 26))
        lm = s.lightmap; lm.fill((150, 160, 175))
        fl = 0.9 + 0.1 * math.sin(t * 0.37)
        lm.blit(glow(90, (int(255 * fl), int(170 * fl), int(80 * fl))), (40 - 90, 150 - 90), special_flags=pygame.BLEND_ADD)
        c.blit(lm, (0, 0), special_flags=pygame.BLEND_MULT); c.blit(vignette(), (0, 0), special_flags=pygame.BLEND_MULT)
        if not s.ffs: s.init_fireflies()
        for f in s.ffs:
            f[0] = (f[0] + f[2] + math.sin(t * 0.03 + f[4]) * 0.2) % W; f[1] = (f[1] + f[3] + math.cos(t * 0.027 + f[4]) * 0.18) % H
            a = 0.5 + 0.5 * math.sin(t * 0.07 + f[4] * 3)
            if a > 0.25: c.fill((int(220 * a), int(255 * a), int(120 * a)), (int(f[0]), int(f[1]), 2, 2))
    # ---------- confirm ----------
    def up_confirm(s):
        r = s.menu_in(); i = s.sel("confirm", 2, r)
        if r["ok"]:
            if i == 0: s.new_game_flow()
            else: s.state_name = "title"
        if r["back"]: s.state_name = "title"
    def dr_confirm(s):
        s.draw_title_bg(s.canvas, s.t_ui)
        s.panel(30, 50, 260, 80)
        for k, ln in enumerate(wrap(s.font, tr("confirm_new"), 236)): s.text(ln, W // 2, 66 + k * 13, (255, 220, 170))
        i = s.menu_i.get("confirm", 1)
        for k, lab in enumerate((tr("yes"), tr("no"))):
            s.text(lab, W // 2 - 40 + k * 80, 112, (255, 225, 140) if i == k else (170, 170, 180))
            if i == k: pygame.draw.rect(s.canvas, (200, 150, 80), (W // 2 - 40 + k * 80 - 24, 104, 48, 16), 1)
    def up_confirm_nav(s): pass
    # ---------- class select ----------
    def up_class(s):
        r = s.menu_in(); s.cs_i = (s.cs_i + (1 if r["right"] else -1 if r["left"] else 0)) % 3
        if r["left"] or r["right"]: sfx("select", 0.5)
        if r["ok"]:
            cls = CLASSES[s.cs_i]; sfx("confirm", 0.8)
            if s.cs_who == 0:
                sv = new_save(cls); s.begin_session(sv)
            else:
                pad = s.cs_pad
                s.add_p2(cls, pad); s.state_name = "play"
        if r["back"]:
            if s.cs_who == 0: s.state_name = "title"
            else: s.state_name = "play"
    def dr_class(s):
        c = s.canvas
        if s.cs_who == 0: s.draw_title_bg(c, s.t_ui)
        else: s.draw_play_scene(); c.blit(s.dimmer, (0, 0))
        s.text(tr("choose_class") if s.cs_who == 0 else tr("choose_class_p2"), W // 2, 12, (255, 225, 150), s.mid)
        for i, cls in enumerate(CLASSES):
            x = 8 + i * 104; sel = i == s.cs_i
            s.panel(x, 24, 98, 130, 225 if sel else 170, (255, 215, 130) if sel else (90, 80, 70))
            spr = player_frame(cls, "idle", (s.t_ui // 24) % 2, False, P2_TINT[cls] if s.cs_who == 1 else None)
            spr = pygame.transform.scale(spr, (spr.get_width() * 2, spr.get_height() * 2))
            if not sel: spr = spr.copy(); spr.fill((120, 120, 120, 255), special_flags=pygame.BLEND_RGBA_MULT)
            c.blit(spr, (x + 49 - spr.get_width() // 2, 30))
            s.text(tr(CLASS_KEYS[cls]), x + 49, 92, (255, 235, 170) if sel else (160, 160, 170), s.font)
            for k, ln in enumerate(wrap(s.tiny, tr("cd_" + cls), 88)): s.text(ln, x + 6, 106 + k * 9, (210, 210, 200) if sel else (130, 130, 140), s.tiny, "l")
        s.rich(tr("hint_choose"), W // 2, 168, (200, 200, 210), s.tiny)
    # ---------- loading ----------
    def up_loading(s):
        sv = s.pending
        s.start_session(sv, s.pend_pad); s.pending = None; s.title_msg = None
        if s.save["bonfire"] == "b0" and not s.save["bosses"] and s.frames == 0 and s.save["time"] < 5: s.hint_t = 0
        s.save_game()
    def dr_loading(s):
        s.canvas.fill((0, 0, 0)); s.text(tr("loading"), W // 2, H // 2, (200, 200, 190))
    # ---------- play ----------
    def up_play(s):
        if getattr(s,"true_end_delay",0):
            s.true_end_delay+=1
            if s.true_end_delay>240:s.state_name="true";s.true_t=0
            return
        pad_start = any(pd.pressed("start") for pd in s.p_pad if pd is not None)
        if ks_quit() or pad_start: s.open_pause(); return
        if not s.coop and not s.dying:
            for pd in s.pads.values():
                if pd is not s.p_pad[0] and pd.pressed("start") and not isinstance(pd, IdlePad):
                    s.cs_who = 1; s.cs_pad = pd; s.cs_i = 0; s.state_name = "class"; return
        if any(pd.pressed("back") for pd in s.p_pad if pd is not None): s.open_map("play"); return
        s.update_world(); s.update_hints()
        if s.ending_t:
            s.ending_t += 1
            if s.ending_t > 260: s.start_ending()
    def update_hints(s):
        if not SETTINGS["hints"] or s.save["bosses"] or "b1" in s.save["seen"] or s.dying: return
        p = s.players[0]; tx = p.x / TILE
        if s.hint_t > 0: s.hint_t -= 1
        if p.y > 31 * TILE: return
        for (a, b, key) in HINTS:
            if a <= tx < b and key not in s.hints_seen:
                s.hints_seen.add(key); s.hint = key; s.hint_t = 330
    def dr_play(s):
        s.draw_play_scene()
    def draw_play_scene(s):
        c = s.canvas
        s.draw_world(c, s.frames)
        s.draw_overlays(c)
    def draw_overlays(s, c):
        cx = int(s.cam[0]); cy = int(s.cam[1])
        for d in s.dns:
            x = int(d[0] - cx); y = int(d[1] - cy); col = d[3]
            if d[5]: s.text(d[2], x, y, col, s.tiny)
            else: s.text(num(d[2]), x, y, col, s.tiny)
        for p in s.players:
            if p.nearby and p.alive() and not s.dying:
                k, ident = p.nearby
                lab = tr("p_rest") if k == "bonfire" else tr("p_lever")
                s.rich(TStr("{interact} " + lab), int(p.x - cx), int(p.y - cy - 38), (255, 240, 200), s.tiny)
            if p.state == "down":
                s.rich(tr("p_revive"), int(p.x - cx), int(p.y - cy - 44), (170, 255, 190), s.tiny)
        s.draw_hud(c)
        if s.sep_t > 70:
            s.text(tr("p_keep_close"), W // 2, 30, (255, 200, 140), s.tiny)
    def draw_perf_overlay(s):
        ar = s.frame_ms; cur = ar[-1] if ar else 0.0; hi = max(ar[-120:]) if ar else 0.0
        txt = TStr("FPS %.0f  FRAME %.1f ms  MAX %.1f ms" % (1000.0 / max(cur, 0.01), cur, hi))
        x = 3; y = H - 26; pygame.draw.rect(s.canvas, (0, 0, 0), (x, y - 6, 182, 20))
        s.text(txt, x + 2, y, (140, 240, 160), s.tiny, "l")
        s.text(TStr("INPUT %.2f ms  CHUNKS %d/%d  AI stream" % (s.input_ms, len(s.chunks), len(GameCore.CHUNK_CACHE))), x + 2, y + 8, (160, 200, 240), s.tiny, "l")
    def draw_hud(s, c):
        for p in s.players:
            right = p.idx == 1
            hw = max(50, min(150, int(p.maxhp * 0.8))); x = W - 6 - hw if right else 6; y = 8
            g = s.hp_ghost[p.idx]; fr = max(0.0, p.hp / p.maxhp)
            g = fr if fr > g else g + (fr - g) * 0.04; s.hp_ghost[p.idx] = g
            col = P2_TINT[p.cls] if right else (255, 220, 120)
            tx = x - 7 if right else x + hw + 2
            pygame.draw.polygon(c, col, [(tx, y), (tx + 5, y), (tx + 2, y + 5)])
            pygame.draw.rect(c, (10, 6, 10), (x - 1, y - 1, hw + 2, 9)); pygame.draw.rect(c, (60, 20, 24), (x, y, hw, 7))
            pygame.draw.rect(c, (200, 160, 120), (x, y, int(hw * g), 7)); pygame.draw.rect(c, (210, 50, 56), (x, y, int(hw * fr), 7))
            pygame.draw.rect(c, (255, 120, 120), (x, y, int(hw * fr), 2)); pygame.draw.rect(c, (120, 100, 70), (x - 1, y - 1, hw + 2, 9), 1)
            sw = max(40, min(140, int(p.maxst * 0.8))); sx = W - 6 - sw if right else 6; fr2 = p.stam / p.maxst
            pygame.draw.rect(c, (10, 6, 10), (sx - 1, y + 9, sw + 2, 6)); pygame.draw.rect(c, (30, 50, 30), (sx, y + 10, sw, 4))
            pygame.draw.rect(c, (110, 220, 90) if p.stam > 20 and p.exh <= 0 else (220, 150, 70), (sx, y + 10, int(sw * fr2), 4))
            yy = y + 16
            if p.cls == "sage":
                fw = max(40, min(120, int(p.maxfoc * 0.7))); fx = W - 6 - fw if right else 6
                pygame.draw.rect(c, (10, 6, 10), (fx - 1, yy + 1, fw + 2, 5)); pygame.draw.rect(c, (20, 50, 60), (fx, yy + 2, fw, 3))
                pygame.draw.rect(c, (90, 220, 230), (fx, yy + 2, int(fw * p.focus / p.maxfoc), 3)); yy += 6
            fx = W - 6 - 24 if right else 6
            pygame.draw.rect(c, (180, 200, 210), (fx + 2, yy + 3, 3, 2)); pygame.draw.ellipse(c, (230, 120, 70) if p.flasks > 0 else (80, 60, 60), (fx, yy + 5, 7, 8))
            s.text(num("x%d" % p.flasks), fx + 9, yy + 10, (230, 230, 220), s.tiny, "l")
            # souls
            sx2 = 8 if right else W - 8
            c.fill((150, 230, 255), (sx2 - (0 if right else 3), H - 14, 3, 3)); c.fill((60, 130, 170), (sx2 - (0 if right else 3) + 1, H - 11, 1, 2))
            s.text(num(p.souls), sx2 + 6 if right else sx2 - 6, H - 11, (230, 245, 255), s.font, "l" if right else "r")
            if getattr(p, "gain_t", 0) > 0 and p.gain_n:
                s.text(num("+%d" % p.gain_n), sx2 + 6 if right else sx2 - 6, H - 23, (150, 230, 255), s.tiny, "l" if right else "r")
        b = s.boss
        if b is not None and b.engaged and not (b.dead and b.dt > 90):
            want = max(0.0, b.hp / b.maxhp); b.shown_bar += (want - b.shown_bar) * 0.1 if want < b.shown_bar else (0.02 if want > b.shown_bar else 0)
            bw = 96; bx = (W - bw) // 2; by = 5
            s.text(tr("boss_" + b.key), W // 2, by + 14, (240, 225, 190), s.font)
            pygame.draw.rect(c, (10, 6, 10), (bx - 2, by - 2, bw + 4, 9)); pygame.draw.rect(c, (60, 20, 24), (bx, by, bw, 5))
            pygame.draw.rect(c, (220, 180, 130), (bx, by, int(bw * b.shown_bar), 5)); pygame.draw.rect(c, (190, 40, 50), (bx, by, int(bw * want), 5))
            pygame.draw.rect(c, (150, 120, 80), (bx - 2, by - 2, bw + 4, 9), 1)
            if b.phase >= 2:
                pygame.draw.polygon(c, (255, 200, 100), [(bx + bw // 2 - 3, by - 1), (bx + bw // 2 + 3, by - 1), (bx + bw // 2, by + 5)]) if False else None
        # messages
        for i, (t, life, col) in enumerate(reversed(s.msgs)):
            a = min(1.0, life / 30.0); cc = tuple(int(v * a) for v in col)
            s.text(t, W // 2, H - 44 - i * 11, cc, s.tiny)
        if s.hint_t > 0 and s.hint and not s.dying:
            a = min(1.0, s.hint_t / 30.0); cc = tuple(int(v * a) for v in (240, 235, 200))
            lines = wrap(s.font, tr(s.hint + "_" + s.players[0].cls) if s.hint == "h_special" else tr(s.hint), 280)
            for i, ln in enumerate(lines): s.rich(ln, W // 2, 98 + i * 12, cc, s.tiny)
        if s.area_popup and not s.dying:
            a, tt = s.area_popup; f = min(1.0, tt / 30.0, (220 - tt) / 40.0)
            if f > 0:
                col = tuple(int(v * f) for v in (235, 225, 190)); img = s.render(tr("area_" + a), s.big, col); r = img.get_rect(center=(W // 2, 38))
                if s.track is not None: s.track.append(("rect", "area", tuple(r)))
                c.blit(s.render(tr("area_" + a), s.big, (0, 0, 0)), r.move(1, 1)); c.blit(img, r)
        if s.felled:
            k, tt = s.felled; f = min(1.0, tt / 25.0, (220 - tt) / 40.0)
            if f > 0:
                col = tuple(int(v * f) for v in (255, 220, 130)); txt = tr("felled", tr("boss_" + k))
                img = s.render(txt, s.mid, col); r = img.get_rect(center=(W // 2, 70))
                if s.track is not None: s.track.append(("rect", str(txt), tuple(r)))
                c.blit(s.render(txt, s.mid, (0, 0, 0)), r.move(1, 1)); c.blit(img, r)
        if s.banner:
            txt, tt = s.banner; f = min(1.0, tt / 20.0, (150 - tt) / 30.0)
            if f > 0:
                col = tuple(int(v * f) for v in (255, 205, 120)); s.text(txt, W // 2, 80, col, s.mid)
        if s.dying:
            f = min(1.0, s.dying / 50.0); ov_ = pygame.Surface((W, H)); ov_.fill((20, 0, 4)); ov_.set_alpha(int(150 * f)); c.blit(ov_, (0, 0))
            col = tuple(int(v * f) for v in (190, 30, 40)); s.text(tr("you_died") if SETTINGS["lang"] else tr("you_died"), W // 2, H // 2 - 6, col, s.big)
            if s.dying > 60 and SETTINGS["penalty"] == "classic" and any(st["souls"] for st in s.stains):
                s.text(tr("stain_hint"), W // 2, H // 2 + 16, (190, 200, 220), s.tiny)
    # ---------- pause ----------
    def pause_items(s):
        it = [("resume", tr("m_resume")), ("map", tr("m_map")), ("settings", tr("m_settings")), ("controls", tr("m_controls"))]
        if s.coop: it.append(("p2off", tr("m_p2_leave")))
        it += [("title", tr("m_to_title")), ("quit", tr("m_quit"))]
        return it
    def up_pause(s):
        if s.need_pad is not None:
            for pd in s.pads.values():
                if pd not in s.p_pad and not isinstance(pd, IdlePad) and (pd.pressed("start") or pd.pressed("jump")):
                    s.players[s.need_pad].pad = pd; s.p_pad[s.need_pad] = pd; s.need_pad = None; break
            ks_quit(); return
        pad_start = any(pd.pressed("start") for pd in s.p_pad if pd is not None)
        r = s.menu_in(); items = s.pause_items(); i = s.sel("pause", len(items), r)
        if r["back"] or pad_start: s.state_name = "play"; return
        if r["ok"]:
            k = items[i][0]; sfx("confirm", 0.6)
            if k == "resume": s.state_name = "play"
            elif k == "map": s.open_map("pause")
            elif k == "settings": s.open_settings("pause")
            elif k == "controls": s.state_name = "controls"; s.ctl_from = "pause"
            elif k == "p2off": s.remove_p2(); s.state_name = "play"
            elif k == "title": s.back_to_title()
            elif k == "quit": s.save_game(); s.running = False
    def dr_pause(s):
        s.draw_play_scene(); s.canvas.blit(s.dimmer, (0, 0))
        if s.need_pad is not None:
            s.panel(40, 60, 240, 56)
            s.text(tr("pad_lost", tr("pl_%d" % (s.need_pad + 1))), W // 2, 78, (255, 200, 150))
            s.rich(tr("pad_lost_d"), W // 2, 98, (200, 200, 210), s.tiny); return
        items = s.pause_items()
        s.menu_box([x[1] for x in items], s.menu_i.get("pause", 0), title=tr("paused"), sub=None if s.coop else tr("p2_hint"), minw=130)
    # ---------- bonfire ----------
    def bonfire_items(s):
        it = [("go", tr("m_leave_fire")), ("lvl0", tr("m_levelup", tr("pl_1")) if s.coop else tr("m_levelup1"))]
        if s.coop: it.append(("lvl1", tr("m_levelup", tr("pl_2"))))
        it += [("map", tr("m_map")), ("title", tr("m_save_exit"))]
        return it
    def up_bonfire(s):
        r = s.menu_in(); items = s.bonfire_items(); i = s.sel("bonfire", len(items), r)
        if r["back"]: s.state_name = "play"; return
        if r["ok"]:
            k = items[i][0]; sfx("confirm", 0.6)
            if k == "go": s.state_name = "play"
            elif k.startswith("lvl"): s.lv_who = int(k[3]); s.lv_i = 0; s.state_name = "levelup"
            elif k == "map": s.open_map("bonfire")
            elif k == "title": s.back_to_title()
    def dr_bonfire(s):
        s.draw_play_scene(); s.canvas.blit(s.dimmer, (0, 0))
        items = s.bonfire_items(); bid = s.save["bonfire"]
        s.menu_box([x[1] for x in items], s.menu_i.get("bonfire", 0), title=tr(BF_KEYS[bid]), sub=tr("fire_sub"), minw=150)
    # ---------- level up ----------
    def up_levelup(s):
        r = s.menu_in(); p = s.players[min(s.lv_who, len(s.players) - 1)]
        if r["up"]: s.lv_i = (s.lv_i - 1) % 4; sfx("select", 0.5)
        if r["down"]: s.lv_i = (s.lv_i + 1) % 4; sfx("select", 0.5)
        if r["back"]: s.state_name = "bonfire"; return
        if r["ok"]:
            if not s.buy_stat(p, STAT_KEYS[s.lv_i]): sfx("hurt", 0.4)
    def dr_levelup(s):
        s.draw_play_scene(); s.canvas.blit(s.dimmer, (0, 0)); c = s.canvas
        p = s.players[min(s.lv_who, len(s.players) - 1)]
        s.panel(10, 8, 300, 154)
        s.text(tr("lv_title"), W // 2, 20, (255, 225, 150), s.mid)
        s.text(tr(CLASS_KEYS[p.cls]) if not s.coop else tr("lv_who", tr("pl_%d" % (p.idx + 1)), tr(CLASS_KEYS[p.cls])), 20, 38, (220, 220, 230), s.font, "l")
        cost = level_cost(p.level) if p.level < MAX_LEVEL else 0
        s.text(tr("lv_level", p.level), 300, 38, (255, 235, 170), s.font, "r")
        names = [tr("st_vit"), tr("st_end"), tr("st_str"), tr("st_foc_" + p.cls)]
        vals = [p.ch["stats"][k] for k in STAT_KEYS]
        for i in range(4):
            y = 58 + i * 20; sel = i == s.lv_i
            if sel: pygame.draw.rect(c, (60, 40, 30), (16, y - 9, 288, 19)); pygame.draw.rect(c, (150, 110, 60), (16, y - 9, 288, 19), 1)
            s.text(names[i], 24, y, (255, 225, 140) if sel else (200, 200, 210), s.font, "l")
            s.text(num(vals[i]), 150, y, (255, 255, 255), s.font, "r")
            dl = wrap(s.tiny, tr("st_%s_d" % STAT_KEYS[i] if i < 3 else "st_foc_%s_d" % p.cls), 140)[:2]
            for j, ln in enumerate(dl): s.text(ln, 160, y + (j * 9 - 4 if len(dl) > 1 else 0), (150, 190, 160) if sel else (110, 140, 120), s.tiny, "l")
        yb = 137
        s.text(tr("lv_souls", p.souls), 24, yb, (150, 230, 255), s.font, "l")
        if p.level >= MAX_LEVEL: s.text(tr("lv_max"), 296, yb, (255, 200, 120), s.font, "r")
        else: s.text(tr("lv_cost", cost), 296, yb, (150, 255, 160) if p.souls >= cost else (255, 120, 110), s.font, "r")
        s.rich(tr("hint_levelup"), W // 2, 152, (190, 190, 200), s.tiny)
    # ---------- map ----------
    def build_map(s):
        if getattr(s, "mapimg", None): return
        s.mapimg = []
        cols = {"forest": ((70, 80, 62), (110, 150, 80)), "swamp": ((70, 78, 56), (140, 160, 80)), "river": ((84, 84, 120), (150, 190, 220)), "pohjola":((36,40,57),(83,105,150))}
        for (nm, a, b) in AREAS:
            surf = pygame.Surface(((b - a) * 2, ROWS)); surf.fill((14, 12, 20)); base, top = cols[nm]
            for tx in range(a, b):
                for ty in range(ROWS):
                    v = GRID[ty][tx]; x = (tx - a) * 2
                    if v == SOLID: surf.fill(top if GRID[ty - 1][tx] != SOLID else base, (x, ty, 2, 1))
                    elif v == PLAT: surf.fill((150, 110, 70), (x, ty, 2, 1))
                    elif v == WATER: surf.fill((50, 90, 170), (x, ty, 2, 1))
                    elif v == THORN: surf.fill((180, 60, 70), (x, ty, 2, 1))
                    elif v == LADDER: surf.fill((170, 120, 70), (x + 0, ty, 1, 1))
            sil = pygame.Surface(surf.get_size()); sil.fill((14, 12, 20))      # "unknown" silhouette version
            for tx in range(a, b):
                for ty in range(ROWS):
                    if GRID[ty][tx] in (SOLID, WATER): sil.fill((34, 32, 42) if GRID[ty][tx] == SOLID else (28, 30, 46), ((tx - a) * 2, ty, 2, 1))
            s.mapimg.append((nm, a, b, surf, sil))
    def up_map(s):
        r = s.menu_in()
        if r["back"] or r["ok"] or any(pd.pressed("back") for pd in s.pads.values()): s.state_name = s.map_from
    def map_known(s):
        """visited cells, and the unknown-but-adjacent frontier (shown as dark silhouettes)."""
        vis = set(); front = set()
        for k in s.mapseen:
            if "," in k:
                try: cx, cy = k.split(","); vis.add((int(cx), int(cy)))
                except ValueError: pass
        for (cx, cy) in vis:
            for d in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                c2 = (cx + d[0], cy + d[1])
                if c2 not in vis: front.add(c2)
        return vis, front
    def dr_map(s):
        s.build_map(); c = s.canvas;s.msgs.clear()
        if s.save is not None: s.draw_play_scene()
        c.blit(s.dimmer, (0, 0)); c.fill((10, 8, 14), (0, 0, W, H))
        s.text(tr("m_map"), W // 2, 7, (255, 225, 150), s.font)
        vis, front = s.map_known()
        for i, (nm, a, b, surf, sil) in enumerate(s.mapimg):
            y = map_y(s,i) if len(s.mapimg)>4 else (17+i*39); x = (W - surf.get_width()) // 2
            known = any(a <= cx * MAP_CW + MAP_CW - 1 and cx * MAP_CW < b for (cx, cy) in vis)
            pygame.draw.rect(c, (10,8,14) if not known else (18,16,24), (x - 1, y - 1, surf.get_width() + 2, ROWS + 2))
            for cx in range(a // MAP_CW, (b - 1) // MAP_CW + 1):
                for cy in range((ROWS + MAP_CH - 1) // MAP_CH):
                    src = surf if (cx, cy) in vis else (sil if (cx, cy) in front else None)
                    if src is None: continue
                    t0 = max(a, cx * MAP_CW); t1 = min(b, cx * MAP_CW + MAP_CW)
                    r = pygame.Rect((t0 - a) * 2, cy * MAP_CH, (t1 - t0) * 2, min(MAP_CH, ROWS - cy * MAP_CH))
                    c.blit(src, (x + r.x, y + r.y), r)
            for k, ar in ARENAS.items():          # boss rooms stay secret until seen
                if a <= ar["x0"] < b:
                    if ("arena:" + k) not in s.mapseen:
                        c.fill((10, 8, 14), (x + (ar["x0"] + 1 - a) * 2, y + ar["y0"], (ar["x1"] - ar["x0"] - 1) * 2, ar["ground"] - ar["y0"] + 2)); continue
                    done = k in s.save["bosses"]; mx = x + (ar["x0"] + 10 - a) * 2; my = y + ar["y0"] + 6
                    pygame.draw.rect(c, (90, 90, 100) if done else (220, 60, 60), (mx - 2, my - 2, 5, 5), 1); c.fill((90, 90, 100) if done else (220, 60, 60), (mx, my, 1, 1))
            for bid, tx in BONFIRES.items():
                if a <= tx < b and bid in s.save["seen"]:
                    by = floor_row(tx, BF_START[bid]); c.fill((255, 170, 70), (x + (tx - a) * 2 - 1, y + by - 3, 4, 3)); c.fill((255, 235, 150), (x + (tx - a) * 2, y + by - 3, 2, 1))
            for p in s.players:
                tx = p.x / TILE
                if a <= tx < b and (s.t_ui // 15) % 2 == 0:
                    col = (255, 255, 255) if p.idx == 0 else P2_TINT[p.cls]; c.fill(col, (x + int((tx - a) * 2) - 1, y + int(p.y / TILE) - 2, 3, 3))
            if known: s.text(tr("area_" + nm), x + 3, y - 5, (220, 215, 200), s.tiny, "l")
        s.text(tr("map_legend"), W // 2, H - 6, (170, 170, 180), s.tiny)
    # ---------- settings ----------
    def setting_label(s, k):
        return tr("set_" + k)
    def setting_value(s, k):
        v = SETTINGS.get(k)
        if k == "lang": return tr("lang_" + v)
        if k == "difficulty": return tr("dn_" + v)
        if k == "penalty": return tr("pen_" + v)
        if k in ("music", "sfx", "shake", "dmgnum", "hints", "perf"): return tr("on") if v else tr("off")
        if k == "flash": return tr("fl_full") if v else tr("fl_reduced")
        if k == "prompts": return tr("pr_" + v)
        if k == "runmode": return tr("run_" + v)
        return None
    def change_setting(s, k, d):
        if k in ("music", "sfx", "shake", "dmgnum", "flash", "hints", "perf"): SETTINGS[k] = not SETTINGS[k]
        elif k in CHOICES:
            ch = CHOICES[k]; SETTINGS[k] = ch[(ch.index(SETTINGS[k]) + d) % len(ch)]
            if k == "lang": s.tcache.clear(); s.gcache.clear()
        elif k in ("music_vol", "sfx_vol"): SETTINGS[k] = max(0, min(10, SETTINGS[k] + d))
        save_settings(); sfx("select", 0.8)
    def up_settings(s):
        r = s.menu_in(); n = len(SETTING_ROWS); i = s.sel("settings", n, r); k = SETTING_ROWS[i]
        d = 1 if r["right"] else -1 if r["left"] else 0
        if k in ("controls", "back"):
            if r["ok"]:
                if k == "back": s.state_name = s.set_from
                else: s.state_name = "controls"; s.ctl_from = "settings"
        elif d: s.change_setting(k, d)
        elif r["ok"]: s.change_setting(k, 1)
        if r["back"]: s.state_name = s.set_from
    def dr_settings(s):
        c = s.canvas
        if s.set_from == "title": s.draw_title_bg(c, s.t_ui)
        else: s.draw_play_scene(); c.blit(s.dimmer, (0, 0))
        s.panel(12, 6, 296, 168)
        s.text(tr("m_settings"), W // 2, 17, (255, 225, 150), s.mid)
        n = len(SETTING_ROWS); i = s.menu_i.get("settings", 0); vis = 9
        top = max(0, min(n - vis, i - vis // 2))
        for row in range(vis):
            idx = top + row; k = SETTING_ROWS[idx]; y = 35 + row * 12; sel = idx == i
            if sel: pygame.draw.rect(c, (60, 40, 30), (18, y - 6, 284, 12)); pygame.draw.rect(c, (150, 110, 60), (18, y - 6, 284, 12), 1)
            col = (255, 225, 140) if sel else (200, 200, 210)
            s.text(s.setting_label(k), 26, y, col, s.font, "l")
            if k in ("music_vol", "sfx_vol"):
                v = SETTINGS[k]
                for q in range(10): c.fill((255, 225, 140) if q < v and sel else (200, 200, 210) if q < v else (60, 56, 64), (222 + q * 7, y - 3, 5, 6))
                if sel: s.text(tr("lt"), 214, y, col, s.font, "r"); s.text(tr("gt"), 296, y, col, s.font, "r")
            elif k in ("controls", "back"):
                if sel: s.text(tr("gt"), 296, y, col, s.font, "r")
            else:
                v = s.setting_value(k)
                s.text(TStr(tr("lt") + " " + v + " " + tr("gt")) if sel else v, 296, y, col, s.font, "r")
        if top > 0: pygame.draw.polygon(c, (200, 180, 120), [(160, 27), (164, 27), (162, 24)])
        if top + vis < n: pygame.draw.polygon(c, (200, 180, 120), [(160, 138), (164, 138), (162, 141)])
        k = SETTING_ROWS[i]; desc = "sd_" + k + ("_" + SETTINGS[k] if k in ("difficulty", "penalty") else "")
        for j, ln in enumerate(wrap(s.tiny, tr(desc), 276)[:2]): s.text(ln, W // 2, 152 + j * 10, (190, 190, 170), s.tiny)
    # ---------- controls ----------
    def up_controls(s):
        r = s.menu_in()
        if r["back"] or r["ok"]: s.state_name = s.ctl_from
    def dr_controls(s):
        c = s.canvas
        if s.ctl_from == "pause" and s.save is not None: s.draw_play_scene(); c.blit(s.dimmer, (0, 0))
        elif s.ctl_from == "title": s.draw_title_bg(c, s.t_ui)
        else: c.fill((10, 8, 14))
        cls = s.players[0].cls if s.save is not None and s.players else (s.save["cls"] if s.save else "warrior")
        s.panel(8, 4, 304, 172)
        s.text(tr("m_controls"), W // 2, 14, (255, 225, 150), s.mid)
        rows = [("move", "c_move"), ("jump", "c_jump"), ("light", "c_light_" + cls), ("heavy", "c_heavy_" + cls), ("dodge", "c_dodge"), ("guard", "c_guard_" + cls),
                ("skill", "c_skill_" + cls), ("flask", "c_flask"), ("interact", "c_interact"), ("map", "c_map"), ("pause", "c_pause")]
        for i, (act, lab) in enumerate(rows):
            y = 30 + i * 11
            g = s.glyph(act); s.canvas.blit(g, (20, y - 6)); s.text(tr(lab), 56, y, (225, 225, 215), s.tiny, "l")
        s.text(tr("c_drop"), 20, 150, (200, 200, 190), s.tiny, "l")
        s.text(tr("c_quit"), 20, 159, (255, 190, 150), s.tiny, "l")
        s.text(tr("c_join"), 20, 168, (170, 220, 190), s.tiny, "l")
    # ---------- ending / secret encounter entrance ----------
    def start_ending(s):
        s.save["done"]=True;s.save["louhi_unlocked"] = "louhi" in s.save["bosses"];s.save_game()
        s.state_name="ending";s.end_page=0;s.end_t=0;MUSIC.request("title")
    def up_ending(s):
        r=s.menu_in();s.end_t+=1
        if r["ok"] and s.end_t>30:s.end_page+=1;s.end_t=0
        if (s.end_page>1 or (s.end_page==1 and s.end_t>80)) and "louhi" not in s.save["bosses"]:s.state_name="interrupt";s.interrupt_t=0
        elif s.end_page>=4:s.enter_pohjola(s.save)
    def dr_ending(s):
        c=s.canvas;c.fill((6,6,12));fs=fog_surface("river");t=s.t_ui;fx=-int(t*.3)%640;c.blit(fs,(fx-640,60));c.blit(fs,(fx,60))
        pg=s.end_page;f=min(1,s.end_t/50)
        if pg<3:
            lines=wrap(s.font,tr("end_%d"%pg),260)
            for i,line in enumerate(lines):s.text(line,160,70+i*15-len(lines)*6,tuple(int(v*f) for v in (225,215,190)))
        else:s.text(tr("end_title"),160,70,tuple(int(v*f) for v in (255,225,150)),s.big);s.text(tr("end_thanks"),160,112,(190,200,190))
    def up_interrupt(s):
        s.interrupt_t+=1
        if s.interrupt_t>115:s.enter_pohjola(s.save)
    def dr_interrupt(s):
        c=s.canvas
        if s.interrupt_t>70:c.fill((0,0,0));return
        c.fill((7,3,12));spr=louhi_frame("windup",s.interrupt_t//6,phase=3);c.blit(spr,(160-spr.get_width()//2,90-spr.get_height()//2))
        if s.interrupt_t<45:s.text(tr("louhi_intro"),160,151,(225,122,131),s.font)
    def up_poht(s):
        s.poht_t+=1
        if s.poht_t==40:MUSIC.request("pohjola")
        if s.poht_t>100:
            if s.save.get("p2") and len(s.players)==1:
                second=next((pd for pd in s.pads.values() if pd is not s.p_pad[0] and not isinstance(pd,IdlePad)),IdlePad());s.add_p2(s.save["p2"]["cls"],second)
            s.state_name="play";s.dark=.67;MUSIC.request("pohjola")
    def dr_poht(s):
        c=s.canvas;c.fill((0,0,0))
        if s.poht_t>=45:s.chunk(int(s.cam[0])//320);s.draw_world(c,0);s.draw_light(c,0,s.cam[0],s.cam[1],PAL["pohjola"])
    def up_true(s):
        s.menu_in();s.true_t+=1
        if s.true_t>120:s.state_name="true_ending";s.true_page=0;s.true_t=0
    def dr_true(s):s.canvas.fill((0,0,0))
    def up_true_ending(s):
        r=s.menu_in();s.true_t+=1
        if r["ok"] and s.true_t>30:s.true_page+=1;s.true_t=0
        if s.true_page>=4:s.back_to_title()
    def dr_true_ending(s):
        c=s.canvas;c.fill((7,10,19));pg=s.true_page
        if pg<3:
            lines=wrap(s.font,tr("real_%d"%pg),260)
            for i,line in enumerate(lines):s.text(line,160,70+i*15-len(lines)*5,(220,222,209))
        else:s.text(tr("real_title"),160,52,(245,221,158),s.big);s.text(tr("end_thanks"),160,110,(205,220,222));s.rich(tr("hint_next"),160,156,(150,170,180),s.tiny)

# ======== p14_text.py ========

# ---------------- translations: Finnish / English ----------------
def _t(key, fi, en): TR["fi"][key] = fi; TR["en"][key] = en

_t("title", "TUONELAN POLKU", "PATH OF TUONELA")
_t("subtitle", "Matka Tuonelan virralle", "A journey to the river of Tuonela")
_t("m_continue", "Jatka", "Continue"); _t("m_new", "Uusi peli", "New game"); _t("m_settings", "Asetukset", "Settings"); _t("m_quit", "Lopeta", "Quit")
_t("m_resume", "Jatka peliä", "Resume"); _t("m_map", "Kartta", "Map"); _t("m_controls", "Ohjaus", "Controls")
_t("m_p2_leave", "Pelaaja 2 poistuu", "Player 2 leaves"); _t("m_to_title", "Päävalikkoon", "Main menu")
_t("paused", "Tauko", "Paused"); _t("p2_hint", "Toinen pelaaja: paina Start toisella ohjaimella", "Second player: press Start on another controller")
