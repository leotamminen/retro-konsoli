def newboss_frame(key,pose,phase,t):
    k=(key,pose,pose=='fish',phase,t%4)
    if k in _BSPR:return _BSPR[k]
    if key=='aino' and pose=='fish':
        s=mk(192,160);jr=(t%4)
        pygame.draw.ellipse(s,(83,153,174),(37,62-jr,119,47));pygame.draw.polygon(s,(145,194,187),[(40,82-jr),(9,47-jr),(14,112-jr),(46,94-jr)])
        pygame.draw.ellipse(s,(132,207,198),(46,61-jr,114,47),2)
        for i in range(5):pygame.draw.arc(s,(189,221,188),(58+i*16,43-jr,34,55),.8,2.1,2)
        pygame.draw.circle(s,(239,215,162),(136,87),5);pygame.draw.circle(s,(23,45,64),(136,87),2)
        pygame.draw.arc(s,(58,112,146),(130,92,19,20),1,4,2)
        for i in range(4):pygame.draw.arc(s,(193,229,216),(53+i*18,87,29,12),0,math.pi,1)
    else:
        s={'joukahainen':_young_singer,'ahti':_sea_king,'aino':_braided_maiden,'vellamo':_water_queen}[key](pose,phase,t)
    s=_outline(s,(13,31,40)).subsurface((1,1,s.get_width(),s.get_height())).copy()
    _BSPR[k]=s
    return s

def aino_glimpse(surf,tx,t):
    spr=newboss_frame('aino','maiden' if tx<598 else 'fish',1,t//8)
    surf.blit(spr,(int(tx-spr.get_width()/2),int(100-spr.get_height()/2)))

# ======== p20_vellamo_music.py ========
PTEMPO={'ranta': 96, 'syvanne': 78, 'katedraali': 96, 'joukahainen': 108, 'ahti': 112, 'aino': 124, 'vellamo': 132, 'vellamo2': 270, 'joukahainen2': 130, 'joukahainen3': 140, 'ahti2': 132, 'ahti3': 140, 'aino2': 136, 'aino3': 140, 'vellamo3': 140}
def compose_water(name):
    phase=2 if name=='vellamo2' else 1;tempo=PTEMPO.get(name,72)
    bars=48 if name=="vellamo2" else 24;steps=12;bar=round(60/tempo*3/2*RATE/12)*12;total=bars*bar;buf=[0.0]*(total+RATE);rnd=random.Random(name)
    scale=[45,48,50,53,55,57,60,62];cache={};beat=bar//steps
    def toneat(n,pos,amp):
        if n not in cache:cache[n]=_lead_note('reed' if 'aino' in name else 'flute',midi(n),1.5+bars%3,n)
        _mixin(buf,cache[n],pos,amp)
    for b in range(bars):
        root=scale[(b//2+sum(name.encode())%5)%4];pos=b*bar
        if name.startswith('joukahainen'):root=[45,52,48,40][b%4]
        elif name.startswith('ahti'):root=[33,36,40,29][(b//2)%4]
        elif name.startswith('aino'):root=[53,50,57,52][(b//2)%4]
        elif name.startswith('vellamo'):root=[38,39,32,31][(b//2)%4]
        for k in (0,3):
            n=0
            _mixin(buf,C(root,k),pos+k*beat,.055)
        for j in range(steps):
            tt=pos+j*beat
            if j%3==0:_mixin(buf,_V_bd,tt,.14 if b%3 else .2)
            pattern={'ranta':(0,3,6,9),'syvanne':(2,5,8,11),'katedraali':(0,4,7,11),'joukahainen':(1,3,7,10),'ahti':(0,6,9),'aino':(2,7,9,11),'vellamo':(0,3,8,11)}[next(k for k in ('ranta','syvanne','katedraali','joukahainen','ahti','aino','vellamo') if name.startswith(k))]
            if j in pattern:toneat(root+scale[(j+b)%len(scale)]%12+12,tt,.058 if b<4 else .11)
            if b>=bars//2 and j%2==0:_mixin(buf,_V_shaker,tt,.065+.01*(name=='vellamo'))
        time.sleep(.001)
    return [math.tanh(v*1.15)*.75 for v in buf[:total]]
_VC={}
def C(root,k):
    key=(root,k)
    if key not in _VC:_VC[key]=_lead_note('choir',midi(root-(12 if k else 0)),4.5,root)
    return _VC[key]
_V_bd=tone(93,40,.28,.45,'sine');_V_shaker=tone(7000,4000,.045,.15,'noise')
_prev13=render_track
def render_track(name):
    if name in PTEMPO:

        return compose_water(name)
    return _prev13(name)
TRACK_ORDER+=tuple(PTEMPO)
for name,tempo in PTEMPO.items():TRACKS[name]={'key':1,'tempo':tempo,'meter':8}
MusicPlayer.LIKELY.update(ranta=['joukahainen'],syvanne=['ahti'],katedraali=['aino'],joukahainen=[],ahti=[],aino=['vellamo'],vellamo=['vellamo2'],vellamo2=[])

# ======== p21_vellamo_combat.py ========
"""Aquatic bosses: unique telegraphed songs, waters, transformations, and sea-vines."""
class WaterBoss(Boss):
    def __init__(s,g,key,x,y):
        Boss.__init__(s,g,key,x,y);s.fly=False;s.vb='idle'
    def physics(s):
        s.vx=.9 if s.atk else 0;s.vy=min(MAX_FALL,s.vy+GRAV);move_body(s.g.wd,s)
    def trans(s):
        s.atk=None;s.invuln=True;s.vb='roar';sfx('roar',.9);s.g.shake(3,38)
        for i in range(90):s.warn=90-i;s.warn_t=i;yield
        s.phase=2 if s.phase<2 else 3;s.invuln=False;s.vb='idle'
        MUSIC.request(s.key+('3' if s.phase==3 else '2'))
    def tell(s,n):
        n=tele(n);s.vb='windup'
        for i in range(n):s.warn=n-i;s.warn_t=i;yield
        s.warn=0;s.vb='attack'
    def wait(s,n):
        s.vb='idle'
        for _ in range(rest(n)):yield
    def shoot(s,kind,x,y,vx,vy,dmg=30,life=180,curve=0,col=(103,210,203)):
        s.g.projs.append(Proj(kind,x,y,vx,vy,dmg*D()['dmg'],10,28,tags=('magic',),life=life,curve=curve,col=col))
    def burst(s,n,speed=1.7,kind='runic'):
        for i in range(n):
            a=i*2*math.pi/n;s.shoot(kind,s.x,s.y-50,math.cos(a)*speed,math.sin(a)*speed,life=140)
    def brain(s):
        yield from s.tell(62);s.invuln=False
        yield from s.wait(22)
        while True:
            if s.key=='joukahainen':yield from s.jous()
            elif s.key=='ahti':yield from s.aht()
            elif s.key=='aino':yield from s.ain()
            else:yield from s.vel()
    def direction(s,x):return 1 if x>=s.x else -1
class Joukahainen(WaterBoss):
    def __init__(s,g,x,y):WaterBoss.__init__(s,g,'joukahainen',x,y)
    def jous(s):
        opts=['runes','bog','crossbow'] if s.phase<2 else ['runes','bog','crossbow','frost']
        s.actname=s.pick([(o,1) for o in opts])
        if s.actname=='runes':
            yield from s.tell(40)
            for j in range(5):
                for y in (250,277,304):s.shoot('verse',s.x-20,y,-2.0 if s.g.players[0].x<s.x else 2.0,0,22,curve=.008 if s.phase>=2 else 0)
                yield from s.wait(8)
        elif s.actname=='bog':
            yield from s.tell(48);t=s.mid_target()
            if t:s.g.zones.append(Zone(t.x,320,48,14,28,180,12*D()['dmg'],'bog',0))
            yield from s.wait(75)
        elif s.actname=='crossbow':
            yield from s.tell(29);t=s.mid_target();a=-math.pi
            if t:s.face=s.direction(t.x);a=math.atan2(t.y-16-s.y+57,t.x-s.x)
            for deg in (-12,0,12) if s.phase>=2 else (0,):
                angle=a+deg*math.pi/180;s.shoot('thornwave',s.x,s.y-57,math.cos(angle)*4,math.sin(angle)*4,34,curve=.012,col=(187,133,109))
            yield from s.wait(22)
        else:
            yield from s.tell(50)
            for j in range(4):s.g.zones.append(Zone(s.L+40+j*70,320,24,140,30+j*13,20,32*D()['dmg'],'frost',2.4))
            yield from s.wait(32)
class Ahti(WaterBoss):
    def __init__(s,g,x,y):WaterBoss.__init__(s,g,'ahti',x,y)
    def aht(s):
        opts=['wave','current','beasts','trident'] if s.phase<2 else ['wave','current','beasts','tide']
        s.actname=s.pick([(o,1) for o in opts])
        if s.actname=='wave':
            yield from s.tell(40)
            for side in (-1,1):
                for i in range(6):s.shoot('swell',s.x,320-i*9,side*2.2,-.13,28,curve=.004)
            yield from s.wait(28)
        elif s.actname=='current':
            yield from s.tell(48);direction=random.choice((-1,1))
            for i in range(125):
                for p in s.g.players:
                    if p.alive() and p.state not in ('roll','hurt'):p.vx=max(-2.8,min(2.8,p.vx+direction*.09))
                if i%12==0:s.shoot('bubble',random.uniform(s.L,s.R),318,-direction*.5,-.5,18,life=130)
                yield
            yield from s.wait(18)
        elif s.actname=='beasts':
            yield from s.tell(52)
            for dx in (-92,62):s.g.zones.append(Zone(max(s.L,min(s.R,s.x+dx)),320,27,90,20,23,27*D()['dmg'],'tentacle',2.7))
            yield from s.wait(38)
        elif s.actname=='trident':
            yield from s.tell(38)
            for x in [s.L+35,s.L+95,s.L+155,s.L+215,s.R-22]:s.g.zones.append(Zone(x,320,22,113,18,25,37*D()['dmg'],'tidepike',2))
            yield from s.wait(24)
        else:
            yield from s.tell(44)
            for x in range(int(s.L+28),int(s.R),50):s.g.zones.append(Zone(x,315,29,180,10,150,22*D()['dmg'],'tentacle',2.6))
            yield from s.wait(30)
class Aino(WaterBoss):
    def __init__(s,g,x,y):WaterBoss.__init__(s,g,'aino',x,y)
    def die(s,pl):s.calm()
    def calm(s):s.hp=1;s.gen=None;s.g.start_aino_reveal()
    def ain(s):
        acts=['fin','drop','stream'] if s.phase<2 else ['fin','memory','stream','transform']
        if s.phase>=3:acts=['stream','memory','transform','fin']
        s.actname=s.pick([(o,1) for o in acts])
        if s.actname in ('fin','transform'):
            s.vb='fish';yield from s.tell(34);t=s.mid_target()
            if t:s.face=s.direction(t.x)
            for dx in (-45,0,45) if s.phase>=3 else (0,):s.shoot('thornwave',s.x,s.y-45,(-s.face*3.1+dx*.006),.3,28,curve=.024,col=(155,214,219))
            yield from s.wait(23);s.vb='maiden'
        elif s.actname=='drop':
            yield from s.tell(43);t=s.mid_target()
            if t:s.shoot('memory',t.x,110,0,.7,32,curve=.014,col=(192,181,231))
            yield from s.wait(40)
        elif s.actname=='stream':
            yield from s.tell(34)
            for side in (-1,1):
                for y in range(263,321,18):s.shoot('bubble',s.x,y,side*2.35,-.18,25,curve=-.001)
            yield from s.wait(20)
        else:
            yield from s.tell(45)
            for x in (s.L+38,s.L+105,s.R-40):s.g.zones.append(Zone(x,320,34,150,28,18,35*D()['dmg'],'frost',2))
            yield from s.wait(25)
class Vellamo(WaterBoss):
    def __init__(s,g,x,y):WaterBoss.__init__(s,g,'vellamo',x,y)
    def vel(s):
        acts=['lattice','crown','undertow'] if s.phase<2 else ['lattice','crown','undertow','cage']
        if s.phase>=3:acts=['lattice','crown','undertow','cage','erasure']
        s.actname=s.pick([(o,1) for o in acts])
        if s.actname=='lattice':
            yield from s.tell(48)
            for j in range(9 if s.phase<3 else 13):
                y=225+(j%5)*17;s.shoot('memory',s.x-28,y,-2.4,0,34,curve=.003*(1 if j%2 else -1),col=(156,166,211));yield from s.wait(4)
        elif s.actname=='crown':
            yield from s.tell(44)
            for x in range(int(s.L+20),int(s.R),52):s.g.zones.append(Zone(x,320,28,130,tele(35)+((x//20)%3)*11,21,36*D()['dmg'],'tidepike',3))
            yield from s.wait(28)
        elif s.actname=='undertow':
            yield from s.tell(43)
            for i in range(105):
                for p in s.g.players:
                    if p.alive():p.vx+=(s.x-p.x)*.0015
                if i%15==0:s.burst(5,1.35,'bubble')
                yield
            yield from s.wait(20)
        elif s.actname=='cage':
            yield from s.tell(46);t=s.mid_target()
            if t:s.g.zones.append(Zone(t.x,320,70,95,22,25,43*D()['dmg'],'cage',2))
            yield from s.wait(32)
        else:
            yield from s.tell(54);s.burst(13,2.0,'memory')
            for x in range(int(s.L+15),int(s.R),53):s.g.zones.append(Zone(x,320,18,118,25,15,36*D()['dmg'],'frost',2))
            yield from s.wait(30)
BOSS_CLS.update(joukahainen=Joukahainen,ahti=Ahti,aino=Aino,vellamo=Vellamo)

# ======== p22_vellamo_mobs.py ========
def aquatic_brain(s):
    fall=0
    s.fly=True
    while True:
        t=s.target()
        if t:s.see(t)
        if s.kind=='poltto':
            gx=s.hx+math.sin(s.t*.028)*42;gy=s.hy-45+math.sin(s.t*.07)*20
            s.vx=(gx-s.x)*.035;s.vy=(gy-s.y)*.035
            if t and s.t%100==0:s.g.projs.append(Proj('bubble',s.x,s.y-8,(t.x-s.x)*.013,-.5,17*D()['dmg'],8,17,tags=('magic',),life=140,col=(144,225,209)))
        elif s.kind=='merikala':
            if t:s.vx=(t.x-s.x)*.024;s.vy=(t.y-12-s.y)*.024+math.sin(s.t*.068)*.45
            s.vy=min(1.8,max(-1.8,s.vy))
        else:
            gx=s.hx+math.sin(s.t*.045)*24;gy=s.hy-16;s.vx=(gx-s.x)*.038;s.vy=(gy-s.y)*.026
            if t and s.t%110==0:
                for z in (-1,0,1):s.g.projs.append(Proj('verse',s.x,s.y-15,z*1.2,-.6,22*D()['dmg'],7,11,tags=('magic',),life=135,curve=.03,col=(154,178,209)))
        yield

# ======== p22_vellamo_projectiles.py ========
_v13_init=Proj.__init__
def _v13_init_new(s,*args,curve=0,**kw):_v13_init(s,*args,**kw);s.curve=curve;s.wd=None
Proj.__init__=_v13_init_new
_v13_proj=Proj.update
def _v13_proj_new(s,g):
    s.wd=g.wd
    if s.kind not in ('runic','verse','memory','thornwave','bubble','swell'):_v13_proj(s,g);return
    s.t+=1;s.life-=1
    if s.life<=0:s.dead=True;return
    s.x+=s.vx;s.y+=s.vy;s.vy+=s.curve
    if s.kind=='bubble':s.vy-=.012
    if s.kind not in ('thornwave',) and g.wd.solid(int(s.x//TILE),int(s.y//TILE)):s.dead=True
Proj.update=_v13_proj_new
_v13_pdraw=Proj.draw
def _v13_pdraw_new(s,surf,cx,cy):
    if s.kind not in ('runic','verse','memory','thornwave','bubble','swell'):_v13_pdraw(s,surf,cx,cy);return
    x=int(s.x-cx);y=int(s.y-cy);co=s.col
    if s.kind in ('runic','memory'):pygame.draw.rect(surf,co,(x-2,y-6,4,12),1);pygame.draw.line(surf,co,(x-5,y+3),(x+5,y-3),1)
    elif s.kind=='thornwave':pygame.draw.polygon(surf,co,[(x-4,y+7),(x,y-8),(x+4,y+7)])
    elif s.kind=='bubble':pygame.draw.circle(surf,co,(x,y),6,1);pygame.draw.circle(surf,(223,250,234),(x+2,y-2),1)
    elif s.kind=='verse':
        pygame.draw.arc(surf,co,(x-8,y-10,15,21),-math.pi/2,math.pi,1);pygame.draw.circle(surf,co,(x-4,y+8),3)
    else:pygame.draw.arc(surf,co,(x-13,y-22,27,40),0,math.pi,3);pygame.draw.arc(surf,(173,233,227),(x-6,y-13,13,23),0,math.pi,1)
Proj.draw=_v13_pdraw_new
_v13_zdraw=Zone.draw
def _v13_draw_zone(s,surf,cx,cy):
    if s.style not in ('bog','tentacle','tidepike','cage','frost'):_v13_zdraw(s,surf,cx,cy);return
    x=int(s.x-cx);y=int(s.y-cy);a=125
    if not s.active:
        pygame.draw.line(surf,(170,225,224),(x-int(s.w/2),y),(x+int(s.w/2),y),2);pygame.draw.line(surf,(168,215,200),(x,y-s.h),(x,y-8),1)
    elif s.style=='bog':pygame.draw.ellipse(surf,(18,50,49),(x-20,y-8,40,8));pygame.draw.ellipse(surf,(87,136,109),(x-16,y-5,32,8),1)
    elif s.style=='tentacle':
        for j in range(5):pygame.draw.circle(surf,(30+j*5,104+j*12,93),(x+int(13*math.sin(j*.8+s.t*.05)),y-j*17),15-j*2)
    elif s.style=='tidepike':pygame.draw.polygon(surf,(178,225,213),[(x-11,y),(x,y-110),(x+2,y-67),(x+18,y-60),(x+10,y-80),(x+8,y-53)])
    elif s.style=='cage':
        for dx in range(-35,36,12):pygame.draw.line(surf,(68,179,148),(x+dx,y+2),(x+dx,y-92),3)
        pygame.draw.line(surf,(112,185,165),(x-35,y-92),(x+35,y-92),3)
    else:pygame.draw.polygon(surf,(168,206,226),[(x-11,y),(x-13,y-60),(x,y-96),(x+12,y-25),(x+4,y-40)])
_zone_rect=Zone.rect
Zone.rect=lambda s:((s.x-24,s.y-20,48,5) if s.style=='bog' and s.active else _zone_rect(s))

_old_zone_update=Zone.update
def _v13_zone_update(s,g):
    _old_zone_update(s,g)
    if s.style=='bog' and s.active:
        for p in g.players:
            if abs(p.x-s.x)<24 and abs(p.y-s.y)<32:
                bo=getattr(p,'bog',None)
                if bo!=s:
                    p.bog=s;p.bog_t=90;p.vx=0;p.y=s.y;p.vy=0
                elif p.pad.pressed("jump"):
                    p.bog_t=0;p.bog=None;p.y-=18;p.vy=JUMP_V;p.inv=max(p.inv,80);s.dead=True
                else:
                    p.bog_t-=1
                    if s.t%90==0:p.take_hit(12*D()['dmg'],s.x,0,tags=('magic',))
                    if p.bog_t<=0:p.bog=None;s.dead=True
Zone.update=_v13_zone_update

# ======== p23_v13_game.py ========
"""Vellamo world, UI and saved continuation. Only the new columns change legacy hazard rules."""
import gc
VERSION='1.3.2'
_spawn=GameCore.spawn_enemies
def spawn_enemies(s):
    _spawn(s);tx=int(s.players[0].x//TILE)
    if tx>=486:
        for k,tx2,fr in [('poltto',502,20),('merikala',511,20),('kutri',536,20),('merikala',553,20),('poltto',564,20),('kutri',587,20),('poltto',610,20),('merikala',650,20)]:
            if abs(tx2-tx)<20:s.enemies.append(Mob(s,k,tx2*TILE,fr*TILE-44))
GameCore.spawn_enemies=spawn_enemies
_session=GameCore.start_session
def start_session(s,save,pad):
    _session(s,save,pad)
    if save and save.get('vellamo_unlocked'):s.wd.set_open('d_vellamo',True)
    s.aino_glimpse=None;s.tide=0;s.vel_end_t=0;s.current=0
GameCore.start_session=start_session
_arena=GameCore.update_arena;_area=GameCore.update_area;_world=GameCore.draw_world
_old_boss=GameCore.start_boss;_dead=GameCore.on_boss_dead
class _V:
    def update_arena(s):
        _arena(s)
        if isinstance(s.boss,WaterBoss):
            k=s.boss.key;ph=s.boss.phase
            suffix='3' if ph>=3 else '2' if ph>=1.5 else ''
            MUSIC.request(k+suffix if k+suffix in TRACK_ORDER else k)
            if k=='ahti':s.tide=int(math.sin(s.frames*.015)*10)+(22 if ph>=2 else 0)
    def update_area(s):
        _area(s)
        if s.area not in ('ranta','syvanne','katedraali'):return
        tx=int(s.players[0].x//TILE);s.save['vellamo_visited']=True
        if not s.aino_glimpse and not s.boss:
            if 493<=tx<499:s.aino_glimpse=(510*TILE,0.)
            elif 548<=tx<554:s.aino_glimpse=(562*TILE,0.)
            elif 602<=tx<609:s.aino_glimpse=(615*TILE,0.)
        if s.aino_glimpse:
            x,t=s.aino_glimpse
            if t>28:x+=1.5
            s.aino_glimpse=(x,t+1) if t<150 else None
        if s.boss and s.boss.key=='vellamo' and s.boss.dead:s.vel_end_t+=1
        if s.vel_end_t>130:s.start_vellamo_ending()
    def draw_world(s,c,t):
        _world(s,c,t)
        if s.aino_glimpse:
            x=s.aino_glimpse[0]-s.cam[0];aino_glimpse(c,int(x),t)
        if s.area in ('ranta','syvanne','katedraali'):
            for x in (-12,77,198,281):
                y=124+int(math.sin(x*.07+t*.04)*3)+s.tide//2
                pygame.draw.arc(c,(65,127,146),(x,y,18,6),.15,2.9,1)
    def start_boss(s,key):
        _old_boss(s,key)
        if key in ('joukahainen','ahti','aino','vellamo'):
            for p in s.players:p.inv=180
    def on_dead(s,b):
        k=b.key
        if k in ('joukahainen','ahti'):
            if k not in s.save['bosses']:s.save['bosses'].append(k)
            s.wd.set_open('d_'+k+'_in',True);s.felled=(k,0)
            s.save['bonfire']='b11' if k=='joukahainen' else 'b12';s.save_game();return
        _dead(s,b)
        if k=='vellamo':s.save['aino_freed']=True;s.save_game();s.vel_end_t=1
    def enter(s):
        sv=s.save;sv['vellamo_unlocked']=True;sv['vellamo_visited']=True;sv['bonfire']='b10'
        if 'b10' not in sv['seen']:sv['seen'].append('b10')
        s.save_game();s.state_name='vellamo_arrival';s.poht_t=0
        s.mapimg = None
        s.start_session(sv,s.p_pad[0] if s.p_pad[0] else s.kb)
        MUSIC.request('ranta');s.prewarm_vellamo()
    def prewarm(s):
        for ar in ('ranta','syvanne','katedraali'):sky_surface(ar);layers_for(ar);fog_surface(ar)
        for ph in (1,2,3):
            for k in ('joukahainen','ahti','aino','vellamo'):
                for po in ('idle','windup','attack','roar','fish','maiden','reveal'):newboss_frame(k,po,ph,0)
        for ch in range(24,28):s.chunk(ch)
    def reveal(s):
        s.reset_boss();s.state_name='aino_reveal';s.reveal_t=0
        for p in s.players:p.spawn((646+p.idx*6)*TILE,320);p.refill();p.inv=180
        s.save['bonfire']='b13'
        if 'b13' not in s.save['seen']:s.save['seen'].append('b13')
        s.save_game();gc.collect()
for k,v in [('update_arena',_V.update_arena),('update_area',_V.update_area),('draw_world',_V.draw_world),('start_boss',_V.start_boss),('on_boss_dead',_V.on_dead),('enter_vellamo',_V.enter),('prewarm_vellamo',_V.prewarm),('start_aino_reveal',_V.reveal)]:setattr(GameCore,k,v)
def _finish_vellamo(s):
    gc.collect();s.state_name='vellamo_ending';s.vel_end_t=0;s.save['vellamo_done']=True;s.save_game()
GameCore.start_vellamo_ending=_finish_vellamo
# Only supplement terrain rendering: returned cached strip remains the exact no-area surface.
mob_brain=Mob.brain
def _mb(s):
    if s.kind not in ('poltto','merikala','kutri'):return mob_brain(s)
    return aquatic_brain(s)
Mob.brain=_mb
_edraw=Enemy.draw
def _enemy_draw(s,surf,cx,cy):
    if not isinstance(s,WaterBoss):return _edraw(s,surf,cx,cy)
    spr=newboss_frame(s.key,getattr(s,'vb','idle'),max(1,min(3,round(s.phase))),s.t)
    if s.face>0:
        fk=('flip',s.key,getattr(s,'vb','idle'),max(1,min(3,round(s.phase))),s.t%4)
        if fk not in _BSPR:_BSPR[fk]=pygame.transform.flip(spr,True,False)
        spr=_BSPR[fk]
    px=int(s.x-cx-spr.get_width()//2);py=int(s.y-cy-spr.get_height())
    surf.blit(spr,(px,py));

Enemy.draw=_enemy_draw
def _mob_draw(s,surf,cx,cy):
    if s.kind not in ('poltto','merikala','kutri'):return enemy_draw(s,surf,cx,cy)
    x=int(s.x-cx);y=int(s.y-s.h/2-cy)
    if s.kind=='poltto':
        pygame.draw.circle(surf,(34,108,121),(x,y),8);pygame.draw.circle(surf,(113,216,183),(x,y),5)
        for i in range(5):pygame.draw.line(surf,(22,90,120),(x-8+i*4,y),(x-8+i*4,y-10),2)
    elif s.kind=='merikala':
        pygame.draw.ellipse(surf,(41,141,164),(x-14,y-8,25,16));pygame.draw.polygon(surf,(96,186,169),[(x-10,y),(x-25,y-8),(x-25,y+8)]);pygame.draw.circle(surf,(211,232,179),(x+7,y-2),2)
    else:
        pygame.draw.arc(surf,(146,171,219),(x-9,y-10,18,34),0,6.28,2)
        for i in range(3):pygame.draw.line(surf,(68,141,138),(x-7+i*7,y),(x-11+i*7,y+14),1)
enemy_draw=Mob.draw
Mob.draw=_mob_draw

# ======== p25_v13_ui.py ========
"""Identical pad semantics for title, true-ending offer, reveal and new ending."""
def new_title_items(s):
    items=[('cont',tr('m_continue'))]
    if s.title_save and s.title_save.get('vellamo_unlocked') and s.title_save.get('done'):items.append(('vellamo',tr('vel_choice')))
    return items+[('new',tr('m_new')),('settings',tr('m_settings')),('quit',tr('m_quit'))]
GameUI.title_items=new_title_items
def up_title(s):
    result=s.menu_in();items=s.title_items();index=s.sel('title',len(items),result);key=items[index][0]
    if result['back']:s.menu_i['title']=len(items)-1
    if not result['ok']:return
    sfx('confirm',.7);s._title_commit_device=getattr(s,'last_accept_pad',None)
    if key=='vellamo':
        committing_pad=s.last_pad
        s.start_session(s.title_save,committing_pad);s.enter_vellamo()
    elif key=='cont':s.begin_session(s.title_save)
    elif key=='new':
        if s.title_save:s.confirm_i=1;s.menu_i['confirm']=1;s.state_name='confirm'
        else:s.new_game_flow()
    elif key=='settings':s.open_settings('title')
    elif key=='quit':s.running=False
GameUI.up_title=up_title
def up_true_end(s):
    result=s.menu_in();s.true_t+=1
    if s.true_page>=4:
        index=s.sel('vel_offer',2,result)
        if result['ok']:
            if index==0:s.save['vellamo_unlocked']=True;s.save_game();s.enter_vellamo()
            else:s.back_to_title()
    elif (result['ok'] or result['any']) and s.true_t>30:s.true_page+=1;s.true_t=0
GameUI.up_true_ending=up_true_end
def up_reveal(s):
    result=s.menu_in();s.reveal_t+=1
    if (result['ok'] and s.reveal_t>1) or s.reveal_t>240:s.state_name='play';s.start_boss('vellamo')
GameUI.up_aino_reveal=up_reveal
def up_ending(s):
    result=s.menu_in()
    if result['ok'] or result['back'] or s.vel_end_t>500:s.back_to_title()
GameUI.up_vellamo_ending=up_ending
GameUI.up_vellamo_arrival=lambda s:(setattr(s,'state_name','play'),pygame.event.clear(),s.prewarm_vellamo())
def dr_arrival(s):
    s.canvas.fill((4,15,26));s.text(tr('area_ranta'),160,53,(158,220,200),s.big)
    pygame.draw.line(s.canvas,(99,190,173),(36,143),(284,143),1)
GameUI.dr_vellamo_arrival=dr_arrival

